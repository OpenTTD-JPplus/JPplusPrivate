spriteset(ng_hg_type300_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/higashiyama/ng_hg_type300/ng_hg_type300.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(ng_hg_type300_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/higashiyama/ng_hg_type300/ng_hg_type300.png"){ tmpl_purchase_2c_dual(0, 50) }
switch(FEAT_TRAINS, SELF, ng_hg_type300_purchase, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: ng_hg_type300_purchase_c1; 1: ng_hg_type300_purchase_c2;}

spriteset(ng_hg_type300_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/higashiyama/ng_hg_type300/ng_hg_type300.png"){ tmpl_std_v3(0, 0) }
spriteset(ng_hg_type300_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/higashiyama/ng_hg_type300/ng_hg_type300.png"){ tmpl_std_v3(0, 25) }
spriteset(ng_hg_type300_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/higashiyama/ng_hg_type300/ng_hg_type300.png"){ tmpl_symm_v3(0, 50) }



    switch(FEAT_TRAINS, SELF, sw_ng_hg_type300_head_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
      1: ng_hg_type300_end;
      ng_hg_type300_front;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_hg_type300_lv,vehicle_type_id){
      mu_car:ng_hg_type300_wag;
      sw_ng_hg_type300_head_gfx_main;
    }



    switch(FEAT_TRAINS, SELF, sw_ng_hg_type300_capacity_main,vehicle_type_id){
      ng_hg_type300: 110;
      default: 115;
    }

    switch(FEAT_TRAINS, SELF, sw_ng_hg_type300_car_power_main,position_in_vehid_chain_from_end %6){
      0..5:return 55;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_hg_type300_power_main,vehicle_type_id){
      ng_hg_type300: 55*2;
      sw_ng_hg_type300_car_power_main;
    }
# 63 "src/metro/Nagoya/items.pnml" 2

item(FEAT_TRAINS, ng_hg_type300) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_nagoya == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_NAGOYA), "300", string(STR_NAME_TYPE));
    introduction_date: date(1967, 3, 30);
    model_life: 38;
    vehicle_life: 33;
    dual_headed: 1;

    cost_factor: 17;
    running_cost_factor: 47;
    speed: 70 km/h;
    track_type:TR_1435_METRO
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 23 ton;
    badges: ["company/nagoya_subway", "line/nagoya_higashi"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 600)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 4,6)),

    string(STR_OPERATOR, string(STR_NAGOYA_SUBWAY))
    ,string(STR_LINES_USED, string(STR_NAGOYA_HIGASHI))
    );

    purchase: ng_hg_type300_purchase;
    cargo_capacity:sw_ng_hg_type300_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_ng_hg_type300_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_3D;
    default:sw_ng_hg_type300_lv;
    power:sw_ng_hg_type300_power_main()*4*1342/1000;
    purchase_power: sw_ng_hg_type300_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_3D;
    cargo_capacity:sw_ng_hg_type300_capacity_main()*param_capacity_mod/3;
    power:sw_ng_hg_type300_power_main()*4*1342/1000;
    default:sw_ng_hg_type300_lv;
    weight: 22;

  }
}
