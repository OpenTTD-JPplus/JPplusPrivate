   switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_1_fake_placer_2_gfx,position_in_vehid_chain){
    2: sotetsu5000n_1_end_f;
    3: sotetsu5000n_1_front_mot_f;
    sw_sotetsu5000n_1_panto_placer_main_1;
   }

   switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_1_fake_placer_3_gfx,position_in_vehid_chain){
    3: sotetsu5000n_1_end_f;
    4: sotetsu5000n_1_front_mot_f;
    sw_sotetsu5000n_1_panto_placer_main_2;
   }

  random_switch(FEAT_TRAINS,PARENT,sw_sotetsu5000n_1_fake_placer_main_0){
   1:sw_sotetsu5000n_1_fake_placer_1_gfx;
   2:sw_sotetsu5000n_1_fake_placer_2_gfx;
  }
  switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_1_fake_placer_main,num_vehs_in_vehid_chain+1){
   0..7: sw_sotetsu5000n_1_panto_placer_main_1;
   8..9: sw_sotetsu5000n_1_fake_placer_main_0;
   sw_sotetsu5000n_1_fake_placer_3_gfx;
  }

    switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_sotetsu5000n_1_end_gfx;
      sw_sotetsu5000n_1_front_gfx;
    }
  switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_lv,vehicle_type_id){
   mu_car:sw_sotetsu5000n_1_fake_placer_main;
   sw_sotetsu5000n_head_gfx_main;
  }



  switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_capacity_main,vehicle_type_id){
   mu_car:135;
   150;
  }

  switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_power_main_1,position_in_vehid_chain %8){
   1:return 180;
   3:return 180;
   6:return 180;
   return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_head_power,build_year){
   0..1987: return 75*2;
   return 180;
  }
  switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_car_power_main,build_year){
   0..1987:return 75;
   sw_sotetsu5000n_power_main_1;
  }
    switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_power_main,vehicle_type_id){
   mu_car:sw_sotetsu5000n_car_power_main;
   sw_sotetsu5000n_head_power;
  }
# 63 "src/private/Kanto/sotetsu/items.pnml" 2

item(FEAT_TRAINS, sotetsu5000n) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_sotetsu == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_SOTETSU), string(STR_CONCAT_2_DASH,"5100",string(STR_CONCAT_2,"5000",string(STR_NAME_2_GEN))), string(STR_NAME_SERIES));
    introduction_date: date(1972, 1, 1);
    model_life: 42;
    vehicle_life: 37;
    dual_headed: 1;

    cost_factor: 18;
    running_cost_factor: 49;
    speed: 100 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 30 ton;
    badges: ["company/sotetsu"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 8,10)),
    string(STR_USAGE, string(STR_COMMUTER)),
    string(STR_OPERATOR, string(STR_SOTETSU))

    );

    purchase: sotetsu5000n_purchase;
    cargo_capacity:sw_sotetsu5000n_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_sotetsu5000n_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_sotetsu5000n_lv;
    power:sw_sotetsu5000n_power_main()*4*1342/1000;
    purchase_power: sw_sotetsu5000n_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_sotetsu5000n_capacity_main()*param_capacity_mod/3;
    power:sw_sotetsu5000n_power_main()*4*1342/1000;
    default:sw_sotetsu5000n_lv;
    weight: 30;

  }
}
