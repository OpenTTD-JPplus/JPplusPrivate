# 734 "src/private/Kanto/tobu/items.pnml" 2

item(FEAT_TRAINS, tobu_deha10) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_tobu == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_TOBU), string(STR_NAME_DEHA, "10"), string(STR_NAME_TYPE));
    introduction_date: date(1935, 7, 13);
    model_life: 44;
    vehicle_life: 39;
    dual_headed: 0;

    cost_factor: 17;
    running_cost_factor: 48;
    speed: 95 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 41 ton;
    badges: ["company/tobu"];

  }
 graphics {
    can_attach_wagon: sw_same_attach_main;


    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS_REFIT, 2,3)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 1,2)),
    string(STR_USAGE, string(STR_CONCAT_2_OR, string(STR_COMMUTER),string(STR_EXPRESS))),
    string(STR_OPERATOR, string(STR_TOBU))

    );
    cargo_subtype_text: sw_tobu_deha10_lv_desc_main;
    purchase: tobu_deha10_purchase;
    cargo_capacity:138*param_capacity_mod/3;

    loading_speed:sw_tobu_deha10_loading_speed_main;
    default:sw_tobu_deha10_lv;
    power:sw_tobu_deha10_power_main()*4*1342/1000;
    purchase_power: sw_tobu_deha10_car_power_main()*4*1342/1000;
    speed:sw_tobu_deha10_speed_main;




  }
  livery_override(mu_car){
  cargo_subtype_text:sw_tobu_deha10_lv_desc_main;
    loading_speed:sw_tobu_deha10_loading_speed_main;
    cargo_capacity:138*param_capacity_mod/3;
    power:sw_tobu_deha10_power_main()*4*1342/1000;
    default:sw_tobu_deha10_lv;
    weight: 41;

  }
}
