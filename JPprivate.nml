  }


    switch(FEAT_TRAINS, SELF, sw_seibu401_1_head_gfx, vehicle_is_flipped==0||position_in_consist%2==0){
        1: seibu401_1_head_mot;
        seibu401_1_head;
    }

    switch(FEAT_TRAINS, SELF, sw_seibu401_1_panto_placer_main,position_in_vehid_chain %2){
        0: seibu401_1_wag;
        seibu401_1_mot;
    }

    switch(FEAT_TRAINS, SELF, seibu401_1_head_light, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: sw_seibu401_1_head_gfx; 1: sw_seibu401_1_lights;}
