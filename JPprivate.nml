item(FEAT_TRAINS, tk_sj_toei10_000) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_tokyo == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_TOEI), "10-000", string(STR_NAME_TYPE));
    introduction_date: date(1971, 12, 21);
    model_life: 52;
    vehicle_life: 47;
    dual_headed: 1;

    cost_factor: 20;
    running_cost_factor: 50;
    speed: 120 km/h;
    track_type:TR_1372_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 25 ton;
    badges: ["company/toei", "line/tokyo_shinjuku"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1372),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_3, 4,6,8)),

    string(STR_OPERATOR, string(STR_TOEI))
    ,string(STR_LINES_USED, string(STR_TOKYO_SHINJUKU))
    );
    cargo_subtype_text: sw_tk_sj_toei10_000_lv_desc_main;
    purchase: tk_sj_toei10_000_purchase;
    cargo_capacity:sw_tk_sj_toei10_000_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_tk_sj_toei10_000_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_tk_sj_toei10_000_lv;
    power:sw_tk_sj_toei10_000_power_main()*4*1342/1000;
    purchase_power: sw_tk_sj_toei10_000_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_tk_sj_toei10_000_lv_desc_main;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_tk_sj_toei10_000_capacity_main()*param_capacity_mod/3;
    power:sw_tk_sj_toei10_000_power_main()*4*1342/1000;
    default:sw_tk_sj_toei10_000_lv;
    weight: 24;

  }
}
