spriteset(os_nm_type500_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/namboku_mido/os_nm_type500/os_nm_type500.png"){ tmpl_std_rev_v3(0, 25) }
