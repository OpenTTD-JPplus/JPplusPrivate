    switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_capacity_main,vehicle_type_id){
      ng_sk_6000series: 138;
      default: 152;
    }

    switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_car_power_main,position_in_vehid_chain_from_end %3){
      0..1:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_power_main,vehicle_type_id){
      ng_sk_6000series: 170;
      sw_ng_sk_6000series_car_power_main;
    }
