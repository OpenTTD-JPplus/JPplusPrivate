# 63 "src/private/Kanto/seibu/items.pnml" 2

item(FEAT_TRAINS, seibu10000) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_seibu == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME_LONG, string(STR_NAME_SEIBU), "10000", string(STR_NAME_SERIES), string(STR_NAME_SEIBU_NRA));
    introduction_date: date(1993, 12, 6);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;

    cost_factor: 22;
    running_cost_factor: 49;
    speed: 120 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 33 ton;
    badges: ["company/seibu"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 1)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 7)),
    string(STR_USAGE, string(STR_LIMITED_EXPRESS)),
    string(STR_OPERATOR, string(STR_SEIBU))

    );
    cargo_subtype_text: sw_seibu10000_lv_desc_main;
    purchase: seibu10000_purchase;
    cargo_capacity:sw_seibu10000_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_seibu10000_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_1D;
    default:sw_seibu10000_lv;
    power:sw_seibu10000_power_main()*4*1342/1000;
    purchase_power: sw_seibu10000_car_power_main()*4*1342/1000;



    cargo_age_period: ltd_express_cargo_age;

  }
  livery_override(mu_car){
  cargo_subtype_text:sw_seibu10000_lv_desc_main;
    loading_speed:param_loading_1D;
    cargo_capacity:sw_seibu10000_capacity_main()*param_capacity_mod/3;
    power:sw_seibu10000_power_main()*4*1342/1000;
    default:sw_seibu10000_lv;
    weight: 33;

  }
}
