spriteset(os_nm_8000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/namboku_mido/os_nm_8000series/os_nm_8000series.png"){ tmpl_std_v3(0, 25) }
spriteset(os_nm_8000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/namboku_mido/os_nm_8000series/os_nm_8000series.png"){ tmpl_symm_v3(0, 50) }




    switch(FEAT_TRAINS, SELF, sw_os_nm_8000series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: os_nm_8000series_end;
      os_nm_8000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_8000series_lv,vehicle_type_id){
      mu_car:os_nm_8000series_wag;
      sw_os_nm_8000series_head_gfx_main;
    }



    switch(FEAT_TRAINS, SELF, sw_os_nm_8000series_capacity_main,vehicle_type_id){
      os_nm_8000series: 120;
      default: 128;
    }

    switch(FEAT_TRAINS, SELF, sw_os_nm_8000series_car_power_main,position_in_vehid_chain_from_end %8){
      2..4:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_8000series_power_main,vehicle_type_id){
      os_nm_8000series: 140*2;
      sw_os_nm_8000series_car_power_main;
    }
# 490 "src/metro/Osaka/items.pnml" 2

item(FEAT_TRAINS, os_nm_8000series) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_osaka == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_KITAKYU), "8000", string(STR_NAME_TYPE));
    introduction_date: date(1986, 2, 28);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;

    cost_factor: 19;
    running_cost_factor: 49;
    speed: 80 km/h;
    track_type:TR_1435_METRO
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 29 ton;
    badges: ["company/osaka_kitakyu", "line/osaka_midosuji"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 750)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 9,10)),

    string(STR_OPERATOR, string(STR_OSAKA_KITAKYU))
    ,string(STR_LINES_USED, string(STR_OSAKA_MIDO_NAMBOKU))
    );

    purchase: os_nm_8000series_purchase;
    cargo_capacity:sw_os_nm_8000series_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_os_nm_8000series_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_os_nm_8000series_lv;
    power:sw_os_nm_8000series_power_main()*4*1342/1000;
    purchase_power: sw_os_nm_8000series_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_os_nm_8000series_capacity_main()*param_capacity_mod/3;
    power:sw_os_nm_8000series_power_main()*4*1342/1000;
    default:sw_os_nm_8000series_lv;
    weight: 31;

  }
}
