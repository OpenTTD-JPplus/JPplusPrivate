spriteset(sp_nm_3000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Sapporo/sp_nm_3000series/sp_nm_3000series_1.png"){ tmpl_purchase_1c_dual(0, 0) }
