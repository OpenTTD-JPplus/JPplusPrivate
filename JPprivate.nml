spriteset(tk_nm_saitama2000_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Tokyo/namboku/tk_nm_saitama2000/tk_nm_saitama2000.png"){ tmpl_symm_v3(0, 75) }
spriteset(tk_nm_saitama2000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Tokyo/namboku/tk_nm_saitama2000/tk_nm_saitama2000.png"){ tmpl_symm_v3(0, 100) }




    switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_panto_placer_main_1,position_in_vehid_chain %5){
      0: tk_nm_saitama2000_mot;
      2: tk_nm_saitama2000_mot_2;
      tk_nm_saitama2000_wag;
    }

    switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_panto_placer_main_2,position_in_vehid_chain %3){
      1: tk_nm_saitama2000_mot_2;
      tk_nm_saitama2000_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_panto_placer_main,num_vehs_in_vehid_chain){
      0..1:sw_tk_nm_saitama2000_panto_placer_main_1;
      4: sw_tk_nm_saitama2000_panto_placer_main_1;
      sw_tk_nm_saitama2000_panto_placer_main_2;
    }

    switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tk_nm_saitama2000_end;
     tk_nm_saitama2000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_lv,vehicle_type_id){
      mu_car:sw_tk_nm_saitama2000_panto_placer_main;
      sw_tk_nm_saitama2000_head_gfx_main;
    }

  switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_capacity_main,vehicle_type_id){
    mu_car: 150;
    140;
  }

  switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_car_power_main,position_in_vehid_chain_from_end %6){
    0..1:return 190;
    3:return 190;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_power_main,vehicle_type_id){
    mu_car: sw_tk_nm_saitama2000_car_power_main;
    0;
  }
# 1954 "src/metro/Tokyo/items.pnml" 2

item(FEAT_TRAINS, tk_nm_saitama2000) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_tokyo == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_SAITAMA), "2000", string(STR_NAME_SERIES));
    introduction_date: date(2001, 3, 23);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;

    cost_factor: 20;
    running_cost_factor: 50;
    speed: 110 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 30 ton;
    badges: ["company/saitama"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 6)),

    string(STR_OPERATOR, string(STR_SAITAMA))
    ,string(STR_LINES_USED, string(STR_TOKYO_NAMBOKU_SAITAMA))
    );

    purchase: tk_nm_saitama2000_purchase;
    cargo_capacity:sw_tk_nm_saitama2000_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_tk_nm_saitama2000_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_tk_nm_saitama2000_lv;
    power:sw_tk_nm_saitama2000_power_main()*4*1342/1000;
    purchase_power: sw_tk_nm_saitama2000_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_tk_nm_saitama2000_capacity_main()*param_capacity_mod/3;
    power:sw_tk_nm_saitama2000_power_main()*4*1342/1000;
    default:sw_tk_nm_saitama2000_lv;
    weight: 30;

  }
}
