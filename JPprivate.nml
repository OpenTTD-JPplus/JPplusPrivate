# 1 "src/metro/Osaka/tsurumi/80series/80series.pnml" 1

spriteset(os_ts_80series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/tsurumi/80series/80series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(os_ts_80series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/tsurumi/80series/80series.png"){ tmpl_purchase_2c_dual(0, 75) }
switch(FEAT_TRAINS, SELF, gfx_os_ts_80series_purchase_main, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8,) ]) { 0: logo_osaka_metro; 1: logo_line_os_tsurumi; 2: os_ts_80series_purchase_c1; 3: os_ts_80series_purchase_c2;}

spriteset(os_ts_80series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/tsurumi/80series/80series.png"){ tmpl_std_v3(0, 0) }
spriteset(os_ts_80series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/tsurumi/80series/80series.png"){ tmpl_std_v3(0, 25) }
spriteset(os_ts_80series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/tsurumi/80series/80series.png"){ tmpl_symm_v3(0, 75) }
spriteset(os_ts_80series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/tsurumi/80series/80series.png"){ tmpl_symm_v3(0, 50) }



    switch(FEAT_TRAINS, SELF, sw_os_ts_80series_panto_placer,position_in_vehid_chain %3){
      1: os_ts_80series_mot;
      os_ts_80series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_os_ts_80series_panto_placer_rev,position_in_vehid_chain_from_end %3){
      1: os_ts_80series_mot;
      os_ts_80series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_os_ts_80series_panto_placer_main_1,vehicle_is_reversed){
      1: sw_os_ts_80series_panto_placer;
      sw_os_ts_80series_panto_placer_rev;
    }
    switch(FEAT_TRAINS, PARENT, sw_os_ts_80series_panto_placer_main,num_vehs_in_vehid_chain){
      0..4: os_ts_80series_wag;
      sw_os_ts_80series_panto_placer_main_1;
    }

    switch(FEAT_TRAINS, SELF, sw_os_ts_80series_head_gfx_main,position_in_consist>0){
      1: os_ts_80series_end;
      os_ts_80series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_ts_80series_lv,vehicle_type_id){
      mu_car:sw_os_ts_80series_panto_placer_main;
      sw_os_ts_80series_head_gfx_main;
    }


    switch(FEAT_TRAINS, SELF, sw_os_ts_80series_capacity_main,vehicle_type_id){
      os_ts_80series: 88;
      default: 99;
    }
