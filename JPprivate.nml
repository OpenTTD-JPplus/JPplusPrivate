# 1 "src/metro/Fukuoka/fk_kk_1000series/fk_kk_1000series.pnml" 1

spriteset(fk_kk_1000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Fukuoka/fk_kk_1000series/fk_kk_1000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(fk_kk_1000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Fukuoka/fk_kk_1000series/fk_kk_1000series.png"){ tmpl_purchase_2c_dual(0, 50) }
switch(FEAT_TRAINS, SELF, fk_kk_1000series_purchase, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: fk_kk_1000series_purchase_c1; 1: fk_kk_1000series_purchase_c2;}

spriteset(fk_kk_1000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Fukuoka/fk_kk_1000series/fk_kk_1000series.png"){ tmpl_std_v3(0, 0) }
spriteset(fk_kk_1000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Fukuoka/fk_kk_1000series/fk_kk_1000series.png"){ tmpl_std_v3(0, 25) }
spriteset(fk_kk_1000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Fukuoka/fk_kk_1000series/fk_kk_1000series.png"){ tmpl_symm_v3(0, 75) }
spriteset(fk_kk_1000series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Fukuoka/fk_kk_1000series/fk_kk_1000series.png"){ tmpl_symm_v3(0, 50) }

switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_head, train_is_driving_backwards != vehicle_is_flipped){
  1: fk_kk_1000series_end;
  fk_kk_1000series_front;
}




      switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_panto_placer_main_1,position_in_vehid_chain %2){
          0: fk_kk_1000series_mot;
          fk_kk_1000series_wag;
      }

      switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_panto_placer_main_2,position_in_vehid_chain %5){
          0: fk_kk_1000series_mot;
          2: fk_kk_1000series_mot;
          fk_kk_1000series_wag;
      }
    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_panto_placer_main,num_vehs_in_vehid_chain){
        0..4: sw_fk_kk_1000series_panto_placer_main_2;
        sw_fk_kk_1000series_panto_placer_main_1;
    }

    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_lv,vehicle_type_id){
      mu_car:sw_fk_kk_1000series_panto_placer_main;
      sw_fk_kk_1000series_head;
    }



    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_capacity_main,vehicle_type_id){
      fk_kk_1000series: 135;
      default: 146;
    }

    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 75;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_power_main,vehicle_type_id){
      fk_kk_1000series: 0;
      sw_fk_kk_1000series_car_power_main;
    }
