item(FEAT_TRAINS, ng_hg_type100) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_nagoya == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_NAGOYA), "100/500", string(STR_NAME_TYPE));
    introduction_date: date(1957, 9, 30);
    model_life: 36;
    vehicle_life: 31;
    dual_headed: 1;


    cost_factor: 17;
    running_cost_factor: 47;
    speed: 65 km/h;
    track_type: TR_1435_M;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 23 ton;

  }
 graphics {


    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 600)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_3, 2,4,6)),

    string(STR_OPERATOR, string(STR_NAGOYA))
    ,string(STR_LINES_USED, string(STR_NAGOYA_HIGASHI))
    );
    cargo_subtype_text: sw_ng_hg_type100_lv_desc_main;
    purchase: gfx_ng_hg_type100_purchase_main;
    cargo_capacity:sw_ng_hg_type100_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_3D;
    default:sw_ng_hg_type100_lv;
    power: sw_ng_hg_type100_power_main()*4*1342/1000;
    purchase_power: sw_ng_hg_type100_car_power_main()*4*1342/1000;


  }
  livery_override(mu_car){
  cargo_subtype_text:sw_ng_hg_type100_lv_desc_main;
    loading_speed:param_loading_3D;
    cargo_capacity:sw_ng_hg_type100_capacity_main()*param_capacity_mod/3;

    power: sw_ng_hg_type100_power_main()*4*1342/1000;
    default:sw_ng_hg_type100_lv;
    weight: 22;

  }
}
