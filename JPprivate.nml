item(FEAT_TRAINS, keisei3100) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_keisei == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_KEISEI), "3100/3150", string(STR_NAME_TYPE));
    introduction_date: date(1960, 11, 1);
    model_life: 52;
    vehicle_life: 47;
    dual_headed: 1;

    cost_factor: 18;
    running_cost_factor: 48;
    speed: 105 km/h;
    track_type:TR_1435_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 34 ton;
    badges: ["company/keisei"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 4,6)),
    string(STR_USAGE, string(STR_ACCESS_COMMUTER)),
    string(STR_OPERATOR, string(STR_KEISEI))

    );
    cargo_subtype_text: sw_keisei3100_lv_desc_main;
    purchase: keisei3100_purchase;
    cargo_capacity:128*param_capacity_mod/3;
    purchase_cargo_capacity:128*param_capacity_mod/3-1;
    loading_speed:param_loading_3D;
    default:sw_keisei3100_lv;
    power:sw_keisei3000_power_main()*4*1342/1000;
    purchase_power: sw_keisei3000_car_power_main()*4*1342/1000;

    start_stop: sw_stop_start_3;
    sound_effect: sw_KS3100_start_sound;


  }
  livery_override(mu_car){
  cargo_subtype_text:sw_keisei3100_lv_desc_main;
    loading_speed:param_loading_3D;
    cargo_capacity:128*param_capacity_mod/3;
    power:sw_keisei3000_power_main()*4*1342/1000;
    default:sw_keisei3100_lv;
    weight: 34;

  }
}
