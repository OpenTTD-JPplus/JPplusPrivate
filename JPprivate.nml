switch(FEAT_TRAINS, SELF, os_sn_50series_purchase, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: os_sn_50series_purchase_c1; 1: os_sn_50series_purchase_c2;}

spriteset(os_sn_50series_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/sennichimae/os_sn_50series/os_sn_50series.png"){ tmpl_std_v3(0, 0) }
spriteset(os_sn_50series_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/sennichimae/os_sn_50series/os_sn_50series.png"){ tmpl_std_v3(0, 25) }
spriteset(os_sn_50series_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/sennichimae/os_sn_50series/os_sn_50series.png"){ tmpl_std_v3(0, 50) }
spriteset(os_sn_50series_1_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/sennichimae/os_sn_50series/os_sn_50series.png"){ tmpl_std_v3(0, 50) }


spriteset(os_sn_50series_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/sennichimae/os_sn_50series/os_sn_50series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(os_sn_50series_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/sennichimae/os_sn_50series/os_sn_50series_1.png"){ tmpl_std_v3(0, 25) }
spriteset(os_sn_50series_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/sennichimae/os_sn_50series/os_sn_50series_1.png"){ tmpl_std_v3(0, 50) }
spriteset(os_sn_50series_2_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/sennichimae/os_sn_50series/os_sn_50series_1.png"){ tmpl_std_v3(0, 50) }


  switch(FEAT_TRAINS, SELF, os_sn_50series_front, cargo_subtype){
    1:os_sn_50series_2_front;
    os_sn_50series_1_front;
  }
  switch(FEAT_TRAINS, SELF, os_sn_50series_end, cargo_subtype){
    1:os_sn_50series_2_end;
    os_sn_50series_1_end;
  }
  switch(FEAT_TRAINS, SELF, os_sn_50series_wag, cargo_subtype){
    1:os_sn_50series_2_wag;
    os_sn_50series_1_wag;
  }
  switch(FEAT_TRAINS, SELF, os_sn_50series_wag_rev, cargo_subtype){
    1:os_sn_50series_2_wag_rev;
    os_sn_50series_1_wag_rev;
  }


  switch(FEAT_TRAINS, SELF, sw_os_sn_50series_wag_gfx,position_in_vehid_chain %2){
    0: os_sn_50series_wag_rev;
    os_sn_50series_wag;
  }


    switch(FEAT_TRAINS, SELF, sw_os_sn_50series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: os_sn_50series_end;
      os_sn_50series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_sn_50series_lv,vehicle_type_id){
      mu_car:sw_os_sn_50series_wag_gfx;
      sw_os_sn_50series_head_gfx_main;
    }



switch(FEAT_TRAINS, SELF, sw_os_sn_50series_lv_desc_main, cargo_subtype){
    0: string(LV_DATED, string(STR_PAINT,string(STR_WHITE)),1960);
    1: string(LV_DATED, string(STR_PAINT,string(STR_GREEN)),1960);
}
