  switch(FEAT_TRAINS, SELF, ng_sk_6000series_head_mot_2, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: ng_sk_6000series_head_base; 1: sw_ng_sk_6000series_lights; 2: ac_quad_1_mot_dual; 3: panto_d_arm;}





  switch(FEAT_TRAINS, SELF, ng_sk_6000series_mot, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: ng_sk_6000series_car_base; 1: ac_quad_1_mot_2; 2: panto_d_arm_single;}




