    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_kyoto == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_KYOTO), "20", string(STR_NAME_SERIES));
    introduction_date: date(2022, 3, 26);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;

    cost_factor: 20;
    running_cost_factor: 50;
    speed: 105 km/h;
    track_type:TR_1435_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 30 ton;
    badges: ["company/kyoto_subway", "line/kyoto_karasuma"];

  }
 graphics {


    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 6)),

    string(STR_OPERATOR, string(STR_KYOTO_SUBWAY))
    ,string(STR_LINES_USED, string(STR_KYOTO_KARASUMA))
    );

    purchase: kt_ks_20series_purchase;
    cargo_capacity:sw_kt_ks_20series_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_4D;
    default:sw_kt_ks_20series_lv;
    power:sw_kt_ks_20series_power_main()*4*1342/1000;
    purchase_power: sw_kt_ks_20series_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_kt_ks_20series_capacity_main()*param_capacity_mod/3;
    power:sw_kt_ks_20series_power_main()*4*1342/1000;
    default:sw_kt_ks_20series_lv;
    weight: 33;

  }
}
# 1 "src/metro/Kyoto/kt_tz_50series/kt_tz_50series.pnml" 1

spriteset(kt_tz_50series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Kyoto/kt_tz_50series/kt_tz_50series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(kt_tz_50series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Kyoto/kt_tz_50series/kt_tz_50series.png"){ tmpl_purchase_2c_dual(0, 25) }
switch(FEAT_TRAINS, SELF, kt_tz_50series_purchase, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8,) ]) { 0: kt_tz_50series_purchase_c1; 1: ac_double_1_c1; 2: kt_tz_50series_purchase_c2; 3: ac_double_1_c2;}


spriteset(kt_tz_50series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Kyoto/kt_tz_50series/kt_tz_50series_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(kt_tz_50series_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Kyoto/kt_tz_50series/kt_tz_50series_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_lights, train_is_driving_backwards != vehicle_is_flipped){
  1: kt_tz_50series_lights_end;
  kt_tz_50series_lights_front;
}

spriteset(kt_tz_50series_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Kyoto/kt_tz_50series/kt_tz_50series.png"){ tmpl_std_v3(0, 0) }
spriteset(kt_tz_50series_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Kyoto/kt_tz_50series/kt_tz_50series.png"){ tmpl_symm_v3(0, 25) }

switch(FEAT_TRAINS, SELF, kt_tz_50series_head, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: kt_tz_50series_head_base; 1: sw_kt_tz_50series_lights; 2: ac_double_1_wag_symm;}



switch(FEAT_TRAINS, SELF, kt_tz_50series_mot, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: kt_tz_50series_car_base; 1: ac_double_1_9; 2: panto_arm_n;}



switch(FEAT_TRAINS, SELF, kt_tz_50series_wag, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: kt_tz_50series_car_base; 1: ac_double_1_wag_symm;}





  switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_panto_placer_1_main,position_in_vehid_chain %5){
    0: kt_tz_50series_mot;
    2: kt_tz_50series_mot;
    kt_tz_50series_wag;
  }

    switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_lv,vehicle_type_id){
      mu_car:sw_kt_tz_50series_panto_placer_1_main;
      kt_tz_50series_head;
    }



    switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_capacity_main,vehicle_type_id){
      kt_tz_50series: 92;
      default: 104;
    }

    switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_car_power_main,position_in_vehid_chain_from_end %5){
      0..3:return 85;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_power_main,vehicle_type_id){
      kt_tz_50series: 0;
      sw_kt_tz_50series_car_power_main;
    }
