  switch(FEAT_TRAINS, SELF, os_nm_10series_front, cargo_subtype>2||(cargo_subtype==0&&current_year>2013)){
    1:os_nm_10series_2_front;
    os_nm_10series_1_front;
  }
  switch(FEAT_TRAINS, SELF, os_nm_10series_end, cargo_subtype>2||(cargo_subtype==0&&current_year>2013)){
    1:os_nm_10series_2_end;
    os_nm_10series_1_end;
  }
  switch(FEAT_TRAINS, SELF, os_nm_10series_wag, cargo_subtype>2||(cargo_subtype==0&&current_year>2013)){
    1:os_nm_10series_2_wag;
    os_nm_10series_1_wag;
  }




    switch(FEAT_TRAINS, SELF, sw_os_nm_10series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: os_nm_10series_end;
      os_nm_10series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_10series_lv,vehicle_type_id){
      mu_car:os_nm_10series_wag;
      sw_os_nm_10series_head_gfx_main;
    }



    switch(FEAT_TRAINS, SELF, sw_os_nm_10series_capacity_main,vehicle_type_id){
      mu_car: 140;
      return 130;
    }

    switch(FEAT_TRAINS, SELF, sw_os_nm_10series_car_power_main,position_in_vehid_chain_from_end %8){
      3..5:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_10series_power_main,vehicle_type_id){
      mu_car: sw_os_nm_10series_car_power_main;
      return 140*2;
    }


switch(FEAT_TRAINS, SELF, sw_os_nm_10series_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1975);
    2: string(LV_DATED,string(STR_LIVERY,string(STR_CONCAT_2,string(LV_DEFAULT),string(LV_WOMEN))),2016);
    3: string(LV_DATED,string(STR_LIVERY,string(STR_RENEWAL)),1998);
    4: string(LV_DATED,string(STR_LIVERY,string(STR_CONCAT_2,string(STR_RENEWAL),string(LV_WOMEN))),2016);
}
# 307 "src/metro/Osaka/items.pnml" 2

item(FEAT_TRAINS, os_nm_10series) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_osaka == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_OSAKA_METRO), "10", string(STR_NAME_SERIES));
    introduction_date: date(1973, 10, 12);
    model_life: 54;
    vehicle_life: 49;
    dual_headed: 1;

    cost_factor: 19;
    running_cost_factor: 49;
    speed: 80 km/h;
    track_type:TR_1435_METRO
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 31 ton;
    badges: ["company/osaka_metro", "line/osaka_midosuji"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 750)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_3, 8,9,10)),

    string(STR_OPERATOR, string(STR_OSAKA_METRO))
    ,string(STR_LINES_USED, string(STR_OSAKA_MIDOSUJI))
    );
    cargo_subtype_text: sw_os_nm_10series_lv_desc_main;
    purchase: os_nm_10series_purchase;
    cargo_capacity:sw_os_nm_10series_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_os_nm_10series_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_os_nm_10series_lv;
    power:sw_os_nm_10series_power_main()*4*1342/1000;
    purchase_power: sw_os_nm_10series_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_os_nm_10series_lv_desc_main;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_os_nm_10series_capacity_main()*param_capacity_mod/3;
    power:sw_os_nm_10series_power_main()*4*1342/1000;
    default:sw_os_nm_10series_lv;
    weight: 31;

  }
}
