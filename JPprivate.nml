# 307 "src/private/Kanto/tobu/items.pnml" 2

item(FEAT_TRAINS, tobu1800) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_tobu == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_TOBU), "1800", string(STR_NAME_SERIES));
    introduction_date: date(1969, 9, 20);
    model_life: 54;
    vehicle_life: 49;
    dual_headed: 1;

    cost_factor: 22;
    running_cost_factor: 50;
    speed: 110 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 33 ton;
    badges: ["company/tobu"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 1)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 4,6)),
    string(STR_USAGE, string(STR_CONCAT_2_OR, string(STR_LIMITED_EXPRESS),string(STR_COMMUTER))),
    string(STR_OPERATOR, string(STR_TOBU))

    );
    cargo_subtype_text: sw_tobu1800_lv_desc_main;
    purchase: tobu1800_purchase;
    cargo_capacity:sw_tobu1800_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_tobu1800_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_1D;
    default:sw_tobu1800_lv;
    power:sw_tobu1800_power_main()*4*1342/1000;
    purchase_power: sw_tobu1800_car_power_main()*4*1342/1000;



    cargo_age_period: sw_tobu1800_cargo_age_main;

  }
  livery_override(mu_car){
  cargo_subtype_text:sw_tobu1800_lv_desc_main;
    loading_speed:param_loading_1D;
    cargo_capacity:sw_tobu1800_capacity_main()*param_capacity_mod/3;
    power:sw_tobu1800_power_main()*4*1342/1000;
    default:sw_tobu1800_lv;
    weight: 36;

  }
}
