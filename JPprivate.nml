    3: string(LV_DATED,string(STR_LIVERY,string(STR_RENEWAL)),1998);
    4: string(LV_DATED,string(STR_LIVERY,string(STR_CONCAT_2,string(STR_RENEWAL),string(LV_WOMEN))),2016);
}
