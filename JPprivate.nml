item(FEAT_TRAINS, os_nm_9000series) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_osaka == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_KITAKYU), "9000", string(STR_NAME_TYPE));
    introduction_date: date(2014, 4, 28);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;

    cost_factor: 20;
    running_cost_factor: 50;
    speed: 95 km/h;
    track_type:TR_1435_METRO
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 31 ton;
    badges: ["company/osaka_kitakyu", "line/osaka_midosuji"];

  }
 graphics {


    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 750)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 10)),

    string(STR_OPERATOR, string(STR_OSAKA_KITAKYU))
    ,string(STR_LINES_USED, string(STR_OSAKA_MIDO_NAMBOKU))
    );
    cargo_subtype_text: sw_os_nm_9000series_lv_desc_main;
    purchase: os_nm_9000series_purchase;
    cargo_capacity:sw_os_nm_9000series_capacity_main()*param_capacity_mod/3;
