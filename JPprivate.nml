  switch(FEAT_TRAINS, SELF, ng_tm_3050series_head, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: ng_tm_3050series_head_base; 1: sw_ng_tm_3050series_lights; 2: ac_quad_1_wag;}



  switch(FEAT_TRAINS, SELF, ng_tm_3050series_head_mot_1, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: ng_tm_3050series_head_base; 1: sw_ng_tm_3050series_lights; 2: ac_quad_1_mot; 3: panto_d_arm_single;}





