    switch(FEAT_TRAINS, SELF, sw_os_yb_50series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: os_yb_50series_end;
      os_yb_50series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_yb_50series_lv,vehicle_type_id){
      mu_car:sw_os_yb_50series_wag_gfx;
      sw_os_yb_50series_head_gfx_main;
    }



switch(FEAT_TRAINS, SELF, sw_os_yb_50series_lv_desc_main, cargo_subtype){
    0: string(LV_DATED, string(STR_PAINT,string(STR_WHITE)),1960);
    1: string(LV_DATED, string(STR_PAINT,string(STR_GREEN)),1960);
}
# 946 "src/metro/Osaka/items.pnml" 2

item(FEAT_TRAINS, os_yb_50series) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_osaka == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_OSAKA_METRO), "50", string(STR_NAME_SERIES));
    introduction_date: date(1960, 3, 1);
    model_life: 34;
    vehicle_life: 29;
    dual_headed: 1;
    variant_group: os_nm_50series;
    cost_factor: 17;
    running_cost_factor: 47;
    speed: 70 km/h;
    track_type:TR_1435_METRO
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 36 ton;
    badges: ["company/osaka_metro", "line/osaka_yotsu"];

  }
 graphics {


    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 750)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 2,4)),

    string(STR_OPERATOR, string(STR_OSAKA_METRO))
    ,string(STR_LINES_USED, string(STR_OSAKA_YOTSU))
    );
    cargo_subtype_text: sw_os_yb_50series_lv_desc_main;
    purchase: os_yb_50series_purchase;
    cargo_capacity:84*param_capacity_mod/3;
    loading_speed:param_loading_3D;
    default:sw_os_yb_50series_lv;
    power:sw_os_nm_50series_power_main()*4*1342/1000;
    purchase_power: sw_os_nm_50series_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_os_yb_50series_lv_desc_main;
    loading_speed:param_loading_3D;
    cargo_capacity:84*param_capacity_mod/3;
    power:sw_os_nm_50series_power_main()*4*1342/1000;
    default:sw_os_yb_50series_lv;
    weight: 36;

  }
}
