    speed: 80 km/h;
    track_type:TR_1435_METRO
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 30 ton;
    badges: ["company/osaka_metro", "line/osaka_tanimachi"];

  }
 graphics {


    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 750)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 4,6)),

    string(STR_OPERATOR, string(STR_OSAKA_METRO))
    ,string(STR_LINES_USED, string(STR_OSAKA_TANIMACHI))
