spriteset(sp_nm_2000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_1.png"){ tmpl_purchase_2c_dual_7(0, 25) }
switch(FEAT_TRAINS, SELF, sp_nm_2000series_purchase, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: sp_nm_2000series_purchase_c1; 1: sp_nm_2000series_purchase_c2;}

spriteset(sp_nm_2000series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_nm_2000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_nm_2000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_1.png"){ tmpl_std_v3(0, 25) }
spriteset(sp_nm_2000series_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_1.png"){ tmpl_std_rev_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sp_nm_2000series_front, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: sp_nm_2000series_end; 1: sp_nm_2000series_lights_front;}


    switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_wag_gfx_main,position_in_vehid_chain %2){
      0:sp_nm_2000series_wag_rev;
      sp_nm_2000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sp_nm_2000series_end;
      sp_nm_2000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_lv,vehicle_type_id){
      mu_car:sw_sp_nm_2000series_wag_gfx_main;
      sw_sp_nm_2000series_head_gfx_main;
    }


  switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_capacity_main,vehicle_type_id){
    mu_car: 94;
    95;
  }

    switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 45;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_power_main,vehicle_type_id){
      mu_car:sw_sp_nm_2000series_car_power_main;
      90;
   }
# 2 "src/metro/Sapporo/items.pnml" 2

item(FEAT_TRAINS, sp_nm_2000series) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_sapporo == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_SAPPORO), "1000/2000", string(STR_NAME_TYPE));
    introduction_date: date(1970, 3, 1);
    model_life: 34;
    vehicle_life: 29;
    dual_headed: 1;

    cost_factor: 15;
    running_cost_factor: 45;
    speed: 70 km/h;
    track_type:TR_3000_GUIDE
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 17 ton;
    badges: ["company/sapporo_subway", "line/sapporo_namboku"];
    length: 7;
  }
 graphics {


    additional_text:string(STR_TRAIN_DESC,
    string(STR_3000),
    string(STR_DENKI, string(STR_DC, 750)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 2)),
    string(STR_FORMATION, string(STR_NUM_CARS_4, 2,4,6,8)),

    string(STR_OPERATOR, string(STR_SAPPORO_SUBWAY))
    ,string(STR_LINES_USED, string(STR_SAPPORO_NAMBOKU))
    );

    purchase: sp_nm_2000series_purchase;
    cargo_capacity:sw_sp_nm_2000series_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_2D;
    default:sw_sp_nm_2000series_lv;
    power:sw_sp_nm_2000series_power_main()*4*1342/1000;
    purchase_power: sw_sp_nm_2000series_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_2D;
    cargo_capacity:sw_sp_nm_2000series_capacity_main()*param_capacity_mod/3;
    power:sw_sp_nm_2000series_power_main()*4*1342/1000;
    default:sw_sp_nm_2000series_lv;
    weight: 18;
    length: 7;
  }
}
