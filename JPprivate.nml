spriteset(sp_nm_3000series_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Sapporo/sp_nm_3000series/sp_nm_3000series_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sp_nm_3000series_lights, train_is_driving_backwards != vehicle_is_flipped){
  1: sp_nm_3000series_lights_end;
  sp_nm_3000series_lights_front;
}
spriteset(sp_nm_3000series_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Sapporo/sp_nm_3000series/sp_nm_3000series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_nm_3000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Sapporo/sp_nm_3000series/sp_nm_3000series_1.png"){ tmpl_symm_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sp_nm_3000series_head, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: sp_nm_3000series_head_base; 1: sp_nm_3000series_lights;}




    switch(FEAT_TRAINS, SELF, sw_sp_nm_3000series_lv,vehicle_type_id){
      mu_car:sp_nm_3000series_wag;
      sp_nm_3000series_head;
    }


  switch(FEAT_TRAINS, SELF, sw_sp_nm_3000series_capacity_main,vehicle_type_id){
    mu_car: 92;
    93;
  }

    switch(FEAT_TRAINS, SELF, sw_sp_nm_3000series_car_power_main,position_in_vehid_chain_from_end %8){
      0..6:return 55;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_nm_3000series_power_main,vehicle_type_id){
      mu_car:sw_sp_nm_3000series_car_power_main;
      110;
   }
