item(FEAT_TRAINS, tk_as_toei5200) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_tokyo == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_TOEI), "5200", string(STR_NAME_TYPE));
    introduction_date: date(1976, 4, 1);
    model_life: 35;
    vehicle_life: 30;
    dual_headed: 1;

    cost_factor: 20;
    running_cost_factor: 50;
    speed: 100 km/h;
    track_type:TR_1435_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 34 ton;
    badges: ["company/toei", "line/tokyo_asakusa"];

  }
 graphics {


    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 6,8)),

    string(STR_OPERATOR, string(STR_TOEI))
    ,string(STR_LINES_USED, string(STR_TOKYO_ASAKUSA))
    );

    purchase: tk_as_toei5200_purchase;
    cargo_capacity:sw_tk_as_toei5000_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_3D;
    default:sw_tk_as_toei5200_lv;
    power:sw_tk_as_toei5000_power_main()*4*1342/1000;
    purchase_power: sw_tk_as_toei5000_car_power_main()*4*1342/1000;


    sound_effect: sw_TOEI5200_start_sound;


  }
  livery_override(mu_car){
  cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_3D;
    cargo_capacity:sw_tk_as_toei5000_capacity_main()*param_capacity_mod/3;
    power:sw_tk_as_toei5000_power_main()*4*1342/1000;
    default:sw_tk_as_toei5200_lv;
    weight: 33;

  }
}
# 1 "src/metro/Tokyo/asakusa/tk_as_toei5300/tk_as_toei5300.pnml" 1

  spriteset(tk_as_toei5300_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Tokyo/asakusa/tk_as_toei5300/tk_as_toei5300.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tk_as_toei5300_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Tokyo/asakusa/tk_as_toei5300/tk_as_toei5300.png"){ tmpl_purchase_2c_dual(0, 25) }
  switch(FEAT_TRAINS, SELF, tk_as_toei5300_purchase, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8,) ]) { 0: tk_as_toei5300_purchase_c1; 1: ac_long_toshiba_c1; 2: tk_as_toei5300_purchase_c2; 3: ac_long_toshiba_c2;}

spriteset(tk_as_toei5300_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Tokyo/asakusa/tk_as_toei5300/tk_as_toei5300_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_as_toei5300_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Tokyo/asakusa/tk_as_toei5300/tk_as_toei5300_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sw_tk_as_toei5300_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: tk_as_toei5300_lights_end;
    tk_as_toei5300_lights_front;
  }
spriteset(tk_as_toei5300_head_base_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Tokyo/asakusa/tk_as_toei5300/tk_as_toei5300.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_as_toei5300_head_base_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Tokyo/asakusa/tk_as_toei5300/tk_as_toei5300.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_as_toei5300_wag_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Tokyo/asakusa/tk_as_toei5300/tk_as_toei5300.png"){ tmpl_symm_v3(0, 50) }
switch(FEAT_TRAINS, SELF, tk_as_toei5300_head_base, build_year){
  0..1993:tk_as_toei5300_head_base_1;
  tk_as_toei5300_head_base_2;
}

  switch(FEAT_TRAINS, SELF, gfx_tk_as_toei5300_head, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: tk_as_toei5300_head_base; 1: sw_tk_as_toei5300_lights; 2: ac_long_toshiba;}
  switch(FEAT_TRAINS, SELF, gfx_tk_as_toei5300_mot, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: tk_as_toei5300_wag_base; 1: ac_long_toshiba; 2: panto_arm_n;}
  switch(FEAT_TRAINS, SELF, gfx_tk_as_toei5300_wag, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: tk_as_toei5300_wag_base; 1: ac_long_toshiba;}




      switch(FEAT_TRAINS, SELF, sw_toei5300_panto_placer_main_1,position_in_vehid_chain %6){
        1: gfx_tk_as_toei5300_mot;
        4: gfx_tk_as_toei5300_mot;
        default: gfx_tk_as_toei5300_wag;
      }

      switch(FEAT_TRAINS, SELF, sw_toei5300_panto_placer_main_2,position_in_vehid_chain %3){
        0: gfx_tk_as_toei5300_mot;
        default: gfx_tk_as_toei5300_wag;
      }

    switch(FEAT_TRAINS, SELF, sw_toei5300_panto_placer_main,num_vehs_in_vehid_chain){
      0..2: sw_toei5300_panto_placer_main_2;
      4: sw_toei5300_panto_placer_main_2;
      sw_toei5300_panto_placer_main_1;
    }

    switch(FEAT_TRAINS, SELF, sw_tk_as_toei5300_lv,vehicle_type_id){
      mu_car:sw_toei5300_panto_placer_main;
      gfx_tk_as_toei5300_head;
    }


    switch(FEAT_TRAINS, SELF, sw_tk_as_toei5300_capacity_main,vehicle_type_id){
      tk_as_toei5300: 123;
      default: 134;
    }

    switch(FEAT_TRAINS, SELF, sw_tk_as_toei5300_car_power_main,position_in_vehid_chain_from_end %6){
      1:return 165;
      4:return 165;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_as_toei5300_power_main,vehicle_type_id){
      tk_as_toei5300: 165*2;
      sw_tk_as_toei5300_car_power_main;
    }
