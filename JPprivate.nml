item(FEAT_TRAINS, fk_nk_3000series) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_fukuoka == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_FUKUOKA), "3000", string(STR_NAME_SERIES));
    introduction_date: date(2005, 2, 3);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;

    cost_factor: 19;
    running_cost_factor: 49;
    speed: 120 km/h;
    track_type:TR_1435_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 27 ton;
    badges: ["company/fukuoka_subway", "line/fukuoka_nanakuma"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 4)),

    string(STR_OPERATOR, string(STR_FUKUOKA_SUBWAY))
    ,string(STR_LINES_USED, string(STR_FUKUOKA_NANAKUMA))
    );
    cargo_subtype_text: sw_fk_nk_3000series_lv_desc_main;
    purchase: fk_nk_3000series_purchase;
    cargo_capacity:sw_fk_nk_3000series_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_fk_nk_3000series_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_3D;
    default:sw_fk_nk_3000series_lv;
    power:sw_fk_nk_3000series_power_main()*4*1342/1000;
    purchase_power: sw_fk_nk_3000series_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_fk_nk_3000series_lv_desc_main;
    loading_speed:param_loading_3D;
    cargo_capacity:sw_fk_nk_3000series_capacity_main()*param_capacity_mod/3;
    power:sw_fk_nk_3000series_power_main()*4*1342/1000;
    default:sw_fk_nk_3000series_lv;
    weight: 26;

  }
}
