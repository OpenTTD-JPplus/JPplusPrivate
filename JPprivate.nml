spriteset(os_yb_50series_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/yotsubashi/os_yb_50series/os_yb_50series_1.png"){ tmpl_std_v3(0, 25) }
spriteset(os_yb_50series_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/yotsubashi/os_yb_50series/os_yb_50series_1.png"){ tmpl_std_v3(0, 50) }
spriteset(os_yb_50series_2_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/yotsubashi/os_yb_50series/os_yb_50series_1.png"){ tmpl_std_rev_v3(0, 50) }



  switch(FEAT_TRAINS, SELF, os_yb_50series_front, cargo_subtype){
    1:os_yb_50series_2_front;
    os_yb_50series_1_front;
  }
  switch(FEAT_TRAINS, SELF, os_yb_50series_end, cargo_subtype){
    1:os_yb_50series_2_end;
    os_yb_50series_1_end;
  }
  switch(FEAT_TRAINS, SELF, os_yb_50series_wag, cargo_subtype){
    1:os_yb_50series_2_wag;
    os_yb_50series_1_wag;
  }
  switch(FEAT_TRAINS, SELF, os_yb_50series_wag_rev, cargo_subtype){
