item(FEAT_TRAINS, ng_sk_6000series) {
  property {
    cargo_capacity: 1; ai_special_flag: AI_FLAG_PASSENGER; sprite_id: SPRITE_ID_NEW_TRAIN; misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY); refittable_cargo_classes: bitmask(CC_PASSENGERS); running_cost_base: RUNNING_COST_ELECTRIC; engine_class: ENGINE_CLASS_ELECTRIC; visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER); bitmask_vehicle_info: 0; power: 1 kW; reliability_decay: 2;

    climates_available: param_disable_nagoya == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_NAGOYA), "6000", string(STR_NAME_TYPE));
    introduction_date: date(1987, 10, 27);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;

    cost_factor: 19;
    running_cost_factor: 49;
    speed: 120 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient: 0.2;
    weight: 33 ton;
    badges: ["company/nagoya_subway", "line/nagoya_sakura"];

  }
 graphics {



    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 4,5)),

    string(STR_OPERATOR, string(STR_NAGOYA_SUBWAY))
    ,string(STR_LINES_USED, string(STR_NAGOYA_SAKURA))
    );

    purchase: ng_sk_6000series_purchase;
    cargo_capacity:sw_ng_sk_6000series_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_ng_sk_6000series_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_ng_sk_6000series_lv;
    power:sw_ng_sk_6000series_power_main()*4*1342/1000;
    purchase_power: sw_ng_sk_6000series_car_power_main()*4*1342/1000;





  }
  livery_override(mu_car){
  cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_ng_sk_6000series_capacity_main()*param_capacity_mod/3;
    power:sw_ng_sk_6000series_power_main()*4*1342/1000;
    default:sw_ng_sk_6000series_lv;
    weight: 32;

  }
}
# 1 "src/metro/Nagoya/sakura/ng_sk_6050series/ng_sk_6050series.pnml" 1

spriteset(ng_sk_6050series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/sakura/ng_sk_6050series/ng_sk_6050series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(ng_sk_6050series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/sakura/ng_sk_6050series/ng_sk_6050series.png"){ tmpl_purchase_2c_dual(0, 75) }
switch(FEAT_TRAINS, SELF, ng_sk_6050series_purchase, [ STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ]) { 0: ng_sk_6050series_purchase_c1; 1: ng_sk_6050series_purchase_c2;}

spriteset(ng_sk_6050series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/sakura/ng_sk_6050series/ng_sk_6050series.png"){ tmpl_std_v3(0, 0) }
spriteset(ng_sk_6050series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/sakura/ng_sk_6050series/ng_sk_6050series.png"){ tmpl_std_v3(0, 25) }
spriteset(ng_sk_6050series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/sakura/ng_sk_6050series/ng_sk_6050series.png"){ tmpl_std_v3(0, 50) }
spriteset(ng_sk_6050series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Nagoya/sakura/ng_sk_6050series/ng_sk_6050series.png"){ tmpl_std_v3(0, 75) }

switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_head, train_is_driving_backwards != vehicle_is_flipped){
  1: ng_sk_6050series_end;
  ng_sk_6050series_front;
}




      switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_panto_placer_main_1,position_in_vehid_chain %6){
        0: ng_sk_6050series_mot;
        1: ng_sk_6050series_mot;
        2: ng_sk_6050series_mot;
        ng_sk_6050series_wag;
      }

      switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_panto_placer_main_2,position_in_articulated_veh %2){
          0: ng_sk_6050series_mot;
          ng_sk_6050series_wag;
      }
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_panto_placer_main,num_vehs_in_vehid_chain){
      0..4:sw_ng_sk_6050series_panto_placer_main_1;
      sw_ng_sk_6050series_panto_placer_main_2;
    }

    switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_lv,vehicle_type_id){
      mu_car:sw_ng_sk_6050series_panto_placer_main;
      sw_ng_sk_6050series_head;
    }



    switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_capacity_main,vehicle_type_id){
      ng_sk_6050series: 136;
      default: 147;
    }

    switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_car_power_main,position_in_vehid_chain_from_end %5){
      0..2:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_power_main,vehicle_type_id){
      ng_sk_6050series: 0;
      sw_ng_sk_6050series_car_power_main;
    }
