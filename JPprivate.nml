    climates_available: param_disable_seibu == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_SEIBU), string(STR_NAME_NEW, "101/301"), string(STR_NAME_SERIES));
    introduction_date: date(1979, 7, 1);
