spriteset(tk_hb_eidan3000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Tokyo/hibiya/tk_hb_eidan3000/tk_hb_eidan3000.png"){ tmpl_symm_v3(0, 75) }




      switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_panto_placer_main_1,position_in_vehid_chain %4){
        1: tk_hb_eidan3000_mot;
        tk_hb_eidan3000_wag;
      }

      switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_panto_placer_main_2,position_in_vehid_chain %5){
        1: tk_hb_eidan3000_mot;
        3: tk_hb_eidan3000_mot;
        tk_hb_eidan3000_wag;
      }

    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_panto_placer_main,num_vehs_in_vehid_chain){
      0..2: tk_hb_eidan3000_wag;
      3..4: sw_tk_hb_eidan3000_panto_placer_main_1;
      sw_tk_hb_eidan3000_panto_placer_main_2;
    }

    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_fake_placer_gfx,position_in_vehid_chain){
      2: tk_hb_eidan3000_end_rev;
      3: tk_hb_eidan3000_end;
      tk_hb_eidan3000_wag;
    }

    random_switch(FEAT_TRAINS, PARENT, sw_tk_hb_eidan3000_fake_placer_main_1){
      3:sw_tk_hb_eidan3000_panto_placer_main;
      1:sw_tk_hb_eidan3000_fake_placer_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_fake_placer_main,num_vehs_in_vehid_chain==6){
      1: sw_tk_hb_eidan3000_fake_placer_main_1;
      sw_tk_hb_eidan3000_panto_placer_main;
    }


    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tk_hb_eidan3000_end;
      tk_hb_eidan3000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_lv,vehicle_type_id){
      mu_car:sw_tk_hb_eidan3000_fake_placer_main;
      sw_tk_hb_eidan3000_head_gfx_main;
    }



  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_capacity_main,vehicle_type_id){
    mu_car: 128;
    120;
  }

  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_car_power_main,position_in_vehid_chain_from_end %8){
    0..6:return 75;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_power_main,vehicle_type_id){
      mu_car:sw_tk_hb_eidan3000_car_power_main;
      75*2;
   }
