}
template tmpl_purchase_2c(x,y) {
    [x +32, y, 8, 17, 40, -13]
}
template tmpl_purchase_1c_7(x,y) {
    [x +120, y,28, 17, -7, -13]
}
template tmpl_purchase_2c_7(x,y) {
    [x +32, y, 12, 17, 35, -13]
}

