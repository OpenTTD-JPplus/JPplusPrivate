spriteset(os_sn_50series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/metro/Osaka/sennichimae/os_sn_50series/os_sn_50series.png"){ tmpl_purchase_1c_dual(0, 0) }
