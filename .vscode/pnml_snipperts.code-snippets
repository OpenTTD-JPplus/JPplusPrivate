{
  // Place your JPplusPrivate workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  "Create switch": {
    "prefix": "swdefault",
    "body": ["switch(FEAT_TRAINS, SELF, $1, $2){\n\t\n\t\n}"],
    "description": "Regular switch"
  },
  "Create LV switch": {
    "prefix": "swlivery",
    "body": ["switch(FEAT_TRAINS, SELF, $1, cargo_subtype){\n\t0:;\n\t1:;\n}"],
    "description": "Regular switch"
  },
  "Create Current-year switch": {
    "prefix": "swcyear",
    "body": ["switch(FEAT_TRAINS, SELF, $1, current_year){\n\t0..:;\n\tX;\n}"],
    "description": "Regular switch"
  },
  "Create Build-year switch": {
    "prefix": "swbuild",
    "body": ["switch(FEAT_TRAINS, SELF, $1, build_year){\n\t0..:;\n\tX;\n}"],
    "description": "Regular switch"
  }
}
