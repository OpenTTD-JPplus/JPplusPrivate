//purchase
spriteset(kb_kg_5000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kobe/kaigan/5000series/5000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(kb_kg_5000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kobe/kaigan/5000series/5000series.png"){ tmpl_purchase_2c_dual(0, 75) }
GRAPHIC_STACK_2(kb_kg_5000series_purchase, kb_kg_5000series_purchase_c1, kb_kg_5000series_purchase_c2)
//livery 1

spriteset(kb_kg_5000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kobe/kaigan/5000series/5000series.png"){ tmpl_std_v3(0, 0) }
spriteset(kb_kg_5000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kobe/kaigan/5000series/5000series.png"){ tmpl_std_v3(0, 25) }
spriteset(kb_kg_5000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kobe/kaigan/5000series/5000series.png"){ tmpl_symm_v3(0, 75) }
spriteset(kb_kg_5000series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kobe/kaigan/5000series/5000series.png"){ tmpl_symm_v3(0, 50) }

//main
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_kb_kg_5000series_panto_placer_1,position_in_vehid_chain %3){
      1: kb_kg_5000series_mot;
      kb_kg_5000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_kb_kg_5000series_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
      1: kb_kg_5000series_mot;
      kb_kg_5000series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_kb_kg_5000series_panto_placer_1_main,vehicle_is_reversed){
      1: sw_kb_kg_5000series_panto_placer_1_rev;
      sw_kb_kg_5000series_panto_placer_1;
    }
  //panto main
    switch(FEAT_TRAINS, SELF, sw_kb_kg_5000series_panto_placer_main,num_vehs_in_vehid_chain >3){
      1:sw_kb_kg_5000series_panto_placer_1_main;
      kb_kg_5000series_wag;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_kb_kg_5000series_head_gfx_main,position_in_consist>0){
      1: kb_kg_5000series_end;
      kb_kg_5000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_kb_kg_5000series_lv,vehicle_type_id){
      mu_car:sw_kb_kg_5000series_panto_placer_main;
      sw_kb_kg_5000series_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_kb_kg_5000series_capacity_main,vehicle_type_id){
      kb_kg_5000series: 84;
      default: 97;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_kb_kg_5000series_car_power_main,position_in_vehid_chain_from_end %3){
      0:return 67;
      1:return 68;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kb_kg_5000series_power_main,vehicle_type_id){
      kb_kg_5000series: 135;
      sw_kb_kg_5000series_car_power_main;
    }
//

