item(FEAT_TRAINS, kb_kg_5000series) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_kobe == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_KOBE), "5000", string(STR_NAME_TYPE));
    introduction_date: date(2001, 7, 7);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;
    
    
    cost_factor: 18;
    running_cost_factor: 48;
    speed: 80 km/h;
    track_type: TR_1435_LINEAR;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 27 ton;
    
  }
	graphics {
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 4)),
    
    string(STR_OPERATOR, string(STR_KOBE))
    ,string(STR_LINES_USED, string(STR_KOBE_KAIGAN))
    );
    
    purchase: kb_kg_5000series_purchase;
    cargo_capacity:sw_kb_kg_5000series_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_3D;
    default:sw_kb_kg_5000series_lv;
    power: sw_kb_kg_5000series_power_main()*4*1342/1000;
    purchase_power: sw_kb_kg_5000series_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_3D;
    cargo_capacity:sw_kb_kg_5000series_capacity_main()*param_capacity_mod/3;
    
    power: sw_kb_kg_5000series_power_main()*4*1342/1000;
    default:sw_kb_kg_5000series_lv;
    weight: 25;
    
  }
}
