//purchase
spriteset(sp_th_7000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_7000series/sp_th_7000series_1.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(sp_th_7000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_7000series/sp_th_7000series_1.png"){ tmpl_purchase_2c_dual(0, 25) }
GRAPHIC_STACK_2(sp_th_7000series_purchase, sp_th_7000series_purchase_c1, sp_th_7000series_purchase_c2)

spriteset(sp_th_7000series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_7000series/sp_th_7000series_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_th_7000series_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_7000series/sp_th_7000series_lights.png"){ tmpl_std_v3(0, 25) }
spriteset(sp_th_7000series_head_base_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_7000series/sp_th_7000series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_th_7000series_wag_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_7000series/sp_th_7000series_1.png"){ tmpl_symm_v3(0, 25) }
spriteset(sp_th_7000series_wag_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_7000series/sp_th_7000series_2.png"){ tmpl_symm_v3(0, 25) }
spriteset(sp_th_7000series_head_base_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_7000series/sp_th_7000series_2.png"){ tmpl_std_v3(0, 0) }

TRAIN_CONSTRUCTOR_2(sp_th_7000series_front_1, sp_th_7000series_head_base_1, sp_th_7000series_lights_front)
TRAIN_CONSTRUCTOR_2(sp_th_7000series_end_1, sp_th_7000series_head_base_1, sp_th_7000series_lights_end)
TRAIN_CONSTRUCTOR_2(sp_th_7000series_front_2, sp_th_7000series_head_base_2, sp_th_7000series_lights_front)
TRAIN_CONSTRUCTOR_2(sp_th_7000series_end_2, sp_th_7000series_head_base_2, sp_th_7000series_lights_end)

TRAIN_CONSTRUCTOR_2(sp_th_7000series_mot_1, sp_th_7000series_wag_1, panto_d_arm_sapporo)
TRAIN_CONSTRUCTOR_2(sp_th_7000series_mot_2, sp_th_7000series_wag_2, panto_d_arm_sapporo)

switch(FEAT_TRAINS, SELF, sp_th_7000series_front_timed, build_year){
  0..1993:sp_th_7000series_front_1;  sp_th_7000series_front_2;
}
switch(FEAT_TRAINS, SELF, sp_th_7000series_end_timed, build_year){
  0..1993:sp_th_7000series_end_1;  sp_th_7000series_end_2;
}
switch(FEAT_TRAINS, SELF, sp_th_7000series_wag_timed, build_year){
  0..1993:sp_th_7000series_wag_1;  sp_th_7000series_wag_2;
}
switch(FEAT_TRAINS, SELF, sp_th_7000series_mot_timed, build_year){
  0..1993:sp_th_7000series_mot_1;  sp_th_7000series_mot_2;
}
switch(FEAT_TRAINS, SELF, sp_th_7000series_front, cargo_subtype){
  0:sp_th_7000series_front_timed;
  1:sp_th_7000series_front_1;
  2:sp_th_7000series_front_2;
}
switch(FEAT_TRAINS, SELF, sp_th_7000series_end, cargo_subtype){
  0:sp_th_7000series_end_timed;
  1:sp_th_7000series_end_1;
  2:sp_th_7000series_end_2;
}
switch(FEAT_TRAINS, SELF, sp_th_7000series_wag, cargo_subtype){
  0:sp_th_7000series_wag_timed;
  1:sp_th_7000series_wag_1;
  2:sp_th_7000series_wag_2;
}
switch(FEAT_TRAINS, SELF, sp_th_7000series_mot, cargo_subtype){
  0:sp_th_7000series_mot_timed;
  1:sp_th_7000series_mot_1;
  2:sp_th_7000series_mot_2;
}
//*main
  //panto placer
    switch(FEAT_TRAINS, SELF, sp_th_7000series_panto_placer, position_in_vehid_chain_from_end %3){
      0:sp_th_7000series_mot;
      sp_th_7000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sp_th_7000series_panto_placer_rev, position_in_vehid_chain %3){
      0:sp_th_7000series_mot;
      sp_th_7000series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sp_th_7000series_panto_placer_main, vehicle_is_reversed){
      1:sp_th_7000series_panto_placer_rev;
      sp_th_7000series_panto_placer;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_sp_th_7000series_head_gfx_main,position_in_consist>0){
      1:sp_th_7000series_end;
      sp_th_7000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_th_7000series_lv,vehicle_type_id){
      mu_car:sp_th_7000series_panto_placer_main;
      sw_sp_th_7000series_head_gfx_main;
    }
//lv desc
  switch(FEAT_TRAINS, SELF, sw_sp_th_7000series_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(LV_DEFAULT),1987);
    2:string(LV_DATED,string(STR_BATCH,3),1994);
  }
//post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_sp_th_7000series_capacity_main,vehicle_type_id){
    mu_car: 130;
    128;
  }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_sp_th_7000series_car_power_main,position_in_vehid_chain %6){
      0..5:return 75;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_th_7000series_power_main,vehicle_type_id){
      mu_car:sw_sp_th_7000series_car_power_main;
      75*2;
   }
