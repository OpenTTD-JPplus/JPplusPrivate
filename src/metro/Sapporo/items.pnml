item(FEAT_TRAINS, sp_nm_2000series) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_sapporo == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_SAPPORO), "1000/2000", string(STR_NAME_TYPE));
    introduction_date: date(1970, 3, 1);
    model_life: 34;
    vehicle_life: 29;
    dual_headed: 1;
    
    
    cost_factor: 15;
    running_cost_factor: 45;
    speed: 70 km/h;
    track_type: TR_3000_GUIDE;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 17 ton;
    badges: ["company/tobu"];
    length: 7;
  }
	graphics {
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_3000),
    string(STR_DENKI, string(STR_DC, 750)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 2)),
    string(STR_FORMATION, string(STR_NUM_CARS_4, 2,4,6,8)),
    
    string(STR_OPERATOR, string(STR_SAPPORO))
    ,string(STR_LINES_USED, string(STR_SAPPORO_NAMBOKU))
    );
    
    purchase: sp_nm_2000series_purchase;
    cargo_capacity:sw_sp_nm_2000series_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_2D;
    default:sw_sp_nm_2000series_lv;
    power: sw_sp_nm_2000series_power_main()*4*1342/1000;
    purchase_power: sw_sp_nm_2000series_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_2D;
    cargo_capacity:sw_sp_nm_2000series_capacity_main()*param_capacity_mod/3;
    
    power: sw_sp_nm_2000series_power_main()*4*1342/1000;
    default:sw_sp_nm_2000series_lv;
    weight: 18;
    length: 7;
  }
}
