//purchase
spriteset(sp_th_9000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_9000series/sp_th_9000series_1.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(sp_th_9000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_9000series/sp_th_9000series_1.png"){ tmpl_purchase_2c_dual(0, 25) }
GRAPHIC_STACK_2(sp_th_9000series_purchase, sp_th_9000series_purchase_c1, sp_th_9000series_purchase_c2)

spriteset(sp_th_9000series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_9000series/sp_th_9000series_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_th_9000series_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_9000series/sp_th_9000series_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sp_th_9000series_lights,  train_is_driving_backwards != vehicle_is_flipped){
  1: sp_th_9000series_lights_end;
  sp_th_9000series_lights_front;
}
spriteset(sp_th_9000series_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_9000series/sp_th_9000series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_th_9000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_th_9000series/sp_th_9000series_1.png"){ tmpl_symm_v3(0, 25) }

TRAIN_CONSTRUCTOR_2(sp_th_9000series_head, sp_th_9000series_head_base, sp_th_9000series_lights)
TRAIN_CONSTRUCTOR_2(sp_th_9000series_mot, sp_th_9000series_wag, panto_d_arm_sapporo)

//*main
  //panto placer
    switch(FEAT_TRAINS, SELF, sp_th_9000series_panto_placer_main, position_in_vehid_chain_from_end %3){
      0:sp_th_9000series_mot;
      sp_th_9000series_wag;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_sp_th_9000series_lv,vehicle_type_id){
      mu_car:sp_th_9000series_panto_placer_main;
      sp_th_9000series_head;
    }
//post fixers
  switch(FEAT_TRAINS, SELF, sw_sp_th_9000series_capacity_main,vehicle_type_id){
    mu_car: 137;
    121;
  }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_sp_th_9000series_car_power_main,position_in_vehid_chain %5){
      0..1:return 140;
      3:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_th_9000series_power_main,vehicle_type_id){
      mu_car:sw_sp_th_9000series_car_power_main;
      0;
   }
