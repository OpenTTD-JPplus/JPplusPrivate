//purchase
spriteset(sp_tz_8000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/8000series/8000series_1.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(sp_tz_8000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/8000series/8000series_1.png"){ tmpl_purchase_2c_dual(0, 25) }
GRAPHIC_STACK_4(gfx_sp_tz_8000series_purchase_main, sprite_logo_sapporo_subway, sprite_logo_line_sp_tozai, sp_tz_8000series_purchase_c1, sp_tz_8000series_purchase_c2)

spriteset(sp_tz_8000series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/8000series/8000series_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_tz_8000series_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/8000series/8000series_lights.png"){ tmpl_std_v3(0, 25) }
spriteset(sp_tz_8000series_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/8000series/8000series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_tz_8000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/8000series/8000series_1.png"){ tmpl_symm_v3(0, 25) }

TRAIN_CONSTRUCTOR_2(sp_tz_8000series_front, sp_tz_8000series_head_base, sp_tz_8000series_lights_front)
TRAIN_CONSTRUCTOR_2(sp_tz_8000series_end, sp_tz_8000series_head_base, sp_tz_8000series_lights_end)
TRAIN_CONSTRUCTOR_2(sp_tz_8000series_mot, sp_tz_8000series_wag, panto_d_arm_sapporo)

//*main
  //panto placer
    switch(FEAT_TRAINS, SELF, sp_tz_8000series_panto_placer, position_in_vehid_chain_from_end %3){
      0:sp_tz_8000series_mot;
      sp_tz_8000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sp_tz_8000series_panto_placer_rev, position_in_vehid_chain %3){
      0:sp_tz_8000series_mot;
      sp_tz_8000series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sp_tz_8000series_panto_placer_main, vehicle_is_reversed){
      1:sp_tz_8000series_panto_placer_rev;
      sp_tz_8000series_panto_placer;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_sp_tz_8000series_head_gfx_main,position_in_consist>0){
      1:sp_tz_8000series_end;
      sp_tz_8000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_tz_8000series_lv,vehicle_type_id){
      mu_car:sp_tz_8000series_panto_placer_main;
      sw_sp_tz_8000series_head_gfx_main;
    }
//post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_sp_tz_8000series_car_power_main,position_in_vehid_chain %5){
      0..1:return 140;
      3:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_tz_8000series_power_main,vehicle_type_id){
      mu_car:sw_sp_tz_8000series_car_power_main;
      0;
   }
