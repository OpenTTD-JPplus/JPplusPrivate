//purchase
spriteset(sp_tz_6000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_tz_6000series/sp_tz_6000series_1.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(sp_tz_6000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_tz_6000series/sp_tz_6000series_1.png"){ tmpl_purchase_2c_dual(0, 25) }
GRAPHIC_STACK_2(sp_tz_6000series_purchase, sp_tz_6000series_purchase_c1, sp_tz_6000series_purchase_c2)

spriteset(sp_tz_6000series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_tz_6000series/sp_tz_6000series_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_tz_6000series_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_tz_6000series/sp_tz_6000series_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sp_tz_6000series_lights,  train_is_driving_backwards != vehicle_is_flipped){
  1: sp_tz_6000series_lights_end;
  sp_tz_6000series_lights_front;
}
spriteset(sp_tz_6000series_head_base_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_tz_6000series/sp_tz_6000series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_tz_6000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_tz_6000series/sp_tz_6000series_1.png"){ tmpl_symm_v3(0, 25) }
spriteset(sp_tz_6000series_head_base_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_tz_6000series/sp_tz_6000series_2.png"){ tmpl_std_v3(0, 0) }

TRAIN_CONSTRUCTOR_2(sp_tz_6000series_head_1, sp_tz_6000series_head_base_1, sp_tz_6000series_lights)
TRAIN_CONSTRUCTOR_2(sp_tz_6000series_head_2, sp_tz_6000series_head_base_2, sp_tz_6000series_lights)

TRAIN_CONSTRUCTOR_2(sp_tz_6000series_mot, sp_tz_6000series_wag, panto_d_arm_sapporo)


switch(FEAT_TRAINS, SELF, sp_tz_6000series_head_timed, build_year){
  0..1975:sp_tz_6000series_head_1;  sp_tz_6000series_head_2;
}
switch(FEAT_TRAINS, SELF, sp_tz_6000series_head, cargo_subtype){
  0:sp_tz_6000series_head_timed;
  1:sp_tz_6000series_head_1;
  2:sp_tz_6000series_head_2;
}
//*main
  //panto placer
    switch(FEAT_TRAINS, SELF, sp_tz_6000series_panto_placer_main, position_in_vehid_chain_from_end %3){
      0:sp_tz_6000series_mot;
      sp_tz_6000series_wag;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_sp_tz_6000series_lv,vehicle_type_id){
      mu_car:sp_tz_6000series_panto_placer_main;
      sp_tz_6000series_head;
    }
//lv desc
  switch(FEAT_TRAINS, SELF, sw_sp_tz_6000series_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(LV_PROTOTYPE),1975);
    2:string(LV_DATED,string(LV_DEFAULT),1976);
  }
//post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_sp_tz_6000series_capacity_main,vehicle_type_id){
    mu_car: 130;
    110;
  }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_sp_tz_6000series_car_power_main,position_in_vehid_chain %6){
      0..5:return 70;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_tz_6000series_power_main,vehicle_type_id){
      mu_car:sw_sp_tz_6000series_car_power_main;
      70*2;
   }
//