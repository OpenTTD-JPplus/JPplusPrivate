//purchase
spriteset(sp_nm_2000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_1.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(sp_nm_2000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_1.png"){ tmpl_purchase_2c_dual_7(0, 25) }
GRAPHIC_STACK_2(sp_nm_2000series_purchase, sp_nm_2000series_purchase_c1, sp_nm_2000series_purchase_c2)

spriteset(sp_nm_2000series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_nm_2000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(sp_nm_2000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_1.png"){ tmpl_std_v3(0, 25) }
spriteset(sp_nm_2000series_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sapporo/sp_nm_2000series/sp_nm_2000series_1.png"){ tmpl_std_rev_v3(0, 25) }
TRAIN_CONSTRUCTOR_2(sp_nm_2000series_front, sp_nm_2000series_end, sp_nm_2000series_lights_front)
//*main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_wag_gfx_main,position_in_vehid_chain %2){
      0:sp_nm_2000series_wag_rev;
      sp_nm_2000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sp_nm_2000series_end;
      sp_nm_2000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_lv,vehicle_type_id){
      mu_car:sw_sp_nm_2000series_wag_gfx_main;
      sw_sp_nm_2000series_head_gfx_main;
    }
//post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_capacity_main,vehicle_type_id){
    mu_car: 94;
    95;
  }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 45;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_sp_nm_2000series_power_main,vehicle_type_id){
      mu_car:sw_sp_nm_2000series_car_power_main;
      90;
   }
//