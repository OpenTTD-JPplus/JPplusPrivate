//main
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_sn_nm_3000series_panto_placer_1,position_in_vehid_chain %3){
        0: sn_nm_3000series_mot;
        sn_nm_3000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_sn_nm_3000series_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
        0: sn_nm_3000series_mot;
        sn_nm_3000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_sn_nm_3000series_panto_placer_main_1,vehicle_is_reversed){
        1: sw_sn_nm_3000series_panto_placer_1_rev;
        sw_sn_nm_3000series_panto_placer_1;
      }
    //
      switch(FEAT_TRAINS, SELF, sw_sn_nm_3000series_panto_placer_2,position_in_vehid_chain %3){
        1: sn_nm_3000series_mot;
        sn_nm_3000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_sn_nm_3000series_panto_placer_2_rev,position_in_vehid_chain_from_end %3){
        1: sn_nm_3000series_mot;
        sn_nm_3000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_sn_nm_3000series_panto_placer_main_2,vehicle_is_reversed){
        1: sw_sn_nm_3000series_panto_placer_2_rev;
        sw_sn_nm_3000series_panto_placer_2;
      }
    switch(FEAT_TRAINS, SELF, sw_sn_nm_3000series_panto_placer_main,num_vehs_in_vehid_chain){
      3: sw_sn_nm_3000series_panto_placer_main_2;
      sw_sn_nm_3000series_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_sn_nm_3000series_head_gfx_main,position_in_consist>0){
      1: sn_nm_3000series_end;
      sn_nm_3000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_sn_nm_3000series_lv,vehicle_type_id){
      mu_car:sw_sn_nm_3000series_panto_placer_main;
      sw_sn_nm_3000series_head_gfx_main;
    }
//
//post fixers
  //power
    switch(FEAT_TRAINS, SELF, sw_sn_nm_3000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..3:return 160;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_sn_nm_3000series_power_main,vehicle_type_id){
      mu_car: sw_sn_nm_3000series_car_power_main;
      0;
    }
