item(FEAT_TRAINS, sn_nm_1000series) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_sendai == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_SENDAI), "1000", string(STR_NAME_SERIES));
    introduction_date: date(1987, 7, 15);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;
    
    
    cost_factor: 17;
    running_cost_factor: 47;
    speed: 105 km/h;
    track_type: TR_1067_DC;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 32 ton;
    
  }
	graphics {
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 4)),
    
    string(STR_OPERATOR, string(STR_SENDAI))
    ,string(STR_LINES_USED, string(STR_SENDAI_NAMBOKU))
    );
    
    purchase: gfx_sn_nm_1000series_purchase_main;
    cargo_capacity:144*param_capacity_mod/3;
    loading_speed:param_loading_4D;
    default:sw_sn_nm_1000series_lv;
    power: sw_sn_nm_1000series_power_main()*4*1342/1000;
    purchase_power: sw_sn_nm_1000series_car_power_main()*4*1342/1000;
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_4D;
    cargo_capacity:144*param_capacity_mod/3;
    
    power: sw_sn_nm_1000series_power_main()*4*1342/1000;
    default:sw_sn_nm_1000series_lv;
    weight: 32;
    
  }
}
item(FEAT_TRAINS, sn_tz_2000series) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_sendai == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_SENDAI), "2000", string(STR_NAME_SERIES));
    introduction_date: date(2015, 12, 6);
    model_life: VEHICLE_NEVER_EXPIRES;
