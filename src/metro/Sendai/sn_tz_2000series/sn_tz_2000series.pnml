//purchase
spriteset(sn_tz_2000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sendai/sn_tz_2000series/sn_tz_2000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(sn_tz_2000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sendai/sn_tz_2000series/sn_tz_2000series.png"){ tmpl_purchase_2c_dual(0, 75) }
GRAPHIC_STACK_2(sn_tz_2000series_purchase, sn_tz_2000series_purchase_c1, sn_tz_2000series_purchase_c2)
//*livery 1

spriteset(sn_tz_2000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sendai/sn_tz_2000series/sn_tz_2000series.png"){ tmpl_std_v3(0, 0) }
spriteset(sn_tz_2000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sendai/sn_tz_2000series/sn_tz_2000series.png"){ tmpl_std_v3(0, 25) }
spriteset(sn_tz_2000series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sendai/sn_tz_2000series/sn_tz_2000series.png"){ tmpl_std_v3(0, 50) }
spriteset(sn_tz_2000series_wag_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sendai/sn_tz_2000series/sn_tz_2000series.png"){ tmpl_std_v3(0, 75) }
spriteset(sn_tz_2000series_wag_rev_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Sendai/sn_tz_2000series/sn_tz_2000series.png"){ tmpl_std_rev_v3(0, 75) }

switch(FEAT_TRAINS, SELF, sw_sn_tz_2000series_head, train_is_driving_backwards != vehicle_is_flipped){
    1: sn_tz_2000series_end;
    sn_tz_2000series_front;
  }

//*livery 1
  //special gfx
    switch(FEAT_TRAINS, SELF, sn_tz_2000series_wag_gfx, position_in_vehid_chain%2){
      1:sn_tz_2000series_wag_def;
      sn_tz_2000series_wag_rev_1;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_sn_tz_2000series_panto_placer_1_main,position_in_vehid_chain %3){
        1: sn_tz_2000series_mot;
        sn_tz_2000series_wag_gfx;
    }
  //panto main
    switch(FEAT_TRAINS, SELF, sw_sn_tz_2000series_panto_placer_main,num_vehs_in_vehid_chain){
        0..2: sn_tz_2000series_wag_gfx;
        sw_sn_tz_2000series_panto_placer_1_main;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_sn_tz_2000series_lv,vehicle_type_id){
      mu_car:sw_sn_tz_2000series_panto_placer_main;
      sw_sn_tz_2000series_head;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_sn_tz_2000series_capacity_main,vehicle_type_id){
      sn_tz_2000series: 92;
      default: 102;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_sn_tz_2000series_car_power_main,position_in_vehid_chain_from_end %3){
      0:return 67;
      1:return 68;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_sn_tz_2000series_power_main,vehicle_type_id){
      sn_tz_2000series: 135;
      sw_sn_tz_2000series_car_power_main;
    }
//
