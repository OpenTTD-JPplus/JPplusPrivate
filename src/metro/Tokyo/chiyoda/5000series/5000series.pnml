//purchase
spriteset(tk_ch_5000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_ch_5000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_purchase_2c_dual(0, 75) }
GRAPHIC_STACK_4(tk_ch_5000series_purchase, logo_tokyo_metro, logo_line_tk_chiyoda, tk_ch_5000series_purchase_c1, tk_ch_5000series_purchase_c2)

spriteset(tk_ch_5000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_ch_5000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_ch_5000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_v3(0, 50) }
spriteset(tk_ch_5000series_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_rev_v3(0, 50) }
spriteset(tk_ch_5000series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_v3(0, 75) }
spriteset(tk_ch_5000series_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_rev_v3(0, 75) }
spriteset(tk_ch_5000series_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_v3(0, 100) }
spriteset(tk_ch_5000series_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_v3(0, 125) }
spriteset(tk_ch_5000series_mot_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_v3(0, 150) }
spriteset(tk_ch_5000series_mot_1_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_rev_v3(0, 150) }
spriteset(tk_ch_5000series_front_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_v3(0, 175) }
spriteset(tk_ch_5000series_end_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/chiyoda/5000series/5000series.png"){ tmpl_std_rev_v3(0, 175) }

//*livery 1
  //special gfx
    //head
    switch(FEAT_TRAINS, PARENT, sw_tk_ch_5000series_front_mot_gfx,vehicle_is_reversed){
      1: tk_ch_5000series_front_mot;
      tk_ch_5000series_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_tk_ch_5000series_front_gfx,num_vehs_in_consist<5){
      1: sw_tk_ch_5000series_front_mot_gfx;
      tk_ch_5000series_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_tk_ch_5000series_end_mot_gfx,vehicle_is_reversed){
      1: tk_ch_5000series_end;
      tk_ch_5000series_end_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_tk_ch_5000series_end_gfx,num_vehs_in_consist<5){
      1: sw_tk_ch_5000series_end_mot_gfx;
      tk_ch_5000series_end;
    }
    //mot
      switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_mot_gfx,(current_year>1999&&num_vehs_in_vehid_chain<4)){
        1: tk_ch_5000series_mot_1;
        tk_ch_5000series_mot;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_mot_rev_gfx,(current_year>1999&&num_vehs_in_vehid_chain<4)){
        1: tk_ch_5000series_mot_1_rev;
        tk_ch_5000series_mot_rev;
      }
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_panto_placer_1,position_in_vehid_chain %5){
        0: tk_ch_5000series_mot;
        2: tk_ch_5000series_mot;
        tk_ch_5000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_panto_placer_1_rev,position_in_vehid_chain_from_end %5){
        0: tk_ch_5000series_mot_rev;
        2: tk_ch_5000series_mot_rev;
        tk_ch_5000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_ch_5000series_panto_placer_main_1,vehicle_is_reversed){
        1: sw_tk_ch_5000series_panto_placer_1_rev;
        sw_tk_ch_5000series_panto_placer_1;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_panto_placer_2,position_in_vehid_chain %2){
        0: tk_ch_5000series_mot;
        tk_ch_5000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_panto_placer_2_rev,position_in_vehid_chain_from_end %2){
        0: tk_ch_5000series_mot_rev;
        tk_ch_5000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_ch_5000series_panto_placer_main_2,vehicle_is_reversed){
        1: sw_tk_ch_5000series_panto_placer_2_rev;
        sw_tk_ch_5000series_panto_placer_2;
      }
    //var 3
      switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_panto_placer_3,position_in_vehid_chain %2){
        0: sw_tk_ch_5000series_mot_rev_gfx;
        tk_ch_5000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_panto_placer_3_rev,position_in_vehid_chain_from_end %2){
        0: sw_tk_ch_5000series_mot_gfx;
        tk_ch_5000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_ch_5000series_panto_placer_main_3,vehicle_is_reversed){
        1: sw_tk_ch_5000series_panto_placer_3_rev;
        sw_tk_ch_5000series_panto_placer_3;
      }
    switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_panto_placer_main,num_vehs_in_vehid_chain){
      1..2: sw_tk_ch_5000series_panto_placer_main_3;
      5: sw_tk_ch_5000series_panto_placer_main_2;
      sw_tk_ch_5000series_panto_placer_main_1;
    }
  //fake head-end placer
    switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_fake_placer,position_in_vehid_chain){
      3: tk_ch_5000series_end_f;
      4: tk_ch_5000series_front_f;
      sw_tk_ch_5000series_panto_placer_main;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_fake_placer_rev,position_in_vehid_chain_from_end ){
      3: tk_ch_5000series_front_f;
      4: tk_ch_5000series_end_f;
      sw_tk_ch_5000series_panto_placer_main;
    }
    switch(FEAT_TRAINS, PARENT, sw_tk_ch_5000series_fake_placer_gfx,vehicle_is_reversed){
      1: sw_tk_ch_5000series_fake_placer_rev;
      sw_tk_ch_5000series_fake_placer;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_fake_placer_main,num_vehs_in_vehid_chain>6){
      1: sw_tk_ch_5000series_fake_placer_gfx;
      sw_tk_ch_5000series_panto_placer_main;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_head_gfx_main,position_in_consist>0){
      1:sw_tk_ch_5000series_end_gfx;
      sw_tk_ch_5000series_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_lv,vehicle_type_id){
      mu_car:sw_tk_ch_5000series_fake_placer_main;
      sw_tk_ch_5000series_head_gfx_main;
    }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_capacity_main,vehicle_type_id){
    mu_car: 144;
    136;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_car_power_main,position_in_vehid_chain_from_end %5){
    0..3:return 100;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_ch_5000series_power_main,vehicle_type_id){
    mu_car:sw_tk_ch_5000series_car_power_main;
    100;
  }
//