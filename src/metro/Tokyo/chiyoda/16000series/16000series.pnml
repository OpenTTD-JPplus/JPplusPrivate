//*main
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_panto_placer_1,position_in_vehid_chain %9){
        0: tk_ch_16000series_mot;
        2: tk_ch_16000series_mot;
        5: tk_ch_16000series_mot;
        7: tk_ch_16000series_mot;
        tk_ch_16000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_panto_placer_1_rev,position_in_vehid_chain_from_end %9){
        0: tk_ch_16000series_mot_rev;
        2: tk_ch_16000series_mot_rev;
        5: tk_ch_16000series_mot_rev;
        7: tk_ch_16000series_mot_rev;
        tk_ch_16000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_ch_16000series_panto_placer_main_1,vehicle_is_reversed){
        1: sw_tk_ch_16000series_panto_placer_1_rev;
        sw_tk_ch_16000series_panto_placer_1;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_panto_placer_2,position_in_vehid_chain %3){
        1: tk_ch_16000series_mot;
        tk_ch_16000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_panto_placer_2_rev,position_in_vehid_chain_from_end %3){
        1: tk_ch_16000series_mot_rev;
        tk_ch_16000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_ch_16000series_panto_placer_main_2,vehicle_is_reversed){
        1: sw_tk_ch_16000series_panto_placer_2_rev;
        sw_tk_ch_16000series_panto_placer_2;
      }
    switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_panto_placer_main,num_vehs_in_vehid_chain){
      5: sw_tk_ch_16000series_panto_placer_main_2;
      sw_tk_ch_16000series_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_head_gfx_main,position_in_consist>0){
      1:tk_ch_16000series_end;
     tk_ch_16000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_lv,vehicle_type_id){
      mu_car:sw_tk_ch_16000series_panto_placer_main;
      sw_tk_ch_16000series_head_gfx_main;
    }
//lv selector
  switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_BATCH,1),2010);
    2:string(LV_DATED,string(STR_BATCH,2),2011);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_capacity_main,vehicle_type_id){
    mu_car: 154;
    143;
  }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_car_power_main,position_in_vehid_chain_from_end %8){
      0:return 205;
      2:return 205;
      5:return 205;
      7:return 205;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_ch_16000series_power_main,vehicle_type_id){
      mu_car:sw_tk_ch_16000series_car_power_main;
      0;
    }
