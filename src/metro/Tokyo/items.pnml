#include "ginza/tk_gz_type1000/tk_gz_type1000.pnml"

item(FEAT_TRAINS, tk_gz_type1000) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_tokyo == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_TOKYOCHIKA), "1000~1100", string(STR_NAME_TYPE));
    introduction_date: date(1927, 12, 30);
    model_life: 46;
    vehicle_life: 41;
    dual_headed: 0;
    
    cost_factor: 17;
    running_cost_factor: 47;
    speed: 55 km/h;
    track_type:TR_1435_METRO
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 35 ton;
    badges: ["company/tokyo_metro", "line/tokyo_ginza"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 600)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_3, 1,2,4)),
    
    string(STR_OPERATOR, string(STR_TOKYO_METRO))
    ,string(STR_LINES_USED, string(STR_TOKYO_GINZA))
    );
    cargo_subtype_text: sw_tk_gz_type1000_lv_desc_main;
    purchase: tk_gz_type1000_purchase;
    cargo_capacity:sw_tk_gz_type1000_capacity_main()*param_capacity_mod/3;
    
    loading_speed:param_loading_3D;
    default:sw_tk_gz_type1000_lv;
    power:sw_tk_gz_type1000_power_main()*4*1342/1000;
    purchase_power: sw_tk_gz_type1000_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_tk_gz_type1000_lv_desc_main;
    loading_speed:param_loading_3D;
    cargo_capacity:sw_tk_gz_type1000_capacity_main()*param_capacity_mod/3;
    power:sw_tk_gz_type1000_power_main()*4*1342/1000;
    default:sw_tk_gz_type1000_lv;
    weight: 35;
    
  }
}
