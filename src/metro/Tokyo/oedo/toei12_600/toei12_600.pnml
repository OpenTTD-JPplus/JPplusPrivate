//*main
  //panto placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tk_od_toei12_600_panto_placer_1,position_in_vehid_chain %3){
        0: tk_od_toei12_600_mot;
        2: tk_od_toei12_600_mot_rev;
        default: tk_od_toei12_600_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_od_toei12_600_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
        0: tk_od_toei12_600_mot_rev;
        2: tk_od_toei12_600_mot;
        default: tk_od_toei12_600_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_toei12_600_panto_placer_main,vehicle_is_reversed){
        1: sw_tk_od_toei12_600_panto_placer_1_rev;
        sw_tk_od_toei12_600_panto_placer_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_toei12_600_head_gfx_main,position_in_consist>0){
      1: tk_od_toei12_600_end;
      tk_od_toei12_600_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_od_toei12_600_lv,vehicle_type_id){
      mu_car:sw_toei12_600_panto_placer_main;
      sw_toei12_600_head_gfx_main;
    }
