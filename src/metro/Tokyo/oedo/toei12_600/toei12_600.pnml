  0: string(LV_RANDOM);
  1: string(LV_DATED,string(STR_BATCH, 1),2012);
  2: string(LV_DATED,string(STR_BATCH, 2),2014);
  3: string(LV_DATED,string(STR_BATCH, 3),2019);
  4: string(LV_DATED,string(STR_BATCH, 4),2023);
}