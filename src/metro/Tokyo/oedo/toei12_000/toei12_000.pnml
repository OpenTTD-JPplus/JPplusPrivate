//*main
  //panto placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tk_od_toei12_000_panto_placer_1,position_in_vehid_chain %3){
        0: tk_od_toei12_000_mot;
        2: tk_od_toei12_000_mot_rev;
        default:tk_od_toei12_000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_od_toei12_000_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
        0: tk_od_toei12_000_mot_rev;
        2: tk_od_toei12_000_mot;
        default:tk_od_toei12_000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_toei12_000_panto_placer_main,vehicle_is_reversed){
        1: sw_tk_od_toei12_000_panto_placer_1_rev;
        sw_tk_od_toei12_000_panto_placer_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_toei12_000_head_gfx_main,position_in_consist>0){
      1:tk_od_toei12_000_end;
     tk_od_toei12_000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_od_toei12_000_lv,vehicle_type_id){
      mu_car:sw_toei12_000_panto_placer_main;
      sw_toei12_000_head_gfx_main;
    }
//lv selector
switch(FEAT_TRAINS, SELF, sw_tk_od_toei12_000_lv_desc_main, cargo_subtype){
  0: string(LV_RANDOM);
  1: string(LV_DATED,string(STR_BATCH_2, 1,2),1991);
  2: string(LV_DATED,string(STR_BATCH, 3),1997);
}
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_tk_od_toei12_000_capacity_main,vehicle_type_id){
      mu_car: 100;
      90;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_tk_od_toei12_000_car_power_main,position_in_vehid_chain_from_end %8){
      0..6:return 60;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_od_toei12_000_power_main,vehicle_type_id){
      mu_car: sw_tk_od_toei12_000_car_power_main;
      120;
    }
