  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_panto_placer_main_1,position_in_vehid_chain %4){
        0: tk_hb_eidan03_mot;
        tk_hb_eidan03_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_panto_placer_main_2,position_in_vehid_chain %3){
        1: tk_hb_eidan03_mot;
        tk_hb_eidan03_wag;
      }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_panto_placer_main,num_vehs_in_vehid_chain){
      3..4: sw_tk_hb_eidan03_panto_placer_main_2;
      sw_tk_hb_eidan03_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tk_hb_eidan03_end;
      tk_hb_eidan03_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_livery_1,vehicle_type_id){
      mu_car:sw_tk_hb_eidan03_panto_placer_main;
      sw_tk_hb_eidan03_head_gfx_main;
    }
//*livery 2
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_tk_hb_eidan03_5d_mot,vehicle_is_reversed==1){
      1: tk_hb_eidan03_5d_mot_rev;
      tk_hb_eidan03_5d_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_5d_mot_gfx,position_in_vehid_chain==0||position_in_vehid_chain_from_end==0){
      1: sw_tk_hb_eidan03_5d_mot;
      tk_hb_eidan03_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_tk_hb_eidan03_5d_wag,vehicle_is_reversed==1){
      1: tk_hb_eidan03_5d_wag_rev;
      tk_hb_eidan03_5d_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_5d_wag_gfx,position_in_vehid_chain==0||position_in_vehid_chain_from_end==0){
      1: sw_tk_hb_eidan03_5d_wag;
      tk_hb_eidan03_wag;
    }
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_5d_panto_placer_main_1,position_in_vehid_chain %4){
        0: sw_tk_hb_eidan03_5d_mot_gfx;
        sw_tk_hb_eidan03_5d_wag_gfx;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_5d_panto_placer_main_2,position_in_vehid_chain %3){
        1: sw_tk_hb_eidan03_5d_mot_gfx;
        sw_tk_hb_eidan03_5d_wag_gfx;
      }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_5d_panto_placer_main,num_vehs_in_vehid_chain){
      3..4: sw_tk_hb_eidan03_5d_panto_placer_main_2;
      sw_tk_hb_eidan03_5d_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_5d_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tk_hb_eidan03_5d_end;
      tk_hb_eidan03_5d_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_livery_2,vehicle_type_id){
      mu_car:sw_tk_hb_eidan03_5d_panto_placer_main;
      sw_tk_hb_eidan03_5d_head_gfx_main;
