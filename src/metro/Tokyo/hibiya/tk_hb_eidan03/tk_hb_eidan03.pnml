//livery randomizer 
random_switch(FEAT_TRAINS, PARENT, sw_tk_hb_eidan03_livery_0_1){
    1: sw_tk_hb_eidan03_livery_1;
    1: sw_tk_hb_eidan03_livery_2;
}
switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_livery_0, build_year>1990&&build_year<1993){
  1: sw_tk_hb_eidan03_livery_0_1;
  default: sw_tk_hb_eidan03_livery_1;
}
//livery selector 
switch(FEAT_TRAINS, PARENT, sw_tk_hb_eidan03_lv, cargo_subtype){
    0: sw_tk_hb_eidan03_livery_0;
    1: sw_tk_hb_eidan03_livery_1;
    2: sw_tk_hb_eidan03_livery_2;
}
switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(LV_DEFAULT),1988);
    2: string(LV_DATED,string(LV_tk_hn_eidan03_2),1990);
}
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_capacity_main,vehicle_type_id){
    mu_car: 137;
    124;
  }
  //loading speed fix
  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_5d_loading,position_in_vehid_chain==0||position_in_vehid_chain_from_end==0){
    1:param_loading_5D;
    param_loading_3D;
  }
  //loading speed
  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_loading_speed_main, cargo_subtype){
    0: param_loading_3D;
    1: param_loading_3D;
    2: sw_tk_hb_eidan03_5d_loading;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_power_year,build_year<1992){
    1:return 160;
    return 190;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_car_power_main,position_in_vehid_chain_from_end %8){
    0:sw_tk_hb_eidan03_power_year;
    2:sw_tk_hb_eidan03_power_year;
    5:sw_tk_hb_eidan03_power_year;
    7:sw_tk_hb_eidan03_power_year;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan03_power_main,vehicle_type_id){
      mu_car:sw_tk_hb_eidan03_car_power_main;
      75*2;
   }
