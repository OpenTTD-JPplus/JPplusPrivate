//purchase
spriteset(tk_hb_eidan3000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hibiya/eidan3000/eidan3000.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_hb_eidan3000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hibiya/eidan3000/eidan3000.png"){ tmpl_purchase_2c_dual(0, 75) }
GRAPHIC_STACK_2(tk_hb_eidan3000_purchase,  tk_hb_eidan3000_purchase_c1, tk_hb_eidan3000_purchase_c2)

spriteset(tk_hb_eidan3000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hibiya/eidan3000/eidan3000.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_hb_eidan3000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hibiya/eidan3000/eidan3000.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_hb_eidan3000_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hibiya/eidan3000/eidan3000.png"){ tmpl_std_rev_v3(0, 25) }
spriteset(tk_hb_eidan3000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hibiya/eidan3000/eidan3000.png"){ tmpl_std_v3(0, 50) }
spriteset(tk_hb_eidan3000_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hibiya/eidan3000/eidan3000.png"){ tmpl_std_rev_v3(0, 50) }
spriteset(tk_hb_eidan3000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hibiya/eidan3000/eidan3000.png"){ tmpl_symm_v3(0, 75) }

//main
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_panto_placer_1,position_in_vehid_chain %4){
        1: tk_hb_eidan3000_mot;
        tk_hb_eidan3000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_panto_placer_1_rev,position_in_vehid_chain_from_end %4){
        1: tk_hb_eidan3000_mot_rev;
        tk_hb_eidan3000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_hb_eidan3000_panto_placer_main_1,vehicle_is_reversed){
        1: sw_tk_hb_eidan3000_panto_placer_1_rev;
        sw_tk_hb_eidan3000_panto_placer_1;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_panto_placer_2,position_in_vehid_chain %5){
        1: tk_hb_eidan3000_mot;
        3: tk_hb_eidan3000_mot;
        tk_hb_eidan3000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_panto_placer_2_rev,position_in_vehid_chain_from_end %5){
        1: tk_hb_eidan3000_mot_rev;
        3: tk_hb_eidan3000_mot_rev;
        tk_hb_eidan3000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_hb_eidan3000_panto_placer_main_2,vehicle_is_reversed){
        1: sw_tk_hb_eidan3000_panto_placer_2_rev;
        sw_tk_hb_eidan3000_panto_placer_2;
      }
     
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_panto_placer_main,num_vehs_in_vehid_chain){
      0..2: tk_hb_eidan3000_wag;
      3..4: sw_tk_hb_eidan3000_panto_placer_main_1;
      sw_tk_hb_eidan3000_panto_placer_main_2;
    }
  //fake head-end placer
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_fake_placer,position_in_vehid_chain){
      2: tk_hb_eidan3000_end_rev;
      3: tk_hb_eidan3000_end;
      tk_hb_eidan3000_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_fake_placer_rev,position_in_vehid_chain_from_end ){
      2: tk_hb_eidan3000_end;
      3: tk_hb_eidan3000_end_rev;
      tk_hb_eidan3000_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_tk_hb_eidan3000_fake_placer_gfx,vehicle_is_reversed){
      1: sw_tk_hb_eidan3000_fake_placer_rev;
      sw_tk_hb_eidan3000_fake_placer;
    }
  //there was only 1 4+4 consist
    random_switch(FEAT_TRAINS, PARENT, sw_tk_hb_eidan3000_fake_placer_main_1){
      3:sw_tk_hb_eidan3000_panto_placer_main;
      1:sw_tk_hb_eidan3000_fake_placer_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_fake_placer_main,num_vehs_in_vehid_chain==6){
      1: sw_tk_hb_eidan3000_fake_placer_main_1;
      sw_tk_hb_eidan3000_panto_placer_main;
    }

  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_head_gfx_main,position_in_consist>0){
      1:tk_hb_eidan3000_end;
      tk_hb_eidan3000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_lv,vehicle_type_id){
      mu_car:sw_tk_hb_eidan3000_fake_placer_main;
      sw_tk_hb_eidan3000_head_gfx_main;
    }
//
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_capacity_main,vehicle_type_id){
    mu_car: 128;
    120;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_car_power_main,position_in_vehid_chain_from_end %8){
    0..6:return 75;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_hb_eidan3000_power_main,vehicle_type_id){
      mu_car:sw_tk_hb_eidan3000_car_power_main;
      75*2;
   }
//