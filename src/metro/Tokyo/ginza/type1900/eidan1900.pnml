spriteset(tk_gz_type1900_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1900/type1900.png"){ tmpl_symm_v3(0, 25) }
spriteset(tk_gz_type1900_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1900/type1900.png"){ tmpl_std_v3(0, 50) }

