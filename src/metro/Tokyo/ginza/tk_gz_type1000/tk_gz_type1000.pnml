//purchase
spriteset(tk_gz_type1000_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000.png"){ tmpl_purchase_1c(0, 100) }

spriteset(gfx_tk_gz_type1000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(gfx_tk_gz_type1000_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000_lights.png"){ tmpl_std_v3(0, 25) }
spriteset(gfx_tk_gz_type1000_lights_front_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000_lights.png"){ tmpl_std_rev_v3(0, 0) }
spriteset(gfx_tk_gz_type1000_lights_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000_lights.png"){ tmpl_std_rev_v3(0, 25) }

switch(FEAT_TRAINS, PARENT, sw_tk_gz_type1000_lights, vehicle_is_reversed){
  1: gfx_tk_gz_type1000_lights_end;
  gfx_tk_gz_type1000_lights_front;
}
switch(FEAT_TRAINS, PARENT, sw_tk_gz_type1000_lights_rev, vehicle_is_reversed){
  1: gfx_tk_gz_type1000_lights_end_rev;
  gfx_tk_gz_type1000_lights_front_rev;
}

spriteset(tk_gz_type1000_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_gz_type1000_1_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000.png"){ tmpl_std_rev_v3(0, 0) }
spriteset(tk_gz_type1000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000.png"){ tmpl_symm_v3(0, 25) }
spriteset(tk_gz_type1000_1_head_s, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000.png"){ tmpl_std_v3(0, 100) }

spriteset(tk_gz_type1000_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000.png"){ tmpl_std_v3(0, 50) }
spriteset(tk_gz_type1000_2_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000.png"){ tmpl_std_rev_v3(0, 50) }
spriteset(tk_gz_type1000_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000.png"){ tmpl_symm_v3(0, 75) }
spriteset(tk_gz_type1000_2_head_s, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type1000/tk_gz_type1000.png"){ tmpl_std_v3(0, 125) }

//lv stuff
  switch(FEAT_TRAINS, SELF, tk_gz_type1000_head_s, cargo_subtype){
    0:tk_gz_type1000_1_head_s;    1:tk_gz_type1000_2_head_s;
  }
  switch(FEAT_TRAINS, SELF, tk_gz_type1000_head, cargo_subtype){
    0:tk_gz_type1000_1_head;    1:tk_gz_type1000_2_head;
  }
  switch(FEAT_TRAINS, SELF, tk_gz_type1000_head_rev, cargo_subtype){
    0:tk_gz_type1000_1_head_rev;    1:tk_gz_type1000_2_head_rev;
  }
  switch(FEAT_TRAINS, SELF, tk_gz_type1000_wag, cargo_subtype){
    0:tk_gz_type1000_1_wag;    1:tk_gz_type1000_2_wag;
  }
  TRAIN_CONSTRUCTOR_2(sw_tk_gz_type1000_front_s, tk_gz_type1000_head_s,sw_tk_gz_type1000_lights)
  TRAIN_CONSTRUCTOR_2(sw_tk_gz_type1000_front, tk_gz_type1000_head,sw_tk_gz_type1000_lights)
  TRAIN_CONSTRUCTOR_2(sw_tk_gz_type1000_end, tk_gz_type1000_head_rev,sw_tk_gz_type1000_lights_rev)

//
//main
switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_end_gfx,position_in_vehid_chain_from_end){
    0: sw_tk_gz_type1000_end;
    tk_gz_type1000_wag;
}
switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_front_gfx,num_vehs_in_consist){
    1: sw_tk_gz_type1000_front_s;
    sw_tk_gz_type1000_front;
}
switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_lv,vehicle_type_id){
    mu_car: sw_tk_gz_type1000_end_gfx;
    sw_tk_gz_type1000_front_gfx;
}

//livery selector
  switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_lv_desc_main, cargo_subtype){
    0: string(LV_DATED,string(LV_DEFAULT),1927);
    1: string(LV_DATED,string(LV_TWO_TONE),1927);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_capacity_main,vehicle_type_id){
    mu_car: 110;
    100;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_car_power_main,position_in_vehid_chain_from_end %6){
    0..4:45;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_power_main,vehicle_type_id){
      mu_car:sw_tk_gz_type1000_car_power_main;
      45;
   }
//