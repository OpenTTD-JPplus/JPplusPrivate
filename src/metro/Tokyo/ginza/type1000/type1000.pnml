spriteset(tk_gz_type1000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1000/type1000.png"){ tmpl_purchase_1c(0, 150) }
GRAPHIC_STACK_3(tk_gz_type1000_purchase, logo_tokyo_metro_s, logo_line_tk_ginza_s, tk_gz_type1000_purchase_c1)

spriteset(tk_gz_type1000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1000/type1000.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_gz_type1000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1000/type1000.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_gz_type1000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1000/type1000.png"){ tmpl_std_rev_v3(0, 50) }
spriteset(tk_gz_type1000_1_front_s, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1000/type1000.png"){ tmpl_std_v3(0, 150) }

spriteset(tk_gz_type1000_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1000/type1000.png"){ tmpl_std_v3(0, 75) }
spriteset(tk_gz_type1000_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1000/type1000.png"){ tmpl_std_v3(0, 100) }
spriteset(tk_gz_type1000_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1000/type1000.png"){ tmpl_std_rev_v3(0, 125) }
spriteset(tk_gz_type1000_2_front_s, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1000/type1000.png"){ tmpl_std_v3(0, 175) }
//lv stuff
  switch(FEAT_TRAINS, SELF, tk_gz_type1000_front, cargo_subtype){
    0:tk_gz_type1000_1_front;    1:tk_gz_type1000_2_front;
  }
  switch(FEAT_TRAINS, SELF, tk_gz_type1000_front_s, cargo_subtype){
    0:tk_gz_type1000_1_front_s;    1:tk_gz_type1000_2_front_s;
  }
  switch(FEAT_TRAINS, SELF, tk_gz_type1000_end, cargo_subtype){
    0:tk_gz_type1000_1_end;    1:tk_gz_type1000_2_end;
  }
  switch(FEAT_TRAINS, SELF, tk_gz_type1000_wag, cargo_subtype){
    0:tk_gz_type1000_1_wag;    1:tk_gz_type1000_2_wag;
  }
//
//main
switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_end_gfx,position_in_vehid_chain_from_end){
    0: tk_gz_type1000_end;
    tk_gz_type1000_wag;
}
switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_front_gfx, num_vehs_in_consist){
  1:tk_gz_type1000_front_s;
  tk_gz_type1000_front;
}
switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_lv,vehicle_type_id){
    mu_car: sw_tk_gz_type1000_end_gfx;
    sw_tk_gz_type1000_front_gfx;
}
//livery selector
  switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_lv_desc_main, cargo_subtype){
    0: string(LV_DATED,string(LV_DEFAULT),1927);
    1: string(LV_DATED,string(LV_TWO_TONE),1927);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_capacity_main,vehicle_type_id){
    mu_car: 110;
    100;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_car_power_main,position_in_vehid_chain_from_end %6){
    0..4:45;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_gz_type1000_power_main,vehicle_type_id){
      mu_car:sw_tk_gz_type1000_car_power_main;
      45;
   }
