//purchase
spriteset(tk_gz_eidan01_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_eidan01/tk_gz_eidan01.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_gz_eidan01_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_eidan01/tk_gz_eidan01.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(tk_gz_eidan01_purchase,  tk_gz_eidan01_purchase_c1, tk_gz_eidan01_purchase_c2)

spriteset(tk_gz_eidan01_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_eidan01/tk_gz_eidan01.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_gz_eidan01_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_eidan01/tk_gz_eidan01.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_gz_eidan01_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_eidan01/tk_gz_eidan01.png"){ tmpl_symm_v3(0, 50) }
//*main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_gz_eidan01_head_gfx_main,position_in_consist>0){
      1:tk_gz_eidan01_end;
      tk_gz_eidan01_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_gz_eidan01_lv,vehicle_type_id){
      mu_car:tk_gz_eidan01_wag;
      sw_tk_gz_eidan01_head_gfx_main;
    }
//post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_gz_eidan01_capacity_main,vehicle_type_id){
    mu_car: 102;
    100;
  }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tk_gz_eidan01_car_power_main,position_in_vehid_chain_from_end %5){
      0..1:return 120;
      3:return 120;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_gz_eidan01_power_main,vehicle_type_id){
      mu_car:sw_tk_gz_eidan01_car_power_main;
      0;
   }
