//purchase
spriteset(tk_gz_type100_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type100/tk_gz_type100.png"){ tmpl_purchase_1c(0, 0) }

spriteset(tk_gz_type100_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type100/tk_gz_type100.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_gz_type100_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type100/tk_gz_type100.png"){ tmpl_symm_v3(0, 25) }
spriteset(tk_gz_type100_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type100/tk_gz_type100.png"){ tmpl_std_v3(0, 50) }
spriteset(tk_gz_type100_front_s, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type100/tk_gz_type100.png"){ tmpl_std_v3(0, 75) }
spriteset(tk_gz_type100_front_s_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/tk_gz_type100/tk_gz_type100.png"){ tmpl_std_rev_v3(0, 75) }
// livery 1
switch(FEAT_TRAINS, PARENT, sw_tk_gz_type100_front_s_gfx,vehicle_is_reversed){
    1: tk_gz_type100_front_s_rev;
    tk_gz_type100_front_s;
}
switch(FEAT_TRAINS, SELF, sw_tk_gz_type100_end_gfx,position_in_vehid_chain_from_end){
    0: tk_gz_type100_end;
    tk_gz_type100_wag;
}
switch(FEAT_TRAINS, SELF, sw_tk_gz_type100_front_gfx, num_vehs_in_consist){
  1:sw_tk_gz_type100_front_s_gfx;
  tk_gz_type100_front;
}
switch(FEAT_TRAINS, SELF, sw_tk_gz_type100_lv,vehicle_type_id){
    mu_car: sw_tk_gz_type100_end_gfx;
    sw_tk_gz_type100_front_gfx;
}
//power fix
  switch(FEAT_TRAINS, SELF, sw_tk_gz_type100_car_power_main,position_in_vehid_chain_from_end %6){
    0..4:75;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_gz_type100_power_main,vehicle_type_id){
      mu_car:sw_tk_gz_type100_car_power_main;
      75;
   }
