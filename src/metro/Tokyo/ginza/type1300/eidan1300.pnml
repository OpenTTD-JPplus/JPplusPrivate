spriteset(tk_gz_type1400_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1300/type1300.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_gz_type1400_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1300/type1300.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_gz_type1400_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1300/type1300.png"){ tmpl_std_v3(0, 50) }

switch(FEAT_TRAINS, SELF, tk_gz_type1300_front, build_year){
  0..1952:tk_gz_type1300_1_front;  tk_gz_type1400_1_front;
}
switch(FEAT_TRAINS, SELF, tk_gz_type1300_end, build_year){
  0..1952:tk_gz_type1300_1_end;  tk_gz_type1400_1_end;
}
switch(FEAT_TRAINS, SELF, tk_gz_type1300_wag, build_year){
  0..1952:tk_gz_type1300_1_wag;  tk_gz_type1400_1_wag;
}
//main
  switch(FEAT_TRAINS, SELF, sw_tk_mn_type1300_head_gfx_main,position_in_consist>0){
    1:tk_gz_type1300_end;
    tk_gz_type1300_front;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_gz_eidan1300_lv,vehicle_type_id){
    mu_car:tk_gz_type1300_wag;
    sw_tk_mn_type1300_head_gfx_main;
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_gz_eidan1300_capacity_main,vehicle_type_id){
    mu_car: 102;
    98;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_gz_eidan1300_car_power_main,position_in_vehid_chain_from_end %6){
    0..4:45;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_gz_eidan1300_power_main,vehicle_type_id){
      mu_car:sw_tk_gz_eidan1300_car_power_main;
      45;
   }
