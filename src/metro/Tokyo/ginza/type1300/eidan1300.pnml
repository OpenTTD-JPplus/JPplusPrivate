spriteset(tk_gz_type1300_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1300/type1300.png"){ tmpl_std_v3(0, 75) }
spriteset(tk_gz_type1300_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/ginza/type1300/type1300.png"){ tmpl_std_v3(0, 100) }
