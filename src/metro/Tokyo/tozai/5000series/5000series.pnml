      1: sw_tk_tz_5000series_1_fake_placer_rev;
      sw_tk_tz_5000series_1_fake_placer;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_5000series_1_fake_placer_main,num_vehs_in_vehid_chain>6){
      1: sw_tk_tz_5000series_1_fake_placer_gfx;
      sw_tk_tz_5000series_1_panto_placer_main;
    }
