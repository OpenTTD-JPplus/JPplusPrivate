    switch(FEAT_TRAINS, SELF, sw_tk_tz_5000series_1_head_gfx_main,position_in_consist>0){
      1:tk_tz_5000series_1_end_gfx;
      tk_tz_5000series_1_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_5000series_livery_1,vehicle_type_id){
      mu_car:sw_tk_tz_5000series_1_fake_placer_main;
      sw_tk_tz_5000series_1_head_gfx_main;
    }
