      1..4:return 100;
      6..7:return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_5000series_power_main,vehicle_type_id){
      mu_car:sw_tk_tz_5000series_car_power_main;
      100;
