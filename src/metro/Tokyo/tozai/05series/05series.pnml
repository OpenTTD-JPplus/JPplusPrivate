    //main
      switch(FEAT_TRAINS, SELF, sw_tk_tz_05series_capacity_main, build_year){
        0..1992: sw_tk_tz_05series_capacity_main_1;
        1993..2002: sw_tk_tz_05series_capacity_main_2;
        2003: sw_tk_tz_05series_capacity_main_3;
        sw_tk_tz_05series_capacity_main_4;
      }
    //
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tk_tz_05series_power_main_1,position_in_vehid_chain_from_end %8){
      0..1:return 160;
      4:return 160;
      6..7:return 160;
      return 0;
    }
    //200kw is not good for gameplay (14th formation)
    switch(FEAT_TRAINS, SELF, sw_tk_tz_05series_power_main_2,position_in_vehid_chain_from_end %8){
      0:return 205;
      2:return 205;
      5:return 205;
      7:return 205;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_05series_power_main_3,position_in_vehid_chain_from_end %8){
      0..1:return 165;
      4:return 165;
      6..7:return 165;
      return 0;
    }
    //main
    switch(FEAT_TRAINS, SELF, sw_tk_tz_05series_car_power_main, build_year){
      0..1998: sw_tk_tz_05series_power_main_1;
      1999..2002: sw_tk_tz_05series_power_main_2;
      sw_tk_tz_05series_power_main_3;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_05series_power_main,vehicle_type_id){
      mu_car:sw_tk_tz_05series_car_power_main;
      0;
   }
    //speed controller
