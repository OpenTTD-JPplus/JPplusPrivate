//purchase
spriteset(tk_tz_toyo1000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_toyo1000/tk_tz_toyo1000.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_tz_toyo1000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_toyo1000/tk_tz_toyo1000.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(tk_tz_toyo1000_purchase, tk_tz_toyo1000_purchase_c1, tk_tz_toyo1000_purchase_c2)

spriteset(tk_tz_toyo1000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_toyo1000/tk_tz_toyo1000.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_tz_toyo1000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_toyo1000/tk_tz_toyo1000.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_tz_toyo1000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_toyo1000/tk_tz_toyo1000.png"){ tmpl_symm_v3(0, 50) }
spriteset(tk_tz_toyo1000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_toyo1000/tk_tz_toyo1000.png"){ tmpl_std_v3(0, 75) }
spriteset(tk_tz_toyo1000_front_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_toyo1000/tk_tz_toyo1000.png"){ tmpl_std_v3(0, 100) }
spriteset(tk_tz_toyo1000_end_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_toyo1000/tk_tz_toyo1000.png"){ tmpl_std_rev_v3(0, 100) }

//*livery 1
	//panto-placers
		//var 1
		switch(FEAT_TRAINS, SELF, sw_tk_tz_toyo1000_panto_placer_main_1,position_in_vehid_chain %2){
      0: tk_tz_toyo1000_mot;
      tk_tz_toyo1000_wag;
    }
		//var 2
		switch(FEAT_TRAINS, SELF, sw_tk_tz_toyo1000_panto_placer_main_2,position_in_vehid_chain %5){
      0: tk_tz_toyo1000_mot;
      2: tk_tz_toyo1000_mot;
      tk_tz_toyo1000_wag;
    }
		//controller 
		switch(FEAT_TRAINS, SELF, sw_tk_tz_toyo1000_panto_placer_main,num_vehs_in_vehid_chain){
      0..7: sw_tk_tz_toyo1000_panto_placer_main_1;
      sw_tk_tz_toyo1000_panto_placer_main_2;
    }
  //fake head-end placer
    switch(FEAT_TRAINS, SELF, sw_tk_tz_toyo1000_fake_placer_gfx,position_in_vehid_chain){
      3: tk_tz_toyo1000_end_f;
      4: tk_tz_toyo1000_front_f;
      sw_tk_tz_toyo1000_panto_placer_main;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_toyo1000_fake_placer_main,num_vehs_in_vehid_chain>6){
      1: sw_tk_tz_toyo1000_fake_placer_gfx;
      sw_tk_tz_toyo1000_panto_placer_main;
    }
	//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_tz_toyo1000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tk_tz_toyo1000_end;
      tk_tz_toyo1000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_toyo1000_lv,vehicle_type_id){
      mu_car:sw_tk_tz_toyo1000_fake_placer_main;
      sw_tk_tz_toyo1000_head_gfx_main;
    }
//*post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tk_tz_toyo1000_capacity_main,vehicle_type_id){
      mu_car: 144;
      136;
    }
	//power
		switch(FEAT_TRAINS, SELF, sw_tk_tz_toyo1000_car_power_main,position_in_vehid_chain %5){
      0..3:return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_toyo1000_power_main,vehicle_type_id){
      mu_car:sw_tk_tz_toyo1000_car_power_main;
      100;
   }
//