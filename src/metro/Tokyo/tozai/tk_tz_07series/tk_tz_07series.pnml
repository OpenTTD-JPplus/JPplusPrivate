//purchase
spriteset(tk_tz_07series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_07series/tk_tz_07series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_tz_07series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_07series/tk_tz_07series.png"){ tmpl_purchase_2c_dual(0, 75) }
GRAPHIC_STACK_2(tk_tz_07series_purchase,  tk_tz_07series_purchase_c1, tk_tz_07series_purchase_c2)

spriteset(tk_tz_07series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_07series/tk_tz_07series.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_tz_07series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_07series/tk_tz_07series.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_tz_07series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_07series/tk_tz_07series.png"){ tmpl_std_v3(0, 50) }
spriteset(tk_tz_07series_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_07series/tk_tz_07series.png"){ tmpl_std_rev_v3(0, 50) }
spriteset(tk_tz_07series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/tozai/tk_tz_07series/tk_tz_07series.png"){ tmpl_symm_v3(0, 75) }

//*livery 1
	//panto-placers
		//var 1
		switch(FEAT_TRAINS, SELF, sw_tk_tz_07series_panto_placer_1,position_in_vehid_chain %5){
      0: tk_tz_07series_mot;
      2: tk_tz_07series_mot;
      tk_tz_07series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_07series_panto_placer_1_rev,position_in_vehid_chain_from_end %5){
      0: tk_tz_07series_mot_rev;
      2: tk_tz_07series_mot_rev;
      tk_tz_07series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_tk_tz_07series_panto_placer_main,vehicle_is_reversed){
      1: sw_tk_tz_07series_panto_placer_1_rev;
      sw_tk_tz_07series_panto_placer_1;
    }
	//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_tz_07series_head_gfx_main,position_in_consist>0){
      1:tk_tz_07series_end;
      tk_tz_07series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_07series_lv,vehicle_type_id){
      mu_car:sw_tk_tz_07series_panto_placer_main;
      sw_tk_tz_07series_head_gfx_main;
    }
//*post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tk_tz_07series_capacity,position_in_vehid_chain_from_end){
      0: 153;
      152;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_07series_capacity_1,position_in_vehid_chain){
      0: 153;
      default: sw_tk_tz_07series_capacity;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_07series_capacity_main,vehicle_type_id){
      mu_car: sw_tk_tz_07series_capacity_1;
      138;
    }
	//power
		switch(FEAT_TRAINS, SELF, sw_tk_tz_07series_car_power_main,position_in_vehid_chain_from_end %8){
      0:return 205;
      2:return 205;
      5:return 205;
      7:return 205;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_tz_07series_power_main,vehicle_type_id){
      mu_car:sw_tk_tz_07series_car_power_main;
      0;
   }
//
