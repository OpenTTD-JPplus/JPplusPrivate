spriteset(tk_nm_eidan9000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_1.png"){ tmpl_symm_v3(0, 75) }
spriteset(tk_nm_eidan9000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_1.png"){ tmpl_std_v3(0, 25) }
//5 batch
spriteset(tk_nm_eidan9000_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_2.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_nm_eidan9000_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_2.png"){ tmpl_symm_v3(0, 50) }
spriteset(tk_nm_eidan9000_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_2.png"){ tmpl_symm_v3(0, 75) }
spriteset(tk_nm_eidan9000_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_2.png"){ tmpl_std_v3(0, 25) }
//B batch
  spriteset(tk_nm_eidan9000_3_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_3.png"){ tmpl_std_v3(0, 0) }
  spriteset(tk_nm_eidan9000_3_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_3.png"){ tmpl_std_v3(0, 25) }
  spriteset(tk_nm_eidan9000_3_mot_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_3.png"){ tmpl_std_v3(0, 50) }
  spriteset(tk_nm_eidan9000_3_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_3.png"){ tmpl_std_v3(0, 50) }
  spriteset(tk_nm_eidan9000_3_wag_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_3.png"){ tmpl_std_v3(0, 75) }
  spriteset(tk_nm_eidan9000_3_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_3.png"){ tmpl_std_v3(0, 75) }
  //special gfx
    switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_3_wag_gfx_1, position_in_vehid_chain<num_vehs_in_vehid_chain/2){
      1:tk_nm_eidan9000_3_wag_def;
      tk_nm_eidan9000_3_wag_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_3_wag_gfx_2, position_in_vehid_chain_from_end<num_vehs_in_vehid_chain/2+1){
        1:tk_nm_eidan9000_3_wag_rev;
        tk_nm_eidan9000_3_wag_def;
    }
    switch(FEAT_TRAINS, PARENT, tk_nm_eidan9000_3_wag,vehicle_is_reversed){
      1: sw_tk_nm_eidan9000_3_wag_gfx_1;
      sw_tk_nm_eidan9000_3_wag_gfx_2;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_3_mot_gfx_1, position_in_vehid_chain<num_vehs_in_vehid_chain/2){
      1:tk_nm_eidan9000_3_mot_def;
      tk_nm_eidan9000_3_mot_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_3_mot_gfx_2, position_in_vehid_chain_from_end<num_vehs_in_vehid_chain/2+1){
        1:tk_nm_eidan9000_3_mot_rev;
        tk_nm_eidan9000_3_mot_def;
    }
    switch(FEAT_TRAINS, PARENT, tk_nm_eidan9000_3_mot,vehicle_is_reversed){
      1: sw_tk_nm_eidan9000_3_mot_gfx_1;
      sw_tk_nm_eidan9000_3_mot_gfx_2;
    }
//
//lv stuff
  switch(FEAT_TRAINS, SELF, tk_nm_eidan9000_0_front, [
    (1*build_year>2008&&current_year>2015)+(2*build_year>2008&&current_year<2016)]){
    1:tk_nm_eidan9000_3_front;
    2:tk_nm_eidan9000_2_front;
    tk_nm_eidan9000_1_front;
  }
  switch(FEAT_TRAINS, SELF, tk_nm_eidan9000_0_end, [
    (1*build_year>2008&&current_year>2015)+(2*build_year>2008&&current_year<2016)]){
    1:tk_nm_eidan9000_3_end;
    2:tk_nm_eidan9000_2_end;
    tk_nm_eidan9000_1_end;
  }
  switch(FEAT_TRAINS, SELF, tk_nm_eidan9000_0_wag, [
    (1*build_year>2008&&current_year>2015)+(2*build_year>2008&&current_year<2016)]){
    1:tk_nm_eidan9000_3_wag;
    2:tk_nm_eidan9000_2_wag;
    tk_nm_eidan9000_1_wag;
  }
  switch(FEAT_TRAINS, SELF, tk_nm_eidan9000_0_mot, [
    (1*build_year>2008&&current_year>2015)+(2*build_year>2008&&current_year<2016)]){
    1:tk_nm_eidan9000_3_mot;
    2:tk_nm_eidan9000_2_mot;
    tk_nm_eidan9000_1_mot;
  }
  switch(FEAT_TRAINS, SELF, tk_nm_eidan9000_front, cargo_subtype){
    0:tk_nm_eidan9000_0_front;
    1:tk_nm_eidan9000_1_front;
    2:tk_nm_eidan9000_2_front;
    3:tk_nm_eidan9000_3_front;
  }
  switch(FEAT_TRAINS, SELF, tk_nm_eidan9000_end, cargo_subtype){
    0:tk_nm_eidan9000_0_end;
    1:tk_nm_eidan9000_1_end;
    2:tk_nm_eidan9000_2_end;
    3:tk_nm_eidan9000_3_end;
  }
  switch(FEAT_TRAINS, SELF, tk_nm_eidan9000_wag, cargo_subtype){
    0:tk_nm_eidan9000_0_wag;
    1:tk_nm_eidan9000_1_wag;
    2:tk_nm_eidan9000_2_wag;
    3:tk_nm_eidan9000_3_wag;
  }
  switch(FEAT_TRAINS, SELF, tk_nm_eidan9000_mot, cargo_subtype){
    0:tk_nm_eidan9000_0_mot;
    1:tk_nm_eidan9000_1_mot;
    2:tk_nm_eidan9000_2_mot;
    3:tk_nm_eidan9000_3_mot;
  }
//
//*main
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_panto_placer_main_1,position_in_vehid_chain %5){
      0: tk_nm_eidan9000_mot;
      2: tk_nm_eidan9000_mot;
      tk_nm_eidan9000_wag;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_panto_placer_main_2,position_in_vehid_chain %3){
      1: tk_nm_eidan9000_mot;
      tk_nm_eidan9000_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_panto_placer_main,num_vehs_in_vehid_chain){
      0..1: sw_tk_nm_eidan9000_panto_placer_main_1;
      4: sw_tk_nm_eidan9000_panto_placer_main_1;
      sw_tk_nm_eidan9000_panto_placer_main_2;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tk_nm_eidan9000_end;
     tk_nm_eidan9000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_lv,vehicle_type_id){
      mu_car:sw_tk_nm_eidan9000_panto_placer_main;
      sw_tk_nm_eidan9000_head_gfx_main;
    }
//
  switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_BATCH_2, 1,4),1990);
    2: string(LV_DATED,string(STR_BATCH, 5),209);
    3: string(LV_DATED,string(LV_tk_nm_eidan9000_3),2016);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_capacity_main,vehicle_type_id){
    mu_car: 151;
    140;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_power_1,position_in_vehid_chain_from_end %6){
    0..1:return 190;
    3:return 190;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_power_2,position_in_vehid_chain_from_end %6){
    0..1:return 225;
    3:return 225;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_car_power_main,build_year){
    0..2015: sw_tk_nm_eidan9000_power_1;
    sw_tk_nm_eidan9000_power_2;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_nm_eidan9000_power_main,vehicle_type_id){
      mu_car: sw_tk_nm_eidan9000_car_power_main;
      0;
    }
