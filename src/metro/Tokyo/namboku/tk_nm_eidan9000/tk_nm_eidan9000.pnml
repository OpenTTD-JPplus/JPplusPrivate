//purchase
spriteset(tk_nm_eidan9000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_nm_eidan9000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_1.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(tk_nm_eidan9000_purchase,  tk_nm_eidan9000_purchase_c1, tk_nm_eidan9000_purchase_c2)

//1-4 batch
spriteset(tk_nm_eidan9000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_eidan9000/tk_nm_eidan9000_1.png"){ tmpl_std_v3(0, 0) }
