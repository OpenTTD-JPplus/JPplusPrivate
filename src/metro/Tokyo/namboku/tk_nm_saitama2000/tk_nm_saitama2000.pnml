//purchase
spriteset(tk_nm_saitama2000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_saitama2000/tk_nm_saitama2000.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_nm_saitama2000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_saitama2000/tk_nm_saitama2000.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(tk_nm_saitama2000_purchase, tk_nm_saitama2000_purchase_c1, tk_nm_saitama2000_purchase_c2)

spriteset(tk_nm_saitama2000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_saitama2000/tk_nm_saitama2000.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_nm_saitama2000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_saitama2000/tk_nm_saitama2000.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_nm_saitama2000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_saitama2000/tk_nm_saitama2000.png"){ tmpl_std_rev_v3(0, 50) }
spriteset(tk_nm_saitama2000_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_saitama2000/tk_nm_saitama2000.png"){ tmpl_std_v3(0, 50) }
spriteset(tk_nm_saitama2000_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_saitama2000/tk_nm_saitama2000.png"){ tmpl_symm_v3(0, 75) }
spriteset(tk_nm_saitama2000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/namboku/tk_nm_saitama2000/tk_nm_saitama2000.png"){ tmpl_symm_v3(0, 100) }

//*livery 1
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_panto_placer_main_1,position_in_vehid_chain %5){
      0: tk_nm_saitama2000_mot;
      2: tk_nm_saitama2000_mot_2;
      tk_nm_saitama2000_wag;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_panto_placer_main_2,position_in_vehid_chain %3){
      1: tk_nm_saitama2000_mot_2;
      tk_nm_saitama2000_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_panto_placer_main,num_vehs_in_vehid_chain){
      0..1:sw_tk_nm_saitama2000_panto_placer_main_1;
      4: sw_tk_nm_saitama2000_panto_placer_main_1;
      sw_tk_nm_saitama2000_panto_placer_main_2;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tk_nm_saitama2000_end;
     tk_nm_saitama2000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_lv,vehicle_type_id){
      mu_car:sw_tk_nm_saitama2000_panto_placer_main;
      sw_tk_nm_saitama2000_head_gfx_main;
    }
//capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_capacity_main,vehicle_type_id){
    mu_car: 150;
    140;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_car_power_main,position_in_vehid_chain_from_end %6){
    0..1:return 190;
    3:return 190;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_nm_saitama2000_power_main,vehicle_type_id){
    mu_car: sw_tk_nm_saitama2000_car_power_main;
    0;
  }
