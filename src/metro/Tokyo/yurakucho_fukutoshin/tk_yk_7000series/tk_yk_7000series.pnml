//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_yk_7000series_capacity_main,vehicle_type_id){
    mu_car: 144;
    136;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_yk_7000series_car_power_main,position_in_vehid_chain_from_end %8){
    0..2:return 160;
		5..6:return 160;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_yk_7000series_power_main,vehicle_type_id){
    mu_car:sw_tk_yk_7000series_car_power_main;
    0;
  }
