//purchase
spriteset(tk_yk_10000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/yurakucho_fukutoshin/tk_yk_10000series/tk_yk_10000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_yk_10000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/yurakucho_fukutoshin/tk_yk_10000series/tk_yk_10000series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(tk_yk_10000series_purchase,  tk_yk_10000series_purchase_c1, tk_yk_10000series_purchase_c2)

spriteset(tk_yk_10000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/yurakucho_fukutoshin/tk_yk_10000series/tk_yk_10000series.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_yk_10000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/yurakucho_fukutoshin/tk_yk_10000series/tk_yk_10000series.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_yk_10000series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/yurakucho_fukutoshin/tk_yk_10000series/tk_yk_10000series.png"){ tmpl_std_v3(0, 50) }
spriteset(tk_yk_10000series_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/yurakucho_fukutoshin/tk_yk_10000series/tk_yk_10000series.png"){ tmpl_symm_v3(0, 75) }
spriteset(tk_yk_10000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/yurakucho_fukutoshin/tk_yk_10000series/tk_yk_10000series.png"){ tmpl_symm_v3(0, 100) }

//*livery 1
	//panto-placers
		//var 1 8 car
		switch(FEAT_TRAINS, SELF, sw_tk_yk_10000series_panto_placer_main_1,position_in_vehid_chain %8){
      0: tk_yk_10000series_mot_2;
      4: tk_yk_10000series_mot_2;
      tk_yk_10000series_wag;
    }
		//var 2 10 car
		switch(FEAT_TRAINS, SELF, sw_tk_yk_10000series_panto_placer_main_2,position_in_vehid_chain %6){
      0: tk_yk_10000series_mot_2;
      3: tk_yk_10000series_mot;
      tk_yk_10000series_wag;
    }
		switch(FEAT_TRAINS, SELF, sw_tk_yk_10000series_panto_placer_main,num_vehs_in_vehid_chain){
			5..6: sw_tk_yk_10000series_panto_placer_main_1;
      sw_tk_yk_10000series_panto_placer_main_2;
    }
	//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_yk_10000series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: tk_yk_10000series_end;
      default: tk_yk_10000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_yk_10000series_lv,vehicle_type_id){
      tk_yk_10000series: sw_tk_yk_10000series_head_gfx_main;
      default: sw_tk_yk_10000series_panto_placer_main;
    }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_yk_10000series_capacity_main,vehicle_type_id){
    mu_car: 154;
    143;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_yk_10000series_car_power_main,position_in_vehid_chain_from_end %8){
    0..1:return 165;
    4..6:return 165;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_yk_10000series_power_main,vehicle_type_id){
    mu_car:sw_tk_yk_10000series_car_power_main;
    0;
  }
//
