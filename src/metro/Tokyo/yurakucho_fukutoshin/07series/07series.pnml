spriteset(tk_yk_07series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/yurakucho_fukutoshin/07series/07series.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_yk_07series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/yurakucho_fukutoshin/07series/07series.png"){ tmpl_std_v3(0, 25) }
