spriteset(tk_yk_07series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/yurakucho_fukutoshin/07series/07series.png"){ tmpl_purchase_2c_dual(0, 50) }
