        tk_sj_toei10_000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_sj_toei10_000_panto_placer_main_1,vehicle_is_reversed){
        1: sw_tk_sj_toei10_000_panto_placer_1_rev;
        sw_tk_sj_toei10_000_panto_placer_1;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_tk_sj_toei10_000_panto_placer_2,position_in_vehid_chain %3){
        0: tk_sj_toei10_000_mot_2;
        tk_sj_toei10_000_wag;
