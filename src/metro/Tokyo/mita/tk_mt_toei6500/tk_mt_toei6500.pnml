//purchase
spriteset(tk_mt_toei6500_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/mita/tk_mt_toei6500/tk_mt_toei6500_1.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_mt_toei6500_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/mita/tk_mt_toei6500/tk_mt_toei6500_1.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(tk_mt_toei6500_purchase, tk_mt_toei6500_purchase_c1, tk_mt_toei6500_purchase_c2)

spriteset(tk_mt_toei6500_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/mita/tk_mt_toei6500/tk_mt_toei6500_1.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_mt_toei6500_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/mita/tk_mt_toei6500/tk_mt_toei6500_1.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_mt_toei6500_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/mita/tk_mt_toei6500/tk_mt_toei6500_1.png"){ tmpl_symm_v3(0, 50) }
spriteset(tk_mt_toei6500_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/mita/tk_mt_toei6500/tk_mt_toei6500_1.png"){ tmpl_symm_v3(0, 75) }

//*livery 1
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6500_1_panto_placer_main_1,position_in_vehid_chain %3){
      0: tk_mt_toei6500_1_mot;
      tk_mt_toei6500_1_wag;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6500_1_panto_placer_main_2,position_in_vehid_chain %4){
      0: tk_mt_toei6500_1_mot;
      tk_mt_toei6500_1_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6500_1_panto_placer_main,num_vehs_in_vehid_chain){
      3: sw_tk_mt_toei6500_1_panto_placer_main_2;
      6: sw_tk_mt_toei6500_1_panto_placer_main_2;
      sw_tk_mt_toei6500_1_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6500_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tk_mt_toei6500_1_end;
     tk_mt_toei6500_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6500_lv,vehicle_type_id){
      mu_car:sw_tk_mt_toei6500_1_panto_placer_main;
      sw_tk_mt_toei6500_head_gfx_main;
    }
//*post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6500_capacity_main,vehicle_type_id){
      mu_car: 149;
      139;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6500_car_power_main,position_in_vehid_chain_from_end %8){
      0..1:return 170;
      3..4:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6500_power_main,vehicle_type_id){
      mu_car: sw_tk_mt_toei6500_car_power_main;
      0;
    }
