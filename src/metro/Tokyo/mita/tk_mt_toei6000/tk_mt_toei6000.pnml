    1972..1987:tk_mt_toei6000_2_wag;
    tk_mt_toei6000_3_wag;
  }
  //
  switch(FEAT_TRAINS, SELF, tk_mt_toei6000_front, cargo_subtype){
    1:tk_mt_toei6000_1_front;
    2:tk_mt_toei6000_2_front;
    3:tk_mt_toei6000_3_front;
    tk_mt_toei6000_front_timed;
  }
  switch(FEAT_TRAINS, SELF, tk_mt_toei6000_end, cargo_subtype){
    1:tk_mt_toei6000_1_end;
    2:tk_mt_toei6000_2_end;
    3:tk_mt_toei6000_3_end;
    tk_mt_toei6000_end_timed;
  }
  switch(FEAT_TRAINS, SELF, tk_mt_toei6000_front_mot, cargo_subtype){
    1:tk_mt_toei6000_1_front_mot;
    2:tk_mt_toei6000_2_front_mot;
    3:tk_mt_toei6000_3_front_mot;
    tk_mt_toei6000_front_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tk_mt_toei6000_end_mot, cargo_subtype){
    1:tk_mt_toei6000_1_end_mot;
    2:tk_mt_toei6000_2_end_mot;
    3:tk_mt_toei6000_3_end_mot;
    tk_mt_toei6000_end_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tk_mt_toei6000_mot_rev, cargo_subtype){
    1:tk_mt_toei6000_1_mot_rev;
    2:tk_mt_toei6000_2_mot_rev;
    3:tk_mt_toei6000_3_mot_rev;
    tk_mt_toei6000_mot_rev_timed;
