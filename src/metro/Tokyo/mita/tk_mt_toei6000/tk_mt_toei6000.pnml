    1:tk_mt_toei6000_1_wag;
    2:tk_mt_toei6000_2_wag;
    3:tk_mt_toei6000_3_wag;
    tk_mt_toei6000_wag_timed;
  }
//
//
//*main
  //head
    switch(FEAT_TRAINS, PARENT, sw_tk_mt_toei6000_front_main,vehicle_is_reversed){
      1: tk_mt_toei6000_front;
      tk_mt_toei6000_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_tk_mt_toei6000_end_main,vehicle_is_reversed){
      1: tk_mt_toei6000_end_mot;
      tk_mt_toei6000_end;
    }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6000_panto_placer_main,position_in_vehid_chain_from_end %2){
      0: tk_mt_toei6000_mot_rev;
      tk_mt_toei6000_wag;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_tk_mt_toei6000_end_main;
     sw_tk_mt_toei6000_front_main;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6000_lv,vehicle_type_id){
      mu_car:sw_tk_mt_toei6000_panto_placer_main;
      sw_tk_mt_toei6000_head_gfx_main;
    }
//livery selector
  switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6000_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(LV_tk_mt_toei6000_1),1968);
    2: string(LV_DATED,string(STR_BATCH, 2),1972);
    3: string(LV_DATED,string(STR_LIVERY,string(STR_BATCH, 3)),1988);
  }
//*post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6000_capacity_main,vehicle_type_id){
      mu_car: 170;
      150;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6000_car_power_main,position_in_vehid_chain_from_end %6){
      0..3:return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_mt_toei6000_power_main,vehicle_type_id){
      mu_car: sw_tk_mt_toei6000_car_power_main;
      100*2;
    }
