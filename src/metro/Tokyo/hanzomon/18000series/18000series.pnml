spriteset(tk_hz_18000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/18000series/18000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_hz_18000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/18000series/18000series.png"){ tmpl_purchase_2c_dual(0, 75) }
