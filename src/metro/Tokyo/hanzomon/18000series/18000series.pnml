spriteset(tk_hz_18000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/18000series/18000series.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_hz_18000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/18000series/18000series.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_hz_18000series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/18000series/18000series.png"){ tmpl_std_v3(0, 50) }
spriteset(tk_hz_18000series_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/18000series/18000series.png"){ tmpl_std_rev_v3(0, 50) }
spriteset(tk_hz_18000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/18000series/18000series.png"){ tmpl_symm_v3(0, 75) }

//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tk_hz_18000series_panto_placer_1,position_in_vehid_chain %5){
          0: tk_hz_18000series_mot;
          2: tk_hz_18000series_mot;
          tk_hz_18000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_hz_18000series_panto_placer_1_rev,position_in_vehid_chain_from_end %5){
          0: tk_hz_18000series_mot_rev;
          2: tk_hz_18000series_mot_rev;
          tk_hz_18000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_hz_18000series_panto_placer_main_1,vehicle_is_reversed){
          1: sw_tk_hz_18000series_panto_placer_1_rev;
          sw_tk_hz_18000series_panto_placer_1;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_tk_hz_18000series_panto_placer_2,position_in_vehid_chain %3){
          0: tk_hz_18000series_mot;
          tk_hz_18000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_hz_18000series_panto_placer_2_rev,position_in_vehid_chain_from_end %3){
          0: tk_hz_18000series_mot_rev;
          tk_hz_18000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_hz_18000series_panto_placer_main_2,vehicle_is_reversed){
          1: sw_tk_hz_18000series_panto_placer_2_rev;
          sw_tk_hz_18000series_panto_placer_2;
      }
    switch(FEAT_TRAINS, SELF, sw_tk_hz_18000series_panto_placer_main,num_vehs_in_vehid_chain){
        5: sw_tk_hz_18000series_panto_placer_main_2;
        sw_tk_hz_18000series_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_hz_18000series_head_gfx_main,position_in_consist>0){
      1:tk_hz_18000series_end;
     tk_hz_18000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hz_18000series_lv,vehicle_type_id){
      mu_car:sw_tk_hz_18000series_panto_placer_main;
      sw_tk_hz_18000series_head_gfx_main;
    }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tk_hz_18000series_capacity_main,vehicle_type_id){
      mu_car: 152;
      142;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tk_hz_18000series_car_power_main,position_in_vehid_chain_from_end %8){
      0:return 205;
      2:return 205;
      5:return 205;
      7:return 205;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hz_18000series_power_main,vehicle_type_id){
        mu_car:sw_tk_hz_18000series_car_power_main;
        0;
    }
