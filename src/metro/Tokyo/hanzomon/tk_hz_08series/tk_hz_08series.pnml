//purchase
spriteset(tk_hz_08series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/tk_hz_08series/tk_hz_08series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_hz_08series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/tk_hz_08series/tk_hz_08series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(tk_hz_08series_purchase,  tk_hz_08series_purchase_c1, tk_hz_08series_purchase_c2)

spriteset(tk_hz_08series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/tk_hz_08series/tk_hz_08series.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_hz_08series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/tk_hz_08series/tk_hz_08series.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_hz_08series_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/tk_hz_08series/tk_hz_08series.png"){ tmpl_symm_v3(0, 50) }
spriteset(tk_hz_08series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/tk_hz_08series/tk_hz_08series.png"){ tmpl_symm_v3(0, 75) }
spriteset(tk_hz_08series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/tk_hz_08series/tk_hz_08series.png"){ tmpl_std_v3(0, 100) }
spriteset(tk_hz_08series_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/hanzomon/tk_hz_08series/tk_hz_08series.png"){ tmpl_std_rev_v3(0, 100) }

//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tk_hz_08series_panto_placer_1,position_in_vehid_chain %6){
          0: tk_hz_08series_mot_2;
          3: tk_hz_08series_mot;
          tk_hz_08series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_hz_08series_panto_placer_1_rev,position_in_vehid_chain_from_end %6){
          0: tk_hz_08series_mot_2;
          3: tk_hz_08series_mot_rev;
          tk_hz_08series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_hz_08series_panto_placer_main_1,vehicle_is_reversed){
          1: sw_tk_hz_08series_panto_placer_1_rev;
          sw_tk_hz_08series_panto_placer_1;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_tk_hz_08series_panto_placer_2,position_in_vehid_chain %6){
          0: tk_hz_08series_mot_2;
          4: tk_hz_08series_mot_2;
          tk_hz_08series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tk_hz_08series_panto_placer_2_rev,position_in_vehid_chain_from_end %6){
          0: tk_hz_08series_mot_2;
          4: tk_hz_08series_mot_2;
          tk_hz_08series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tk_hz_08series_panto_placer_main_2,vehicle_is_reversed){
          1: sw_tk_hz_08series_panto_placer_2_rev;
          sw_tk_hz_08series_panto_placer_2;
      }
    switch(FEAT_TRAINS, SELF, sw_tk_hz_08series_panto_placer_main,num_vehs_in_vehid_chain){
        5..6: sw_tk_hz_08series_panto_placer_main_2;
        sw_tk_hz_08series_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tk_hz_08series_head_gfx_main,position_in_consist>0){
      1:tk_hz_08series_end;
     tk_hz_08series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hz_08series_lv,vehicle_type_id){
      mu_car:sw_tk_hz_08series_panto_placer_main;
      sw_tk_hz_08series_head_gfx_main;
    }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tk_hz_08series_capacity_main,vehicle_type_id){
      mu_car: 152;
      141;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tk_hz_08series_car_power_main,position_in_vehid_chain_from_end %10){
      0..1:return 165;
      4:return 165;
      6..7:return 165;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tk_hz_08series_power_main,vehicle_type_id){
      mu_car:sw_tk_hz_08series_car_power_main;
      0;
    }
