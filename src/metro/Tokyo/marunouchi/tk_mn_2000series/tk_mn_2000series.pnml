//purchase
spriteset(tk_mn_2000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_2000series/tk_mn_2000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_mn_2000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_2000series/tk_mn_2000series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(tk_mn_2000series_purchase,  tk_mn_2000series_purchase_c1, tk_mn_2000series_purchase_c2)

spriteset(tk_mn_2000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_2000series/tk_mn_2000series.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_mn_2000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_2000series/tk_mn_2000series.png"){ tmpl_std_v3(0, 25) }
spriteset(tk_mn_2000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_2000series/tk_mn_2000series.png"){ tmpl_std_v3(0, 50) }

//main
  switch(FEAT_TRAINS, SELF, sw_tk_mn_2000series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
    1:tk_mn_2000series_end;
    tk_mn_2000series_front;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_mn_2000series_lv,vehicle_type_id){
    mu_car:tk_mn_2000series_wag;
    sw_tk_mn_2000series_head_gfx_main;
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_mn_2000series_capacity_main,vehicle_type_id){
    mu_car: 122;
    120;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_mn_2000series_car_power_main,position_in_vehid_chain_from_end %6){
    0..4:75;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_mn_2000series_power_main,vehicle_type_id){
      mu_car:sw_tk_mn_2000series_car_power_main;
      75;
   }
