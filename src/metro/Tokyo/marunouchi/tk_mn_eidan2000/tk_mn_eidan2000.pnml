spriteset(tk_mn_eidan2000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_eidan2000/tk_mn_eidan2000.png"){ tmpl_purchase_2c_dual(0, 25) }
