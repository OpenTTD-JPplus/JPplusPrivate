//purchase
spriteset(tk_mn_eidan02_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_eidan02/tk_mn_eidan02.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_mn_eidan02_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_eidan02/tk_mn_eidan02.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(tk_mn_eidan02_purchase,  tk_mn_eidan02_purchase_c1, tk_mn_eidan02_purchase_c2)

spriteset(tk_mn_eidan02_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_eidan02/tk_mn_eidan02.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_mn_eidan02_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_eidan02/tk_mn_eidan02.png"){ tmpl_symm_v3(0, 50) }
spriteset(tk_mn_eidan02_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_eidan02/tk_mn_eidan02.png"){ tmpl_std_v3(0, 25) }

spriteset(tk_mn_eidan02_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_eidan02/tk_mn_eidan02_2.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_mn_eidan02_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_eidan02/tk_mn_eidan02_2.png"){ tmpl_symm_v3(0, 50) }
spriteset(tk_mn_eidan02_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/tk_mn_eidan02/tk_mn_eidan02_2.png"){ tmpl_std_v3(0, 25) }
//lv stuff
  switch(FEAT_TRAINS, SELF, tk_mn_eidan02_front, cargo_subtype){
    0:tk_mn_eidan02_1_front;
    1:tk_mn_eidan02_2_front;
  }
  switch(FEAT_TRAINS, SELF, tk_mn_eidan02_end, cargo_subtype){
    0:tk_mn_eidan02_1_end;
    1:tk_mn_eidan02_2_end;
  }
  switch(FEAT_TRAINS, SELF, tk_mn_eidan02_wag, cargo_subtype){
    0:tk_mn_eidan02_1_wag;
    1:tk_mn_eidan02_2_wag;
  }
//main
  switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan02_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
    1:tk_mn_eidan02_end;
    tk_mn_eidan02_front;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan02_lv,vehicle_type_id){
    mu_car:tk_mn_eidan02_wag;
    sw_tk_mn_eidan02_head_gfx_main;
  }
//livery selector
switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan02_lv_desc_main, cargo_subtype){
    0: string(LV_DATED,string(LV_DEFAULT),1988);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_tk_mn_eidan02_2)),2004);
}
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan02_capacity_main,vehicle_type_id){
    mu_car: 136;
    124;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan02_car_power_main,position_in_vehid_chain_from_end %6){
    0..4:120;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan02_power_main,vehicle_type_id){
      mu_car:sw_tk_mn_eidan02_car_power_main;
      0;
   }
