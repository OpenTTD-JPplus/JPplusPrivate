//purchase
spriteset(tk_mn_eidan500_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/eidan500/eidan500.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(tk_mn_eidan500_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/eidan500/eidan500.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_4(gfx_tk_mn_eidan500_purchase_main, logo_tokyo_metro, logo_line_tk_maru, tk_mn_eidan500_purchase_c1, tk_mn_eidan500_purchase_c2)

spriteset(tk_mn_eidan500_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/eidan500/eidan500.png"){ tmpl_std_v3(0, 0) }
spriteset(tk_mn_eidan500_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/eidan500/eidan500.png"){ tmpl_symm_v3(0, 50) }
spriteset(tk_mn_eidan500_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Tokyo/marunouchi/eidan500/eidan500.png"){ tmpl_std_v3(0, 25) }

//main
  switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan500_head_gfx_main,position_in_consist>0){
    1:tk_mn_eidan500_end;
    tk_mn_eidan500_front;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan500_lv,vehicle_type_id){
    mu_car:tk_mn_eidan500_wag;
    sw_tk_mn_eidan500_head_gfx_main;
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan500_capacity_main,vehicle_type_id){
    mu_car: 130;
    120;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan500_car_power_main,position_in_vehid_chain_from_end %6){
    0..4:75;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tk_mn_eidan500_power_main,vehicle_type_id){
      mu_car:sw_tk_mn_eidan500_car_power_main;
      75*2;
   }
