//purchase
spriteset(kt_tz_50series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_tz_50series/kt_tz_50series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(kt_tz_50series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_tz_50series/kt_tz_50series.png"){ tmpl_purchase_2c_dual(0, 25) }
GRAPHIC_STACK_4(kt_tz_50series_purchase, kt_tz_50series_purchase_c1,ac_double_1_c1, kt_tz_50series_purchase_c2,ac_double_1_c2)

//base
spriteset(kt_tz_50series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_tz_50series/kt_tz_50series_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(kt_tz_50series_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_tz_50series/kt_tz_50series_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_lights, train_is_driving_backwards != vehicle_is_flipped){
  1: kt_tz_50series_lights_end;
  kt_tz_50series_lights_front;
}

spriteset(kt_tz_50series_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_tz_50series/kt_tz_50series.png"){ tmpl_std_v3(0, 0) }
spriteset(kt_tz_50series_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_tz_50series/kt_tz_50series.png"){ tmpl_symm_v3(0, 25) }

TRAIN_CONSTRUCTOR_3(kt_tz_50series_head,
  kt_tz_50series_head_base,
  sw_kt_tz_50series_lights,
  ac_double_1_wag_symm)
TRAIN_CONSTRUCTOR_3(kt_tz_50series_mot,
  kt_tz_50series_car_base,
  ac_double_1_9,
  panto_arm_n)
TRAIN_CONSTRUCTOR_2(kt_tz_50series_wag,
  kt_tz_50series_car_base,
  ac_double_1_wag_symm)

//livery 1
  //panto placer
  switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_panto_placer_1_main,position_in_vehid_chain %5){
    0: kt_tz_50series_mot;
    2: kt_tz_50series_mot;
    kt_tz_50series_wag;
  }
//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_lv,vehicle_type_id){
      mu_car:sw_kt_tz_50series_panto_placer_1_main;
      kt_tz_50series_head;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_capacity_main,vehicle_type_id){
      kt_tz_50series: 92;
      default: 104;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_car_power_main,position_in_vehid_chain_from_end %5){
      0..3:return 85;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kt_tz_50series_power_main,vehicle_type_id){
      kt_tz_50series: 0;
      sw_kt_tz_50series_car_power_main;
    }
//


