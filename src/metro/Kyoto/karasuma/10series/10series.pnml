//purchase
spriteset(kt_ks_10series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/karasuma/10series/10series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(kt_ks_10series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/karasuma/10series/10series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(kt_ks_10series_purchase, kt_ks_10series_purchase_c1, kt_ks_10series_purchase_c2)

spriteset(kt_ks_10series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/karasuma/10series/10series.png"){ tmpl_std_v3(0, 0) }
spriteset(kt_ks_10series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/karasuma/10series/10series.png"){ tmpl_std_v3(0, 25) }
spriteset(kt_ks_10series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/karasuma/10series/10series.png"){ tmpl_symm_v3(0, 75) }
spriteset(kt_ks_10series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/karasuma/10series/10series.png"){ tmpl_symm_v3(0, 50) }

//livery 1
  //panto placer
  switch(FEAT_TRAINS, SELF, sw_kt_ks_10series_panto_placer_1_def,position_in_vehid_chain %3){
    0: kt_ks_10series_mot;
    kt_ks_10series_wag;
  }
  switch(FEAT_TRAINS, SELF, sw_kt_ks_10series_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
    0: kt_ks_10series_mot;
    kt_ks_10series_wag;
  }
  switch(FEAT_TRAINS, PARENT, sw_kt_ks_10series_panto_placer_1_main,vehicle_is_reversed){
    1: sw_kt_ks_10series_panto_placer_1_rev;
    sw_kt_ks_10series_panto_placer_1_def;
  }
//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_kt_ks_10series_head_gfx_main,position_in_consist>0){
      1: kt_ks_10series_end;
      kt_ks_10series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_kt_ks_10series_lv,vehicle_type_id){
      mu_car:sw_kt_ks_10series_panto_placer_1_main;
      sw_kt_ks_10series_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_kt_ks_10series_capacity_main,vehicle_type_id){
      kt_ks_10series: 130;
      default: 144;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_kt_ks_10series_car_power_main,position_in_vehid_chain_from_end %4){
      0..1:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kt_ks_10series_power_main,vehicle_type_id){
      kt_ks_10series: 140*2;
      sw_kt_ks_10series_car_power_main;
    }
//