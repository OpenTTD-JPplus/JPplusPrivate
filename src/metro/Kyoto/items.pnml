item(FEAT_TRAINS, kt_ks_10series) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_kyoto == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_KYOTO), "10", string(STR_NAME_SERIES));
    introduction_date: date(1981, 5, 29);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;
    
    
    cost_factor: 19;
    running_cost_factor: 49;
    speed: 105 km/h;
    track_type: TR_1435_DC;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 35 ton;
    
  }
	graphics {
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 4,6)),
    
    string(STR_OPERATOR, string(STR_KYOTO))
    ,string(STR_LINES_USED, string(STR_KYOTO_KARASUMA))
    );
    
    purchase: kt_ks_10series_purchase;
    cargo_capacity:sw_kt_ks_10series_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_4D;
    default:sw_kt_ks_10series_lv;
    power: sw_kt_ks_10series_power_main()*4*1342/1000;
    purchase_power: sw_kt_ks_10series_car_power_main()*4*1342/1000;
    
    start_stop: sw_stop_start_3;
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_kt_ks_10series_capacity_main()*param_capacity_mod/3;
    
    power: sw_kt_ks_10series_power_main()*4*1342/1000;
    default:sw_kt_ks_10series_lv;
    weight: 34;
    
  }
}
