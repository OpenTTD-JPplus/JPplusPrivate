//purchase
spriteset(kt_ks_20series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_ks_20series/kt_ks_20series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(kt_ks_20series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_ks_20series/kt_ks_20series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(kt_ks_20series_purchase, kt_ks_20series_purchase_c1, kt_ks_20series_purchase_c2)

spriteset(kt_ks_20series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_ks_20series/kt_ks_20series.png"){ tmpl_std_v3(0, 0) }
spriteset(kt_ks_20series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_ks_20series/kt_ks_20series.png"){ tmpl_std_v3(0, 25) }
spriteset(kt_ks_20series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_ks_20series/kt_ks_20series.png"){ tmpl_symm_v3(0, 75) }
spriteset(kt_ks_20series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Kyoto/kt_ks_20series/kt_ks_20series.png"){ tmpl_std_v3(0, 50) }

switch(FEAT_TRAINS, SELF, sw_kt_ks_20series_head, train_is_driving_backwards != vehicle_is_flipped){
  1: kt_ks_20series_end;
  kt_ks_20series_front;
}

//livery 1
  //panto placer
  switch(FEAT_TRAINS, SELF, sw_kt_ks_20series_panto_placer_1_main,position_in_vehid_chain %3){
    0: kt_ks_20series_mot;
    kt_ks_20series_wag;
  }
//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_kt_ks_20series_lv,vehicle_type_id){
      mu_car:sw_kt_ks_20series_panto_placer_1_main;
      sw_kt_ks_20series_head;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_kt_ks_20series_capacity_main,vehicle_type_id){
      kt_ks_20series: 130;
      default: 143;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_kt_ks_20series_car_power_main,position_in_vehid_chain_from_end %5){
      0..3:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kt_ks_20series_power_main,vehicle_type_id){
      kt_ks_20series: 0;
      sw_kt_ks_20series_car_power_main;
    }
