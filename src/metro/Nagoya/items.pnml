    string(STR_FORMATION, string(STR_NUM_CARS_2, 4,5)),
    
    string(STR_OPERATOR, string(STR_NAGOYA_SUBWAY))
    ,string(STR_LINES_USED, string(STR_NAGOYA_SAKURA))
    );
    
    purchase: ng_sk_6000series_purchase;
    cargo_capacity:sw_ng_sk_6000series_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_ng_sk_6000series_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_ng_sk_6000series_lv;
    power:sw_ng_sk_6000series_power_main()*4*1342/1000;
    purchase_power: sw_ng_sk_6000series_car_power_main()*4*1342/1000;
    
    
    
    
    
