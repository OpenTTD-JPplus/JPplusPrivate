//livery 1
spriteset(ng_mj_type1000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/type1000/type1000.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(ng_mj_type1000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/type1000/type1000.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_4(gfx_ng_mj_type1000_purchase_main, logo_nagoya_subway, logo_line_ng_meijo, ng_mj_type1000_purchase_c1, ng_mj_type1000_purchase_c2)

spriteset(ng_mj_type1000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/type1000/type1000.png"){ tmpl_std_v3(0, 0) }
spriteset(ng_mj_type1000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/type1000/type1000.png"){ tmpl_std_v3(0, 25) }
spriteset(ng_mj_type1000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/type1000/type1000.png"){ tmpl_symm_v3(0, 50) }

//*main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_ng_mj_type1000_head_gfx_main,position_in_consist>0){
      1: ng_mj_type1000_end;
      ng_mj_type1000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_mj_type1000_lv,vehicle_type_id){
      mu_car:ng_mj_type1000_wag;
      sw_ng_mj_type1000_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_ng_mj_type1000_capacity_main,vehicle_type_id){
      ng_mj_type1000: 110;
      default: 115;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_ng_mj_type1000_car_power_main,position_in_vehid_chain_from_end %6){
      0..5:return 55;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_mj_type1000_power_main,vehicle_type_id){
      ng_mj_type1000: 55*2;
      sw_ng_mj_type1000_car_power_main;
    }
