spriteset(ng_mj_2000series_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/2000series/2000series.png"){ tmpl_std_v3(0, 0) }
spriteset(ng_mj_2000series_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/2000series/2000series.png"){ tmpl_std_v3(0, 25) }
spriteset(ng_mj_2000series_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/2000series/2000series.png"){ tmpl_symm_v3(0, 50) }


spriteset(ng_mj_2000series_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/2000series/2000series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(ng_mj_2000series_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/2000series/2000series_1.png"){ tmpl_std_v3(0, 25) }
spriteset(ng_mj_2000series_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/2000series/2000series_1.png"){ tmpl_symm_v3(0, 50) }


//lv stuff
  switch(FEAT_TRAINS, SELF, ng_mj_2000series_front, cargo_subtype){
    1:ng_mj_2000series_2_front;
    ng_mj_2000series_1_front;
  }
  switch(FEAT_TRAINS, SELF, ng_mj_2000series_end, cargo_subtype){
    1:ng_mj_2000series_2_end;
    ng_mj_2000series_1_end;
  }
  switch(FEAT_TRAINS, SELF, ng_mj_2000series_wag, cargo_subtype){
    1:ng_mj_2000series_2_wag;
    ng_mj_2000series_1_wag;
  }
