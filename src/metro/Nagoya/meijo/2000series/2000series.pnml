spriteset(ng_mj_2000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/meijo/2000series/2000series.png"){ tmpl_purchase_2c_dual(0, 50) }
