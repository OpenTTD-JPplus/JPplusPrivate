//*livery 1
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_ng_mj_2000series_head_gfx_main,position_in_consist>0){
      1: ng_mj_2000series_end;
      ng_mj_2000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_mj_2000series_lv,vehicle_type_id){
      mu_car:ng_mj_2000series_wag;
      sw_ng_mj_2000series_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_ng_mj_2000series_capacity_main,vehicle_type_id){
      ng_mj_2000series: 97;
      default: 107;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_ng_mj_2000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..5:return 75;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_mj_2000series_power_main,vehicle_type_id){
      ng_mj_2000series: 0;
      sw_ng_mj_2000series_car_power_main;
    }
//

//livery selector
  switch(FEAT_TRAINS, SELF, sw_ng_mj_2000series_lv_desc_main, cargo_subtype){
      0: string(LV_DEFAULT);
      //TODO かつて走っていたドラゴンズ・トレイン 2010
