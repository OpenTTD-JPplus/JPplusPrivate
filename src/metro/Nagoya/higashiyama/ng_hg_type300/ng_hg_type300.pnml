//livery 1
spriteset(ng_hg_type300_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/ng_hg_type300/ng_hg_type300.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(ng_hg_type300_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/ng_hg_type300/ng_hg_type300.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(ng_hg_type300_purchase, ng_hg_type300_purchase_c1, ng_hg_type300_purchase_c2)

spriteset(ng_hg_type300_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/ng_hg_type300/ng_hg_type300.png"){ tmpl_std_v3(0, 0) }
spriteset(ng_hg_type300_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/ng_hg_type300/ng_hg_type300.png"){ tmpl_std_v3(0, 25) }
spriteset(ng_hg_type300_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/ng_hg_type300/ng_hg_type300.png"){ tmpl_symm_v3(0, 50) }

//*main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_ng_hg_type300_head_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
      1: ng_hg_type300_end;
      ng_hg_type300_front;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_hg_type300_lv,vehicle_type_id){
      mu_car:ng_hg_type300_wag;
      sw_ng_hg_type300_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_ng_hg_type300_capacity_main,vehicle_type_id){
      ng_hg_type300: 110;
      default: 115;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_ng_hg_type300_car_power_main,position_in_vehid_chain_from_end %6){
      0..5:return 55;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_hg_type300_power_main,vehicle_type_id){
      ng_hg_type300: 55*2;
      sw_ng_hg_type300_car_power_main;
    }
