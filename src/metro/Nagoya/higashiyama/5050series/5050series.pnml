spriteset(ng_hg_5050series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/5050series/5050series.png"){ tmpl_purchase_2c_dual(0, 50) }
