//livery 1
spriteset(ng_hg_n1000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/N1000series/N1000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(ng_hg_n1000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/N1000series/N1000series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_4(gfx_ng_hg_n1000series_purchase_main, logo_nagoya_subway, logo_line_ng_higashiyama, ng_hg_n1000series_purchase_c1, ng_hg_n1000series_purchase_c2)

spriteset(ng_hg_n1000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/N1000series/N1000series.png"){ tmpl_std_v3(0, 0) }
spriteset(ng_hg_n1000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/N1000series/N1000series.png"){ tmpl_std_v3(0, 25) }
spriteset(ng_hg_n1000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/higashiyama/N1000series/N1000series.png"){ tmpl_symm_v3(0, 50) }

//*main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_ng_hg_n1000series_head_gfx_main,position_in_consist>0){
      1: ng_hg_n1000series_end;
      ng_hg_n1000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_hg_n1000series_lv,vehicle_type_id){
      mu_car:ng_hg_n1000series_wag;
      sw_ng_hg_n1000series_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_ng_hg_n1000series_capacity_main,vehicle_type_id){
      ng_hg_n1000series: 97;
      default: 106;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_ng_hg_n1000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..5:return 75;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_hg_n1000series_power_main,vehicle_type_id){
      ng_hg_n1000series: 0;
      sw_ng_hg_n1000series_car_power_main;
    }
