//livery 1
spriteset(ng_km_7000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/kamiida/7000series/7000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(ng_km_7000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/kamiida/7000series/7000series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_4(ng_km_7000series_purchase, logo_nagoya_subway, logo_line_ng_kamiida, ng_km_7000series_purchase_c1, ng_km_7000series_purchase_c2)

spriteset(ng_km_7000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/kamiida/7000series/7000series.png"){ tmpl_std_v3(0, 0) }
spriteset(ng_km_7000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/kamiida/7000series/7000series.png"){ tmpl_std_v3(0, 25) }
spriteset(ng_km_7000series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/kamiida/7000series/7000series.png"){ tmpl_std_v3(0, 50) }
spriteset(ng_km_7000series_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/kamiida/7000series/7000series.png"){ tmpl_std_rev_v3(0, 50) }
spriteset(ng_km_7000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/kamiida/7000series/7000series.png"){ tmpl_symm_v3(0, 75) }

//*main
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_ng_km_7000series_panto_placer,position_in_vehid_chain %4){
        0: ng_km_7000series_mot_rev;
        1: ng_km_7000series_mot;
        ng_km_7000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_km_7000series_panto_placer_rev,position_in_vehid_chain_from_end %4){
        0: ng_km_7000series_mot;
        1: ng_km_7000series_mot_rev;
        ng_km_7000series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_km_7000series_panto_placer_main,vehicle_is_reversed){
        1: sw_ng_km_7000series_panto_placer_rev;
        sw_ng_km_7000series_panto_placer;
    }
  //front-end-fixer
    //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_ng_km_7000series_head_gfx_main,position_in_consist>0){
      1: ng_km_7000series_end;
      ng_km_7000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_km_7000series_lv,vehicle_type_id){
      mu_car:sw_ng_km_7000series_panto_placer_main;
      sw_ng_km_7000series_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_ng_km_7000series_capacity_main,vehicle_type_id){
      ng_km_7000series: 128;
      default: 135;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_ng_km_7000series_car_power_main,position_in_vehid_chain_from_end %4){
      0..1:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_km_7000series_power_main,vehicle_type_id){
      ng_km_7000series: 0;
      sw_ng_km_7000series_car_power_main;
    }
