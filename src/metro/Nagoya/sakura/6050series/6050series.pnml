//livery 1
spriteset(ng_sk_6050series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/6050series/6050series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(ng_sk_6050series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/6050series/6050series.png"){ tmpl_purchase_2c_dual(0, 75) }
GRAPHIC_STACK_2(ng_sk_6050series_purchase, ng_sk_6050series_purchase_c1, ng_sk_6050series_purchase_c2)

spriteset(ng_sk_6050series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/6050series/6050series.png"){ tmpl_std_v3(0, 0) }
spriteset(ng_sk_6050series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/6050series/6050series.png"){ tmpl_std_v3(0, 25) }
spriteset(ng_sk_6050series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/6050series/6050series.png"){ tmpl_std_v3(0, 50) }
spriteset(ng_sk_6050series_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/6050series/6050series.png"){ tmpl_std_rev_v3(0, 50) }
spriteset(ng_sk_6050series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/6050series/6050series.png"){ tmpl_std_v3(0, 75) }

//*livery 1
  //panto placer
    //1
      switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_panto_placer,position_in_vehid_chain %6){
        0: ng_sk_6050series_mot;
        1: ng_sk_6050series_mot;
        2: ng_sk_6050series_mot;
        ng_sk_6050series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_panto_placer_rev,position_in_vehid_chain_from_end %6){
          0: ng_sk_6050series_mot_rev;
          1: ng_sk_6050series_mot_rev;
          2: ng_sk_6050series_mot_rev;
          ng_sk_6050series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_ng_sk_6050series_panto_placer_main_1,vehicle_is_reversed){
          1: sw_ng_sk_6050series_panto_placer_rev;
          sw_ng_sk_6050series_panto_placer;
      }
    //2
      switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_1_panto_placer,position_in_articulated_veh %2){
          0: ng_sk_6050series_mot;
          ng_sk_6050series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_1_panto_placer_rev,position_in_articulated_veh_from_end %2){
          0: ng_sk_6050series_mot_rev;
          ng_sk_6050series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_ng_sk_6050series_panto_placer_main_2,vehicle_is_reversed){
          1: sw_ng_sk_6050series_1_panto_placer_rev;
          sw_ng_sk_6050series_1_panto_placer;
      }
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_panto_placer_main,num_vehs_in_vehid_chain){
      0..4:sw_ng_sk_6050series_panto_placer_main_1;
      sw_ng_sk_6050series_panto_placer_main_2;
    }
//front-end-fixer
    //front-end-fixer
      switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_head_gfx_main,position_in_consist>0){
        1: ng_sk_6050series_end;
        ng_sk_6050series_front;
      }
      switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_lv,vehicle_type_id){
        mu_car:sw_ng_sk_6050series_panto_placer_main;
        sw_ng_sk_6050series_head_gfx_main;
      }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_capacity_main,vehicle_type_id){
      ng_sk_6050series: 136;
      default: 147;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_car_power_main,position_in_vehid_chain_from_end %5){
      0..2:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6050series_power_main,vehicle_type_id){
      ng_sk_6050series: 0;
      sw_ng_sk_6050series_car_power_main;
    }
//