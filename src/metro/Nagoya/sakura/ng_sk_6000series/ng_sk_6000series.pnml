//purchase sprites
  spriteset(ng_sk_6000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/ng_sk_6000series/ng_sk_6000series.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(ng_sk_6000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/ng_sk_6000series/ng_sk_6000series.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_5(ng_sk_6000series_purchase, ng_sk_6000series_purchase_c1, ac_quad_1_mot_c1,panto_d_arm_single_c1, ng_sk_6000series_purchase_c2,ac_quad_1_wag_c2)
//base
  spriteset(ng_sk_6000series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/ng_sk_6000series/ng_sk_6000series_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(ng_sk_6000series_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/ng_sk_6000series/ng_sk_6000series_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: ng_sk_6000series_lights_end;
    ng_sk_6000series_lights_front;
  }

  spriteset(ng_sk_6000series_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/ng_sk_6000series/ng_sk_6000series.png"){ tmpl_std_v3(0, 0) }
  spriteset(ng_sk_6000series_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/sakura/ng_sk_6000series/ng_sk_6000series.png"){ tmpl_symm_v3(0, 25) }
//
  TRAIN_CONSTRUCTOR_3(ng_sk_6000series_head,
  ng_sk_6000series_head_base,
  sw_ng_sk_6000series_lights,
  ac_quad_1_wag)
  TRAIN_CONSTRUCTOR_4(ng_sk_6000series_head_mot_1,
  ng_sk_6000series_head_base,
  sw_ng_sk_6000series_lights,
  ac_quad_1_mot,
  panto_d_arm_single
  )
  TRAIN_CONSTRUCTOR_4(ng_sk_6000series_head_mot_2,
  ng_sk_6000series_head_base,
  sw_ng_sk_6000series_lights,
  ac_quad_1_mot_dual,
  panto_d_arm
  )
  TRAIN_CONSTRUCTOR_3(ng_sk_6000series_mot,
  ng_sk_6000series_car_base,
  ac_quad_1_mot,
  panto_d_arm_single
  )
  TRAIN_CONSTRUCTOR_2(ng_sk_6000series_wag,
  ng_sk_6000series_car_base,
  ac_quad_1_wag
  )
//*livery 1
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_ng_sk_6000series_front_gfx_1, vehicle_is_reversed){
      1:ng_sk_6000series_head;
      ng_sk_6000series_head_mot_1;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_sk_6000series_front_gfx_2, vehicle_is_reversed){
      1:ng_sk_6000series_head;
      ng_sk_6000series_head_mot_2;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_sk_6000series_end_gfx_1, vehicle_is_reversed){
      1:ng_sk_6000series_head_mot_1;
      ng_sk_6000series_head;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_sk_6000series_end_gfx_2, vehicle_is_reversed){
      1:ng_sk_6000series_head_mot_2;
      ng_sk_6000series_head;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_panto_placer_main,position_in_vehid_chain %3){
        1: ng_sk_6000series_mot;
        2: ng_sk_6000series_mot;
        ng_sk_6000series_wag;
    }
  //front-end-fixer
    //front-end-fixer
      switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_head_gfx_main_1,position_in_consist>0){
        1: sw_ng_sk_6000series_end_gfx_1;
        sw_ng_sk_6000series_front_gfx_1;
      }
      switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_head_gfx_main_2,position_in_consist>0){
        1: sw_ng_sk_6000series_end_gfx_2;
        sw_ng_sk_6000series_front_gfx_2;
      }
      random_switch(FEAT_TRAINS,PARENT,sw_ng_sk_6000series_head_gfx_main){
        3:sw_ng_sk_6000series_head_gfx_main_1;
        1:sw_ng_sk_6000series_head_gfx_main_2;
      }
      switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_lv,vehicle_type_id){
        mu_car:sw_ng_sk_6000series_panto_placer_main;
        sw_ng_sk_6000series_head_gfx_main;
      }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_capacity_main,vehicle_type_id){
      ng_sk_6000series: 138;
      default: 152;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_car_power_main,position_in_vehid_chain_from_end %3){
      0..1:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_sk_6000series_power_main,vehicle_type_id){
      ng_sk_6000series: 170;
      sw_ng_sk_6000series_car_power_main;
    }
//