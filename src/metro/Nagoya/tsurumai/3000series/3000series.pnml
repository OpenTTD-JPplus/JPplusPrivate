//purchase sprites
  spriteset(ng_tm_3000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/3000series/3000series.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(ng_tm_3000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/3000series/3000series.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_7(gfx_ng_tm_3000series_purchase_main, logo_nagoya_subway, logo_line_ng_tsurumai, ng_tm_3000series_purchase_c1, ac_quad_1_mot_c1,panto_d_arm_single_c1, ng_tm_3000series_purchase_c2,ac_quad_1_wag_c2)
//base
  spriteset(ng_tm_3000series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/3000series/3000series_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(ng_tm_3000series_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/3000series/3000series_lights.png"){ tmpl_std_v3(0, 25) }
  spriteset(ng_tm_3000series_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/3000series/3000series.png"){ tmpl_std_v3(0, 0) }
  spriteset(ng_tm_3000series_car_a_base_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/3000series/3000series.png"){ tmpl_std_v3(0, 25) }
  spriteset(ng_tm_3000series_car_a_base_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/3000series/3000series.png"){ tmpl_std_rev_v3(0, 25) }
  spriteset(ng_tm_3000series_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/3000series/3000series.png"){ tmpl_symm_v3(0, 50) }
//
  TRAIN_CONSTRUCTOR_3(ng_tm_3000series_front,
  ng_tm_3000series_head_base,
  ng_tm_3000series_lights_front,
  ac_quad_1_wag)
  TRAIN_CONSTRUCTOR_3(ng_tm_3000series_end,
  ng_tm_3000series_head_base,
  ng_tm_3000series_lights_end,
  ac_quad_1_wag)
  TRAIN_CONSTRUCTOR_4(ng_tm_3000series_front_mot_1,
  ng_tm_3000series_head_base,
  ng_tm_3000series_lights_front,
  ac_quad_1_mot,
  panto_d_arm_single
  )
  TRAIN_CONSTRUCTOR_4(ng_tm_3000series_end_mot_1,
  ng_tm_3000series_head_base,
  ng_tm_3000series_lights_end,
  ac_quad_1_mot,
  panto_d_arm_single
  )
  TRAIN_CONSTRUCTOR_4(ng_tm_3000series_front_mot_2,
  ng_tm_3000series_head_base,
  ng_tm_3000series_lights_front,
  ac_quad_1_mot_dual,
  panto_d_arm
  )
  TRAIN_CONSTRUCTOR_4(ng_tm_3000series_end_mot_2,
  ng_tm_3000series_head_base,
  ng_tm_3000series_lights_end,
  ac_quad_1_mot_dual,
  panto_d_arm
  )
  TRAIN_CONSTRUCTOR_3(ng_tm_3000series_mot,
  ng_tm_3000series_car_base,
  ac_quad_1_mot,
  panto_d_arm_single
  )
  TRAIN_CONSTRUCTOR_3(ng_tm_3000series_mot_rev,
  ng_tm_3000series_car_base,
  ac_quad_1_mot_rev,
  panto_d_arm_single_rev
  )
  TRAIN_CONSTRUCTOR_2(ng_tm_3000series_wag_a,
  ng_tm_3000series_car_a_base_def,
  ac_quad_1_wag
  )
  TRAIN_CONSTRUCTOR_2(ng_tm_3000series_wag_a_rev,
  ng_tm_3000series_car_a_base_rev,
  ac_quad_1_wag
  )
  TRAIN_CONSTRUCTOR_2(ng_tm_3000series_wag,
  ng_tm_3000series_car_base,
  ac_quad_1_wag
  )
  
//
//*livery 1
  //special gfx
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3000series_wag_def, position_in_vehid_chain_from_end==1&&num_vehs_in_vehid_chain>2){
      1:ng_tm_3000series_wag_a_rev;
      ng_tm_3000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3000series_wag_rev, position_in_vehid_chain==1&&num_vehs_in_vehid_chain>2){
      1:ng_tm_3000series_wag_a;
      ng_tm_3000series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_tm_3000series_wag, vehicle_is_reversed){
      1:sw_ng_tm_3000series_wag_rev;
      sw_ng_tm_3000series_wag_def;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_tm_3000series_front_gfx_1, vehicle_is_reversed){
      1:ng_tm_3000series_front;
      ng_tm_3000series_front_mot_1;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_tm_3000series_front_gfx_2, vehicle_is_reversed){
      1:ng_tm_3000series_front;
      ng_tm_3000series_front_mot_2;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_tm_3000series_end_gfx_1, vehicle_is_reversed){
      1:ng_tm_3000series_end_mot_1;
      ng_tm_3000series_end;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_tm_3000series_end_gfx_2, vehicle_is_reversed){
      1:ng_tm_3000series_end_mot_2;
      ng_tm_3000series_end;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3000series_panto_placer,position_in_vehid_chain %2){
      1: ng_tm_3000series_mot;
      sw_ng_tm_3000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3000series_panto_placer_rev,position_in_vehid_chain_from_end %2){
      1: ng_tm_3000series_mot_rev;
      sw_ng_tm_3000series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_tm_3000series_panto_placer_main,vehicle_is_reversed){
      1: sw_ng_tm_3000series_panto_placer_rev;
      sw_ng_tm_3000series_panto_placer;
    }
  //front-end-fixer
    //front-end-fixer
      switch(FEAT_TRAINS, SELF, sw_ng_tm_3000series_head_gfx_main_1,position_in_consist>0){
        1: sw_ng_tm_3000series_end_gfx_1;
        sw_ng_tm_3000series_front_gfx_1;
      }
      switch(FEAT_TRAINS, SELF, sw_ng_tm_3000series_head_gfx_main_2,position_in_consist>0){
        1: sw_ng_tm_3000series_end_gfx_2;
        sw_ng_tm_3000series_front_gfx_2;
      }
      random_switch(FEAT_TRAINS,PARENT,sw_ng_tm_3000series_head_gfx_main){
        3:sw_ng_tm_3000series_head_gfx_main_1;
        1:sw_ng_tm_3000series_head_gfx_main_2;
      }
      switch(FEAT_TRAINS, SELF, sw_ng_tm_3000series_lv,vehicle_type_id){
        mu_car:sw_ng_tm_3000series_panto_placer_main;
        sw_ng_tm_3000series_head_gfx_main;
      }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3000series_capacity_main,vehicle_type_id){
      ng_tm_3000series: 130;
      default: 140;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 135;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3000series_power_main,vehicle_type_id){
      ng_tm_3000series: 135*2;
      sw_ng_tm_3000series_car_power_main;
    }
