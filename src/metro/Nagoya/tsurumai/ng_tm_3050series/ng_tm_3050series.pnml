//purchase sprites
  spriteset(ng_tm_3050series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/ng_tm_3050series/ng_tm_3050series.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(ng_tm_3050series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/ng_tm_3050series/ng_tm_3050series.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_5(ng_tm_3050series_purchase, ng_tm_3050series_purchase_c1, ac_quad_1_mot_c1,panto_d_arm_single_c1, ng_tm_3050series_purchase_c2,ac_quad_1_wag_c2)
//base
  spriteset(ng_tm_3050series_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/ng_tm_3050series/ng_tm_3050series_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(ng_tm_3050series_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/ng_tm_3050series/ng_tm_3050series_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_ng_tm_3050series_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: ng_tm_3050series_lights_end;
    ng_tm_3050series_lights_front;
  }

  spriteset(ng_tm_3050series_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/ng_tm_3050series/ng_tm_3050series.png"){ tmpl_std_v3(0, 0) }
  spriteset(ng_tm_3050series_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/ng_tm_3050series/ng_tm_3050series.png"){ tmpl_symm_v3(0, 25) }
//
  TRAIN_CONSTRUCTOR_3(ng_tm_3050series_head,
  ng_tm_3050series_head_base,
  sw_ng_tm_3050series_lights,
  ac_quad_1_wag)
  TRAIN_CONSTRUCTOR_4(ng_tm_3050series_head_mot_1,
  ng_tm_3050series_head_base,
  sw_ng_tm_3050series_lights,
  ac_quad_1_mot_2,
  panto_d_arm_single
  )
  TRAIN_CONSTRUCTOR_4(ng_tm_3050series_head_mot_2,
  ng_tm_3050series_head_base,
  sw_ng_tm_3050series_lights,
  ac_quad_1_mot_dual,
  panto_d_arm
  )
  TRAIN_CONSTRUCTOR_3(ng_tm_3050series_mot,
  ng_tm_3050series_car_base,
  ac_quad_1_mot_2,
  panto_d_arm_single
  )
  TRAIN_CONSTRUCTOR_2(ng_tm_3050series_wag,
  ng_tm_3050series_car_base,
  ac_quad_1_wag
  )
//*livery 1
  //special gfx
     switch(FEAT_TRAINS, PARENT, sw_ng_tm_3050series_front_gfx_1, vehicle_is_reversed){
      1:ng_tm_3050series_head;
      ng_tm_3050series_head_mot_1;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_tm_3050series_front_gfx_2, vehicle_is_reversed){
      1:ng_tm_3050series_head;
      ng_tm_3050series_head_mot_2;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_tm_3050series_end_gfx_1, vehicle_is_reversed){
      1:ng_tm_3050series_head_mot_1;
      ng_tm_3050series_head;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_tm_3050series_end_gfx_2, vehicle_is_reversed){
      1:ng_tm_3050series_head_mot_2;
      ng_tm_3050series_head;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3050series_panto_placer_main,position_in_vehid_chain %2){
      1: ng_tm_3050series_mot;
      ng_tm_3050series_wag;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3050series_head_gfx_main_1,train_is_driving_backwards != vehicle_is_flipped){
      1: sw_ng_tm_3050series_end_gfx_1;
      sw_ng_tm_3050series_front_gfx_1;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3050series_head_gfx_main_2,train_is_driving_backwards != vehicle_is_flipped){
      1: sw_ng_tm_3050series_end_gfx_2;
      sw_ng_tm_3050series_front_gfx_2;
    }
    random_switch(FEAT_TRAINS,PARENT,sw_ng_tm_3050series_head_gfx_main){
      3:sw_ng_tm_3050series_head_gfx_main_1;
      1:sw_ng_tm_3050series_head_gfx_main_2;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3050series_lv,vehicle_type_id){
      mu_car:sw_ng_tm_3050series_panto_placer_main;
      sw_ng_tm_3050series_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3050series_capacity_main,vehicle_type_id){
      ng_tm_3050series: 138;
      default: 152;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3050series_car_power_main,position_in_vehid_chain_from_end %6){
      0..3:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_tm_3050series_power_main,vehicle_type_id){
      ng_tm_3050series: 170;
      sw_ng_tm_3050series_car_power_main;
    }
