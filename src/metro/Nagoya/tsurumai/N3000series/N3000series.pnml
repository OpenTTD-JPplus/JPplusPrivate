//purchase sprites
    spriteset(ng_tm_N3000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series.png"){ tmpl_purchase_1c_dual(0, 0) }
    spriteset(ng_tm_N3000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series.png"){ tmpl_purchase_2c_dual(0, 75) }
    GRAPHIC_STACK_2(ng_tm_N3000series_purchase, ng_tm_N3000series_purchase_c1, ng_tm_N3000series_purchase_c2)
//livery 1
  spriteset(ng_tm_N3000series_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series.png"){ tmpl_std_v3(0, 0) }
  spriteset(ng_tm_N3000series_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series.png"){ tmpl_std_v3(0, 25) }
  spriteset(ng_tm_N3000series_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series.png"){ tmpl_std_v3(0, 50) }
  spriteset(ng_tm_N3000series_1_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series.png"){ tmpl_std_rev_v3(0, 50) }
  spriteset(ng_tm_N3000series_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series.png"){ tmpl_symm_v3(0, 75) }

  spriteset(ng_tm_N3000series_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(ng_tm_N3000series_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(ng_tm_N3000series_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series_1.png"){ tmpl_std_v3(0, 50) }
  spriteset(ng_tm_N3000series_2_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series_1.png"){ tmpl_std_rev_v3(0, 50) }
  spriteset(ng_tm_N3000series_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Nagoya/tsurumai/N3000series/N3000series_1.png"){ tmpl_symm_v3(0, 75) }
//
//lv stuff
  switch(FEAT_TRAINS, SELF, ng_tm_N3000series_front, cargo_subtype==2||(cargo_subtype==0&&current_year<2012)){
    1:ng_tm_N3000series_2_front;
    ng_tm_N3000series_1_front;
  }
  switch(FEAT_TRAINS, SELF, ng_tm_N3000series_end, cargo_subtype==2||(cargo_subtype==0&&current_year<2012)){
    1:ng_tm_N3000series_2_end;
    ng_tm_N3000series_1_end;
  }
  switch(FEAT_TRAINS, SELF, ng_tm_N3000series_mot, cargo_subtype==2||(cargo_subtype==0&&current_year<2012)){
    1:ng_tm_N3000series_2_mot;
    ng_tm_N3000series_1_mot;
  }
  switch(FEAT_TRAINS, SELF, ng_tm_N3000series_mot_rev, cargo_subtype==2||(cargo_subtype==0&&current_year<2012)){
    1:ng_tm_N3000series_2_mot_rev;
    ng_tm_N3000series_1_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, ng_tm_N3000series_wag, cargo_subtype==2||(cargo_subtype==0&&current_year<2012)){
    1:ng_tm_N3000series_2_wag;
    ng_tm_N3000series_1_wag;
  }
//
//*livery 1
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_ng_tm_N3000series_panto_placer,position_in_vehid_chain %3){
      0: ng_tm_N3000series_mot;
      1: ng_tm_N3000series_mot;
      ng_tm_N3000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_tm_N3000series_panto_placer_rev,position_in_vehid_chain_from_end %3){
      0: ng_tm_N3000series_mot_rev;
      1: ng_tm_N3000series_mot_rev;
      ng_tm_N3000series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_ng_tm_N3000series_panto_placer_main,vehicle_is_reversed){
      1: sw_ng_tm_N3000series_panto_placer_rev;
      sw_ng_tm_N3000series_panto_placer;
    }

  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_ng_tm_N3000series_head_gfx_main,position_in_consist>0){
        1: ng_tm_N3000series_end;
        ng_tm_N3000series_front;
      }
    switch(FEAT_TRAINS, SELF, sw_ng_tm_N3000series_lv,vehicle_type_id){
        mu_car:sw_ng_tm_N3000series_panto_placer_main;
        sw_ng_tm_N3000series_head_gfx_main;
      }

//livery selector
  switch(FEAT_TRAINS, SELF, sw_ng_tm_N3000series_lv_desc_main, cargo_subtype){
      0: string(LV_RANDOM);
      1: string(LV_DATED, string(STR_ALUMI), 2011);
      2: string(LV_DATED, string(STR_SUTEN), 2012);
  }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_ng_tm_N3000series_capacity_main,vehicle_type_id){
      ng_tm_N3000series: 136;
      default: 147;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_ng_tm_N3000series_car_power_main,position_in_vehid_chain_from_end %6){
      0:return 170;
      2..3:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_ng_tm_N3000series_power_main,vehicle_type_id){
      ng_tm_N3000series: 0;
      sw_ng_tm_N3000series_car_power_main;
    }
