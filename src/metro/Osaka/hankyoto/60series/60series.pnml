spriteset(os_hk_60series_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series_old.png"){ tmpl_std_v3(0, 100) }
spriteset(os_hk_60series_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series_old.png"){ tmpl_std_v3(0, 125) }

