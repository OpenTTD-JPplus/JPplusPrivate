spriteset(os_hk_60series_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series.png"){ tmpl_symm_v3(0, 75) }
spriteset(os_hk_60series_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series.png"){ tmpl_std_v3(0, 100) }
spriteset(os_hk_60series_2_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series.png"){ tmpl_std_v3(0, 125) }
//lv stuff
  switch(FEAT_TRAINS, SELF, os_hk_60series_front, current_year>1989){
    1:os_hk_60series_2_front;
    os_hk_60series_1_front;
  }
  switch(FEAT_TRAINS, SELF, os_hk_60series_end, current_year>1989){
    1:os_hk_60series_2_end;
    os_hk_60series_1_end;
  }
  switch(FEAT_TRAINS, SELF, os_hk_60series_front_mot, current_year>1989){
    1:os_hk_60series_2_front_mot;
    os_hk_60series_1_front_mot;
  }
  switch(FEAT_TRAINS, SELF, os_hk_60series_end_mot, current_year>1989){
    1:os_hk_60series_2_end_mot;
    os_hk_60series_1_end_mot;
  }
  switch(FEAT_TRAINS, SELF, os_hk_60series_mot, current_year>1989){
    1:os_hk_60series_2_mot;
    os_hk_60series_1_mot;
  }
  switch(FEAT_TRAINS, SELF, os_hk_60series_mot_rev, current_year>1989){
    1:os_hk_60series_2_mot_rev;
    os_hk_60series_1_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, os_hk_60series_wag, current_year>1989){
    1:os_hk_60series_2_wag;
    os_hk_60series_1_wag;
  }
//
//*livery 1
  //special gfx
    switch(FEAT_TRAINS, PARENT, os_hk_60series_front_gfx, vehicle_is_reversed){
      1:os_hk_60series_front;
      os_hk_60series_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, os_hk_60series_end_gfx, vehicle_is_reversed){
      1:os_hk_60series_end_mot;
      os_hk_60series_end;
    }
  //panto placer
    //var 1
      switch(FEAT_TRAINS, SELF, sw_os_hk_60series_panto_placer_1,position_in_vehid_chain_from_end){
          0: os_hk_60series_mot;
          os_hk_60series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_os_hk_60series_panto_placer_1_rev,position_in_vehid_chain){
          0: os_hk_60series_mot_rev;
          os_hk_60series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_os_hk_60series_panto_placer_1_main,vehicle_is_reversed){
          1: sw_os_hk_60series_panto_placer_1_rev;
          sw_os_hk_60series_panto_placer_1;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_os_hk_60series_panto_placer_2,position_in_vehid_chain %3){
          2: os_hk_60series_mot;
          os_hk_60series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_os_hk_60series_panto_placer_2_rev,position_in_vehid_chain_from_end %3){
          2: os_hk_60series_mot_rev;
          os_hk_60series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_os_hk_60series_panto_placer_2_main,vehicle_is_reversed){
          1: sw_os_hk_60series_panto_placer_2_rev;
          sw_os_hk_60series_panto_placer_2;
      }
    switch(FEAT_TRAINS,SELF,sw_os_hk_60series_panto_placer_main,num_vehs_in_vehid_chain){
      0..1:os_hk_60series_wag;
      2..4:sw_os_hk_60series_panto_placer_1_main;
      sw_os_hk_60series_panto_placer_2_main;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_hk_60series_head_gfx_main,position_in_consist>0){
      1: os_hk_60series_end_gfx;
      os_hk_60series_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_os_hk_60series_lv,vehicle_type_id){
      mu_car:sw_os_hk_60series_panto_placer_main;
      sw_os_hk_60series_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_os_hk_60series_capacity_main,vehicle_type_id){
      os_hk_60series: 150;
      default: 135;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_os_hk_60series_car_power_main,position_in_vehid_chain_from_end %8){
      0..1:return 120;
      4..5:return 120;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_hk_60series_power_main,vehicle_type_id){
      os_hk_60series: 120*2;
      sw_os_hk_60series_car_power_main;
    }
