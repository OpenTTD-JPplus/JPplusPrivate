//purchase
spriteset(os_hk_60series_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series_old.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(os_hk_60series_purchase_c2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series_old.png"){ tmpl_purchase_2c_dual(0, 50) }
spriteset(os_hk_60series_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(os_hk_60series_purchase_c2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series.png"){ tmpl_purchase_2c_dual(0, 50) }
switch(FEAT_TRAINS, SELF, os_hk_60series_purchase_c1, current_year>1989){
			1: os_hk_60series_purchase_c1_1;
			os_hk_60series_purchase_c1_2;
	}
switch(FEAT_TRAINS, SELF, os_hk_60series_purchase_c2, current_year>1989){
			1: os_hk_60series_purchase_c2_1;
			os_hk_60series_purchase_c2_2;
	}
GRAPHIC_STACK_2(os_hk_60series_purchase, os_hk_60series_purchase_c1, os_hk_60series_purchase_c2)

