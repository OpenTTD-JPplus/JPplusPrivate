spriteset(os_hk_60series_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series.png"){ tmpl_std_v3(0, 25) }
spriteset(os_hk_60series_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/60series/60series.png"){ tmpl_std_v3(0, 50) }
