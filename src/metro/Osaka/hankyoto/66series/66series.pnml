//*livery 1
spriteset(os_hk_66series_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/66series/66series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(os_hk_66series_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/66series/66series_1.png"){ tmpl_std_v3(0, 25) }
spriteset(os_hk_66series_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/66series/66series_1.png"){ tmpl_symm_v3(0, 50) }
spriteset(os_hk_66series_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/66series/66series_1.png"){ tmpl_symm_v3(0, 75) }
//*livery 2

spriteset(os_hk_66series_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/66series/66series_2.png"){ tmpl_std_v3(0, 0) }
spriteset(os_hk_66series_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/66series/66series_2.png"){ tmpl_std_v3(0, 25) }
spriteset(os_hk_66series_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/66series/66series_2.png"){ tmpl_symm_v3(0, 50) }
spriteset(os_hk_66series_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/66series/66series_2.png"){ tmpl_symm_v3(0, 75) }

//lv stuff
  switch(FEAT_TRAINS, SELF, os_hk_66series_front, cargo_subtype==2||(cargo_subtype==0&&current_year>2011)){
    1:os_hk_66series_2_front;
    os_hk_66series_1_front;
  }
  switch(FEAT_TRAINS, SELF, os_hk_66series_end, cargo_subtype==2||(cargo_subtype==0&&current_year>2011)){
    1:os_hk_66series_2_end;
    os_hk_66series_1_end;
  }
  switch(FEAT_TRAINS, SELF, os_hk_66series_mot, cargo_subtype==2||(cargo_subtype==0&&current_year>2011)){
    1:os_hk_66series_2_mot;
    os_hk_66series_1_mot;
  }
  switch(FEAT_TRAINS, SELF, os_hk_66series_wag, cargo_subtype==2||(cargo_subtype==0&&current_year>2011)){
    1:os_hk_66series_2_wag;
    os_hk_66series_1_wag;
  }
//
//*livery 1
  //panto placer
    //var 1
      switch(FEAT_TRAINS, SELF, sw_os_hk_66series_panto_placer_1,position_in_vehid_chain %5){
          0: os_hk_66series_mot;
          os_hk_66series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_os_hk_66series_panto_placer_1_rev,position_in_vehid_chain_from_end %5){
          0: os_hk_66series_mot;
          os_hk_66series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_os_hk_66series_panto_placer_1_main,vehicle_is_reversed){
          1: sw_os_hk_66series_panto_placer_1_rev;
          sw_os_hk_66series_panto_placer_1;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_os_hk_66series_panto_placer_2,position_in_vehid_chain %3){
          0: os_hk_66series_mot;
          os_hk_66series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_os_hk_66series_panto_placer_2_rev,position_in_vehid_chain_from_end %3){
          0: os_hk_66series_mot;
          os_hk_66series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_os_hk_66series_panto_placer_2_main,vehicle_is_reversed){
          1: sw_os_hk_66series_panto_placer_2_rev;
          sw_os_hk_66series_panto_placer_2;
      }
    switch(FEAT_TRAINS,SELF,sw_os_hk_66series_panto_placer_main,num_vehs_in_vehid_chain){
      0..5:sw_os_hk_66series_panto_placer_2_main;
      sw_os_hk_66series_panto_placer_1_main;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_hk_66series_head_gfx_main,position_in_consist>0){
      1: os_hk_66series_end;
      os_hk_66series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_hk_66series_lv,vehicle_type_id){
      mu_car:sw_os_hk_66series_panto_placer_main;
      sw_os_hk_66series_head_gfx_main;
    }
//
//lv selector
  switch(FEAT_TRAINS, SELF, sw_os_hk_66series_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1990);
    2: string(LV_DATED,string(STR_LIVERY,string(STR_RENEWAL)),2012);
  }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_os_hk_66series_capacity_main,vehicle_type_id){
      os_hk_66series: 140;
      default: 134;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_os_hk_66series_car_power_main,position_in_vehid_chain_from_end %8){
      0..1:return 180;
      4..5:return 180;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_hk_66series_power_main,vehicle_type_id){
      os_hk_66series: 0;
      sw_os_hk_66series_car_power_main;
    }
