spriteset(os_hk_66series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/66series/66series_1.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(os_hk_66series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/hankyoto/66series/66series_1.png"){ tmpl_purchase_2c_dual(0, 50) }
