//livery selector
switch(FEAT_TRAINS, SELF, sw_os_yb_type1100_lv_desc_main, cargo_subtype){
    0: string(LV_DATED, string(STR_PAINT,string(LV_TWO_TONE)),1957);
    1: string(LV_DATED, string(STR_PAINT,string(STR_BELT, string(STR_BLUE))),1975);
