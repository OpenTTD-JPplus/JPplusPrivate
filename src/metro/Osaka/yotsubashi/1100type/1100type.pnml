//lv stuff
  switch(FEAT_TRAINS, SELF, os_yb_type1100_front, cargo_subtype){
    1:os_yb_type1100_2_front;
    os_yb_type1100_1_front;
  }
  switch(FEAT_TRAINS, SELF, os_yb_type1100_end, cargo_subtype){
    1:os_yb_type1100_2_end;
    os_yb_type1100_1_end;
  }
  switch(FEAT_TRAINS, SELF, os_yb_type1100_wag, cargo_subtype){
    1:os_yb_type1100_2_wag;
    os_yb_type1100_1_wag;
  }
  switch(FEAT_TRAINS, SELF, os_yb_type1100_wag_rev, cargo_subtype){
    1:os_yb_type1100_2_wag_rev;
    os_yb_type1100_1_wag_rev;
  }
//
//specialgfx
  switch(FEAT_TRAINS, SELF, sw_os_yb_type1100_wag_1_gfx,position_in_vehid_chain %2){
    0: os_yb_type1100_wag_rev;
    os_yb_type1100_wag;
  }
  switch(FEAT_TRAINS, SELF, sw_os_yb_type1100_wag_rev_gfx,position_in_vehid_chain_from_end %2){
    0: os_yb_type1100_wag;
    os_yb_type1100_wag_rev;
  }
  switch(FEAT_TRAINS, PARENT, sw_os_yb_type1100_wag_gfx,vehicle_is_reversed){
    1: sw_os_yb_type1100_wag_1_gfx;
    sw_os_yb_type1100_wag_rev_gfx;
  }
//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_yb_type1100_head_gfx_main,position_in_consist>0){
      1: os_yb_type1100_end;
      os_yb_type1100_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_yb_type1100_lv,vehicle_type_id){
      mu_car:sw_os_yb_type1100_wag_gfx;
      sw_os_yb_type1100_head_gfx_main;
    }
