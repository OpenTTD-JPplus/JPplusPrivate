//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_tm_50series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: os_tm_50series_end;
      os_tm_50series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_tm_50series_lv,vehicle_type_id){
      mu_car:sw_os_tm_50series_wag_gfx;
      sw_os_tm_50series_head_gfx_main;
    }
