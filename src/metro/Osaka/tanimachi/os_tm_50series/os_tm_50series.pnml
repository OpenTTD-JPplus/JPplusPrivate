  switch(FEAT_TRAINS, SELF, os_tm_50series_front, cargo_subtype){
    1:os_tm_50series_2_front;
    os_tm_50series_1_front;
  }
  switch(FEAT_TRAINS, SELF, os_tm_50series_end, cargo_subtype){
    1:os_tm_50series_2_end;
    os_tm_50series_1_end;
  }
  switch(FEAT_TRAINS, SELF, os_tm_50series_wag, cargo_subtype){
    1:os_tm_50series_2_wag;
    os_tm_50series_1_wag;
  }
