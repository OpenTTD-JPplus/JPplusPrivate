//purchase
spriteset(kintetsu7000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/chuo/kintetsu7000/kintetsu7000.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(kintetsu7000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/chuo/kintetsu7000/kintetsu7000.png"){ tmpl_purchase_2c_dual(0, 50) }
