spriteset(kintetsu7000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/chuo/kintetsu7000/kintetsu7000.png"){ tmpl_std_v3(0, 0) }
spriteset(kintetsu7000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/chuo/kintetsu7000/kintetsu7000.png"){ tmpl_std_v3(0, 25) }
spriteset(kintetsu7000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/chuo/kintetsu7000/kintetsu7000.png"){ tmpl_symm_v3(0, 50) }

//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_kintetsu7000_head_gfx_main,position_in_consist>0){
      1: kintetsu7000_end;
      kintetsu7000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu7000_lv,vehicle_type_id){
      mu_car:kintetsu7000_wag;
      sw_kintetsu7000_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_kintetsu7000_capacity_main,vehicle_type_id){
      mu_car: 135;
      return 125;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_kintetsu7000_car_power_main,position_in_vehid_chain_from_end %5){
      0:return 140;
      2..3:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu7000_power_main,vehicle_type_id){
      mu_car: sw_kintetsu7000_car_power_main;
      return 0;
    }
