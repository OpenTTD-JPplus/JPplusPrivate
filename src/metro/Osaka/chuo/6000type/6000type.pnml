//specialgfx
  switch(FEAT_TRAINS, PARENT, sw_os_ch_6000type_wag_gfx,vehicle_is_reversed){
    1: os_ch_6000type_wag_rev;
    os_ch_6000type_wag;
  }
  switch(FEAT_TRAINS, SELF, sw_os_ch_6000type_front_gfx,num_vehs_in_consist){
    1: os_ch_6000type_front_s;
    os_ch_6000type_front;
