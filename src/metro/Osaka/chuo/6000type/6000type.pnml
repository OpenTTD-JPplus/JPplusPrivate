//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_ch_6000type_head_gfx_main,position_in_vehid_chain_from_end){
      0: os_ch_6000type_end;
      sw_os_ch_6000type_wag_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_os_ch_6000type_lv,vehicle_type_id){
      mu_car:sw_os_ch_6000type_head_gfx_main;
      sw_os_ch_6000type_front_gfx;
