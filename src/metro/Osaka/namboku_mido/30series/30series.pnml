spriteset(os_nm_30series_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/30series/30series.png"){ tmpl_std_v3(0, 25) }
spriteset(os_nm_30series_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/30series/30series.png"){ tmpl_symm_v3(0, 50) }
