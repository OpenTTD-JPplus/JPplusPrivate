spriteset(os_nm_30series_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/30series/30series_al.png"){ tmpl_std_v3(0, 25) }
spriteset(os_nm_30series_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/30series/30series_al.png"){ tmpl_symm_v3(0, 50) }
//lv stuff
  switch(FEAT_TRAINS, SELF, os_nm_30series_front, cargo_subtype){
    1:os_nm_30series_2_front;
    os_nm_30series_1_front;
  }
  switch(FEAT_TRAINS, SELF, os_nm_30series_end, cargo_subtype){
    1:os_nm_30series_2_end;
    os_nm_30series_1_end;
  }
  switch(FEAT_TRAINS, SELF, os_nm_30series_wag, cargo_subtype){
    1:os_nm_30series_2_wag;
    os_nm_30series_1_wag;
  }
//
//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_nm_30series_head_gfx_main,position_in_consist>0){
      1: os_nm_30series_end;
      os_nm_30series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_30series_lv,vehicle_type_id){
      mu_car:os_nm_30series_wag;
      sw_os_nm_30series_head_gfx_main;
    }
//
//livery selector desc
switch(FEAT_TRAINS, SELF, sw_os_nm_30series_lv_desc_main, cargo_subtype){
    0: string(STR_STEEL);
    1: string(STR_ALUMI);
}
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_os_nm_30series_capacity_main,vehicle_type_id){
      os_nm_30series: 91;
      default: 95;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_os_nm_30series_car_power_main,position_in_vehid_chain_from_end %8){
      0..1:return 120;
      4..5:return 120;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_30series_power_main,vehicle_type_id){
      os_nm_30series: 120*2;
      sw_os_nm_30series_car_power_main;
    }
