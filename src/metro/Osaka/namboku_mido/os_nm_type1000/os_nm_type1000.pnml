//purchase
spriteset(os_nm_type1000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_type1000/os_nm_type1000.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(os_nm_type1000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_type1000/os_nm_type1000.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(os_nm_type1000_purchase, os_nm_type1000_purchase_c1, os_nm_type1000_purchase_c2)

spriteset(os_nm_type1000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_type1000/os_nm_type1000.png"){ tmpl_std_v3(0, 0) }
spriteset(os_nm_type1000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_type1000/os_nm_type1000.png"){ tmpl_std_v3(0, 25) }
spriteset(os_nm_type1000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_type1000/os_nm_type1000.png"){ tmpl_std_v3(0, 50) }
spriteset(os_nm_type1000_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_type1000/os_nm_type1000.png"){ tmpl_std_rev_v3(0, 50) }

spriteset(os_nm_50series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_50series/os_nm_50series.png"){ tmpl_std_v3(0, 0) }
spriteset(os_nm_50series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_50series/os_nm_50series.png"){ tmpl_std_v3(0, 25) }
spriteset(os_nm_50series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_50series/os_nm_50series.png"){ tmpl_std_v3(0, 50) }
spriteset(os_nm_50series_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_50series/os_nm_50series.png"){ tmpl_std_rev_v3(0, 50) }

//specialgfx
  switch(FEAT_TRAINS, SELF, sw_os_nm_50series_wag_gfx,position_in_vehid_chain %2){
    0: os_nm_50series_wag_rev;
    os_nm_50series_wag;
  }
//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_nm_50series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: os_nm_50series_end;
      os_nm_50series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_50series_lv,vehicle_type_id){
      mu_car:sw_os_nm_50series_wag_gfx;
      sw_os_nm_50series_head_gfx_main;
    }

//specialgfx
  switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_wag_gfx,position_in_vehid_chain %2){
    0: os_nm_type1000_wag_rev;
    os_nm_type1000_wag;
  }
//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: os_nm_type1000_end;
      os_nm_type1000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_lv_1,vehicle_type_id){
      mu_car:sw_os_nm_type1000_wag_gfx;
      sw_os_nm_type1000_head_gfx_main;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_lv, build_year>1957){
      1:sw_os_nm_50series_lv;
      sw_os_nm_type1000_lv_1;
    }
//
//post fixers
  //power
    switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 90;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_power_main,vehicle_type_id){
      os_nm_type1000: 90*2;
      sw_os_nm_type1000_car_power_main;
    }
