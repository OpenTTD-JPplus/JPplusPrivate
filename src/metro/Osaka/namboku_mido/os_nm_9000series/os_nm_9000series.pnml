spriteset(os_nm_9000series_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_9000series/os_nm_9000series_1.png"){ tmpl_std_v3(0, 0) }
spriteset(os_nm_9000series_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_9000series/os_nm_9000series_1.png"){ tmpl_std_v3(0, 25) }
spriteset(os_nm_9000series_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/os_nm_9000series/os_nm_9000series_1.png"){ tmpl_symm_v3(0, 50) }

//lv stuff
  switch(FEAT_TRAINS, SELF, os_nm_9000series_front, cargo_subtype){
    1:os_nm_9000series_2_front;
    os_nm_9000series_1_front;
  }
  switch(FEAT_TRAINS, SELF, os_nm_9000series_end, cargo_subtype){
    1:os_nm_9000series_2_end;
    os_nm_9000series_1_end;
  }
  switch(FEAT_TRAINS, SELF, os_nm_9000series_wag, cargo_subtype){
    1:os_nm_9000series_2_wag;
    os_nm_9000series_1_wag;
  }
//

//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_nm_9000series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: os_nm_9000series_end;
      os_nm_9000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_9000series_lv,vehicle_type_id){
      mu_car:os_nm_9000series_wag;
      sw_os_nm_9000series_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_os_nm_9000series_capacity_main,vehicle_type_id){
      os_nm_9000series: 128;
      default: 138;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_os_nm_9000series_car_power_main,position_in_vehid_chain_from_end %8){
      3..4:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_9000series_power_main,vehicle_type_id){
      os_nm_9000series: 170*2;
      sw_os_nm_9000series_car_power_main;
    }
//
//timed-livery selector
switch(FEAT_TRAINS, SELF, sw_os_nm_9000series_lv_desc_main, cargo_subtype){
    0: string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2014);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_os_nm_9000series_2)),2014);
}