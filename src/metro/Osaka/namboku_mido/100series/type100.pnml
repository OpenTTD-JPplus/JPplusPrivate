//purchase
spriteset(os_nm_type100_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/100series/100series.png"){ tmpl_purchase_1c(0, 0) }

spriteset(os_nm_type100_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/100series/100series.png"){ tmpl_std_v3(0, 0) }
spriteset(os_nm_type100_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/100series/100series.png"){ tmpl_std_rev_v3(0, 25) }
spriteset(os_nm_type100_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/100series/100series.png"){ tmpl_std_v3(0, 50) }
spriteset(os_nm_type100_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/100series/100series.png"){ tmpl_std_rev_v3(0, 50) }
//specialgfx
  switch(FEAT_TRAINS, PARENT, sw_os_nm_type100_wag_gfx,vehicle_is_reversed){
    1: os_nm_type100_wag_rev;
    os_nm_type100_wag;
  }
//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_nm_type100_head_gfx_main,position_in_vehid_chain_from_end){
      0: os_nm_type100_end;
      sw_os_nm_type100_wag_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_type100_lv,vehicle_type_id){
      mu_car:sw_os_nm_type100_head_gfx_main;
      os_nm_type100_front;
    }
//
//post fixers
  //power
    switch(FEAT_TRAINS, SELF, sw_os_nm_type100_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 85;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_type100_power_main,vehicle_type_id){
      os_nm_type100: 85;
      sw_os_nm_type100_car_power_main;
    }
