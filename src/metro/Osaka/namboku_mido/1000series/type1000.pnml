//purchase
spriteset(os_nm_type1000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/1000series/1000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(os_nm_type1000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/1000series/1000series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(os_nm_type1000_purchase, os_nm_type1000_purchase_c1, os_nm_type1000_purchase_c2)

spriteset(os_nm_type1000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/1000series/1000series.png"){ tmpl_std_v3(0, 0) }
spriteset(os_nm_type1000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/1000series/1000series.png"){ tmpl_std_v3(0, 25) }
spriteset(os_nm_type1000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/1000series/1000series.png"){ tmpl_std_v3(0, 50) }
spriteset(os_nm_type1000_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/1000series/1000series.png"){ tmpl_std_rev_v3(0, 50) }

//specialgfx
  switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_wag_1_gfx,position_in_vehid_chain %2){
    0: os_nm_type1000_wag_rev;
    os_nm_type1000_wag;
  }
  switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_wag_rev_gfx,position_in_vehid_chain_from_end %2){
    0: os_nm_type1000_wag;
    os_nm_type1000_wag_rev;
  }
  switch(FEAT_TRAINS, PARENT, sw_os_nm_type1000_wag_gfx,vehicle_is_reversed){
    1: sw_os_nm_type1000_wag_1_gfx;
    sw_os_nm_type1000_wag_rev_gfx;
  }
//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_head_gfx_main,position_in_consist>0){
      1: os_nm_type1000_end;
      os_nm_type1000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_lv_1,vehicle_type_id){
      mu_car:sw_os_nm_type1000_wag_gfx;
      sw_os_nm_type1000_head_gfx_main;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_lv, build_year>1957){
      1:sw_os_nm_50series_lv;
      sw_os_nm_type1000_lv_1;
    }
//
//post fixers
  //power
    switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 90;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_type1000_power_main,vehicle_type_id){
      os_nm_type1000: 90*2;
      sw_os_nm_type1000_car_power_main;
    }
//