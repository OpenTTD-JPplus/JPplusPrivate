spriteset(os_nm_type500_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/500series/type500.png"){ tmpl_std_v3(0, 0) }
spriteset(os_nm_type500_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/500series/type500.png"){ tmpl_std_rev_v3(0, 25) }
spriteset(os_nm_type500_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/500series/type500.png"){ tmpl_std_v3(0, 50) }
spriteset(os_nm_type500_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/500series/type500.png"){ tmpl_std_rev_v3(0, 50) }


//specialgfx
  switch(FEAT_TRAINS, PARENT, sw_os_nm_type500_wag_gfx,vehicle_is_reversed){
    1: os_nm_type500_wag_rev;
    os_nm_type500_wag;
  }
//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_nm_type500_head_gfx_main,position_in_vehid_chain_from_end){
      0: os_nm_type500_end;
      sw_os_nm_type500_wag_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_type500_lv,vehicle_type_id){
      mu_car:sw_os_nm_type500_head_gfx_main;
      os_nm_type500_front;
    }
//
//post fixers
  //power
    switch(FEAT_TRAINS, SELF, sw_os_nm_type500_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 85;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_nm_type500_power_main,vehicle_type_id){
      os_nm_type500: 85;
      sw_os_nm_type500_car_power_main;
    }
