spriteset(os_nm_type500_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/500series/type500.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(os_nm_type500_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Osaka/namboku_mido/500series/type500.png"){ tmpl_purchase_2c_dual(0, 50) }
