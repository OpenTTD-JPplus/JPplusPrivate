    name: string(STR_TRAIN_NAME, string(STR_NAME_OSAKA_METRO), "100~400", string(STR_NAME_TYPE));
    introduction_date: date(1933, 5, 20);
    model_life: 42;
    vehicle_life: 37;
    dual_headed: 0;
    
    cost_factor: 17;
    running_cost_factor: 47;
    speed: 65 km/h;
    track_type:TR_1435_METRO
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 40 ton;
    badges: ["company/osaka_metro", "line/osaka_midosuji"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 750)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 2,4)),
    
    string(STR_OPERATOR, string(STR_OSAKA_METRO))
    ,string(STR_LINES_USED, string(STR_OSAKA_MIDO_YOTSU))
    );
    
    purchase: os_nm_type100_purchase;
    cargo_capacity:80*param_capacity_mod/3;
    
    loading_speed:param_loading_3D;
    default:sw_os_nm_type100_lv;
    power:sw_os_nm_type100_power_main()*4*1342/1000;
    purchase_power: sw_os_nm_type100_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
