    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_osaka == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_OSAKA_METRO), "30", string(STR_NAME_SERIES));
    introduction_date: date(1970, 3, 24);
    model_life: 48;
    vehicle_life: 43;
    dual_headed: 1;
    variant_group: os_nm_30series;
    cost_factor: 18;
    running_cost_factor: 48;
    speed: 75 km/h;
    track_type:TR_1435_METRO
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 30 ton;
    badges: ["company/osaka_metro", "line/osaka_chuo"];
    
  }
	graphics {
    
    
    
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 750)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 4,6)),
    
    string(STR_OPERATOR, string(STR_OSAKA_METRO))
    ,string(STR_LINES_USED, string(STR_OSAKA_CHUO))
    );
    cargo_subtype_text: sw_os_ch_30series_lv_desc_main;
    purchase: os_ch_30series_purchase;
    cargo_capacity:sw_os_nm_30series_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_os_nm_30series_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_4D;
    default:sw_os_ch_30series_lv;
    power:sw_os_nm_30series_power_main()*4*1342/1000;
    purchase_power: sw_os_nm_30series_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_os_ch_30series_lv_desc_main;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_os_nm_30series_capacity_main()*param_capacity_mod/3;
    power:sw_os_nm_30series_power_main()*4*1342/1000;
    default:sw_os_ch_30series_lv;
    weight: 32;
    
  }
}
