//lv stuff
  switch(FEAT_TRAINS, SELF, os_ts_70series_front_timed, current_year){
    0..1995: os_ts_70series_1_front;
    1996..2010: os_ts_70series_2_front;
    os_ts_70series_3_front;
  }
  switch(FEAT_TRAINS, SELF, os_ts_70series_end_timed, current_year){
    0..1995: os_ts_70series_1_end;
    1996..2010: os_ts_70series_2_end;
    os_ts_70series_3_end;
  }
  switch(FEAT_TRAINS, SELF, os_ts_70series_mot_timed, current_year){
    0..1995: os_ts_70series_1_mot;
    1996..2010: os_ts_70series_2_mot;
    os_ts_70series_3_mot;
  }
  switch(FEAT_TRAINS, SELF, os_ts_70series_wag_timed, current_year){
    0..1995: os_ts_70series_1_wag;
    1996..2010: os_ts_70series_2_wag;
    os_ts_70series_3_wag;
  }

  switch(FEAT_TRAINS, SELF, os_ts_70series_front, cargo_subtype){
    1: os_ts_70series_1_front;
    2: os_ts_70series_2_front;
    3: os_ts_70series_3_front;
    os_ts_70series_front_timed;
  }
  switch(FEAT_TRAINS, SELF, os_ts_70series_end, cargo_subtype){
    1: os_ts_70series_1_end;
    2: os_ts_70series_2_end;
    3: os_ts_70series_3_end;
    os_ts_70series_end_timed;
  }
  switch(FEAT_TRAINS, SELF, os_ts_70series_mot, cargo_subtype){
    1: os_ts_70series_1_mot;
    2: os_ts_70series_2_mot;
    3: os_ts_70series_3_mot;
    os_ts_70series_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, os_ts_70series_wag, cargo_subtype){
    1: os_ts_70series_1_wag;
    2: os_ts_70series_2_wag;
    3: os_ts_70series_3_wag;
    os_ts_70series_wag_timed;
  }

//*main
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_os_ts_70series_panto_placer,position_in_vehid_chain %3){
      1: os_ts_70series_mot;
      os_ts_70series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_os_ts_70series_panto_placer_rev,position_in_vehid_chain_from_end %3){
      1: os_ts_70series_mot;
      os_ts_70series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_os_ts_70series_panto_placer_main_1,vehicle_is_reversed){
      1: sw_os_ts_70series_panto_placer;
      sw_os_ts_70series_panto_placer_rev;
    }
    switch(FEAT_TRAINS, PARENT, sw_os_ts_70series_panto_placer_main,num_vehs_in_vehid_chain){
      0..4: os_ts_70series_wag;
      sw_os_ts_70series_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_ts_70series_head_gfx_main,position_in_consist>0){
      1: os_ts_70series_end;
      os_ts_70series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_ts_70series_lv,vehicle_type_id){
      mu_car:sw_os_ts_70series_panto_placer_main;
      sw_os_ts_70series_head_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_os_ts_70series_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_BATCH,1),1990);
    2: string(LV_DATED,string(STR_LIVERY,string(LV_os_ts_70series_2)),1996);
    3: string(LV_DATED,string(STR_LIVERY,string(STR_RENEWAL)),2011);
}
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_os_ts_70series_capacity_main,vehicle_type_id){
      os_ts_70series: 89;
      default: 101;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_os_ts_70series_car_power_main,position_in_vehid_chain_from_end %4){
      0..1:return 50;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_os_ts_70series_power_main,vehicle_type_id){
      mu_car:sw_os_ts_70series_car_power_main;
      100;
    }
