//main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_os_sn_type1200_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: os_sn_type1200_end;
      os_sn_type1200_front;
    }
    switch(FEAT_TRAINS, SELF, sw_os_sn_type1200_lv,vehicle_type_id){
      mu_car:sw_os_sn_type1200_wag_gfx;
      sw_os_sn_type1200_head_gfx_main;
