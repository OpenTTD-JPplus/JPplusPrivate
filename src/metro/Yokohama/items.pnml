item(FEAT_TRAINS, yk_bl_1000series) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_yokohama == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_YOKOHAMA), "1000/2000", string(STR_NAME_TYPE));
    introduction_date: date(1972, 12, 16);
    model_life: 39;
    vehicle_life: 34;
    dual_headed: 1;
    
    
    cost_factor: 18;
    running_cost_factor: 50;
    speed: 90 km/h;
    track_type: TR_1435_M;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 27 ton;
    
  }
	graphics {
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 750)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_3, 3,5,6)),
    
    string(STR_OPERATOR, string(STR_YOKOHAMA))
    ,string(STR_LINES_USED, string(STR_YOKOHAMA_BLUE))
    );
    cargo_subtype_text: sw_yk_bl_1000series_lv_desc_main;
    purchase: yk_bl_1000series_purchase;
    cargo_capacity:sw_yk_bl_1000series_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_4D;
    default:sw_yk_bl_1000series_lv;
    power: sw_yk_bl_1000series_power_main()*4*1342/1000;
    purchase_power: sw_yk_bl_1000series_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_yk_bl_1000series_lv_desc_main;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_yk_bl_1000series_capacity_main()*param_capacity_mod/3;
    
    power: sw_yk_bl_1000series_power_main()*4*1342/1000;
    default:sw_yk_bl_1000series_lv;
    weight: 33;
    
  }
}
