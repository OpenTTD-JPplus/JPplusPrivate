//purchase
spriteset(yk_gl_10000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(yk_gl_10000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_4(yk_gl_10000series_purchase, logo_yokohama_subway, logo_line_yk_green, yk_gl_10000series_purchase_c1, yk_gl_10000series_purchase_c2)

spriteset(yk_gl_10000series_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series.png"){ tmpl_std_v3(0, 0) }
spriteset(yk_gl_10000series_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series.png"){ tmpl_std_v3(0, 25) }
spriteset(yk_gl_10000series_1_wag_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series.png"){ tmpl_std_v3(0, 75) }
spriteset(yk_gl_10000series_1_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series.png"){ tmpl_std_rev_v3(0, 75) }
spriteset(yk_gl_10000series_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series.png"){ tmpl_std_v3(0, 50) }
spriteset(yk_gl_10000series_1_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series.png"){ tmpl_std_rev_v3(0, 50) }

spriteset(yk_gl_10000series_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series_3.png"){ tmpl_std_v3(0, 0) }
spriteset(yk_gl_10000series_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series_3.png"){ tmpl_std_v3(0, 25) }
spriteset(yk_gl_10000series_2_wag_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series_3.png"){ tmpl_std_v3(0, 75) }
spriteset(yk_gl_10000series_2_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series_3.png"){ tmpl_std_rev_v3(0, 75) }
spriteset(yk_gl_10000series_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series_3.png"){ tmpl_std_v3(0, 50) }
spriteset(yk_gl_10000series_2_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/GreenLine/10000series/10000series_3.png"){ tmpl_std_rev_v3(0, 50) }
//lv
  switch(FEAT_TRAINS, SELF, yk_gl_10000series_front, cargo_subtype){
    1:yk_gl_10000series_2_front;
    yk_gl_10000series_1_front;
  }
  switch(FEAT_TRAINS, SELF, yk_gl_10000series_end, cargo_subtype){
    1:yk_gl_10000series_2_end;
    yk_gl_10000series_1_end;
  }
  switch(FEAT_TRAINS, SELF, yk_gl_10000series_wag_def, cargo_subtype){
    1:yk_gl_10000series_2_wag_def;
    yk_gl_10000series_1_wag_def;
  }
  switch(FEAT_TRAINS, SELF, yk_gl_10000series_wag_rev, cargo_subtype){
    1:yk_gl_10000series_2_wag_rev;
    yk_gl_10000series_1_wag_rev;
  }
  switch(FEAT_TRAINS, SELF, yk_gl_10000series_mot, cargo_subtype){
    1:yk_gl_10000series_2_mot;
    yk_gl_10000series_1_mot;
  }
  switch(FEAT_TRAINS, SELF, yk_gl_10000series_mot_rev, cargo_subtype){
    1:yk_gl_10000series_2_mot_rev;
    yk_gl_10000series_1_mot_rev;
  }
//
//*main
  //special gfx
    switch(FEAT_TRAINS, SELF, yk_gl_10000series_wag_1, position_in_vehid_chain %2){
      1:yk_gl_10000series_wag_def;
      yk_gl_10000series_wag_rev;
    }
    switch(FEAT_TRAINS, SELF, yk_gl_10000series_wag_2, position_in_vehid_chain_from_end %2){
      1:yk_gl_10000series_wag_rev;
      yk_gl_10000series_wag_def;
    }
    switch(FEAT_TRAINS, PARENT, yk_gl_10000series_wag, vehicle_is_reversed){
      1:yk_gl_10000series_wag_2;
      yk_gl_10000series_wag_1;
    }

  //panto placer
    switch(FEAT_TRAINS, SELF, sw_yk_gl_10000series_panto_placer_1,position_in_vehid_chain %3){
        1: yk_gl_10000series_mot;
        yk_gl_10000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_yk_gl_10000series_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
        1: yk_gl_10000series_mot_rev;
        yk_gl_10000series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_yk_gl_10000series_panto_placer_main_1,vehicle_is_reversed){
        1: sw_yk_gl_10000series_panto_placer_1_rev;
        sw_yk_gl_10000series_panto_placer_1;
    }
    switch(FEAT_TRAINS, SELF, sw_yk_gl_10000series_panto_placer_main,num_vehs_in_vehid_chain){
        0..3: yk_gl_10000series_wag;
        sw_yk_gl_10000series_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_yk_gl_10000series_head_gfx_main,position_in_consist>0){
      1: yk_gl_10000series_end;
      yk_gl_10000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_yk_gl_10000series_lv,vehicle_type_id){
      mu_car:sw_yk_gl_10000series_panto_placer_main;
      sw_yk_gl_10000series_head_gfx_main;
    }
//
//lv desc stuff
switch(FEAT_TRAINS, SELF, sw_yk_gl_10000series_lv_desc_main, cargo_subtype){
    0: string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2007);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_yk_gl_10000series_2)),2009);
}
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_yk_gl_10000series_capacity_main,vehicle_type_id){
      yk_gl_10000series: 88;
      default: 102;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_yk_gl_10000series_car_power_main,position_in_vehid_chain_from_end %5){
      0..1:return 67;
      3:return 68;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_yk_gl_10000series_power_main,vehicle_type_id){
      yk_gl_10000series: 135;
      sw_yk_gl_10000series_car_power_main;
    }
//