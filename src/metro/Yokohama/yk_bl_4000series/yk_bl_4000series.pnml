//purchase
spriteset(yk_bl_4000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/yk_bl_4000series/yk_bl_4000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(yk_bl_4000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/yk_bl_4000series/yk_bl_4000series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_2(yk_bl_4000series_purchase, yk_bl_4000series_purchase_c1, yk_bl_4000series_purchase_c2)

spriteset(yk_bl_4000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/yk_bl_4000series/yk_bl_4000series.png"){ tmpl_std_v3(0, 0) }
spriteset(yk_bl_4000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/yk_bl_4000series/yk_bl_4000series.png"){ tmpl_std_v3(0, 25) }
spriteset(yk_bl_4000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/yk_bl_4000series/yk_bl_4000series.png"){ tmpl_symm_v3(0, 50) }

//*main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_yk_bl_4000series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: yk_bl_4000series_end;
      yk_bl_4000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_yk_bl_4000series_lv,vehicle_type_id){
      mu_car:yk_bl_4000series_wag;
      sw_yk_bl_4000series_head_gfx_main;
    }
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_yk_bl_4000series_capacity_main,vehicle_type_id){
      mu_car: 133;
      122;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_yk_bl_4000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_yk_bl_4000series_power_main,vehicle_type_id){
      mu_car:sw_yk_bl_4000series_car_power_main;
      0;
    }
