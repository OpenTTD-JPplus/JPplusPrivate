//lv stuff
  switch(FEAT_TRAINS, SELF, yk_bl_3000series_front_timed, build_year){
    0..1998:yk_bl_3000series_1_front;
    1999..2003:yk_bl_3000series_2_front;
    2004..2005:yk_bl_3000series_3_front;
    2006..2016:yk_bl_3000series_4_front;
    yk_bl_3000series_5_front;
  }
  switch(FEAT_TRAINS, SELF, yk_bl_3000series_end_timed, build_year){
    0..1998:yk_bl_3000series_1_end;
    1999..2003:yk_bl_3000series_2_end;
    2004..2005:yk_bl_3000series_3_end;
    2006..2016:yk_bl_3000series_4_end;
    yk_bl_3000series_5_end;
  }
  switch(FEAT_TRAINS, SELF, yk_bl_3000series_wag_timed, build_year){
    0..1998:yk_bl_3000series_1_wag;
    1999..2003:yk_bl_3000series_2_wag;
    2004..2005:yk_bl_3000series_3_wag;
    2006..2016:yk_bl_3000series_4_wag;
    yk_bl_3000series_5_wag;
  }

  switch(FEAT_TRAINS, SELF, yk_bl_3000series_front, cargo_subtype){
    1: yk_bl_3000series_1_front;
    2: yk_bl_3000series_2_front;
    3: yk_bl_3000series_3_front;
    4: yk_bl_3000series_4_front;
    5: yk_bl_3000series_5_front;
    yk_bl_3000series_front_timed;
  }
  switch(FEAT_TRAINS, SELF, yk_bl_3000series_end, cargo_subtype){
    1: yk_bl_3000series_1_end;
    2: yk_bl_3000series_2_end;
    3: yk_bl_3000series_3_end;
    4: yk_bl_3000series_4_end;
    5: yk_bl_3000series_5_end;
    yk_bl_3000series_end_timed;
  }
  switch(FEAT_TRAINS, SELF, yk_bl_3000series_wag, cargo_subtype){
    1: yk_bl_3000series_1_wag;
    2: yk_bl_3000series_2_wag;
    3: yk_bl_3000series_3_wag;
    4: yk_bl_3000series_4_wag;
    5: yk_bl_3000series_5_wag;
    yk_bl_3000series_wag_timed;
  }

//*main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_yk_bl_3000series_head_gfx_main,position_in_consist>0){
      1: yk_bl_3000series_end;
      yk_bl_3000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_yk_bl_3000series_lv,vehicle_type_id){
      mu_car:yk_bl_3000series_wag;
      sw_yk_bl_3000series_head_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_yk_bl_3000series_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_TRAIN_NAME_SHORT,"3000A",string(STR_NAME_TYPE)),1992);
    2: string(LV_DATED,string(STR_TRAIN_NAME_SHORT,"3000N",string(STR_NAME_TYPE)),1999);
    3: string(LV_DATED,string(STR_TRAIN_NAME_SHORT,"3000R",string(STR_NAME_TYPE)),2004);
    4: string(LV_DATED,string(STR_TRAIN_NAME_SHORT,"3000S",string(STR_NAME_TYPE)),2006);
    5: string(LV_DATED,string(STR_TRAIN_NAME_SHORT,"3000V",string(STR_NAME_TYPE)),2017);
}
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_yk_bl_3000series_capacity_main,vehicle_type_id){
      mu_car: 133;
      122;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_yk_bl_3000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_yk_bl_3000series_power_main,vehicle_type_id){
      mu_car:sw_yk_bl_3000series_car_power_main;
      0;
    }
