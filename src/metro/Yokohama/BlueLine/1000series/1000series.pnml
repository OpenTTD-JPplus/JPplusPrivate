//purchase
spriteset(yk_bl_1000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/BlueLine/1000series/1000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(yk_bl_1000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/BlueLine/1000series/1000series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_4(yk_bl_1000series_purchase, logo_yokohama_subway, logo_line_yk_blue, yk_bl_1000series_purchase_c1, yk_bl_1000series_purchase_c2)

spriteset(yk_bl_1000series_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/BlueLine/1000series/1000series.png"){ tmpl_std_v3(0, 0) }
spriteset(yk_bl_1000series_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/BlueLine/1000series/1000series.png"){ tmpl_std_v3(0, 25) }
spriteset(yk_bl_1000series_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/BlueLine/1000series/1000series.png"){ tmpl_symm_v3(0, 50) }

spriteset(yk_bl_2000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/BlueLine/1000series/2000series.png"){ tmpl_std_v3(0, 0) }
spriteset(yk_bl_2000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/BlueLine/1000series/2000series.png"){ tmpl_std_v3(0, 25) }
spriteset(yk_bl_2000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Yokohama/BlueLine/1000series/2000series.png"){ tmpl_symm_v3(0, 50) }

//lv stuff
  switch(FEAT_TRAINS, SELF, yk_bl_1000series_front, cargo_subtype==2||(cargo_subtype==0&&build_year>1982)){
    1:yk_bl_2000series_front;
    yk_bl_1000series_1_front;
  }
  switch(FEAT_TRAINS, SELF, yk_bl_1000series_end, cargo_subtype==2||(cargo_subtype==0&&build_year>1982)){
    1:yk_bl_2000series_end;
    yk_bl_1000series_1_end;
  }
  switch(FEAT_TRAINS, SELF, yk_bl_1000series_wag, cargo_subtype==2||(cargo_subtype==0&&build_year>1982)){
    1:yk_bl_2000series_wag;
    yk_bl_1000series_1_wag;
  }
//
//*main
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_yk_bl_1000series_head_gfx_main,position_in_consist>0){
      1: yk_bl_1000series_end;
      yk_bl_1000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_yk_bl_1000series_lv,vehicle_type_id){
      mu_car:yk_bl_1000series_wag;
      sw_yk_bl_1000series_head_gfx_main;
    }
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_yk_bl_1000series_capacity_main,vehicle_type_id){
      mu_car: 140;
      150;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_yk_bl_1000series_car_power_main,position_in_vehid_chain_from_end %5){
      0..1:return 120;
      3:return 120;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_yk_bl_1000series_power_main,vehicle_type_id){
      mu_car:sw_yk_bl_1000series_car_power_main;
      120;
    }
//

//timed-livery selector
switch(FEAT_TRAINS, SELF, sw_yk_bl_1000series_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_TRAIN_NAME_SHORT,"1000",string(STR_NAME_SERIES)),1972);
    2: string(LV_DATED,string(STR_TRAIN_NAME_SHORT,"2000",string(STR_NAME_SERIES)),1983);
}