//*main
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_fk_nk_3000series_panto_placer_1,position_in_vehid_chain %3){
        1: fk_nk_3000series_mot;
        fk_nk_3000series_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_fk_nk_3000series_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
        1: fk_nk_3000series_mot;
        fk_nk_3000series_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_fk_nk_3000series_panto_placer_main_1,vehicle_is_reversed){
        1: sw_fk_nk_3000series_panto_placer_1_rev;
        sw_fk_nk_3000series_panto_placer_1;
    }
    switch(FEAT_TRAINS, SELF, sw_fk_nk_3000series_panto_placer_main,num_vehs_in_vehid_chain){
        0..3: fk_nk_3000series_wag;
        sw_fk_nk_3000series_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_fk_nk_3000series_head_gfx_main,position_in_consist>0){
      1: fk_nk_3000series_end;
      fk_nk_3000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_fk_nk_3000series_lv,vehicle_type_id){
      mu_car:sw_fk_nk_3000series_panto_placer_main;
      sw_fk_nk_3000series_head_gfx_main;
    }
//
//lv desc stuff
switch(FEAT_TRAINS, SELF, sw_fk_nk_3000series_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_TRAIN_NAME_SHORT,"3000",string(STR_NAME_SERIES)),2004);
    2: string(LV_DATED,string(STR_TRAIN_NAME_SHORT,"3000A",string(STR_NAME_SERIES)),2021);
}
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_fk_nk_3000series_capacity_main,vehicle_type_id){
      fk_nk_3000series: 89;
      default: 100;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_fk_nk_3000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 75;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_fk_nk_3000series_power_main,vehicle_type_id){
      fk_nk_3000series: 75*2;
      sw_fk_nk_3000series_car_power_main;
    }
