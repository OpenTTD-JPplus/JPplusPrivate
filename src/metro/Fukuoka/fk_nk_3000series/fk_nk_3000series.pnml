  switch(FEAT_TRAINS, SELF, fk_nk_3000series_front, cargo_subtype==2||(cargo_subtype==0&&current_year>2020)){
    1:fk_nk_3000series_2_front;
    fk_nk_3000series_1_front;
  }
  switch(FEAT_TRAINS, SELF, fk_nk_3000series_end, cargo_subtype==2||(cargo_subtype==0&&current_year>2020)){
    1:fk_nk_3000series_2_end;
    fk_nk_3000series_1_end;
