  spriteset(fk_nk_3000series_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series_1.png"){ tmpl_symm_v3(0, 50) }
