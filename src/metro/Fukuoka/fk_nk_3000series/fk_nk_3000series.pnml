spriteset(fk_nk_3000series_purchase_c2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series.png"){ tmpl_purchase_2c_dual(0, 75) }
