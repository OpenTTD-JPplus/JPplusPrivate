//livery 1
  spriteset(fk_nk_3000series_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series.png"){ tmpl_std_v3(0, 0) }
  spriteset(fk_nk_3000series_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series.png"){ tmpl_std_v3(0, 25) }
  spriteset(fk_nk_3000series_1_wag_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series.png"){ tmpl_std_v3(0, 75) }
  spriteset(fk_nk_3000series_1_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series.png"){ tmpl_std_rev_v3(0, 75) }
  switch(FEAT_TRAINS, PARENT, fk_nk_3000series_1_wag,vehicle_is_reversed ){
    1:fk_nk_3000series_1_wag_rev;fk_nk_3000series_1_wag_def;}
  spriteset(fk_nk_3000series_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series.png"){ tmpl_symm_v3(0, 50) }
//3000A
  spriteset(fk_nk_3000series_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(fk_nk_3000series_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(fk_nk_3000series_2_wag_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series_1.png"){ tmpl_std_v3(0, 75) }
  spriteset(fk_nk_3000series_2_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/fk_nk_3000series/fk_nk_3000series_1.png"){ tmpl_std_rev_v3(0, 75) }
