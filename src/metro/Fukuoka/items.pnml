item(FEAT_TRAINS, fk_kk_1000series) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_fukuoka == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_FUKUOKA), "1000", string(STR_NAME_SERIES));
    introduction_date: date(1981, 7, 26);
    model_life: 51;
    vehicle_life: 46;
    dual_headed: 1;
    
    
    cost_factor: 19;
    running_cost_factor: 49;
    speed: 90 km/h;
    track_type: TR_1067_DC;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 38 ton;
    
  }
	graphics {
    
    
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 6)),
    
    string(STR_OPERATOR, string(STR_FUKUOKA))
    ,string(STR_LINES_USED, string(STR_FUKUOKA_KUKO))
    );
    
    purchase: gfx_fk_kk_1000series_purchase_main;
    cargo_capacity:sw_fk_kk_1000series_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_3D;
    default:sw_fk_kk_1000series_lv;
    power: sw_fk_kk_1000series_power_main()*4*1342/1000;
    purchase_power: sw_fk_kk_1000series_car_power_main()*4*1342/1000;
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_3D;
    cargo_capacity:sw_fk_kk_1000series_capacity_main()*param_capacity_mod/3;
    
    power: sw_fk_kk_1000series_power_main()*4*1342/1000;
    default:sw_fk_kk_1000series_lv;
    weight: 37;
    
  }
}
