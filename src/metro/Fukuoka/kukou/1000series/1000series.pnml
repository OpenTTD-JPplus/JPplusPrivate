//livery 1
spriteset(fk_kk_1000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "gfx/metro/Fukuoka/kukou/1000series/1000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(fk_kk_1000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/kukou/1000series/1000series.png"){ tmpl_purchase_2c_dual(0, 50) }
GRAPHIC_STACK_4(gfx_fk_kk_1000series_purchase_main, logo_fukuoka_subway, logo_line_fk_kukou, fk_kk_1000series_purchase_c1, fk_kk_1000series_purchase_c2)

spriteset(fk_kk_1000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/kukou/1000series/1000series.png"){ tmpl_std(0, 0) }
spriteset(fk_kk_1000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/kukou/1000series/1000series.png"){ tmpl_std_rev(0, 25) }
spriteset(fk_kk_1000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/kukou/1000series/1000series.png"){ tmpl_symm(0, 75) }
spriteset(fk_kk_1000series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/metro/Fukuoka/kukou/1000series/1000series.png"){ tmpl_symm(0, 50) }

//livery 1
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_panto_placer_1,position_in_vehid_chain %2){
          0: fk_kk_1000series_mot;
          fk_kk_1000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_panto_placer_1_rev,position_in_vehid_chain_from_end %2){
        0: fk_kk_1000series_mot;
        fk_kk_1000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_fk_kk_1000series_panto_placer_main_1,vehicle_is_reversed){
          1: sw_fk_kk_1000series_panto_placer_1;
          sw_fk_kk_1000series_panto_placer_1_rev;
      }
    //
      switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_panto_placer_2,position_in_vehid_chain %5){
          0: fk_kk_1000series_mot;
          2: fk_kk_1000series_mot;
          fk_kk_1000series_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_panto_placer_2_rev,position_in_vehid_chain_from_end %5){
          0: fk_kk_1000series_mot;
          2: fk_kk_1000series_mot;
          fk_kk_1000series_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_fk_kk_1000series_panto_placer_main_2,vehicle_is_reversed){
          1: sw_fk_kk_1000series_panto_placer_2_rev;
          sw_fk_kk_1000series_panto_placer_2;
      }
    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_panto_placer_main,num_vehs_in_vehid_chain){
        0..4: sw_fk_kk_1000series_panto_placer_main_2;
        sw_fk_kk_1000series_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_head_gfx_main,position_in_consist>0){
      1: fk_kk_1000series_end;
      fk_kk_1000series_front;
    }
    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_lv,vehicle_type_id){
      mu_car:sw_fk_kk_1000series_panto_placer_main;
      sw_fk_kk_1000series_head_gfx_main;
    }
//
//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_capacity_main,vehicle_type_id){
      fk_kk_1000series: 135;
      default: 146;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 75;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_fk_kk_1000series_power_main,vehicle_type_id){
      fk_kk_1000series: 0;
      sw_fk_kk_1000series_car_power_main;
    }
//