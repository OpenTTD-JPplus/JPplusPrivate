item (FEAT_BADGES, company) {
    property {
        label: "company";
        name: string(STR_COMPANY);
    }
}
item (FEAT_BADGES, line) {
    property {
        label: "line";
        name: string(STR_LINE);
        flags: bitmask(BADGE_FLAG_NAME_LIST_STOP,BADGE_FLAG_NAME_LIST_FIRST_ONLY);
    }
}

