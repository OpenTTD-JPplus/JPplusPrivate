#include "kotoden1200/kotoden1200.pnml"

item(FEAT_TRAINS, kotoden1200) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_semiPrivate == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_KOTODEN), "1200/1250", string(STR_NAME_TYPE));
    introduction_date: date(2003, 3, 1);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;
    
    cost_factor: 18;
    running_cost_factor: 48;
    speed: 100 km/h;
    track_type:TR_1435_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 35 ton;
    badges: ["company/kotoden"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 2)),
    string(STR_USAGE, string(STR_COMMUTER)),
    string(STR_OPERATOR, string(STR_KOTODEN))
    
    );
    cargo_subtype_text: sw_kotoden1200_lv_desc_main;
    purchase: kotoden1200_purchase;
    cargo_capacity:139*param_capacity_mod/3;
    purchase_cargo_capacity:139*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_kotoden1200_lv;
    power:150*4*1342/1000;
    
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_kotoden1200_lv_desc_main;
    loading_speed:param_loading_4D;
    cargo_capacity:139*param_capacity_mod/3;
    power:150*4*1342/1000;
    default:sw_kotoden1200_lv;
    weight: 35;
    
  }
}
