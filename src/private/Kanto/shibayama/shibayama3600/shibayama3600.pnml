//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_shibayama3600_panto_placer_main_1,position_in_vehid_chain_from_end %2){
        0: shibayama3600_mot_2;
        shibayama3600_wag;
      }
    //var 3
      switch(FEAT_TRAINS, SELF, sw_shibayama3600_panto_placer_main_2,position_in_vehid_chain_from_end %6){
        0: shibayama3600_mot_2;
        2: shibayama3600_mot;
        4: shibayama3600_mot_2;
        default: shibayama3600_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_shibayama3600_panto_placer_main_3,position_in_vehid_chain_from_end){
        0: shibayama3600_head_f_mot;
        1: shibayama3600_head_f;
        default: sw_shibayama3600_panto_placer_main_1;
      }
      switch(FEAT_TRAINS, SELF, sw_shibayama3600_panto_placer_main,num_vehs_in_vehid_chain){
        2:sw_shibayama3600_panto_placer_main_3;
        3..4:sw_shibayama3600_panto_placer_main_1;
        sw_shibayama3600_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, shibayama3600_head_m, vehicle_is_flipped){
      1:shibayama3600_head;
      shibayama3600_head_mot;
    }
    TRAIN_CONSTRUCTOR_2(shibayama3600_head_gfx, shibayama3600_head_m, sw_keisei3600_lights)
    switch(FEAT_TRAINS, SELF, sw_shibayama3600_lv,vehicle_type_id){
        mu_car: sw_shibayama3600_panto_placer_main;
        shibayama3600_head_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_shibayama3600_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2002);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_MODERN)),2016);
    }