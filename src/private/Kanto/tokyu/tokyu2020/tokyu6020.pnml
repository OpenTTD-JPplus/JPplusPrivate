  spriteset(tokyu6020_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/tokyu/tokyu2020/tokyu6020.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tokyu6020_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/tokyu/tokyu2020/tokyu6020.png"){ tmpl_purchase_2c_dual(0, 0) }
  GRAPHIC_STACK_4(tokyu6020_purchase,  tokyu6020_purchase_c1, ac_long_toshiba_c1, tokyu6020_purchase_c2, ac_long_toshiba_c2)
//base
  spriteset(tokyu6020_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu2020/tokyu6020.png"){ tmpl_std_v3(0, 0) }
  spriteset(tokyu6020_1_wag_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu2020/tokyu6020.png"){ tmpl_symm_v3(0, 25) }
  spriteset(tokyu6020_1_wag_qcar_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu2020/tokyu6020.png"){ tmpl_symm_v3(0, 50) }
