//tokyu6020
  TRAIN_CONSTRUCTOR_3(gfx_tokyu6020_1_head, tokyu6020_1_head_base, sw_tokyu2020_lights, ac_long_toshiba)

  TRAIN_CONSTRUCTOR_2(gfx_tokyu6020_1_wag, tokyu6020_1_wag_base, ac_long_toshiba)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu6020_1_mot, tokyu6020_1_wag_base, ac_long_toshiba,panto_arm_n_single_rev)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu6020_1_mot_2, tokyu6020_1_wag_base, ac_long_toshiba,panto_arm_n)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu6020_1_mot_2_qcar, tokyu6020_1_wag_qcar_base, ac_long_toshiba,panto_arm_n)
  TRAIN_CONSTRUCTOR_2(gfx_tokyu6020_1_wag_qcar, tokyu6020_1_wag_qcar_base, ac_long_toshiba)
//*6020
//lv handler
  switch(FEAT_TRAINS, SELF, sw_tokyu6020_mot_2_gfx,(cargo_subtype==1&&position_in_vehid_chain==1)){
    1:gfx_tokyu6020_1_mot_2_qcar;
    gfx_tokyu6020_1_mot_2;
  }
  switch(FEAT_TRAINS, SELF, sw_tokyu6020_wag_gfx,(cargo_subtype==1&&position_in_vehid_chain==1)){
    1:gfx_tokyu6020_1_wag_qcar;
    gfx_tokyu6020_1_wag;
  }
//
//main
  //panto placer
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tokyu6020_panto_placer_main_1,position_in_vehid_chain_from_end %9){
        0: sw_tokyu6020_mot_2_gfx;
        3: gfx_tokyu6020_1_mot;
        6: sw_tokyu6020_mot_2_gfx;
        sw_tokyu6020_wag_gfx;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_tokyu6020_panto_placer_main_2,position_in_vehid_chain_from_end %3){
          0: sw_tokyu6020_mot_2_gfx;
          sw_tokyu6020_wag_gfx;
      }
    //var 3. For short forms
      switch(FEAT_TRAINS, SELF, sw_tokyu6020_panto_placer_main_3,position_in_vehid_chain %3){
          0: gfx_tokyu6020_1_mot;
          2: sw_tokyu6020_mot_2_gfx;
          sw_tokyu6020_wag_gfx;
      }
    switch(FEAT_TRAINS, SELF, sw_tokyu6020_panto_placer_main,num_vehs_in_vehid_chain){
        0..3:sw_tokyu6020_panto_placer_main_3;
        4..6:sw_tokyu6020_panto_placer_main_2;
        sw_tokyu6020_panto_placer_main_1;
    }
  //
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tokyu6020_lv,vehicle_type_id){
      mu_car:sw_tokyu6020_panto_placer_main;
      gfx_tokyu6020_1_head;
    }
//
//livery controller
  switch(FEAT_TRAINS, SELF, sw_tokyu6020_lv_desc_main, cargo_subtype){
    0:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2018);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_tokyu_Q_seat)),2018);
  }
