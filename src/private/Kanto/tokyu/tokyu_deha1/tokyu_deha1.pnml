  spriteset(tokyu_deha1_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu_deha1/tokyu_deha1.png"){ tmpl_purchase_1c(0, 0) }
