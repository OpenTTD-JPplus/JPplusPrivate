//purchase
  spriteset(tokyu_deha1_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu_deha1/tokyu_deha1.png"){ tmpl_purchase_1c_7(0, 0) }
  GRAPHIC_STACK_2(gfx_tokyu_deha1_purchase_main, sprite_logo_tokyu_7, tokyu_deha1_purchase_c1)
//livery 1
  spriteset(gfx_tokyu_deha1_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu_deha1/tokyu_deha1_lights.png"){ tmpl_std_v3(0, 0) }
//lv 1
  spriteset(gfx_tokyu_deha1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu_deha1/tokyu_deha1.png"){ tmpl_std_v3(0, 0) }
  spriteset(gfx_tokyu_deha1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu_deha1/tokyu_deha1.png"){ tmpl_std_rev_v3(0, 0) }
  TRAIN_CONSTRUCTOR_2(gfx_tokyu_deha1_1_front, gfx_tokyu_deha1_end,gfx_tokyu_deha1_lights_front)
  TRAIN_CONSTRUCTOR_2(gfx_tokyu_deha1_1_front_rev, gfx_tokyu_deha1_end_rev,gfx_tokyu_deha1_lights_front)
  spriteset(gfx_tokyu_deha1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu_deha1/tokyu_deha1.png"){ tmpl_symm_v3(0, 25) }
//
//*livery 1
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tokyu_deha1_front_gfx, vehicle_is_reversed){
        1:gfx_tokyu_deha1_1_front_rev;
        gfx_tokyu_deha1_1_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_tokyu_deha1_end_gfx, vehicle_is_reversed){
        1:gfx_tokyu_deha1_end_rev;
        gfx_tokyu_deha1_end;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_tokyu_deha1_panto_placer,position_in_vehid_chain %2){
        1: gfx_tokyu_deha1_end;
        gfx_tokyu_deha1_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu_deha1_panto_placer_rev,position_in_vehid_chain_from_end %2){
        0: gfx_tokyu_deha1_end_rev;
        gfx_tokyu_deha1_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_tokyu_deha1_panto_placer_main,vehicle_is_reversed){
        1: sw_tokyu_deha1_panto_placer_rev;
        sw_tokyu_deha1_panto_placer;
    }
  //end car fixer
    switch(FEAT_TRAINS, SELF, sw_tokyu_deha1_end_fix, position_in_vehid_chain_from_end){
      0:sw_tokyu_deha1_end_gfx;
      sw_tokyu_deha1_panto_placer_main;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu_deha1_lv,vehicle_type_id){
      mu_car:sw_tokyu_deha1_end_fix;
      sw_tokyu_deha1_front_gfx;
    }
//
//post fixers
  switch(FEAT_TRAINS, SELF, sw_tokyu_deha1_car_power_main,position_in_vehid_chain %2){
    1:90;
    0;
  }
  switch(FEAT_TRAINS, SELF, sw_tokyu_deha1_power_main,vehicle_type_id){
    mu_car:sw_tokyu_deha1_car_power_main;
    90;
  }
