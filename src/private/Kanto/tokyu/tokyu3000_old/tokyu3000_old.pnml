  spriteset(tokyu3000_old_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu3000_old/tokyu3000_old_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_4(gfx_tokyu3000_old_purchase_main, logo_tokyu, tokyu3000_old_purchase_c1,panto_d_arm_single_rev_c1, tokyu3000_old_purchase_c2)
