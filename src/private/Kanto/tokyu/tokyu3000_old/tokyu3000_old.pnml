//
//lv handler
  switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_front_mot_gfx,cargo_subtype){
    1:gfx_tokyu3000_old_2_front;
    gfx_tokyu3000_old_1_front;
  }
  switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_end_mot_gfx,cargo_subtype){
    1:gfx_tokyu3000_old_2_end;
    gfx_tokyu3000_old_1_end;
  }
  switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_end_rev_mot_gfx,cargo_subtype){
    1:gfx_tokyu3000_old_2_end_rev;
    gfx_tokyu3000_old_1_end_rev;
  }
  switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_wag_gfx,cargo_subtype){
    1:gfx_tokyu3000_old_2_wag;
    gfx_tokyu3000_old_1_wag;
  }
//
//main
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_panto_placer,position_in_vehid_chain %3){
      1: sw_tokyu3000_old_end_rev_mot_gfx;
      2: sw_tokyu3000_old_end_mot_gfx;
      sw_tokyu3000_old_wag_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_panto_placer_rev,position_in_vehid_chain_from_end %3){
      1: sw_tokyu3000_old_end_mot_gfx;
      2: sw_tokyu3000_old_end_rev_mot_gfx;
      sw_tokyu3000_old_wag_gfx;
    }
    switch(FEAT_TRAINS, PARENT, sw_tokyu3000_old_panto_placer_main,vehicle_is_reversed){
      1: sw_tokyu3000_old_panto_placer_rev;
      sw_tokyu3000_old_panto_placer;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_head_gfx_main,position_in_consist>0){
      1: sw_tokyu3000_old_end_mot_gfx;
      sw_tokyu3000_old_front_mot_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_lv,vehicle_type_id){
      mu_car:sw_tokyu3000_old_panto_placer_main;
      sw_tokyu3000_old_head_gfx_main;
    }
  //lv selector
    switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_lv_desc_main, cargo_subtype){
      0:string(LV_DATED, string(STR_LIVERY,string(LV_DEFAULT)),1928);
      1:string(LV_DATED, string(STR_LIVERY,string(LV_TWO_TONE)),1980);
    }
//
//post fixers
  switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_car_power_main,position_in_vehid_chain %2){
    1:94;
    0;
  }
  switch(FEAT_TRAINS, SELF, sw_tokyu3000_old_power_main,vehicle_type_id){
    mu_car:sw_tokyu3000_old_car_power_main;
    94;
  }
