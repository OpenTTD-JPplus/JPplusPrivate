  spriteset(tokyu3000_old_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu3000_old/tokyu3000_old_lights.png"){ tmpl_std_v3(0, 0) }
  
  spriteset(tokyu3000_old_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu3000_old/tokyu3000_old_1.png"){ tmpl_std_v3(0, 0) }
