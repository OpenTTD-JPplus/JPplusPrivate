//livery 1
  TRAIN_CONSTRUCTOR_3(gfx_tokyu3000_old_1_front, tokyu3000_old_1_head_base, tokyu3000_old_lights_front,panto_d_arm_single_rev)
  TRAIN_CONSTRUCTOR_2(gfx_tokyu3000_old_1_end, tokyu3000_old_1_head_base,panto_d_arm_single_rev)
