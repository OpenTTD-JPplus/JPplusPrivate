  spriteset(tokyu3000_old_2_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu3000_old/tokyu3000_old_2.png"){ tmpl_std_v3(0, 0) }
  spriteset(tokyu3000_old_2_head_base_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu3000_old/tokyu3000_old_2.png"){ tmpl_std_rev_v3(0, 0) }
