//purchase
  spriteset(tokyu1000_purchase_1_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tokyu1000_purchase_1_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_4(tokyu1000_purchase_1,  tokyu1000_purchase_1_c1,ac_quad_1_wag_c1, tokyu1000_purchase_1_c2,ac_quad_1_wag_c2)
  spriteset(tokyu1000_purchase_2_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tokyu1000_purchase_2_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_4(tokyu1000_purchase_2,  tokyu1000_purchase_2_c1,ac_quad_1_wag_c1, tokyu1000_purchase_2_c2,ac_quad_1_wag_c2)
  switch(FEAT_TRAINS, SELF, tokyu1000_purchase, current_year){
    0..2013:tokyu1000_purchase_1;
    tokyu1000_purchase_2;
  }
//base
  //lv1
  spriteset(tokyu1000_1_head_base_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000.png"){ tmpl_std_v3(0, 0) }
  spriteset(tokyu1000_1_head_base_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, tokyu1000_1_head_base, current_year>2005 ){
    1:tokyu1000_1_head_base_2;tokyu1000_1_head_base_1;
  }
  spriteset(tokyu1000_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000.png"){ tmpl_symm_v3(0, 50) }
  //lv2
  spriteset(tokyu1000_2_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(tokyu1000_2_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000_1.png"){ tmpl_symm_v3(0, 25) }
  //lv3
  spriteset(tokyu1000_3_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000_2.png"){ tmpl_std_v3(0, 0) }
  spriteset(tokyu1000_3_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000_2.png"){ tmpl_symm_v3(0, 25) }
  //lv4
  spriteset(tokyu1000_4_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000_3.png"){ tmpl_std_v3(0, 0) }
  spriteset(tokyu1000_4_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000_3.png"){ tmpl_symm_v3(0, 25) }
  //lv5
  spriteset(tokyu1000_5_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000_4.png"){ tmpl_std_v3(0, 0) }
  spriteset(tokyu1000_5_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu1000/tokyu1000_4.png"){ tmpl_symm_v3(0, 25) }
//subtype
  switch(FEAT_TRAINS, SELF, tokyu1000_head_base, cargo_subtype){
    1:tokyu1000_2_head_base;
    2:tokyu1000_3_head_base;
    3:tokyu1000_4_head_base;
    4:tokyu1000_5_head_base;
    tokyu1000_1_head_base;
  }
  switch(FEAT_TRAINS, SELF, tokyu1000_car_base, cargo_subtype){
    1:tokyu1000_2_car_base;
    2:tokyu1000_3_car_base;
    3:tokyu1000_4_car_base;
    4:tokyu1000_5_car_base;
    tokyu1000_1_car_base;
  }
//
//panto
  switch(FEAT_TRAINS, SELF, tokyu1000_panto_single, current_year<2006&&num_vehs_in_vehid_chain>3){
    1:panto_d_arm_single;
    panto_arm_n_single;
  }
  switch(FEAT_TRAINS, SELF, tokyu1000_panto_single_rev, current_year<2006&&num_vehs_in_vehid_chain>3){
    1:panto_d_arm_single_rev;
    panto_arm_n_single_rev;
  }
//
  TRAIN_CONSTRUCTOR_3(gfx_tokyu1000_front, tokyu1000_head_base, tokyu9000_lights_front, ac_triple_1_wag)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu1000_end, tokyu1000_head_base, tokyu9000_lights_end, ac_triple_1_wag)
  TRAIN_CONSTRUCTOR_4(gfx_tokyu1000_front_mot, tokyu1000_head_base, tokyu9000_lights_front, ac_triple_1_mot_rev,tokyu1000_panto_single)
  TRAIN_CONSTRUCTOR_4(gfx_tokyu1000_end_mot, tokyu1000_head_base, tokyu9000_lights_end, ac_triple_1_mot,tokyu1000_panto_single)

  TRAIN_CONSTRUCTOR_3(gfx_tokyu1000_mot, tokyu1000_car_base, ac_triple_1_mot_rev,tokyu1000_panto_single_rev)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu1000_mot_rev, tokyu1000_car_base, ac_triple_1_mot,tokyu1000_panto_single)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu1000_mot_2, tokyu1000_car_base ,ac_triple_1_mot_2,panto_arm_n)
  TRAIN_CONSTRUCTOR_2(gfx_tokyu1000_wag, tokyu1000_car_base, ac_triple_1_wag)
//*main
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_tokyu1000_front_gfx,vehicle_is_reversed==1){
      1: gfx_tokyu1000_front_mot;
      gfx_tokyu1000_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_tokyu1000_end_gfx,vehicle_is_reversed==0){
      1: gfx_tokyu1000_end_mot;
      gfx_tokyu1000_end;
    }
  //panto placer
    //var 1000 1
      switch(FEAT_TRAINS, SELF, sw_tokyu1000_panto_placer_1,position_in_vehid_chain_from_end %2){
        0: gfx_tokyu1000_mot;
        gfx_tokyu1000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tokyu1000_panto_placer_1_rev,position_in_vehid_chain %2){
        0: gfx_tokyu1000_mot_rev;
        gfx_tokyu1000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tokyu1000_panto_placer_main_tc,vehicle_is_reversed){
        1: sw_tokyu1000_panto_placer_1_rev;
        sw_tokyu1000_panto_placer_1;
      }
    //var 1000 2 mot head
      switch(FEAT_TRAINS, SELF, sw_tokyu1000_panto_placer_2,position_in_vehid_chain_from_end %5){
        1: gfx_tokyu1000_mot;
        4: gfx_tokyu1000_mot;
        gfx_tokyu1000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tokyu1000_panto_placer_2_rev,position_in_vehid_chain %5){
        1: gfx_tokyu1000_mot_rev;
        4: gfx_tokyu1000_mot_rev;
        gfx_tokyu1000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tokyu1000_panto_placer_main_2,vehicle_is_reversed){
        1: sw_tokyu1000_panto_placer_2_rev;
        sw_tokyu1000_panto_placer_2;
      }
    //var 1000 3 4-car
      switch(FEAT_TRAINS, SELF, sw_tokyu1000_panto_placer_3,position_in_vehid_chain_from_end %4){
        0..1: gfx_tokyu1000_mot;
        gfx_tokyu1000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tokyu1000_panto_placer_3_rev,position_in_vehid_chain %4){
        0..1: gfx_tokyu1000_mot_rev;
        gfx_tokyu1000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tokyu1000_panto_placer_main_3,vehicle_is_reversed){
        1: sw_tokyu1000_panto_placer_3_rev;
        sw_tokyu1000_panto_placer_3;
      }
    //var 1500
      switch(FEAT_TRAINS, SELF, sw_tokyu1000_panto_placer_4,position_in_vehid_chain_from_end %3){
        0: gfx_tokyu1000_mot_2;
        gfx_tokyu1000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tokyu1000_panto_placer_4_rev,position_in_vehid_chain %3){
        0: gfx_tokyu1000_mot_2;
        gfx_tokyu1000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tokyu1000_panto_placer_main_4,vehicle_is_reversed){
        1: sw_tokyu1000_panto_placer_4_rev;
        sw_tokyu1000_panto_placer_4;
      }
    //controller
      random_switch(FEAT_TRAINS, PARENT, sw_tokyu1000_panto_placer_main_0_1){
        1:sw_tokyu1000_panto_placer_main_2;
        1:sw_tokyu1000_panto_placer_main_3;
      }
      switch(FEAT_TRAINS, SELF, sw_tokyu1000_panto_placer_main_mc, num_vehs_in_vehid_chain){
        0..1:sw_tokyu1000_panto_placer_main_tc;
        2:sw_tokyu1000_panto_placer_main_0_1;
        sw_tokyu1000_panto_placer_main_2;
      }
      switch(FEAT_TRAINS, SELF, sw_tokyu1500_panto_placer_main, num_vehs_in_vehid_chain){
        0..3:sw_tokyu1000_panto_placer_main_4;
        sw_tokyu1000_panto_placer_main_tc;
      }
  //front end fixer
    switch(FEAT_TRAINS, SELF, sw_tokyu1000_head_gfx_main_tc,position_in_consist>0){
      1: gfx_tokyu1000_end;
      gfx_tokyu1000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu1000_head_gfx_main_mc,position_in_consist>0){
      1: sw_tokyu1000_end_gfx;
      sw_tokyu1000_front_gfx;
    }
  //
    switch(FEAT_TRAINS, SELF, sw_tokyu1000_lv_1,vehicle_type_id){
      mu_car:sw_tokyu1000_panto_placer_main_mc;
      sw_tokyu1000_head_gfx_main_mc;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu1000_lv_2,vehicle_type_id){
      mu_car:sw_tokyu1000_panto_placer_main_tc;
      sw_tokyu1000_head_gfx_main_tc;
    }
    random_switch(FEAT_TRAINS,PARENT,sw_tokyu1000_lv_0){
      1:sw_tokyu1000_lv_1;
      1:sw_tokyu1000_lv_2;
    }
    switch(FEAT_TRAINS,PARENT,sw_tokyu1000_lv_0_1,num_vehs_in_consist){
      2..3:sw_tokyu1000_lv_1;
      sw_tokyu1000_lv_0;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu1500_lv_1,vehicle_type_id){
      mu_car:sw_tokyu1500_panto_placer_main;
      sw_tokyu1000_head_gfx_main_tc;
    }
  //
    switch(FEAT_TRAINS, SELF, sw_tokyu1000_lv_3,build_year>2013||cargo_subtype>2){
      1:sw_tokyu1500_lv_1;
      sw_tokyu1000_lv_0_1;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu1000_lv,num_vehs_in_consist){
      2:sw_tokyu1000_lv_1;
      sw_tokyu1000_lv_3;
    }
//
//*livery controller
  switch(FEAT_TRAINS, SELF, sw_tokyu1000_lv_desc_main,cargo_subtype){
    0:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1988);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_tokyu1000_2)),2016);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_tokyu1000_3)),2019);
    3:string(LV_DATED,string(STR_LIVERY,string(STR_CONCAT_3, "1500", string(STR_NAME_SERIES), string(STR_RENEWAL))),2014);
    4:string(LV_DATED,string(STR_LIVERY,string(LV_tokyu_iketama)),2024);
  }
//
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tokyu1000_capacity_main,vehicle_type_id){
      mu_car: 135;
      125;
    }
//power
    switch(FEAT_TRAINS, SELF, sw_tokyu1000_car_power_main,position_in_vehid_chain_from_end %8){
      0..1:return 130;
      3..5:return 130;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu1000_power_main,vehicle_type_id){
      mu_car:sw_tokyu1000_car_power_main;
      return 130;
    }
