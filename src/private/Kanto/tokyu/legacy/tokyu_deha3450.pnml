      1: sw_tokyu_deha3450_panto_placer_2_rev;
      sw_tokyu_deha3450_panto_placer_2;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu_deha3450_head_gfx_main_2,position_in_consist==0){
      1: gfx_tokyu_deha3450_1_end_mot;
