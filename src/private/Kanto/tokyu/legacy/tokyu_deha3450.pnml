    switch(FEAT_TRAINS, SELF, sw_tokyu_deha3450_lv_2,vehicle_type_id){
      mu_car:sw_tokyu_deha3450_head_gfx_main_2;
      sw_tokyu_deha3450_front_gfx_3;
