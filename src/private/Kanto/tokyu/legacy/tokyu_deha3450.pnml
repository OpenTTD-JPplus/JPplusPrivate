    switch(FEAT_TRAINS, SELF, sw_tokyu_deha3450_panto_placer_2_rev,position_in_consist_from_end %2){
      0: gfx_tokyu_deha3450_1_end_mot_rev;
      gfx_tokyu_deha3450_1_end_mot;
    }
