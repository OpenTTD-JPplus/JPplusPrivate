  //variations
    switch(FEAT_TRAINS, PARENT, sw_tokyu_deha3450_front_gfx_1, vehicle_is_reversed){
      1:gfx_tokyu_deha3450_1_front_mot_rev;
      gfx_tokyu_deha3450_1_front_mot;
    }
  //2+cars
    switch(FEAT_TRAINS, PARENT, sw_tokyu_deha3450_front_gfx_2, vehicle_is_reversed){
      1:gfx_tokyu_deha3450_1_front_mot_2;
      gfx_tokyu_deha3450_1_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_tokyu_deha3450_end_gfx_2, vehicle_is_reversed){
      1:gfx_tokyu_deha3450_1_end;
      gfx_tokyu_deha3450_1_end_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu_deha3450_panto_placer_1,position_in_vehid_chain %2){
      0: gfx_tokyu_deha3450_1_end_mot;
      gfx_tokyu_deha3450_1_end;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu_deha3450_panto_placer_1_rev,position_in_vehid_chain_from_end %2){
      1: gfx_tokyu_deha3450_1_end_mot_rev;
      gfx_tokyu_deha3450_1_end;
    }
    switch(FEAT_TRAINS, PARENT, sw_tokyu_deha3450_panto_placer_1_main,vehicle_is_reversed){
      1: sw_tokyu_deha3450_panto_placer_1_rev;
      sw_tokyu_deha3450_panto_placer_1;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu_deha3450_head_gfx_main_1,position_in_vehid_chain_from_end){
      0: sw_tokyu_deha3450_end_gfx_2;
      sw_tokyu_deha3450_panto_placer_1_main;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu_deha3450_lv_1,vehicle_type_id){
      mu_car:sw_tokyu_deha3450_head_gfx_main_1;
      sw_tokyu_deha3450_front_gfx_2;
    }
  //2+cars 2
    switch(FEAT_TRAINS, PARENT, sw_tokyu_deha3450_front_gfx_3, vehicle_is_reversed){
      1:gfx_tokyu_deha3450_1_front_mot_2;
      gfx_tokyu_deha3450_1_front_mot;
