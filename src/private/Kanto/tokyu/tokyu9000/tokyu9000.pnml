  spriteset(tokyu9000_1_2_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu9000/tokyu9000_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(tokyu9000_1_3_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu9000/tokyu9000_1.png"){ tmpl_std_v3(0, 50) }
  spriteset(tokyu9000_1_4_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu9000/tokyu9000_1.png"){ tmpl_std_v3(0, 75) }
  spriteset(tokyu9000_1_wag_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu9000/tokyu9000_1.png"){ tmpl_symm_v3(0, 100) }
