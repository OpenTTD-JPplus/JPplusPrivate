//livery gfx
  //timed
    switch(FEAT_TRAINS, SELF, sw_tokyu9000_1_1_head_timed, current_year){
      0..2004:gfx_tokyu9000_1_1_head;
      gfx_tokyu9000_1_2_head;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu9000_1_2_head_timed, current_year){
      0..2004:gfx_tokyu9000_1_3_head;
      gfx_tokyu9000_1_4_head;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu9000_1_mot_timed, current_year>2010&&num_vehs_in_vehid_chain<4){
      1:gfx_tokyu9000_1_mot_n;
      gfx_tokyu9000_1_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu9000_2_head_timed, current_year){
      0..2004:gfx_tokyu9000_2_1_head;
      gfx_tokyu9000_2_2_head;
    }
  //
  switch(FEAT_TRAINS, SELF, sw_tokyu9000_head, cargo_subtype){
    0:sw_tokyu9000_1_1_head_timed;
    1:sw_tokyu9000_1_2_head_timed;
    2:sw_tokyu9000_2_head_timed;
    3:gfx_tokyu9000_3_head;
    sw_tokyu9000_1_1_head_timed;
  }
  switch(FEAT_TRAINS, SELF, sw_tokyu9000_mot, cargo_subtype){
    0..1:sw_tokyu9000_1_mot_timed;
    2:gfx_tokyu9000_2_mot;
    3:gfx_tokyu9000_3_mot;
    gfx_tokyu9000_1_mot;
  }
  switch(FEAT_TRAINS, SELF, sw_tokyu9000_wag, cargo_subtype){
    0..1:gfx_tokyu9000_1_wag;
    2:gfx_tokyu9000_2_wag;
    3:gfx_tokyu9000_3_wag;
    gfx_tokyu9000_1_wag;
  }
//
//*livery 1
  //panto placer
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tokyu9000_panto_placer_main_1,position_in_vehid_chain %5){
        0: sw_tokyu9000_mot;
        2: sw_tokyu9000_mot;
        4: sw_tokyu9000_mot;
        sw_tokyu9000_wag;
      }
    //var 2 5 cars
      switch(FEAT_TRAINS, SELF, sw_tokyu9000_panto_placer_main_2,position_in_vehid_chain %4){
        0: sw_tokyu9000_mot;
        1: sw_tokyu9000_mot;
        2: sw_tokyu9000_mot;
        sw_tokyu9000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tokyu9000_panto_placer_main,num_vehs_in_vehid_chain){
        0..4: sw_tokyu9000_panto_placer_main_2;
        sw_tokyu9000_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tokyu9000_lv,vehicle_type_id){
      mu_car:sw_tokyu9000_panto_placer_main;
      sw_tokyu9000_head;
    }
//lv controller
switch(FEAT_TRAINS, SELF, sw_tokyu9000_lv_desc_main, cargo_subtype){
    0:string(LV_DATED,string(STR_LIVERY,string(LV_tokyu_toyoko_belt)),1986);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_tokyu_oimachi_belt)),2009);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_toqbox)),1988);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_tokyu_100_anniv)),2022);
}

//post fixers
  //capacity
    switch(FEAT_TRAINS, SELF, sw_tokyu9000_capacity_main, vehicle_type_id){
      tokyu9000: 130;
      default: 144;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_tokyu9000_car_power_main_1, position_in_vehid_chain%8){
      0:return 170;
      2:return 170;
      4:return 170;
      5:return 170;
      default: 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu9000_car_power_main_2, position_in_vehid_chain%5){
      0..2:return 170;
      default: 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu9000_car_power_main, num_vehs_in_vehid_chain){
      0..3:sw_tokyu9000_car_power_main_2;
      sw_tokyu9000_car_power_main_1;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu9000_power_main, vehicle_type_id){
      tokyu9000: 0;
      default: sw_tokyu9000_car_power_main;
    }