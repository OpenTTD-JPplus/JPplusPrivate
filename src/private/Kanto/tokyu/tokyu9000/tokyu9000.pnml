  TRAIN_CONSTRUCTOR_3(gfx_tokyu9000_1_1_head, tokyu9000_1_1_head_base, sw_tokyu9000_lights, ac_quad_1_wag)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu9000_1_2_head, tokyu9000_1_2_head_base, sw_tokyu9000_lights, ac_quad_1_wag)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu9000_1_3_head, tokyu9000_1_3_head_base, sw_tokyu9000_lights, ac_quad_1_wag)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu9000_1_4_head, tokyu9000_1_4_head_base, sw_tokyu9000_lights, ac_quad_1_wag)

  TRAIN_CONSTRUCTOR_2(gfx_tokyu9000_1_wag, tokyu9000_1_wag_base, ac_quad_1_wag)
