//purchase
  spriteset(y000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/tokyu/y000/y000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(y000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/tokyu/y000/y000.png"){ tmpl_purchase_2c_dual(0, 0) }
  GRAPHIC_STACK_6(gfx_y000_purchase_main, logo_tokyu, y000_purchase_c1, ac_long_toshiba_c1, y000_purchase_c2, ac_long_toshiba_c2, panto_arm_n_c2)
//base
  spriteset(y000_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/y000/y000.png"){ tmpl_std_v3(0, 0) }
  spriteset(y000_1_head_base_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/y000/y000.png"){ tmpl_std_rev_v3(0, 0) }
  spriteset(y000_1_wag_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/y000/y000.png"){ tmpl_symm_v3(0, 25) }
//y000
  TRAIN_CONSTRUCTOR_3(gfx_y000_1_front, y000_1_head_base, tokyu3000_lights_front, ac_long_toshiba)
  TRAIN_CONSTRUCTOR_3(gfx_y000_1_end, y000_1_head_base, tokyu3000_lights_end, ac_long_toshiba)
  TRAIN_CONSTRUCTOR_4(gfx_y000_1_front_mot, y000_1_head_base, tokyu3000_lights_front, ac_long_toshiba,panto_arm_n)
  TRAIN_CONSTRUCTOR_4(gfx_y000_1_end_mot, y000_1_head_base, tokyu3000_lights_end, ac_long_toshiba,panto_arm_n)
  TRAIN_CONSTRUCTOR_3(gfx_y000_1_mot, y000_1_wag_base, ac_long_toshiba,panto_arm_n)
  TRAIN_CONSTRUCTOR_2(gfx_y000_1_wag, y000_1_wag_base, ac_long_toshiba)
  TRAIN_CONSTRUCTOR_2(gfx_y000_1_front_f, y000_1_head_base, ac_long_toshiba)
  TRAIN_CONSTRUCTOR_2(gfx_y000_1_end_f, y000_1_head_base_rev, ac_long_toshiba)
  TRAIN_CONSTRUCTOR_3(gfx_y000_1_front_mot_f, y000_1_head_base, ac_long_toshiba,panto_arm_n)
  TRAIN_CONSTRUCTOR_3(gfx_y000_1_end_mot_f, y000_1_head_base_rev, ac_long_toshiba,panto_arm_n)
//
//*main
  //front gfx
    switch(FEAT_TRAINS, PARENT, sw_y000_front,vehicle_is_reversed){
        1: gfx_y000_1_front_mot;
        gfx_y000_1_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_y000_end,vehicle_is_reversed){
        1: gfx_y000_1_end;
        gfx_y000_1_end_mot;
    }
  switch(FEAT_TRAINS,SELF,sw_y000_panto_placer_check_1,position_in_vehid_chain<2){
        1:gfx_y000_1_wag;
        gfx_y000_1_mot;
    }
    switch(FEAT_TRAINS,SELF,sw_y000_panto_placer_check_2,position_in_vehid_chain_from_end<2){
        1:gfx_y000_1_wag;
        gfx_y000_1_mot;
    }
    switch(FEAT_TRAINS,PARENT,sw_y000_mot,vehicle_is_reversed){
        1:sw_y000_panto_placer_check_1;
        sw_y000_panto_placer_check_2;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_y000_panto_placer_0,position_in_vehid_chain %3){
      1:sw_y000_mot;
      gfx_y000_1_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_y000_panto_placer_0_rev,position_in_vehid_chain_from_end %3){
      1:sw_y000_mot;
      gfx_y000_1_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_y000_panto_placer_main,vehicle_is_reversed){
      1: sw_y000_panto_placer_0_rev;
      sw_y000_panto_placer_0;
    }
  //fake head-end placer
    //var 1
    switch(FEAT_TRAINS, SELF, sw_y000_fake_placer,position_in_vehid_chain){
        0: gfx_y000_1_end_mot_f;
        1: gfx_y000_1_front_f;
    sw_y000_panto_placer_main;
    }
    switch(FEAT_TRAINS, SELF, sw_y000_fake_placer_rev,position_in_vehid_chain_from_end ){
        0: gfx_y000_1_front_mot_f;
        1: gfx_y000_1_end_f;
    sw_y000_panto_placer_main;
    }
    switch(FEAT_TRAINS, PARENT, sw_y000_fake_placer_gfx,vehicle_is_reversed){
        1: sw_y000_fake_placer_rev;
        sw_y000_fake_placer;
    }
    switch(FEAT_TRAINS, SELF, sw_y000_fake_placer_main_1,num_vehs_in_vehid_chain>1){
        1: sw_y000_fake_placer_gfx;
    sw_y000_panto_placer_main;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_y000_fake_placer_2,position_in_vehid_chain){
        3: gfx_y000_1_end_f;
        4: gfx_y000_1_front_f;
    sw_y000_panto_placer_main;
    }
    switch(FEAT_TRAINS, SELF, sw_y000_fake_placer_2_rev,position_in_vehid_chain_from_end ){
        3: gfx_y000_1_front_f;
        4: gfx_y000_1_end_f;
    sw_y000_panto_placer_main;
    }
    switch(FEAT_TRAINS, PARENT, sw_y000_fake_placer_2_gfx,vehicle_is_reversed){
        1: sw_y000_fake_placer_2_rev;
        sw_y000_fake_placer_2;
    }
    switch(FEAT_TRAINS, SELF, sw_y000_fake_placer_main_2,num_vehs_in_vehid_chain>6){
        1: sw_y000_fake_placer_2_gfx;
    sw_y000_panto_placer_main;
    }
  switch(FEAT_TRAINS, SELF, sw_y000_sandwich_main, num_vehs_in_vehid_chain){
      0..4:sw_y000_fake_placer_main_1;
      sw_y000_fake_placer_main_2;
  }
  switch(FEAT_TRAINS, SELF, sw_y000_head_gfx_main,position_in_consist>0){
    1: sw_y000_end;
    sw_y000_front;
  }
  switch(FEAT_TRAINS, SELF, sw_y000_lv,vehicle_type_id){
    mu_car:sw_y000_sandwich_main;
    sw_y000_head_gfx_main;
  }
//
//post fixers
  switch(FEAT_TRAINS, SELF, sw_y000_capacity_main,vehicle_type_id){
    mu_car: 149;
    141;
  }
  switch(FEAT_TRAINS, SELF, sw_y000_car_power_main,position_in_vehid_chain %2){
    0:190;
    0;
  }
  switch(FEAT_TRAINS, SELF, sw_y000_power_main,vehicle_type_id){
    mu_car:sw_y000_car_power_main;
    190;
  }
