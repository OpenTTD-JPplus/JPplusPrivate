spriteset(y500_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/tokyu/y500/y500.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(y500_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/tokyu/y500/y500.png"){ tmpl_purchase_2c_dual(0, 0) }
  GRAPHIC_STACK_4(y500_purchase, y500_purchase_c1, ac_long_toshiba_c1, y500_purchase_c2, ac_long_toshiba_c2)
//base
  spriteset(y500_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/tokyu/y500/y500.png"){ tmpl_std_v3 (0, 0) }
  spriteset(y500_wag_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/tokyu/y500/y500.png"){ tmpl_std_v3 (0, 25) }
  spriteset(y500_wag_base_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/tokyu/y500/y500.png"){ tmpl_std_rev_v3 (0, 25) }
  spriteset(y500_wag_base_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/tokyu/y500/y500.png"){ tmpl_std_v3 (0, 50) }
  spriteset(y500_wag_base_2_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/tokyu/y500/y500.png"){ tmpl_std_rev_v3 (0, 50) }
  
  switch(FEAT_TRAINS, SELF, wag_base_gfx, position_in_vehid_chain>=(num_vehs_in_vehid_chain/2)){
      1:y500_wag_base_rev;
      y500_wag_base;
  }
  switch(FEAT_TRAINS, SELF, wag_base_2_gfx, position_in_vehid_chain>=(num_vehs_in_vehid_chain/2)){
      1:y500_wag_base_2_rev;
      y500_wag_base_2;
  }
  switch(FEAT_TRAINS, SELF, sw_wag_base, position_in_vehid_chain==(num_vehs_in_vehid_chain/2)||position_in_vehid_chain_from_end==(num_vehs_in_vehid_chain/2)){
      1:wag_base_2_gfx;
      wag_base_gfx;
  }

//
  TRAIN_CONSTRUCTOR_3(gfx_y500_head, y500_head_base, sw_tokyu5000_lights, ac_long_toshiba)
  TRAIN_CONSTRUCTOR_3(gfx_y500_mot, sw_wag_base, ac_long_toshiba,panto_arm_n)
  TRAIN_CONSTRUCTOR_2(gfx_y500_wag, sw_wag_base, ac_long_toshiba)
//
//*Livery 1 
switch(FEAT_TRAINS, SELF, sw_y500_panto_placer_0_main,position_in_vehid_chain %7){
  1:gfx_y500_mot;
  5:gfx_y500_mot;
  gfx_y500_wag;
}
switch(FEAT_TRAINS, SELF, sw_y500_panto_placer_2_main,position_in_vehid_chain %5){
  0:gfx_y500_mot;
  3:gfx_y500_mot;
  gfx_y500_wag;
}
switch(FEAT_TRAINS, SELF, sw_y500_panto_placer_main, num_vehs_in_vehid_chain){
  default:sw_y500_panto_placer_0_main;
  0..2:sw_y500_panto_placer_2_main;
  4..5:sw_y500_panto_placer_2_main;
}

switch(FEAT_TRAINS, SELF, sw_y500_lv,vehicle_type_id){
  mu_car:sw_y500_panto_placer_main;
  gfx_y500_head;
}

  
switch(FEAT_TRAINS, SELF, sw_y500_capacity_main,vehicle_type_id){
  mu_car: 152;
  141;
}
switch(FEAT_TRAINS, SELF, sw_y500_car_power_main,position_in_vehid_chain %10){
  0..1:190;
  4..5:190;
  7:190;
  0;
}
switch(FEAT_TRAINS, SELF, sw_y500_power_main,vehicle_type_id){
  mu_car:sw_y500_car_power_main;
  return 0;
}