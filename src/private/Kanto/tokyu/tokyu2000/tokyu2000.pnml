//purchase
    GRAPHIC_STACK_5(tokyu2000_purchase, logo_tokyu, tokyu9000_purchase_c1,ac_quad_1_wag_c1, tokyu9000_purchase_c2,ac_quad_1_wag_c2)
//livery 1
//ac
  switch(FEAT_TRAINS, SELF, tokyu2000_ac_wag, build_year){
    0..1999:ac_double_1_wag_symm;
    ac_quad_1_wag;    
  }
  switch(FEAT_TRAINS, SELF, tokyu2000_ac_mot_2, build_year){
    0..1999:ac_double_1_mot_2;
    ac_quad_1_mot_dual;    
  }
  switch(FEAT_TRAINS, SELF, tokyu2000_ac_mot, build_year){
    0..1999:ac_double_1_mot;
    ac_quad_1_mot;    
  }
  switch(FEAT_TRAINS, SELF, tokyu2000_ac_mot_rev, build_year){
    0..1999:ac_double_1_mot_rev;
    ac_quad_1_mot_rev;    
  }
//
//base
  spriteset(tokyu2000_1_head_base_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu9000/tokyu9000_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(tokyu2000_1_head_base_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu9000/tokyu9000_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(tokyu2000_1_head_base_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu2000/tokyu2000_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(tokyu2000_1_wag_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu2000/tokyu2000_1.png"){ tmpl_symm_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, tokyu2000_1_head_base, current_year){
    0..2002:tokyu2000_1_head_base_1;
    tokyu2000_1_head_base_2;
  }
//
  TRAIN_CONSTRUCTOR_3(gfx_tokyu2000_1_front, tokyu2000_1_head_base, tokyu9000_lights_front, tokyu2000_ac_wag)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu2000_1_end, tokyu2000_1_head_base, tokyu9000_lights_end, tokyu2000_ac_wag)

  TRAIN_CONSTRUCTOR_3(gfx_tokyu2000_2_front, tokyu2000_1_head_base_3, tokyu9000_lights_front, tokyu2000_ac_wag)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu2000_2_end, tokyu2000_1_head_base_3, tokyu9000_lights_end, tokyu2000_ac_wag)

  TRAIN_CONSTRUCTOR_2(gfx_tokyu2000_1_wag, tokyu2000_1_wag_base, tokyu2000_ac_wag)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu2000_1_mot, tokyu2000_1_wag_base, tokyu2000_ac_mot_rev,panto_d_arm_single_rev)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu2000_1_mot_rev, tokyu2000_1_wag_base, tokyu2000_ac_mot,panto_d_arm_single)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu2000_1_mot_n, tokyu2000_1_wag_base, tokyu2000_ac_mot_rev,panto_arm_n_single_rev)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu2000_1_mot_n_rev, tokyu2000_1_wag_base, tokyu2000_ac_mot,panto_arm_n_single)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu2000_1_mot_n_2, tokyu2000_1_wag_base, tokyu2000_ac_mot_2,panto_arm_n)
//
//lv data
  switch(FEAT_TRAINS, SELF, swtokyu2000_front_gfx, cargo_subtype){
    1:gfx_tokyu2000_2_front;
    gfx_tokyu2000_1_front;
  }
  switch(FEAT_TRAINS, SELF, swtokyu2000_end_gfx, cargo_subtype){
    1:gfx_tokyu2000_2_end;
    gfx_tokyu2000_1_end;
  }
//
//*main
  //panto placer
    //var 1 2000
      switch(FEAT_TRAINS, SELF, sw_tokyu2000_panto_placer,position_in_vehid_chain_from_end %3){
          0: gfx_tokyu2000_1_mot;
          gfx_tokyu2000_1_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tokyu2000_panto_placer_rev,position_in_vehid_chain %3){
          0: gfx_tokyu2000_1_mot_rev;
          gfx_tokyu2000_1_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tokyu2000_panto_placer_main_1,vehicle_is_reversed){
          1: sw_tokyu2000_panto_placer_rev;
          sw_tokyu2000_panto_placer;
      }
    //var 9020
      switch(FEAT_TRAINS, SELF, sw_tokyu2000_panto_placer_1,position_in_vehid_chain_from_end %4){
          0: gfx_tokyu2000_1_mot_n_2;
          2: gfx_tokyu2000_1_mot_n;
          gfx_tokyu2000_1_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tokyu2000_panto_placer_1_rev,position_in_vehid_chain %4){
          0: gfx_tokyu2000_1_mot_n_2;
          2: gfx_tokyu2000_1_mot_n_rev;
          gfx_tokyu2000_1_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tokyu2000_panto_placer_main_2,vehicle_is_reversed){
          1: sw_tokyu2000_panto_placer_1_rev;
          sw_tokyu2000_panto_placer_1;
      }
    switch(FEAT_TRAINS, SELF, sw_tokyu2000_panto_placer_main,num_vehs_in_vehid_chain){
        0..5: sw_tokyu2000_panto_placer_main_2;
        sw_tokyu2000_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tokyu2000_head_gfx_main,position_in_consist>0){
      1: swtokyu2000_end_gfx;
      swtokyu2000_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu2000_lv,vehicle_type_id){
      mu_car:sw_tokyu2000_panto_placer_main;
      sw_tokyu2000_head_gfx_main;
    }
  //livery controller
    switch(FEAT_TRAINS, SELF, sw_tokyu2000_lv_desc_main,cargo_subtype){
      0: string(LV_DATED,string(STR_LIVERY,string(STR_CONCAT_2, "2000", string(STR_NAME_SERIES))),1992);
      1: string(LV_DATED,string(STR_LIVERY,string(STR_CONCAT_2, "9020", string(STR_NAME_SERIES))),2018);
    }
//
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tokyu2000_capacity_main,vehicle_type_id){
      mu_car: 144;
      130;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_tokyu2000_power_main_1,position_in_vehid_chain_from_end %10){
      0..1:return 170;
      3..4:return 170;
      6..7:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu9020_power_main,position_in_vehid_chain_from_end %5){
      0..2:return 175;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu2000_car_power_main,cargo_subtype){
      1: sw_tokyu9020_power_main;
      sw_tokyu2000_power_main_1;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu2000_power_main,vehicle_type_id){
      mu_car:sw_tokyu2000_car_power_main;
      return 0;
    }
