//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_tokyu7000_capacity_main,vehicle_type_id){
      tokyu7000: 122;
      default: 134;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_tokyu7000_car_power_main,position_in_vehid_chain_from_end %2){
      0:return 190;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tokyu7000_power_main,vehicle_type_id){
      tokyu7000: 190;
      sw_tokyu7000_car_power_main;
    }
