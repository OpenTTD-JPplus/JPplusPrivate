  spriteset(tokyu7000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu7000/tokyu7000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tokyu7000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu7000/tokyu7000.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_4(tokyu7000_purchase,  tokyu7000_purchase_c1, ac_long_toshiba_c1, tokyu7000_purchase_c2, ac_long_toshiba_c2)
//base
spriteset(tokyu7000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu7000/tokyu7000_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(tokyu7000_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu7000/tokyu7000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_tokyu7000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: tokyu7000_lights_end;
    tokyu7000_lights_front;
  }
spriteset(tokyu7000_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu7000/tokyu7000.png"){ tmpl_std_v3(0, 0) }
spriteset(tokyu7000_wag_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tokyu/tokyu7000/tokyu7000.png"){ tmpl_symm_v3(0, 25) }
//1
  TRAIN_CONSTRUCTOR_3(gfx_tokyu7000_head, tokyu7000_head_base, sw_tokyu7000_lights, ac_long_toshiba)
  TRAIN_CONSTRUCTOR_3(gfx_tokyu7000_mot, tokyu7000_wag_base, ac_long_toshiba,panto_arm_n)
  TRAIN_CONSTRUCTOR_2(gfx_tokyu7000_wag, tokyu7000_wag_base, ac_long_toshiba)
