//*livery 1
  //panto placer
    //var 1
      switch(FEAT_TRAINS, SELF, sw_tokyu7000_panto_placer_1_main,position_in_vehid_chain %3){
          0: gfx_tokyu7000_mot;
          gfx_tokyu7000_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_tokyu7000_panto_placer_2_main,position_in_vehid_chain %3){
          1: gfx_tokyu7000_mot;
          gfx_tokyu7000_wag;
      }
    switch(FEAT_TRAINS, SELF, sw_tokyu7000_panto_placer_main,num_vehs_in_vehid_chain){
        0..1:sw_tokyu7000_panto_placer_1_main;
        4..5: sw_tokyu7000_panto_placer_1_main;
        sw_tokyu7000_panto_placer_2_main;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tokyu7000_lv,vehicle_type_id){
      mu_car:sw_tokyu7000_panto_placer_main;
      gfx_tokyu7000_head;
    }
