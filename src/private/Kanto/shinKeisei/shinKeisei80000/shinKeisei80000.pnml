//purchase
  spriteset(shinKeisei80000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/shinKeisei/shinKeisei80000/shinKeisei80000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei80000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/shinKeisei/shinKeisei80000/shinKeisei80000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_5(shinKeisei80000_purchase, shinKeisei80000_purchase_c1, shinKeisei80000_purchase_c2, ac_single_1_c1, ac_single_1_c2, panto_arm_n_c2)
//livery 1
  spriteset(shinKeisei80000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei80000/shinKeisei80000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(shinKeisei80000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei80000/shinKeisei80000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei80000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: shinKeisei80000_lights_back;
    shinKeisei80000_lights_front;
  }
spriteset (shinKeisei80000_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei80000/shinKeisei80000_1.png") { tmpl_std_v3(0, 0) }
spriteset (shinKeisei80000_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei80000/shinKeisei80000_1.png") { tmpl_symm_v3(0, 25) }

spriteset (shinKeisei80000_2_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei80000/shinKeisei80000_2.png") { tmpl_std_v3(0, 0) }
spriteset (shinKeisei80000_2_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei80000/shinKeisei80000_2.png") { tmpl_symm_v3(0, 25) }

switch(FEAT_TRAINS, SELF, shinKeisei80000_head_base_timed, current_year){
  0..2025:shinKeisei80000_1_head_base;  shinKeisei80000_2_head_base;
}
switch(FEAT_TRAINS, SELF, shinKeisei80000_car_base_timed, current_year){
  0..2025:shinKeisei80000_1_car_base;  shinKeisei80000_2_car_base;
}

switch(FEAT_TRAINS, SELF, shinKeisei80000_head_base, cargo_subtype){
  0:shinKeisei80000_head_base_timed;  1:shinKeisei80000_1_head_base;  shinKeisei80000_2_head_base;
}
switch(FEAT_TRAINS, SELF, shinKeisei80000_car_base, cargo_subtype){
  0:shinKeisei80000_car_base_timed;  1:shinKeisei80000_1_car_base;  shinKeisei80000_2_car_base;
}

TRAIN_CONSTRUCTOR_3(shinKeisei80000_head, shinKeisei80000_head_base,ac_single_1_1, sw_shinKeisei80000_lights)
TRAIN_CONSTRUCTOR_3(shinKeisei80000_mot, shinKeisei80000_car_base,ac_single_1_1, panto_arm_n_single)
TRAIN_CONSTRUCTOR_3(shinKeisei80000_mot_2, shinKeisei80000_car_base,ac_single_1_1, panto_arm_n)
TRAIN_CONSTRUCTOR_2(shinKeisei80000_wag, shinKeisei80000_car_base,ac_single_1_1)
//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_shinKeisei80000_panto_placer_main_1,position_in_vehid_chain %8){
        0: shinKeisei80000_mot_2;
        2: shinKeisei80000_mot;
        5: shinKeisei80000_mot_2;
        shinKeisei80000_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_shinKeisei80000_panto_placer_main_2,position_in_vehid_chain %3){
        0: shinKeisei80000_mot_2;
        default: shinKeisei80000_wag;
      }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei80000_panto_placer_main, num_vehs_in_vehid_chain){
      0..7:sw_shinKeisei80000_panto_placer_main_2;
      sw_shinKeisei80000_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_shinKeisei80000_lv,vehicle_type_id){
        mu_car: sw_shinKeisei80000_panto_placer_main;
        shinKeisei80000_head;
    }
  //
  switch(FEAT_TRAINS, SELF, sw_shinKeisei80000_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2019);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_SHIN_KEISEI_KEISEI)),2026);
  }
