//purchase
  spriteset(shinKeisei8900_1_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei8900_1_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  
  spriteset(shinKeisei8900_2_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei8900_2_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_2.png"){ tmpl_purchase_2c_dual(0, 25) }
  switch(FEAT_TRAINS, SELF, shinKeisei8900_purchase_c1, current_year){
    0..2013:shinKeisei8900_1_purchase_c1;
    shinKeisei8900_2_purchase_c1;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei8900_purchase_c2, current_year){
    0..2013:shinKeisei8900_1_purchase_c2;
    shinKeisei8900_2_purchase_c2;
  }
  GRAPHIC_STACK_5(shinKeisei8900_purchase, shinKeisei8900_purchase_c1, shinKeisei8900_purchase_c2, ac_double_1_c1, ac_double_1_c2, panto_arm_n_c2)

//livery 1
  spriteset(shinKeisei8900_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(shinKeisei8900_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: shinKeisei8900_lights_back;
    shinKeisei8900_lights_front;
  }
spriteset (shinKeisei8900_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_1.png") { tmpl_std_v3(0, 0) }
spriteset (shinKeisei8900_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_1.png") { tmpl_symm_v3(0, 25) }

spriteset (shinKeisei8900_2_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_2.png") { tmpl_std_v3(0, 0) }
spriteset (shinKeisei8900_2_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_2.png") { tmpl_symm_v3(0, 25) }

spriteset (shinKeisei8900_3_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_3.png") { tmpl_std_v3(0, 0) }
spriteset (shinKeisei8900_3_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/shinKeisei/shinKeisei8900/shinKeisei8900_3.png") { tmpl_symm_v3(0, 25) }
//
  switch(FEAT_TRAINS, SELF, shinKeisei8900_head_timed, current_year){
    0..2013:shinKeisei8900_1_head_base;
    2014..2025:shinKeisei8900_2_head_base;
    shinKeisei8900_3_head_base;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei8900_car_timed, current_year){
    0..2013:shinKeisei8900_1_car_base;
    2014..2025:shinKeisei8900_2_car_base;
    shinKeisei8900_3_car_base;
  }

  switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_head, cargo_subtype){
    1:shinKeisei8900_1_head_base;    2:shinKeisei8900_2_head_base;    
    3:shinKeisei8900_3_head_base;       shinKeisei8900_head_timed;
  }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_car, cargo_subtype){
    1:shinKeisei8900_1_car_base;    2:shinKeisei8900_2_car_base;    
    3:shinKeisei8900_3_car_base;       shinKeisei8900_car_timed;
  }
  TRAIN_CONSTRUCTOR_3(shinKeisei8900_head, sw_shinKeisei8900_head, sw_shinKeisei8900_lights, ac_double_1_1)
  TRAIN_CONSTRUCTOR_3(shinKeisei8900_mot_2, sw_shinKeisei8900_car, ac_double_1_9, panto_arm_n)
  TRAIN_CONSTRUCTOR_2(shinKeisei8900_wag, sw_shinKeisei8900_car, ac_double_1_1)
//
//*livery 1
  //panto-placers
    //var 1 8 cars
      switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_panto_placer_main_1,position_in_vehid_chain %4){
        0: shinKeisei8900_mot_2;
        shinKeisei8900_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_panto_placer_main_2,position_in_vehid_chain %5){
        0: shinKeisei8900_mot_2;
        2: shinKeisei8900_mot_2;
        default: shinKeisei8900_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_panto_placer_main,num_vehs_in_vehid_chain){
        5..6: sw_shinKeisei8900_panto_placer_main_1;
        sw_shinKeisei8900_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_lv,vehicle_type_id){
        mu_car: sw_shinKeisei8900_panto_placer_main;
        shinKeisei8900_head;
    }
//
//*liveries
  switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1993);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_SHIN_KEISEI)),2014);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_SHIN_KEISEI_KEISEI)),2026);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_capacity_main,vehicle_type_id){
      mu_car: 127;
      122;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_car_power_main,vehicle_type_id){
      0..1:return 135;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8900_power_main,position_in_vehid_chain_from_end %8){
      mu_car:sw_shinKeisei8900_car_power_main;
      return 0;
    }
