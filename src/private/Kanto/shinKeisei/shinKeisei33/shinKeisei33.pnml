	//main
    switch(FEAT_TRAINS, SELF, sw_shinKeisei33_end_placer,position_in_vehid_chain_from_end==0&&num_vehs_in_vehid_chain>1){
      1: shinKeisei33_head;
      sw_shinKeisei33_panto_placer_main;
    }
    TRAIN_CONSTRUCTOR_2(sw_shinKeisei33_lv,  sw_shinKeisei33_end_placer,  sw_shinKeisei33_lights)
