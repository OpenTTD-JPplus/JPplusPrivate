//purchase
  spriteset(shinKeisei33_purchase_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei33/shinKeisei33_1.png"){ tmpl_purchase_1c(0, 0) }
  spriteset(shinKeisei33_purchase_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei33/shinKeisei33_2.png"){ tmpl_purchase_1c(0, 0) }
  switch(FEAT_TRAINS, SELF, shinKeisei33_purchase,current_year){
    0..1952:shinKeisei33_purchase_1;
    shinKeisei33_purchase_2;
  }
//
  spriteset(shinKeisei33_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/shinKeisei/shinKeisei33/shinKeisei33_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(shinKeisei33_lights_front_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/shinKeisei/shinKeisei33/shinKeisei33_lights.png"){ tmpl_std_rev_v3(0, 0) }
  switch(FEAT_TRAINS, PARENT, sw_shinKeisei33_lights, vehicle_is_reversed){
    1: shinKeisei33_lights_front_rev;
    shinKeisei33_lights_front;
  }
  spriteset (shinKeisei33_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei33/shinKeisei33_1.png") { tmpl_std_v3(0, 0) }
  spriteset (shinKeisei33_1_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei33/shinKeisei33_1.png") { tmpl_std_rev_v3(0, 0) }

  spriteset (shinKeisei33_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei33/shinKeisei33_2.png") { tmpl_std_v3(0, 0) }
  spriteset (shinKeisei33_2_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei33/shinKeisei33_2.png") { tmpl_std_rev_v3(0, 0) }
  switch(FEAT_TRAINS, SELF, shinKeisei33_head_timed, current_year){
    0..1951:shinKeisei33_1_head;    shinKeisei33_2_head;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei33_head_rev_timed, current_year){
    0..1951:shinKeisei33_1_head_rev;    shinKeisei33_2_head_rev;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei33_head, cargo_subtype){
    1:shinKeisei33_1_head;    1:shinKeisei33_2_head;
    shinKeisei33_head_timed;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei33_head_rev, cargo_subtype){
    1:shinKeisei33_1_head_rev;    1:shinKeisei33_2_head_rev;
    shinKeisei33_head_rev_timed;
  }
