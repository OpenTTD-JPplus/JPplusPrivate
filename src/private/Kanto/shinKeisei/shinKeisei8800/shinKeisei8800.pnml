//*livery 1
  //panto-placers
    //var 1 8 cars
      switch(FEAT_TRAINS, SELF, sw_shinKeisei8800_panto_placer_main_1,position_in_vehid_chain %4){
        0: shinKeisei8800_mot;
        shinKeisei8800_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_shinKeisei8800_panto_placer_main_2,position_in_vehid_chain %5){
        0: shinKeisei8800_mot;
        2: shinKeisei8800_mot;
        default: shinKeisei8800_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_shinKeisei8800_panto_placer_main,num_vehs_in_vehid_chain){
        5..6: sw_shinKeisei8800_panto_placer_main_1;
        sw_shinKeisei8800_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8800_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: shinKeisei8800_end;
        shinKeisei8800_front;
    }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8800_lv,vehicle_type_id){
        mu_car: sw_shinKeisei8800_panto_placer_main;
        sw_shinKeisei8800_gfx_main;
    }
//
//*liveries
  switch(FEAT_TRAINS, SELF, sw_shinKeisei8800_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1986);
		2:string(LV_DATED,string(STR_LIVERY,string(LV_shinKeisei8800_2)),1986);
		3:string(LV_DATED,string(STR_LIVERY,string(LV_SHIN_KEISEI)),2014);
		4:string(LV_DATED,string(STR_LIVERY,string(LV_SHIN_KEISEI_KEISEI)),2026);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8800_capacity_main,vehicle_type_id){
      mu_car: 133;
      122;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8800_car_power_main,position_in_vehid_chain %4){
      0..1:return 135;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8800_power_main,vehicle_type_id){
      mu_car:sw_shinKeisei8800_car_power_main;
      return 0;
    }
