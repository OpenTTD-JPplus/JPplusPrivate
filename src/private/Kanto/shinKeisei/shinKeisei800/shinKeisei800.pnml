    0..1984: shinKeisei800_2_wag;
    shinKeisei800_2_wag_ac;
  }
//
  switch(FEAT_TRAINS, PARENT, sw_shinKeisei800_front_timed, build_year){
    0..1979:shinKeisei800_1_front;    sw_shinKeisei800_2_front;
  }
  switch(FEAT_TRAINS, PARENT, sw_shinKeisei800_end_timed, build_year){
    0..1979:shinKeisei800_1_end;    sw_shinKeisei800_2_end;
  }
  switch(FEAT_TRAINS,PARENT,sw_shinKeisei800_mot_1_timed, build_year){
    0..1979:shinKeisei800_1_mot_1;  sw_shinKeisei800_2_mot_1;
  }
  switch(FEAT_TRAINS,PARENT,sw_shinKeisei800_mot_1_rev_timed, build_year){
    0..1979:shinKeisei800_1_mot_1_rev;  sw_shinKeisei800_2_mot_1_rev;
  }
  switch(FEAT_TRAINS,PARENT,sw_shinKeisei800_wag_1_timed, build_year){
    0..1979:shinKeisei800_1_wag_1;  sw_shinKeisei800_2_wag_1;
  }
  switch(FEAT_TRAINS,PARENT,sw_shinKeisei800_mot_2_timed, build_year){
    0..1979:shinKeisei800_1_mot_2;  sw_shinKeisei800_2_mot_2;
  }
  switch(FEAT_TRAINS,PARENT,sw_shinKeisei800_mot_2_rev_timed, build_year){
    0..1979:shinKeisei800_1_mot_2_rev;  sw_shinKeisei800_2_mot_2_rev;
  }
  switch(FEAT_TRAINS,PARENT,sw_shinKeisei800_wag_timed, build_year){
    0..1979:shinKeisei800_1_wag;  sw_shinKeisei800_2_wag;
  }

  switch(FEAT_TRAINS,SELF,sw_shinKeisei800_front, cargo_subtype){
    1:shinKeisei800_1_front;    2:sw_shinKeisei800_2_front;
    sw_shinKeisei800_front_timed;
  }
  switch(FEAT_TRAINS,SELF,sw_shinKeisei800_end, cargo_subtype){
    1:shinKeisei800_1_end;    2:sw_shinKeisei800_2_end;
    sw_shinKeisei800_end_timed;
  }
  switch(FEAT_TRAINS,SELF,sw_shinKeisei800_mot_1, cargo_subtype){
    1:shinKeisei800_1_mot_1;  2:sw_shinKeisei800_2_mot_1;
    sw_shinKeisei800_mot_1_timed;
  }
  switch(FEAT_TRAINS,SELF,sw_shinKeisei800_mot_1_rev, cargo_subtype){
    1:shinKeisei800_1_mot_1_rev;  2:sw_shinKeisei800_2_mot_1_rev;
    sw_shinKeisei800_mot_1_rev_timed;
  }
  switch(FEAT_TRAINS,SELF,sw_shinKeisei800_wag_1, cargo_subtype){
    1:shinKeisei800_1_wag_1;  2:sw_shinKeisei800_2_wag_1;
    sw_shinKeisei800_wag_1_timed;
  }
  switch(FEAT_TRAINS,SELF,sw_shinKeisei800_mot_2, cargo_subtype){
    1:shinKeisei800_1_mot_2;  2:sw_shinKeisei800_2_mot_2;
    sw_shinKeisei800_mot_2_timed;
  }
  switch(FEAT_TRAINS,SELF,sw_shinKeisei800_mot_2_rev, cargo_subtype){
    1:shinKeisei800_1_mot_2_rev;  2:sw_shinKeisei800_2_mot_2_rev;
    sw_shinKeisei800_mot_2_rev_timed;
  }
  switch(FEAT_TRAINS,SELF,sw_shinKeisei800_wag, cargo_subtype){
    1:shinKeisei800_1_wag;  2:sw_shinKeisei800_2_wag;
    sw_shinKeisei800_wag_timed;
  }

//*livery 1
  //panto-placers
    //var 1 8 cars
      switch(FEAT_TRAINS, SELF, sw_shinKeisei800_panto_placer_main_1,position_in_vehid_chain %8){
        0: sw_shinKeisei800_mot_2_rev;
        2: sw_shinKeisei800_mot_1_rev;
        3: sw_shinKeisei800_wag_1;
        4: sw_shinKeisei800_mot_2_rev;
        sw_shinKeisei800_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_shinKeisei800_panto_placer_main_2,position_in_vehid_chain %5){
        1: sw_shinKeisei800_mot_1;
        default: sw_shinKeisei800_wag;
      }
    //var 3
      switch(FEAT_TRAINS, SELF, sw_shinKeisei800_panto_placer_main_3,position_in_vehid_chain %2){
        1: sw_shinKeisei800_mot_2;
        default: sw_shinKeisei800_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_shinKeisei800_panto_placer_main,num_vehs_in_vehid_chain){
        0..4: sw_shinKeisei800_panto_placer_main_2;
        5..6: sw_shinKeisei800_panto_placer_main_1;
        sw_shinKeisei800_panto_placer_main_3;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_shinKeisei800_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: sw_shinKeisei800_end;
        sw_shinKeisei800_front;
    }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei800_lv,vehicle_type_id){
        mu_car: sw_shinKeisei800_panto_placer_main;
        sw_shinKeisei800_gfx_main;
    }
//
//*liveries
  switch(FEAT_TRAINS, SELF, sw_shinKeisei800_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_TWO_TONE)),1971);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_shinKeisei8000_2)),1980);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_shinKeisei800_capacity_main,vehicle_type_id){
      mu_car: 140;
      130;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_shinKeisei800_car_power_main,position_in_vehid_chain_from_end %6){
      1:return 120;
      4:return 120;
      5:return 120;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei800_power_main ,vehicle_type_id){
      mu_car:sw_shinKeisei800_car_power_main;
      return 120;
    }
