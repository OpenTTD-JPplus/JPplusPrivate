//purchase
  spriteset(shinKeisei800_1_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei800/shinKeisei800_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei800_1_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei800/shinKeisei800_1.png"){ tmpl_purchase_2c_dual(0, 125) }
