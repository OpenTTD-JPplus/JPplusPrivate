//purchase
  spriteset(shinKeisei300_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei300_purchase_c2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_1.png"){ tmpl_purchase_2c_dual_7(0, 50) }
  spriteset(shinKeisei300_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei300_purchase_c2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_2.png"){ tmpl_purchase_2c_dual_7(0, 50) }
  GRAPHIC_STACK_2(shinKeisei300_purchase_1, shinKeisei300_purchase_c1_1, shinKeisei300_purchase_c2_1)
  GRAPHIC_STACK_2(shinKeisei300_purchase_2, shinKeisei300_purchase_c1_2, shinKeisei300_purchase_c2_2)

  switch(FEAT_TRAINS, SELF, shinKeisei300_purchase,current_year){
    0..1952:shinKeisei300_purchase_1;
    shinKeisei300_purchase_2;
  }
//
spriteset (shinKeisei300_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_1.png") { tmpl_std_v3(0, 25) }
spriteset (shinKeisei300_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_1.png") { tmpl_std_v3(0, 50) }
spriteset (shinKeisei300_1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_1.png") { tmpl_std_rev_v3(0, 50) }

spriteset (shinKeisei300_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_2.png") { tmpl_std_v3(0, 0) }
spriteset (shinKeisei300_2_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_2.png") { tmpl_std_v3(0, 25) }
spriteset (shinKeisei300_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_2.png") { tmpl_std_v3(0, 50) }
spriteset (shinKeisei300_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_2.png") { tmpl_std_v3(0, 75) }
spriteset (shinKeisei300_2_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei300/shinKeisei300_2.png") { tmpl_std_rev_v3(0, 75) }

switch(FEAT_TRAINS, PARENT, sw_shinKeisei300_2_front_gfx, vehicle_is_reversed){
  1: shinKeisei300_2_front;  shinKeisei300_2_front_mot;
}
switch(FEAT_TRAINS, PARENT, sw_shinKeisei300_2_end_gfx, vehicle_is_reversed){
  1: shinKeisei300_2_end_mot;  shinKeisei300_2_end;
}
switch(FEAT_TRAINS, PARENT, shinKeisei300_front_timed, current_year){
  0..1952:shinKeisei300_1_front;  sw_shinKeisei300_2_front_gfx;
}
switch(FEAT_TRAINS, PARENT, shinKeisei300_end_timed, current_year){
  0..1952:shinKeisei300_1_end;  sw_shinKeisei300_2_end_gfx;
}
switch(FEAT_TRAINS, PARENT, shinKeisei300_mot_timed, current_year){
  0..1952:shinKeisei300_1_end;  shinKeisei300_2_end_mot;
}
switch(FEAT_TRAINS, PARENT, shinKeisei300_mot_rev_timed, current_year){
  0..1952:shinKeisei300_1_end_rev;  shinKeisei300_2_end_rev;
}

switch(FEAT_TRAINS,SELF,shinKeisei300_front, cargo_subtype){
  1: shinKeisei300_1_front; 2:sw_shinKeisei300_2_front_gfx; shinKeisei300_front_timed;
}
switch(FEAT_TRAINS,SELF,shinKeisei300_end, cargo_subtype){
  1: shinKeisei300_1_end; 2:sw_shinKeisei300_2_end_gfx; shinKeisei300_end_timed;
}
switch(FEAT_TRAINS,SELF,shinKeisei300_mot, cargo_subtype){
  1: shinKeisei300_1_end; 2:shinKeisei300_2_end_mot; shinKeisei300_mot_timed;
}
switch(FEAT_TRAINS,SELF,shinKeisei300_mot_rev, cargo_subtype){
  1: shinKeisei300_1_end_rev; 2:shinKeisei300_2_end_rev; shinKeisei300_mot_rev_timed;
}
//
  switch(FEAT_TRAINS, SELF, shinKeisei300_head, train_is_driving_backwards != vehicle_is_flipped){
    1:shinKeisei300_end;    shinKeisei300_front;
  }
//*livery 1
  //main
    switch(FEAT_TRAINS, SELF, sw_shinKeisei300_panto_placer_main, position_in_vehid_chain%2){
      0:shinKeisei300_mot_rev;
      shinKeisei300_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei300_lv,vehicle_type_id){
      mu_car: sw_shinKeisei300_panto_placer_main;
      shinKeisei300_head;
    }
//
//liveries
  switch(FEAT_TRAINS, SELF, sw_shinKeisei300_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_OLD)),1948);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_TWO_TONE)),1953);
  }
//
// post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_shinKeisei300_car_power_main,position_in_vehid_chain %2){
      0:return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei300_power_main,vehicle_type_id){
      mu_car:sw_shinKeisei300_car_power_main;
      return 100;
    }
