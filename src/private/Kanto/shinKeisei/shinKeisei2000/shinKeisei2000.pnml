//purchase
  spriteset(shinKeisei2000_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png"){ tmpl_purchase_1c(0, 0) }
  spriteset(shinKeisei2000_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png"){ tmpl_purchase_1c_dual(0, 50) }
  spriteset(shinKeisei2000_purchase_c2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png"){ tmpl_purchase_2c_dual(0, 150) }
  GRAPHIC_STACK_2(shinKeisei2000_purchase_2, shinKeisei2000_purchase_c1_2, shinKeisei2000_purchase_c2_2)
// purchase
  switch(FEAT_TRAINS, SELF, shinKeisei2000_purchase, current_year){
    0..1967:shinKeisei2000_purchase_c1_1;
    shinKeisei2000_purchase_2;
  }
//
//livery 1
spriteset (shinKeisei2000_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png") { tmpl_std_v3(0, 50) }
spriteset (shinKeisei2000_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png") { tmpl_std_v3(0, 75) }
spriteset (shinKeisei2000_1_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png") { tmpl_std_rev_v3(0, 75) }
spriteset (shinKeisei2000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png") { tmpl_symm_v3(0, 150) }

spriteset (shinKeisei2000_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png") { tmpl_std_v3(0, 50) }
spriteset (shinKeisei2000_2_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png") { tmpl_std_v3(0, 75) }
spriteset (shinKeisei2000_2_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png") { tmpl_std_rev_v3(0, 75) }
spriteset (shinKeisei2000_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png") { tmpl_symm_v3(0, 150) }

  switch(FEAT_TRAINS, PARENT, shinKeisei2000_front_mot_timed, current_year){
    0..1967:shinKeisei2000_1_front_mot;    shinKeisei2000_2_front_mot;
  }
  switch(FEAT_TRAINS, PARENT, shinKeisei2000_end_mot_timed, current_year){
    0..1967:shinKeisei2000_1_end_mot;    shinKeisei2000_2_end_mot;
  }
  switch(FEAT_TRAINS, PARENT, shinKeisei2000_end_mot_rev_timed, current_year){
    0..1967:shinKeisei2000_1_end_mot_rev;    shinKeisei2000_2_end_mot_rev;
  }
  switch(FEAT_TRAINS, PARENT, shinKeisei2000_wag_timed, current_year){
    0..1967:shinKeisei2000_1_wag;    shinKeisei2000_2_wag;
  }

  switch(FEAT_TRAINS, SELF, shinKeisei2000_front_mot, cargo_subtype){
    1:shinKeisei2000_1_front_mot;    2:shinKeisei2000_2_front_mot;
    shinKeisei2000_front_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei2000_end_mot, cargo_subtype){
    1:shinKeisei2000_1_end_mot;    2:shinKeisei2000_2_end_mot;
    shinKeisei2000_end_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei2000_end_mot_rev, cargo_subtype){
    1:shinKeisei2000_1_end_mot_rev;    2:shinKeisei2000_2_end_mot_rev;
    shinKeisei2000_end_mot_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei2000_wag, cargo_subtype){
    1:shinKeisei2000_1_wag;    2:shinKeisei2000_2_wag;
    shinKeisei2000_wag_timed;
  }
//*livery 1
  //panto-placers
    //var 1 6
      switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_panto_placer_main_1,position_in_vehid_chain %3){
        1: shinKeisei2000_end_mot_rev;
        2: shinKeisei2000_end_mot;
        shinKeisei2000_wag;
      }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_panto_placer_main,num_vehs_in_vehid_chain){
        1: shinKeisei2000_wag;
        sw_shinKeisei2000_panto_placer_main_1;
      }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
    1: shinKeisei2000_end_mot;
    shinKeisei2000_front_mot;
  }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_lv,vehicle_type_id){
    mu_car: sw_shinKeisei2000_panto_placer_main;
    sw_shinKeisei2000_gfx_main;
  }
//*liveries
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_TWO_TONE)),1950);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_shinKeisei8000_2)),1968);
  }
//
switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_car_power_main,position_in_vehid_chain_from_end %2){
    0:return 110;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_power_main ,vehicle_type_id){
    mu_car:sw_shinKeisei2000_car_power_main;
    return 110;
  }