//purchase
  spriteset(shinKeisei2000_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png"){ tmpl_purchase_1c(0, 0) }
  spriteset(shinKeisei2000_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png"){ tmpl_purchase_1c(0, 25) }
// purchase
  switch(FEAT_TRAINS, SELF, shinKeisei2000_purchase, current_year){
    0..1967:shinKeisei2000_purchase_c1_1;
    shinKeisei2000_purchase_c1_2;
  }
//
//livery 1
  spriteset(shinKeisei2000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(shinKeisei2000_lights_front_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_lights.png"){ tmpl_std_rev_v3(0, 0) }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_lights_1, train_is_driving_backwards != vehicle_is_flipped){
    1: gfx_empty;
    shinKeisei2000_lights_front;
  }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_lights_rev, train_is_driving_backwards != vehicle_is_flipped){
    1: shinKeisei2000_lights_front_rev;
    gfx_empty;
  }
  switch(FEAT_TRAINS, PARENT, sw_shinKeisei2000_lights_s, vehicle_is_reversed){
    1:sw_shinKeisei2000_lights_rev;
    sw_shinKeisei2000_lights_1;
  }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_lights, num_vehs_in_vehid_chain){
    1:sw_shinKeisei2000_lights_s;
    sw_shinKeisei2000_lights_1;
  }
spriteset (shinKeisei2000_1_head_mot_s, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png") { tmpl_std_v3(0, 0) }
spriteset (shinKeisei2000_1_head_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png") { tmpl_std_v3(0, 25) }
spriteset (shinKeisei2000_1_head_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png") { tmpl_std_rev_v3(0, 25) }
spriteset (shinKeisei2000_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png") { tmpl_std_rev_v3(0, 50) }
spriteset (shinKeisei2000_1_car, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_1.png") { tmpl_symm_v3(0, 75) }

spriteset (shinKeisei2000_2_head_mot_s, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png") { tmpl_std_v3(0, 0) }
spriteset (shinKeisei2000_2_head_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png") { tmpl_std_v3(0, 25) }
spriteset (shinKeisei2000_2_head_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png") { tmpl_std_rev_v3(0, 25) }
spriteset (shinKeisei2000_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png") { tmpl_std_rev_v3(0, 50) }
spriteset (shinKeisei2000_2_car, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei2000/shinKeisei2000_2.png") { tmpl_symm_v3(0, 75) }

  switch(FEAT_TRAINS, PARENT, shinKeisei2000_head_mot_s_timed, current_year){
    0..1967:shinKeisei2000_1_head_mot_s;    shinKeisei2000_2_head_mot_s;
  }
  switch(FEAT_TRAINS, PARENT, shinKeisei2000_head_mot_timed, current_year){
    0..1967:shinKeisei2000_1_head_mot;    shinKeisei2000_2_head_mot;
  }
  switch(FEAT_TRAINS, PARENT, shinKeisei2000_head_mot_rev_timed, current_year){
    0..1967:shinKeisei2000_1_head_mot_rev;    shinKeisei2000_2_head_mot_rev;
  }
  switch(FEAT_TRAINS, PARENT, shinKeisei2000_head_timed, current_year){
    0..1967:shinKeisei2000_1_head;    shinKeisei2000_2_head;
  }
  switch(FEAT_TRAINS, PARENT, shinKeisei2000_car_timed, current_year){
    0..1967:shinKeisei2000_1_car;    shinKeisei2000_2_car;
  }

  switch(FEAT_TRAINS, SELF, shinKeisei2000_head_mot_s, cargo_subtype){
    1:shinKeisei2000_1_head_mot_s;    2:shinKeisei2000_2_head_mot_s;
    shinKeisei2000_head_mot_s_timed;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei2000_head_mot, cargo_subtype){
    1:shinKeisei2000_1_head_mot;    2:shinKeisei2000_2_head_mot;
    shinKeisei2000_head_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei2000_head_mot_rev, cargo_subtype){
    1:shinKeisei2000_1_head_mot_rev;    2:shinKeisei2000_2_head_mot_rev;
    shinKeisei2000_head_mot_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei2000_head, cargo_subtype){
    1:shinKeisei2000_1_head;    2:shinKeisei2000_2_head;
    shinKeisei2000_head_timed;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei2000_car, cargo_subtype){
    1:shinKeisei2000_1_car;    2:shinKeisei2000_2_car;
    shinKeisei2000_car_timed;
  }
//*livery 1
  //special gfx
    switch(FEAT_TRAINS, SELF, shinKeisei2000_front_gfx, num_vehs_in_vehid_chain){
      1:shinKeisei2000_head_mot_s;
      shinKeisei2000_head_mot;
    }
    switch(FEAT_TRAINS, SELF, shinKeisei2000_end_gfx, num_vehs_in_vehid_chain==2&&position_in_vehid_chain==1){
      1:shinKeisei2000_head;
      shinKeisei2000_head_mot_rev;
    }
  //panto-placers
    //var 1 6
      switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_panto_placer_main_1,position_in_vehid_chain %3){
        1: shinKeisei2000_head_mot_rev;
        2: shinKeisei2000_head_mot;
        shinKeisei2000_car;
      }
      switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_panto_placer_main_2,position_in_vehid_chain %4){
        2: shinKeisei2000_head_mot_rev;
        3: shinKeisei2000_head_mot;
        shinKeisei2000_car;
      }
      switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_panto_placer_main_cool,num_vehs_in_vehid_chain%2){
        1: sw_shinKeisei2000_panto_placer_main_1;
        sw_shinKeisei2000_panto_placer_main_2;
      }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_panto_placer_main,num_vehs_in_vehid_chain){
        0..4: shinKeisei2000_car;
        sw_shinKeisei2000_panto_placer_main_cool;
      }
    TRAIN_CONSTRUCTOR_2(shinKeisei2000_end_main, shinKeisei2000_end_gfx, sw_shinKeisei2000_lights_rev)
    TRAIN_CONSTRUCTOR_2(shinKeisei2000_front_main, shinKeisei2000_front_gfx, sw_shinKeisei2000_lights)
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_gfx_main,position_in_vehid_chain_from_end){
    0: shinKeisei2000_end_main;
    sw_shinKeisei2000_panto_placer_main;
  }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_lv,position_in_vehid_chain){
    0: shinKeisei2000_front_main;
    sw_shinKeisei2000_gfx_main;
  }
//*liveries
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_TWO_TONE)),1950);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_shinKeisei8000_2)),1968);
  }
//
switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_car_power_main,position_in_vehid_chain_from_end %2){
    0:return 110;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei2000_power_main ,vehicle_type_id){
    shinKeisei2000:sw_shinKeisei2000_car_power_main;
    return 110;
  }