//purchase
  spriteset(shinKeisei800n_1_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei800n/shinKeisei800n_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei800n_1_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei800n/shinKeisei800n_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  
  spriteset(shinKeisei800n_2_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei800n/shinKeisei800n_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei800n_2_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/shinKeisei/shinKeisei800n/shinKeisei800n_2.png"){ tmpl_purchase_2c_dual(0, 25) }
  switch(FEAT_TRAINS, SELF, shinKeisei800n_purchase_c1, current_year){
    0..2013:shinKeisei800n_1_purchase_c1;
    shinKeisei800n_2_purchase_c1;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei800n_purchase_c2, current_year){
    0..2013:shinKeisei800n_1_purchase_c2;
    shinKeisei800n_2_purchase_c2;
  }
  GRAPHIC_STACK_5(shinKeisei800n_purchase, shinKeisei800n_purchase_c1, shinKeisei800n_purchase_c2, ac_single_1_c1, ac_single_1_c2, panto_arm_n_c2)

//livery 1
spriteset (shinKeisei800n_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/shinKeisei/shinKeisei800n/shinKeisei800n_1.png") { tmpl_std_v3(0, 0) }
spriteset (shinKeisei800n_1_car, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/shinKeisei/shinKeisei800n/shinKeisei800n_1.png") { tmpl_symm_v3(0, 25) }

spriteset (shinKeisei800n_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/shinKeisei/shinKeisei800n/shinKeisei800n_2.png") { tmpl_std_v3(0, 0) }
spriteset (shinKeisei800n_2_car, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/shinKeisei/shinKeisei800n/shinKeisei800n_2.png") { tmpl_symm_v3(0, 25) }
//
  switch(FEAT_TRAINS, SELF, shinKeisei800n_head_timed, current_year){
    0..2013:shinKeisei800n_1_head;
    2014..2025:shinKeisei800n_2_head;
    keisei3000n_1_head;
  }
  switch(FEAT_TRAINS, SELF, shinKeisei800n_car_timed, current_year){
    0..2013:shinKeisei800n_1_car;
    2014..2025:shinKeisei800n_2_car;
    keisei3000n_1_car;
  }

  switch(FEAT_TRAINS, SELF, sw_shinKeisei800n_head, cargo_subtype){
    1:shinKeisei800n_1_head;    2:shinKeisei800n_2_head;    
    3:keisei3000n_1_head;       shinKeisei800n_head_timed;
  }
  switch(FEAT_TRAINS, SELF, sw_shinKeisei800n_car, cargo_subtype){
    1:shinKeisei800n_1_car;    2:shinKeisei800n_2_car;    
    3:keisei3000n_1_car;       shinKeisei800n_car_timed;
  }
  TRAIN_CONSTRUCTOR_3(shinKeisei800n_head, sw_shinKeisei800n_head, sw_keisei3000n_lights, ac_single_1_1)
  TRAIN_CONSTRUCTOR_2(shinKeisei800n_wag, sw_shinKeisei800n_car, ac_single_1_1)
  TRAIN_CONSTRUCTOR_3(shinKeisei800n_mot, sw_shinKeisei800n_car, ac_single_1_1, panto_arm_n_single)
  TRAIN_CONSTRUCTOR_3(shinKeisei800n_mot_2, sw_shinKeisei800n_car, ac_single_1_1, panto_arm_n)
//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_shinKeisei800n_panto_placer_main_1,position_in_vehid_chain %8){
        0: shinKeisei800n_mot_2;
        2: shinKeisei800n_mot;
        5: shinKeisei800n_mot_2;
        shinKeisei800n_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_shinKeisei800n_panto_placer_main_2,position_in_vehid_chain_from_end %3){
        0: shinKeisei800n_mot_2;
        default: shinKeisei800n_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_shinKeisei800n_panto_placer_main,num_vehs_in_vehid_chain){
        4..5: sw_shinKeisei800n_panto_placer_main_2;
        sw_shinKeisei800n_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_shinKeisei800n_lv,vehicle_type_id){
        mu_car: sw_shinKeisei800n_panto_placer_main;
        shinKeisei800n_head;
    }
//
//*liveries
  switch(FEAT_TRAINS, SELF, sw_shinKeisei800n_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2005);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_SHIN_KEISEI)),2014);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_SHIN_KEISEI_KEISEI)),2026);
  }