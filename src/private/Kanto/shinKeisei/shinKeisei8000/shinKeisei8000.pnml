//purchase
  spriteset(shinKeisei8000_1_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei8000/shinKeisei8000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei8000_1_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei8000/shinKeisei8000_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(shinKeisei8000_1_purchase, shinKeisei8000_1_purchase_c1, shinKeisei8000_1_purchase_c2)
  
  spriteset(shinKeisei8000_2_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei8000/shinKeisei8000_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei8000_2_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/shinKeisei/shinKeisei8000/shinKeisei8000_2.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(shinKeisei8000_2_purchase, shinKeisei8000_2_purchase_c1, shinKeisei8000_2_purchase_c2)
  
  spriteset(shinKeisei8000_3_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/shinKeisei/shinKeisei8000/shinKeisei8000_3.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(shinKeisei8000_3_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/shinKeisei/shinKeisei8000/shinKeisei8000_3.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(shinKeisei8000_3_purchase, shinKeisei8000_3_purchase_c1, shinKeisei8000_3_purchase_c2)

  switch(FEAT_TRAINS, PARENT, shinKeisei8000_purchase, current_year){
		0..1978: shinKeisei8000_1_purchase;
		1979..2013: shinKeisei8000_2_purchase;
		shinKeisei8000_3_purchase;
	}
