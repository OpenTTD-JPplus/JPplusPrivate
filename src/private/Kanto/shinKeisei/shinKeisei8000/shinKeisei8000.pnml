switch(FEAT_TRAINS, SELF, shinKeisei8000_front_timed, current_year){
  0..1978:shinKeisei8000_1_front;  1979..2013:shinKeisei8000_2_front;
  shinKeisei8000_3_front;
}
switch(FEAT_TRAINS, SELF, shinKeisei8000_end_timed, current_year){
  0..1978:shinKeisei8000_1_end;  1979..2013:shinKeisei8000_2_end;
  shinKeisei8000_3_end;
}
switch(FEAT_TRAINS, SELF, shinKeisei8000_mot_timed, current_year){
  0..1978:shinKeisei8000_1_mot;  1979..2013:shinKeisei8000_2_mot;
  shinKeisei8000_3_mot;
}
switch(FEAT_TRAINS, SELF, shinKeisei8000_wag_timed, current_year){
  0..1978:shinKeisei8000_1_wag;  1979..2013:shinKeisei8000_2_wag;
  shinKeisei8000_3_wag;
}

switch(FEAT_TRAINS, SELF, shinKeisei8000_front, cargo_subtype){
  0:shinKeisei8000_front_timed;  1:shinKeisei8000_1_front;
  2:shinKeisei8000_2_front;  shinKeisei8000_1_front;
}
switch(FEAT_TRAINS, SELF, shinKeisei8000_end, cargo_subtype){
  0:shinKeisei8000_end_timed;  1:shinKeisei8000_1_end;
  2:shinKeisei8000_2_end;  shinKeisei8000_1_end;
}
switch(FEAT_TRAINS, SELF, shinKeisei8000_mot, cargo_subtype){
  0:shinKeisei8000_mot_timed;  1:shinKeisei8000_1_mot;
  2:shinKeisei8000_2_mot;  shinKeisei8000_1_mot;
}
switch(FEAT_TRAINS, SELF, shinKeisei8000_wag, cargo_subtype){
  0:shinKeisei8000_wag_timed;  1:shinKeisei8000_1_wag;
  2:shinKeisei8000_2_wag;  shinKeisei8000_1_wag;
}
//*livery 1
  //panto-placers
    //var 1 8 cars
      switch(FEAT_TRAINS, SELF, sw_shinKeisei8000_panto_placer_main_1,position_in_vehid_chain %4){
        0: shinKeisei8000_mot;
        shinKeisei8000_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_shinKeisei8000_panto_placer_main_2,position_in_vehid_chain %5){
        0: shinKeisei8000_mot;
        2: shinKeisei8000_mot;
        default: shinKeisei8000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_shinKeisei8000_panto_placer_main,num_vehs_in_vehid_chain){
        5..6: sw_shinKeisei8000_panto_placer_main_1;
        sw_shinKeisei8000_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8000_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: shinKeisei8000_end;
        shinKeisei8000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8000_lv,vehicle_type_id){
        mu_car: sw_shinKeisei8000_panto_placer_main;
        sw_shinKeisei8000_gfx_main;
    }
//
//*liveries
  switch(FEAT_TRAINS, SELF, sw_shinKeisei8000_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
		1:string(LV_DATED,string(STR_LIVERY,string(LV_TWO_TONE)),1978);
		2:string(LV_DATED,string(STR_LIVERY,string(LV_shinKeisei8000_2)),1979);
		3:string(LV_DATED,string(STR_LIVERY,string(LV_SHIN_KEISEI)),2014);
	}
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8000_capacity_main,vehicle_type_id){
      mu_car: 133;
      122;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8000_car_power_main,position_in_vehid_chain %4){
      0..1:return 135;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8000_power_main,vehicle_type_id){
      mu_car:sw_shinKeisei8000_car_power_main;
      return 0;
    }
  //speed fix
    switch(FEAT_TRAINS, SELF, sw_shinKeisei8000_speed_main,build_year){
      0..2006: 100;
      110;
    }
