//purchase
  spriteset(chibaE_1000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/chibaExpress/chibaE_1000/chibaE_1000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(chibaE_1000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/chibaExpress/chibaE_1000/chibaE_1000.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(chibaE_1000_purchase, chibaE_1000_purchase_c1, chibaE_1000_purchase_c2)
//livery 1
spriteset (chibaE_1000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_1000/chibaE_1000.png") { tmpl_std_v3(0, 0) }
spriteset (chibaE_1000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_1000/chibaE_1000.png") { tmpl_std_v3(0, 25) }
spriteset (chibaE_1000_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_1000/chibaE_1000.png") { tmpl_std_rev_v3(0, 25) }
spriteset (chibaE_1000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_1000/chibaE_1000.png") { tmpl_std_v3(0, 50) }
spriteset (chibaE_1000_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_1000/chibaE_1000.png") { tmpl_std_rev_v3(0, 50) }
spriteset (chibaE_1000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_1000/chibaE_1000.png") { tmpl_std_v3(0, 75) }

//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_chibaE_1000_panto_placer_main,position_in_vehid_chain %4){
        0: chibaE_1000_mot_rev;
        1: chibaE_1000_mot;
        chibaE_1000_wag;
      }
  //fake-head-placer
    //var 1 (8+)
      switch(FEAT_TRAINS, SELF, sw_chibaE_1000_fake_head_placer_gfx,position_in_vehid_chain){
        2: chibaE_1000_end_rev;
        3: chibaE_1000_end;
        sw_chibaE_1000_panto_placer_main;
      }
      switch(FEAT_TRAINS, SELF, sw_chibaE_1000_fake_head_placer_main,num_vehs_in_vehid_chain>5){
        1: sw_chibaE_1000_fake_head_placer_gfx;
        sw_chibaE_1000_panto_placer_main;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_chibaE_1000_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: chibaE_1000_end;
        chibaE_1000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_chibaE_1000_lv,vehicle_type_id){
        mu_car: sw_chibaE_1000_fake_head_placer_main;
        sw_chibaE_1000_gfx_main;
    }
