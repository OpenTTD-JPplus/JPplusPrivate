//purchase
  spriteset(chibaE_3050_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/chibaExpress/chibaE_3050/chibaE_3050.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(chibaE_3050_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/chibaExpress/chibaE_3050/chibaE_3050.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(chibaE_3050_purchase, chibaE_3050_purchase_c1, chibaE_3050_purchase_c2)
//livery 1
spriteset (chibaE_3050_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_3050/chibaE_3050.png") { tmpl_std_v3(0, 0) }
spriteset (chibaE_3050_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_3050/chibaE_3050.png") { tmpl_std_v3(0, 25) }
spriteset (chibaE_3050_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_3050/chibaE_3050.png") { tmpl_std_v3(0, 50) }
spriteset (chibaE_3050_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_3050/chibaE_3050.png") { tmpl_std_v3(0, 75) }
spriteset (chibaE_3050_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_3050/chibaE_3050.png") { tmpl_std_rev_v3(0, 75) }
spriteset (chibaE_3050_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_3050/chibaE_3050.png") { tmpl_std_v3(0, 100) }
spriteset (chibaE_3050_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_3050/chibaE_3050.png") { tmpl_symm_v3(0, 125) }

//*livery 1
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_chibaE_3050_front, vehicle_is_reversed){
      1:chibaE_3050_front;
      chibaE_3050_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_chibaE_3050_end, vehicle_is_reversed){
      1:chibaE_3050_end_mot;
      chibaE_3050_end;
    }
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_chibaE_3050_panto_placer_main,position_in_vehid_chain %2){
        1: chibaE_3050_mot;
        chibaE_3050_wag;
      }
  //fake-head-placer
    //var 1 (8+)
      switch(FEAT_TRAINS, SELF, sw_chibaE_3050_fake_head_placer_gfx,position_in_vehid_chain){
        2: chibaE_3050_end_rev;
        3: chibaE_3050_end_mot;
        sw_chibaE_3050_panto_placer_main;
      }
      switch(FEAT_TRAINS, SELF, sw_chibaE_3050_fake_head_placer_main,num_vehs_in_vehid_chain>5){
        1: sw_chibaE_3050_fake_head_placer_gfx;
        sw_chibaE_3050_panto_placer_main;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_chibaE_3050_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: sw_chibaE_3050_end;
        sw_chibaE_3050_front;
    }
    switch(FEAT_TRAINS, SELF, sw_chibaE_3050_lv,vehicle_type_id){
        mu_car: sw_chibaE_3050_fake_head_placer_main;
        sw_chibaE_3050_gfx_main;
    }
