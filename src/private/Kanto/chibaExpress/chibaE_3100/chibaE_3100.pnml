//purchase
  spriteset(chibaE_3100_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3100.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(chibaE_3100_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3100.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(chibaE_3100_purchase, chibaE_3100_purchase_c1, chibaE_3100_purchase_c2)
//livery 1
spriteset (chibaE_3100_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3100.png") { tmpl_std_v3(0, 0) }
spriteset (chibaE_3100_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3100.png") { tmpl_std_v3(0, 25) }
spriteset (chibaE_3100_1_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3100.png") { tmpl_std_rev_v3(0, 25) }
spriteset (chibaE_3100_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3100.png") { tmpl_std_v3(0, 50) }
spriteset (chibaE_3100_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3100.png") { tmpl_std_rev_v3(0, 75) }
spriteset (chibaE_3100_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3100.png") { tmpl_std_v3(0, 100) }
spriteset (chibaE_3100_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3100.png") { tmpl_symm_v3(0, 125) }

spriteset (chibaE_3100_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3150.png") { tmpl_std_v3(0, 0) }
spriteset (chibaE_3100_2_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3150.png") { tmpl_std_v3(0, 25) }
spriteset (chibaE_3100_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3150.png") { tmpl_std_v3(0, 50) }
spriteset (chibaE_3100_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3150.png") { tmpl_std_v3(0, 75) }
spriteset (chibaE_3100_2_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaExpress/chibaE_3100/chibaE_3150.png") { tmpl_std_v3(0, 75) }

//*livery 1
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_chibaE_3100_1_front, vehicle_is_reversed){
      1:chibaE_3100_1_front;
      chibaE_3100_1_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_chibaE_3100_1_end, vehicle_is_reversed){
      1:chibaE_3100_1_end_mot;
      chibaE_3100_1_end;
    }  
    switch(FEAT_TRAINS, PARENT, sw_chibaE_3100_2_front, vehicle_is_reversed){
      1:chibaE_3100_2_front;
      chibaE_3100_2_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_chibaE_3100_2_end, vehicle_is_reversed){
      1:chibaE_3100_2_end_mot;
      chibaE_3100_2_end;
    }  
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_chibaE_3100_panto_placer_main,position_in_vehid_chain %2){
        1: chibaE_3100_mot;
        chibaE_3100_wag;
      }
  //fake-head-placer
    //var 1 (8+)
      switch(FEAT_TRAINS, SELF, sw_chibaE_3100_fake_head_placer_gfx,position_in_vehid_chain){
        2: chibaE_3100_1_end;
        3: chibaE_3100_1_end_mot_rev;
        sw_chibaE_3100_panto_placer_main;
      }
      switch(FEAT_TRAINS, SELF, sw_chibaE_3100_fake_head_placer_main,num_vehs_in_vehid_chain>5){
        1: sw_chibaE_3100_fake_head_placer_gfx;
        sw_chibaE_3100_panto_placer_main;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_chibaE_3100_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: sw_chibaE_3100_1_end;
        sw_chibaE_3100_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_chibaE_3100_livery_1,vehicle_type_id){
        mu_car: sw_chibaE_3100_fake_head_placer_main;
        sw_chibaE_3100_gfx_main;
    }
//*livery 2 3150
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_chibaE_3150_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: sw_chibaE_3100_2_end;
        sw_chibaE_3100_2_front;
    }
    switch(FEAT_TRAINS, SELF, sw_chibaE_3100_livery_2,vehicle_type_id){
        mu_car: sw_chibaE_3150_gfx_main;
        sw_chibaE_3100_fake_head_placer_main;
    }
//liveries 
random_switch(FEAT_TRAINS, PARENT, sw_chibaE_3100_lv){
  1:sw_chibaE_3100_livery_1;
  1:sw_chibaE_3100_livery_2;
}
