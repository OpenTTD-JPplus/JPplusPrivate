//purchase
  spriteset(chibaNT_9100_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9100/chibaNT_9100.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(chibaNT_9100_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9100/chibaNT_9100.png"){ tmpl_purchase_2c_dual(0, 75) }
  GRAPHIC_STACK_3(chibaNT_9100_purchase, logo_chiba_nt, chibaNT_9100_purchase_c1, chibaNT_9100_purchase_c2)
//livery 1
spriteset (chibaNT_9100_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9100/chibaNT_9100.png") { tmpl_std_v3(0, 0) }
spriteset (chibaNT_9100_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9100/chibaNT_9100.png") { tmpl_std_v3(0, 25) }
spriteset (chibaNT_9100_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9100/chibaNT_9100.png") { tmpl_std_rev_v3(0, 50) }
spriteset (chibaNT_9100_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9100/chibaNT_9100.png") { tmpl_std_v3(0, 75) }
spriteset (chibaNT_9100_mot_2_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9100/chibaNT_9100.png") { tmpl_std_rev_v3(0, 75) }
spriteset (chibaNT_9100_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9100/chibaNT_9100.png") { tmpl_std_v3(0, 100) }
spriteset (chibaNT_9100_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9100/chibaNT_9100.png") { tmpl_std_rev_v3(0, 100) }

//*livery 1
  //special gfx
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_wag,position_in_vehid_chain>(num_vehs_in_vehid_chain/2)){
      1:chibaNT_9100_wag_rev;
      chibaNT_9100_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_mot_2,position_in_vehid_chain>(num_vehs_in_vehid_chain/2)){
      1:chibaNT_9100_mot_2_rev;
      chibaNT_9100_mot_2;
    }
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_panto_placer_main_1,position_in_vehid_chain){
        0: sw_chibaNT_9100_mot_2;
        3: chibaNT_9100_mot_rev;
        5: sw_chibaNT_9100_mot_2;
        sw_chibaNT_9100_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_panto_placer_main_2,position_in_vehid_chain %3){
        1: sw_chibaNT_9100_mot_2;
        default: sw_chibaNT_9100_wag;
      }
    //var 3
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_panto_placer_main_3,position_in_vehid_chain %2){
        0: chibaNT_9100_mot_2;
        default: sw_chibaNT_9100_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_panto_placer_main,num_vehs_in_vehid_chain){
        0..2:sw_chibaNT_9100_panto_placer_main_1;
        3: sw_chibaNT_9100_panto_placer_main_2;
        4: sw_chibaNT_9100_panto_placer_main_3;
        5: sw_chibaNT_9100_panto_placer_main_2;
        sw_chibaNT_9100_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: chibaNT_9100_end;
        chibaNT_9100_front;
    }
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_lv,vehicle_type_id){
        mu_car: sw_chibaNT_9100_panto_placer_main;
        sw_chibaNT_9100_gfx_main;
    }
//post fixers
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_capacity_main,vehicle_type_id){
      mu_car: 132;
      121;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_car_power_main,position_in_vehid_chain %3){
      0:return 130;
      2:return 130;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9100_power_main,vehicle_type_id){
      mu_car:sw_chibaNT_9100_car_power_main;
      return 130*2;
    }
