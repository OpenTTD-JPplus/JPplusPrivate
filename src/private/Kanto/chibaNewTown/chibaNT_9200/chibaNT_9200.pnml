  TRAIN_CONSTRUCTOR_3(chibaNT_9200_head, chibaNT_9200_head_base, sw_keisei3000n_lights, ac_single_1_1)
  TRAIN_CONSTRUCTOR_2(chibaNT_9200_wag, chibaNT_9200_car, ac_single_1_1)
  TRAIN_CONSTRUCTOR_3(chibaNT_9200_mot, chibaNT_9200_car, ac_single_1_1, panto_arm_n_single)
