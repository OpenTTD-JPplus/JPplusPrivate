//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9200_panto_placer_main_1,position_in_vehid_chain %8){
        0: chibaNT_9200_mot_2;
        2: chibaNT_9200_mot;
        5: chibaNT_9200_mot_2;
        chibaNT_9200_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9200_panto_placer_main_2,position_in_vehid_chain_from_end %3){
        0: chibaNT_9200_mot_2;
        default: chibaNT_9200_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9200_panto_placer_main,num_vehs_in_vehid_chain){
        4..5: sw_chibaNT_9200_panto_placer_main_2;
        sw_chibaNT_9200_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9200_lv,vehicle_type_id){
        mu_car: sw_chibaNT_9200_panto_placer_main;
        chibaNT_9200_head;
    }
