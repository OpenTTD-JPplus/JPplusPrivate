  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9800_panto_placer_main_1,position_in_vehid_chain %8){
        0: chibaNT_9800_mot_2;
        2: chibaNT_9800_mot;
        5: chibaNT_9800_mot_2;
        chibaNT_9800_car;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9800_panto_placer_main_2,position_in_vehid_chain_from_end %3){
        0: chibaNT_9800_mot_2;
        chibaNT_9800_car;
      }
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9800_panto_placer_main,num_vehs_in_vehid_chain){
        4..5: sw_chibaNT_9800_panto_placer_main_2;
        sw_chibaNT_9800_panto_placer_main_1;
      }
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9800_lv,vehicle_type_id){
      mu_car: sw_chibaNT_9800_panto_placer_main;
      chibaNT_9800_head;
    }
