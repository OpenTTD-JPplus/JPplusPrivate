//purchase
  spriteset(chibaNT_9000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9000/chibaNT_9000_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(chibaNT_9000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/chibaNewTown/chibaNT_9000/chibaNT_9000_1.png"){ tmpl_purchase_2c_dual(0, 75) }
  GRAPHIC_STACK_3(chibaNT_9000_purchase, logo_chiba_nt, chibaNT_9000_purchase_c1, chibaNT_9000_purchase_c2)
//livery 1
spriteset (chibaNT_9000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaNewTown/chibaNT_9000/chibaNT_9000_1.png") { tmpl_std_v3(0, 0) }
spriteset (chibaNT_9000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaNewTown/chibaNT_9000/chibaNT_9000_1.png") { tmpl_std_v3(0, 25) }
spriteset (chibaNT_9000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaNewTown/chibaNT_9000/chibaNT_9000_1.png") { tmpl_std_v3(0, 50) }
spriteset (chibaNT_9000_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaNewTown/chibaNT_9000/chibaNT_9000_1.png") { tmpl_std_rev_v3(0, 50) }
spriteset (chibaNT_9000_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaNewTown/chibaNT_9000/chibaNT_9000_1.png") { tmpl_symm_v3(0, 75) }
spriteset (chibaNT_9000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaNewTown/chibaNT_9000/chibaNT_9000_1.png") { tmpl_symm_v3(0, 100) }

spriteset (chibaNT_9000_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaNewTown/chibaNT_9000/chibaNT_9000_2.png") { tmpl_std_v3(0, 0) }
spriteset (chibaNT_9000_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/chibaNewTown/chibaNT_9000/chibaNT_9000_2.png") { tmpl_std_v3(0, 25) }
//*livery 1
  //special gfx
    switch(FEAT_TRAINS, SELF, chibaNT_9000_front, build_year>1990){
      1:chibaNT_9000_2_front;
      chibaNT_9000_1_front;
    }
    switch(FEAT_TRAINS, SELF, chibaNT_9000_end, build_year>1990){
      1:chibaNT_9000_2_end;
      chibaNT_9000_1_end;
    }
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9000_panto_placer_main_1,position_in_vehid_chain %8){
        0: chibaNT_9000_mot_2;
        2: chibaNT_9000_mot;
        5: chibaNT_9000_mot_2;
        chibaNT_9000_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9000_panto_placer_main_2,position_in_vehid_chain %3){
        1: chibaNT_9000_mot_2;
        default: chibaNT_9000_wag;
      }
    //var 3
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9000_panto_placer_main_3,position_in_vehid_chain %2){
        0: chibaNT_9000_mot_2;
        default: chibaNT_9000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_chibaNT_9000_panto_placer_main,num_vehs_in_vehid_chain){
        3: sw_chibaNT_9000_panto_placer_main_2;
        4: sw_chibaNT_9000_panto_placer_main_3;
        5: sw_chibaNT_9000_panto_placer_main_2;
        sw_chibaNT_9000_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9000_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: chibaNT_9000_end;
        chibaNT_9000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9000_lv,vehicle_type_id){
        mu_car: sw_chibaNT_9000_panto_placer_main;
        sw_chibaNT_9000_gfx_main;
    }
//post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9000_car_power_main,position_in_vehid_chain %8){
      0..5:return 130;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_chibaNT_9000_power_main,vehicle_type_id){
      mu_car:sw_chibaNT_9000_car_power_main;
      return 0;
    }
