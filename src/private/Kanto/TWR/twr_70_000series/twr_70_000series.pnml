spriteset(gfx_twr_70_000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/TWR/twr_70_000series/twr_70_000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(gfx_twr_70_000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/TWR/twr_70_000series/twr_70_000series.png"){ tmpl_purchase_2c_dual(0, 0) }
GRAPHIC_STACK_2(twr_70_000series_purchase, gfx_twr_70_000series_purchase_c1, gfx_twr_70_000series_purchase_c2)

spriteset(gfx_twr_70_000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/TWR/twr_70_000series/twr_70_000series.png"){ tmpl_std_v3 (0, 0) }
spriteset(gfx_twr_70_000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/TWR/twr_70_000series/twr_70_000series.png"){ tmpl_std_v3 (0, 25) }
spriteset(gfx_twr_70_000series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/TWR/twr_70_000series/twr_70_000series.png"){ tmpl_std_v3 (0, 50) }
spriteset(gfx_twr_70_000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/TWR/twr_70_000series/twr_70_000series.png"){ tmpl_symm_v3 (0, 75) }

switch(FEAT_TRAINS, SELF, sw_twr71000_head, train_is_driving_backwards != vehicle_is_flipped){
  1: gfx_twr_70_000series_end;
  gfx_twr_70_000series_front;
}
//*Livery 1 
switch(FEAT_TRAINS, SELF, sw_twr_70_000series_panto_placer_0_main,position_in_vehid_chain %3){
  0:gfx_twr_70_000series_mot;
  gfx_twr_70_000series_wag;
}
switch(FEAT_TRAINS, SELF, sw_twr_70_000series_panto_placer_1_main,position_in_vehid_chain %2){
  0:gfx_twr_70_000series_mot;
  gfx_twr_70_000series_wag;
}
switch(FEAT_TRAINS, SELF, sw_twr_70_000series_panto_placer_main, num_vehs_in_vehid_chain){
  default:sw_twr_70_000series_panto_placer_0_main;
  4..5:sw_twr_70_000series_panto_placer_1_main;
}
switch(FEAT_TRAINS, SELF, sw_twr_70_000series_lv,vehicle_type_id){
  mu_car:sw_twr_70_000series_panto_placer_main;
  sw_twr71000_head;
}

switch(FEAT_TRAINS, SELF, sw_twr_70_000series_capacity_main, vehicle_type_id == twr_70_000series){
	1: 146;
	default: 156;
}
switch(FEAT_TRAINS, SELF, sw_twr_70_000series_car_power_main, position_in_vehid_chain%6){
	0..3: 95;
	default: 0;
}
switch(FEAT_TRAINS, SELF, sw_twr_70_000series_power_main, vehicle_type_id == twr_70_000series){
	1: 0;
	default: sw_twr_70_000series_car_power_main;
}
