//post fixers
  //capacity-changer  
    switch(FEAT_TRAINS, SELF, sw_twr71000_capacity_main,vehicle_type_id){
      twr71000: 140;
      default: 158;
    } 
  //power
    switch(FEAT_TRAINS, SELF, sw_twr71000_car_power_main,position_in_vehid_chain_from_end %3){
      0..1:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_twr71000_power_main,vehicle_type_id){
      twr71000: 0;
      sw_twr71000_car_power_main;
    }
