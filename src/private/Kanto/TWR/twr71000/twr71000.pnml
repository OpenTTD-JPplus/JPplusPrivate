//*livery 1
  //panto placer
    //var 1
      switch(FEAT_TRAINS, SELF, sw_twr71000_panto_placer_main,position_in_vehid_chain_from_end %9){
          0: gfx_twr71000_mot;
          3: gfx_twr71000_mot;
          6: gfx_twr71000_mot_2;
          gfx_twr71000_wag;
