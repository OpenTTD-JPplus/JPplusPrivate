spriteset(twr71000_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/TWR/twr71000/twr71000.png"){ tmpl_std_v3(0, 0) }
spriteset(twr71000_wag_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/TWR/twr71000/twr71000.png"){ tmpl_symm_v3(0, 25) }
