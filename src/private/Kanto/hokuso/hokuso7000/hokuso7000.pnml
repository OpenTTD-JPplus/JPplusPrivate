//purchase
  spriteset(hokuso7000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7000/hokuso7000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(hokuso7000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7000/hokuso7000.png"){ tmpl_purchase_2c_dual(0, 100) }
  GRAPHIC_STACK_3(hokuso7000_purchase, logo_hokuso, hokuso7000_purchase_c1, hokuso7000_purchase_c2)
//livery 1
spriteset (hokuso7000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7000/hokuso7000.png") { tmpl_std_v3(0, 0) }
spriteset (hokuso7000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7000/hokuso7000.png") { tmpl_std_v3(0, 25) }
spriteset (hokuso7000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7000/hokuso7000.png") { tmpl_std_v3(0, 50) }
spriteset (hokuso7000_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7000/hokuso7000.png") { tmpl_std_rev_v3(0, 50) }
spriteset (hokuso7000_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7000/hokuso7000.png") { tmpl_symm_v3(0, 75) }
spriteset (hokuso7000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7000/hokuso7000.png") { tmpl_symm_v3(0, 100) }

//*livery 1
  //panto-placers
    //var 1 6 car
      switch(FEAT_TRAINS, SELF, sw_hokuso7000_panto_placer_main_1,position_in_vehid_chain_from_end %2){
        1: hokuso7000_mot_2;
        default: hokuso7000_wag;
      }
    //var 2 8 car
      switch(FEAT_TRAINS, SELF, sw_hokuso7000_panto_placer_main_2,position_in_vehid_chain_from_end %7){
        0: hokuso7000_mot_2;
        2: hokuso7000_mot;
        4: hokuso7000_mot_2;
        default: hokuso7000_wag;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_hokuso7000_panto_placer_main,num_vehs_in_vehid_chain){
        0..4: sw_hokuso7000_panto_placer_main_1;
        sw_hokuso7000_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hokuso7000_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: hokuso7000_end;
        hokuso7000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hokuso7000_lv,vehicle_type_id){
        mu_car: sw_hokuso7000_panto_placer_main;
        sw_hokuso7000_gfx_main;
    }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_hokuso7000_capacity_main,vehicle_type_id){
      mu_car: 136;
      126;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_hokuso7000_car_power_main,position_in_vehid_chain %8){
      0..3:return 130;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_hokuso7000_power_main,vehicle_type_id){
      mu_car:sw_hokuso7000_car_power_main;
      return 0;
    }
