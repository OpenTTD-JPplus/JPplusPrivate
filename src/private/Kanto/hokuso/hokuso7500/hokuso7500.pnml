  TRAIN_CONSTRUCTOR_3(hokuso7500_head, hokuso7500_head_base, sw_keisei3000n_lights, ac_single_1_1)
  TRAIN_CONSTRUCTOR_2(hokuso7500_wag, hokuso7500_car, ac_single_1_1)
  TRAIN_CONSTRUCTOR_3(hokuso7500_mot, hokuso7500_car, ac_single_1_1, panto_arm_n_single)
  TRAIN_CONSTRUCTOR_3(hokuso7500_mot_2, hokuso7500_car, ac_single_1_1, panto_arm_n)
//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_hokuso7500_panto_placer_main_1,position_in_vehid_chain %8){
        0: hokuso7500_mot_2;
        2: hokuso7500_mot;
        5: hokuso7500_mot_2;
        hokuso7500_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_hokuso7500_panto_placer_main_2,position_in_vehid_chain_from_end %3){
        0: hokuso7500_mot_2;
        default: hokuso7500_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_hokuso7500_panto_placer_main,num_vehs_in_vehid_chain){
        4..5: sw_hokuso7500_panto_placer_main_2;
        sw_hokuso7500_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hokuso7500_lv,vehicle_type_id){
        mu_car: sw_hokuso7500_panto_placer_main;
        hokuso7500_head;
    }
