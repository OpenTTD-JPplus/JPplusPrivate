  spriteset(hokuso7500_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7500/hokuso7500_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(hokuso7500_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7500/hokuso7500_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_5(hokuso7500_purchase, hokuso7500_purchase_c1, hokuso7500_purchase_c2, ac_single_1_c1, ac_single_1_c2, panto_arm_n_c2)
