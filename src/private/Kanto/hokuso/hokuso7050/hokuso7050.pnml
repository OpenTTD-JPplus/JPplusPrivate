//purchase
  spriteset(hokuso7050_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7050/hokuso7050.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(hokuso7050_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7050/hokuso7050.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_3(hokuso7050_purchase, logo_hokuso, hokuso7050_purchase_c1, hokuso7050_purchase_c2)
//livery 1
spriteset (hokuso7050_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7050/hokuso7050.png") { tmpl_std_v3(0, 0) }
spriteset (hokuso7050_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7050/hokuso7050.png") { tmpl_std_v3(0, 25) }
spriteset (hokuso7050_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7050/hokuso7050.png") { tmpl_std_rev_v3(0, 25) }
spriteset (hokuso7050_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7050/hokuso7050.png") { tmpl_std_v3(0, 50) }
spriteset (hokuso7050_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7050/hokuso7050.png") { tmpl_std_v3(0, 75) }
spriteset (hokuso7050_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7050/hokuso7050.png") { tmpl_std_v3(0, 100) }
spriteset (hokuso7050_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/hokuso/hokuso7050/hokuso7050.png") { tmpl_symm_v3(0, 125) }

//*livery 1
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_hokuso7050_front,vehicle_is_reversed){
        1: hokuso7050_front;
        hokuso7050_front_mot;
      }
    switch(FEAT_TRAINS, PARENT, sw_hokuso7050_end,vehicle_is_reversed){
        1: hokuso7050_end_mot;
        hokuso7050_end;
      }
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_hokuso7050_panto_placer_main,position_in_vehid_chain %2){
        1: hokuso7050_mot;
        default: hokuso7050_wag;
      }
  //fake-head-placer
    //var 1 (8+)
      switch(FEAT_TRAINS, SELF, sw_hokuso7050_fake_head_placer_gfx,position_in_vehid_chain){
        2: hokuso7050_end_rev;
        3: hokuso7050_end_mot;
        sw_hokuso7050_panto_placer_main;
      }
      switch(FEAT_TRAINS, SELF, sw_hokuso7050_fake_head_placer_main,num_vehs_in_vehid_chain>5){
        1: sw_hokuso7050_fake_head_placer_gfx;
        sw_hokuso7050_panto_placer_main;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hokuso7050_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: sw_hokuso7050_end;
        sw_hokuso7050_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hokuso7050_lv,vehicle_type_id){
        mu_car: sw_hokuso7050_fake_head_placer_main;
        sw_hokuso7050_gfx_main;
    }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_hokuso7050_capacity_main,vehicle_type_id){
      mu_car: 140;
      136;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_hokuso7050_car_power_main,position_in_vehid_chain %2){
      0:return 75;
      return 0;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_hokuso7050_power_main,vehicle_type_id){
      mu_car:sw_hokuso7050_car_power_main;
      return 75;
    }
