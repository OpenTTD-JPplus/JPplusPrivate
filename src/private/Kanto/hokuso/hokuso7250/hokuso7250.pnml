//purchase
  spriteset(hokuso7250_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7250/hokuso7250.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(hokuso7250_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7250/hokuso7250.png"){ tmpl_purchase_2c_dual(0, 100) }
  GRAPHIC_STACK_3(hokuso7250_purchase, logo_hokuso, hokuso7250_purchase_c1, hokuso7250_purchase_c2)
//livery 1
spriteset (hokuso7250_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7250/hokuso7250.png") { tmpl_std_v3(0, 0) }
spriteset (hokuso7250_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7250/hokuso7250.png") { tmpl_std_v3(0, 25) }
spriteset (hokuso7250_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7250/hokuso7250.png") { tmpl_std_rev_v3(0, 25) }
spriteset (hokuso7250_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7250/hokuso7250.png") { tmpl_std_v3(0, 100) }
spriteset (hokuso7250_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7250/hokuso7250.png") { tmpl_std_rev_v3(0, 100) }
spriteset (hokuso7250_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7250/hokuso7250.png") { tmpl_symm_v3(0, 125) }
spriteset (hokuso7250_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/hokuso/hokuso7250/hokuso7250.png") { tmpl_symm_v3(0, 150) }

//*livery 1
  //panto-placers
    //var 1 7250
      switch(FEAT_TRAINS, SELF, sw_hokuso7250_panto_placer_main_1,position_in_vehid_chain %5){
        0: hokuso7250_mot_2;
        default: hokuso7250_wag;
      }
    //var 2 7250
      switch(FEAT_TRAINS, SELF, sw_hokuso7250_panto_placer_main_2,position_in_vehid_chain %3){
        1: hokuso7250_mot_2;
        default: hokuso7250_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_hokuso7250_panto_placer_main,num_vehs_in_vehid_chain){
        0..2:sw_hokuso7250_panto_placer_main_1;
        3..5: sw_hokuso7250_panto_placer_main_2;
        6..7:sw_hokuso7250_panto_placer_main_1;
        sw_hokuso7250_panto_placer_main_2;
      }
    //var 3 7260
      switch(FEAT_TRAINS, SELF, sw_hokuso7250_panto_placer_main_3,position_in_vehid_chain %4){
        0: hokuso7250_mot_rev;
        1: hokuso7250_mot;
        default: hokuso7250_wag;
      }
      //fake-head-placer
        switch(FEAT_TRAINS, SELF, sw_hokuso7250_fake_head_placer_gfx,position_in_vehid_chain){
          2: hokuso7250_end_rev;
          3: hokuso7250_end;
          sw_hokuso7250_panto_placer_main_3;
        }
        switch(FEAT_TRAINS, SELF, sw_hokuso7250_fake_head_placer_main_1,num_vehs_in_vehid_chain>5){
          1: sw_hokuso7250_fake_head_placer_gfx;
          sw_hokuso7250_panto_placer_main_3;
        }
      random_switch(FEAT_TRAINS, PARENT, sw_hokuso7250_fake_head_placer_main){
        1:sw_hokuso7250_fake_head_placer_main_1;
        1: sw_hokuso7250_panto_placer_main;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hokuso7250_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: hokuso7250_end;
        hokuso7250_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hokuso7250_lv,vehicle_type_id){
        mu_car: sw_hokuso7250_fake_head_placer_main;
        sw_hokuso7250_gfx_main;
    }