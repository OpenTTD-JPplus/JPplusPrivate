//*purchase
  spriteset(sotetsu5000_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"gfx/private/Kanto/sotetsu/sotetsu5000/sotetsu5000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu5000_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"gfx/private/Kanto/sotetsu/sotetsu5000/sotetsu5000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu5000_purchase, roof_gray_med_c1, sotetsu5000_1_front_base_c1, ac_vents_1_c1, roof_gray_med_c2, sotetsu5000_1_car_base_c2, ac_vents_1_c2)

//6000
//*livery 1
	spriteset(sotetsu5000_1_front_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"gfx/private/Kanto/sotetsu/sotetsu5000/sotetsu5000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu5000_1_end_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"gfx/private/Kanto/sotetsu/sotetsu5000/sotetsu5000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu5000_1_car_base_def, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"gfx/private/Kanto/sotetsu/sotetsu5000/sotetsu5000_1.png"){ tmpl_std_v3(0, 25) }
	spriteset(sotetsu5000_1_car_base_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"gfx/private/Kanto/sotetsu/sotetsu5000/sotetsu5000_1.png"){ tmpl_std_rev_v3(0, 25) }
		switch(FEAT_TRAINS, SELF, sotetsu5000_1_car_base,position_in_vehid_chain%2){
			0: sotetsu5000_1_car_base_def;
			sotetsu5000_1_car_base_rev;
		}
	spriteset(sotetsu5000_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"gfx/private/Kanto/sotetsu/sotetsu5000/sotetsu5000_lights.png"){ tmpl_std_v3(0, 0) }

	TRAIN_CONSTRUCTOR_4(sotetsu5000_1_front, sotetsu5000_1_front_base, roof_gray_med, sotetsu5000_lights_rear, ac_vents_1)
	TRAIN_CONSTRUCTOR_3(sotetsu5000_1_end, sotetsu5000_1_end_base, roof_gray_med, ac_vents_1)
	TRAIN_CONSTRUCTOR_5(sotetsu5000_1_front_mot, sotetsu5000_1_front_base, roof_gray_med, sotetsu5000_lights_rear, ac_vents_1_mot, panto_d_arm_single_rev)
	TRAIN_CONSTRUCTOR_4(sotetsu5000_1_end_mot, sotetsu5000_1_end_base, roof_gray_med, ac_vents_1_mot, panto_d_arm_single)
	TRAIN_CONSTRUCTOR_3(sotetsu5000_1_wag, sotetsu5000_1_car_base, roof_gray_med, ac_vents_1_wag)
	TRAIN_CONSTRUCTOR_4(sotetsu5000_1_mot, sotetsu5000_1_car_base, roof_gray_med, ac_vents_1_mot, panto_d_arm_single_rev)
//
//*livery 1
	//special gfx
		switch(FEAT_TRAINS, PARENT, sw_sotetsu5000_1_front_gfx,vehicle_is_reversed){
			1: sotetsu5000_1_front;
			sotetsu5000_1_front_mot;
		}
		switch(FEAT_TRAINS, PARENT, sw_sotetsu5000_1_end_gfx,vehicle_is_reversed){
			1: sotetsu5000_1_end_mot;
			sotetsu5000_1_end;
		}
	//panto placer
		//1
			switch(FEAT_TRAINS, SELF, sw_sotetsu5000_1_panto_placer_main,position_in_vehid_chain %2){
				1: sotetsu5000_1_mot;
				sotetsu5000_1_wag;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_sotetsu5000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_sotetsu5000_1_end_gfx;
      sw_sotetsu5000_1_front_gfx;
    }
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000_lv,vehicle_type_id){
			mu_car:sw_sotetsu5000_1_panto_placer_main;
			sw_sotetsu5000_head_gfx_main;
		}

//
//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000_capacity_main,vehicle_type_id){
			mu_car:130;
			120;
		}
