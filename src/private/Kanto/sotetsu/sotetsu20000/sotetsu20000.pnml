//livery 1
spriteset(sotetsu20000_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu20000/sotetsu20000.png"){ tmpl_std_v3(0, 0) }
spriteset(sotetsu20000_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000.png"){ tmpl_symm_v3(0, 25) }

spriteset(sotetsu20000_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu20000/sotetsu20000_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(sotetsu20000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu20000/sotetsu20000_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sw_sotetsu20000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: sotetsu20000_lights_back;
    sotetsu20000_lights_rear;
  }
TRAIN_CONSTRUCTOR_4(sotetsu20000_head, sotetsu20000_head_base, roof_gray_med_h1, sw_sotetsu20000_lights, ac_long_toshiba)
TRAIN_CONSTRUCTOR_3(sotetsu20000_wag, sotetsu20000_car_base, roof_gray_med, ac_long_toshiba)
TRAIN_CONSTRUCTOR_4(sotetsu20000_mot, sotetsu20000_car_base, roof_gray_med, ac_long_toshiba, panto_arm_n_single)

//*purchase
  spriteset(sotetsu20000_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu20000/sotetsu20000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu20000_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu20000_purchase, roof_gray_med_c1, sotetsu20000_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu20000_car_base_c2, ac_long_toshiba_c2)

//*livery 1
	//panto placer
	//1 10
	switch(FEAT_TRAINS, SELF, sw_sotetsu20000_panto_placer_main,position_in_vehid_chain %5){
		0: sotetsu20000_mot;
		2: sotetsu20000_mot;
		3: sotetsu20000_mot;
		sotetsu20000_wag;
	}
	//front-end-fixer
	switch(FEAT_TRAINS, SELF, sw_sotetsu20000_lv,vehicle_type_id){
		mu_car:sw_sotetsu20000_panto_placer_main;
		sotetsu20000_head;
	}
//
//post fixers
//capacity-changer
	switch(FEAT_TRAINS, SELF, sw_sotetsu20000_capacity,position_in_vehid_chain_from_end){
    0: 144;
    default: 143;
	}
	switch(FEAT_TRAINS, SELF, sw_sotetsu20000_capacity_1,position_in_vehid_chain){
    0: 133;
    default: sw_sotetsu20000_capacity;
	}
	switch(FEAT_TRAINS, SELF, sw_sotetsu20000_capacity_main,vehicle_type_id){
    mu_car:sw_sotetsu20000_capacity;
    sw_sotetsu20000_capacity_1;
	}
//power fix
	switch(FEAT_TRAINS, SELF, sw_sotetsu20000_car_power_main,position_in_vehid_chain %10){
    0:return 190;
    2..3:return 190;
    5:return 190;
    7:return 190;
    return 0;
	}
  switch(FEAT_TRAINS, SELF, sw_sotetsu20000_power_main, vehicle_type_id){
    mu_car:sw_sotetsu20000_car_power_main;
    return 0;
  }
