//*panto logic
switch(FEAT_TRAINS,PARENT, sw_sotetsu7000n_panto, current_year){
	0..2006:panto_d_arm_single;
	panto_arm_n_single;
}
switch(FEAT_TRAINS,PARENT, sw_sotetsu7000n_panto_rev, current_year){
	0..2006:panto_d_arm_single_rev;
	panto_arm_n_single_rev;
}
//*purchase
  spriteset(sotetsu7000n_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000n_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu7000n_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000n_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu7000n_purchase_1, roof_gray_med_c1, sotetsu7000n_1_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu7000n_1_car_base_c2, ac_long_toshiba_c2)
  
	spriteset(sotetsu7000n_2_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000n_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu7000n_2_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000n_2.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu7000n_purchase_2, roof_gray_med_c1, sotetsu7000n_2_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu7000n_2_car_base_c2, ac_long_toshiba_c2)

	switch(FEAT_TRAINS, SELF, sotetsu7000n_purchase, current_year){
		0..2006: sotetsu7000n_purchase_1;
		sotetsu7000n_purchase_2;
	}
//*lights
	spriteset(sotetsu7000n_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000n_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu7000n_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000n_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_sotetsu7000n_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: sotetsu7000n_lights_back;
    sotetsu7000n_lights_rear;
  }
//*livery 1
	spriteset(sotetsu7000n_1_front_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000n_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu7000n_1_end_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000n_1.png"){ tmpl_std_rev_v3(0, 0) }
