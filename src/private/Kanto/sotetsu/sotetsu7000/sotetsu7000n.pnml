  switch(FEAT_TRAINS, SELF, sotetsu7000n_head, current_year){
    0..2006:sotetsu7000n_1_head;    sotetsu7000n_2_head;
  }
  switch(FEAT_TRAINS, SELF, sotetsu7000n_wag, current_year){
    0..2006:sotetsu7000n_1_wag;    sotetsu7000n_2_wag;
  }
  switch(FEAT_TRAINS, SELF, sotetsu7000n_mot, current_year){
    0..2006:sotetsu7000n_1_mot;    sotetsu7000n_2_mot;
  }
  switch(FEAT_TRAINS, SELF, sotetsu7000n_mot_rev, current_year){
    0..2006:sotetsu7000n_1_mot_rev;    sotetsu7000n_2_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, sotetsu7000n_front_f, current_year){
    0..2006:sotetsu7000n_1_front_f;    sotetsu7000n_2_front_f;
  }
  switch(FEAT_TRAINS, SELF, sotetsu7000n_end_f, current_year){
