//*panto logic
switch(FEAT_TRAINS,PARENT, sw_sotetsu7000_panto, current_year){
	0..2010:panto_d_arm_single;
	panto_arm_n_single;
}
switch(FEAT_TRAINS,PARENT, sw_sotetsu7000_panto_rev, current_year){
	0..2010:panto_d_arm_single_rev;
	panto_arm_n_single_rev;
}
//*purchase
  spriteset(sotetsu7000_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu7000_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu7000_purchase, roof_gray_med_c1, sotetsu7000_1_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu7000_1_car_base_c2, ac_long_toshiba_c2)

//*lights
	spriteset(sotetsu7000_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu7000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_sotetsu7000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: sotetsu7000_lights_back;
    sotetsu7000_lights_rear;
  }
//*livery 1
	spriteset(sotetsu7000_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu7000_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu7000/sotetsu7000_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(sotetsu7000_1_head, sotetsu7000_1_head_base, roof_gray_med, sw_sotetsu7000_lights, ac_long_toshiba)
	TRAIN_CONSTRUCTOR_3(sotetsu7000_1_wag, sotetsu7000_1_car_base, roof_gray_med, ac_long_toshiba)
	TRAIN_CONSTRUCTOR_4(sotetsu7000_1_mot, sotetsu7000_1_car_base, roof_gray_med, ac_long_toshiba, sw_sotetsu7000_panto)
	TRAIN_CONSTRUCTOR_4(sotetsu7000_1_mot_rev, sotetsu7000_1_car_base, roof_gray_med, ac_long_toshiba, sw_sotetsu7000_panto_rev)
//
//*livery 1
	//panto placer
		//1
			switch(FEAT_TRAINS, SELF, sw_sotetsu7000_1_panto_placer_main_1,position_in_vehid_chain %4){
				0: sotetsu7000_1_mot_rev;
				1: sotetsu7000_1_mot_rev;
				sotetsu7000_1_wag;
			}
		//2
			switch(FEAT_TRAINS, SELF, sw_sotetsu7000_1_panto_placer_main_2,position_in_vehid_chain %3){
				0: sotetsu7000_1_mot;
				1: sotetsu7000_1_mot;
				sotetsu7000_1_wag;
			}
		//panto controller
      switch(FEAT_TRAINS, SELF, sw_sotetsu7000_1_panto_placer_main,num_vehs_in_vehid_chain){
        4:sw_sotetsu7000_1_panto_placer_main_2;
        7..8:sw_sotetsu7000_1_panto_placer_main_2;
        sw_sotetsu7000_1_panto_placer_main_1;
      }
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_sotetsu7000_lv,vehicle_type_id){
			mu_car:sw_sotetsu7000_1_panto_placer_main;
			sotetsu7000_1_head;
		}

//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_sotetsu7000_capacity_main,vehicle_type_id){
			mu_car:140;
			154;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_sotetsu7000_car_power_main,position_in_vehid_chain %4){
			0..1:return 130;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_sotetsu7000_power_main, vehicle_type_id){
			mu_car:sw_sotetsu7000_car_power_main;
			return 0;
		}
