//
  switch(FEAT_TRAINS, SELF, sotetsu10000_head_timed, 1*(current_year<2007&&build_year<2020)+2*(current_year>2006&&build_year<2020)+3*(current_year<2021&&build_year>2019)+4*(current_year>2020&&build_year>2019)){
    1:sotetsu10000_1_head;    2:sotetsu10000_2_head;    3:sotetsu10000_3_head;    4:sotetsu10000_4_head;
  }
  switch(FEAT_TRAINS, SELF, sotetsu10000_wag_timed,  1*(current_year<2007&&build_year<2020)+2*(current_year>2006&&build_year<2020)+3*(current_year<2021&&build_year>2019)+4*(current_year>2020&&build_year>2019)){
    1:sotetsu10000_1_wag;    2..3:sotetsu10000_2_wag;    4:sotetsu10000_4_wag;
  }
  switch(FEAT_TRAINS, SELF, sotetsu10000_mot_timed,  1*(current_year<2007&&build_year<2020)+2*(current_year>2006&&build_year<2020)+3*(current_year<2021&&build_year>2019)+4*(current_year>2020&&build_year>2019)){
    1:sotetsu10000_1_mot;    2..3:sotetsu10000_2_mot;    4:sotetsu10000_4_mot;
  }

  switch(FEAT_TRAINS, SELF, sotetsu10000_head, cargo_subtype){
    0:sotetsu10000_head_timed;    1:sotetsu10000_1_head;    2:sotetsu10000_2_head;    3:sotetsu10000_3_head;    4:sotetsu10000_4_head;
  }
  switch(FEAT_TRAINS, SELF, sotetsu10000_wag, cargo_subtype){
    0:sotetsu10000_wag_timed;    1:sotetsu10000_1_wag;    2..3:sotetsu10000_2_wag;    4:sotetsu10000_4_wag;
  }
  switch(FEAT_TRAINS, SELF, sotetsu10000_mot_rev, cargo_subtype){
    0:sotetsu10000_mot_timed;    1:sotetsu10000_1_mot;    2..3:sotetsu10000_2_mot;    4:sotetsu10000_4_mot;
  }
//
//*livery 1
	//panto placer
		//1 10
			switch(FEAT_TRAINS, SELF, sw_sotetsu10000_panto_placer_main_1,position_in_vehid_chain %6){
				1: sotetsu10000_mot_rev;
				3: sotetsu10000_mot_rev;
				sotetsu10000_wag;
			}
		//2 8
			switch(FEAT_TRAINS, SELF, sw_sotetsu10000_panto_placer_main_2,position_in_vehid_chain %8){
				1: sotetsu10000_mot_rev;
				5: sotetsu10000_mot_rev;
				sotetsu10000_wag;
			}
		//3 3-5
			switch(FEAT_TRAINS, SELF, sw_sotetsu10000_panto_placer_main_3,position_in_vehid_chain %5){
				0: sotetsu10000_mot_rev;
				2: sotetsu10000_mot_rev;
				sotetsu10000_wag;
			}
	//panto controller
		switch(FEAT_TRAINS, SELF, sw_sotetsu10000_panto_placer_main,num_vehs_in_vehid_chain){
			0..3:sw_sotetsu10000_panto_placer_main_3;
			6..7:sw_sotetsu10000_panto_placer_main_2;
			sw_sotetsu10000_panto_placer_main_1;
		}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_sotetsu10000_lv,vehicle_type_id){
			mu_car:sw_sotetsu10000_panto_placer_main;
			sotetsu10000_head;
		}
//*livery logic
	switch(FEAT_TRAINS, SELF, sw_sotetsu10000_lv_desc_main, cargo_subtype){
		0:string(LV_RANDOM);
		1:string(LV_DATED,string(LV_OLD),2002);
		2:string(LV_DATED,string(STR_LIVERY,string(LV_sotetsu_orange_blue)),2007);
		3:string(LV_DATED,string(LV_MODERN),2021);
		4:string(LV_DATED,string(STR_LIVERY,string(LV_sotetsu_navyblue)),2021);
	}
//
//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_sotetsu10000_capacity_main,vehicle_type_id){
			mu_car:141;
			160;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_sotetsu10000_car_power_main,position_in_vehid_chain_from_end %10){
			0..1:return 95;
			4..5:return 95;
			7:return 95;
			return 0;
		}
    switch(FEAT_TRAINS, SELF, sw_sotetsu10000_power_main, vehicle_type_id){
			mu_car:sw_sotetsu10000_car_power_main;
			return 0;
		}
