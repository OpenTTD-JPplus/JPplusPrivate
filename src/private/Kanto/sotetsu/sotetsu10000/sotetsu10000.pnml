spriteset(sotetsu10000_4_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu10000/sotetsu10000_4.png"){ tmpl_symm_v3(0, 25) }

