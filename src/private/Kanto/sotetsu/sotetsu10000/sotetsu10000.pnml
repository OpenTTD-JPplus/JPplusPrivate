//*purchase
  spriteset(sotetsu10000_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu10000/sotetsu10000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu10000_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu10000/sotetsu10000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu10000_purchase_1, roof_gray_med_c1, sotetsu10000_1_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu10000_1_car_base_c2, ac_long_toshiba_c2)
  
	spriteset(sotetsu10000_2_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu10000/sotetsu10000_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu10000_2_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu10000/sotetsu10000_2.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu10000_purchase_2, roof_gray_med_c1, sotetsu10000_2_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu10000_2_car_base_c2, ac_long_toshiba_c2)
	
	switch(FEAT_TRAINS, PARENT, sotetsu10000_purchase, current_year){
		0..2006: sotetsu10000_purchase_1;
		sotetsu10000_purchase_2;
	}
//*lights
spriteset(sotetsu10000_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu10000/sotetsu10000_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(sotetsu10000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu10000/sotetsu10000_lights.png"){ tmpl_std_v3(0, 25) }
