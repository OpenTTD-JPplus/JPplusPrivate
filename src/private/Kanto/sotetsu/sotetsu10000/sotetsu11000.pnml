//*purchase
  spriteset(sotetsu11000_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu10000/sotetsu11000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu11000_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu10000/sotetsu11000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu11000_purchase, roof_gray_med_c1, sotetsu11000_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu11000_car_base_c2, ac_long_toshiba_c2)
//*livery 1
	spriteset(sotetsu11000_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu10000/sotetsu11000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu11000_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu10000/sotetsu11000_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(sotetsu11000_1_head, sotetsu11000_1_head_base, roof_gray_med_h1, sw_sotetsu11000_lights, ac_long_toshiba)
	TRAIN_CONSTRUCTOR_3(sotetsu11000_1_wag, sotetsu11000_1_car_base, roof_gray_med, ac_long_toshiba)
	TRAIN_CONSTRUCTOR_4(sotetsu11000_1_mot_2, sotetsu11000_1_car_base, roof_gray_med, ac_long_toshiba, panto_arm_n)
	TRAIN_CONSTRUCTOR_4(sotetsu11000_1_mot, sotetsu11000_1_car_base, roof_gray_med, ac_long_toshiba, panto_arm_n_single)
	TRAIN_CONSTRUCTOR_4(sotetsu11000_1_mot_rev, sotetsu11000_1_car_base, roof_gray_med, ac_long_toshiba, panto_arm_n_single_rev)
//
//*livery 1
	//panto placer
		//1 10
			switch(FEAT_TRAINS, SELF, sw_sotetsu11000_1_panto_placer_main_1,position_in_vehid_chain %9){
				0: sotetsu11000_1_mot_2;
				3: sotetsu11000_1_mot;
				7: sotetsu11000_1_mot;
				sotetsu11000_1_wag;
			}
		//2 8
			switch(FEAT_TRAINS, SELF, sw_sotetsu11000_1_panto_placer_main_2,position_in_vehid_chain %8){
				1: sotetsu11000_1_mot_2;
				5: sotetsu11000_1_mot_2;
				sotetsu11000_1_wag;
			}
		//3 3-5
			switch(FEAT_TRAINS, SELF, sw_sotetsu11000_1_panto_placer_main_3,position_in_vehid_chain %5){
				0: sotetsu11000_1_mot_rev;
				2: sotetsu11000_1_mot_rev;
				sotetsu11000_1_wag;
			}
	//panto controller
		switch(FEAT_TRAINS, SELF, sw_sotetsu11000_1_panto_placer_main,num_vehs_in_vehid_chain){
			5:sw_sotetsu11000_1_panto_placer_main_3;
			8..9:sw_sotetsu11000_1_panto_placer_main_2;
			sw_sotetsu11000_1_panto_placer_main_1;
		}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_sotetsu11000_lv,vehicle_type_id){
			mu_car:sw_sotetsu11000_1_panto_placer_main;
			sotetsu11000_1_head;
		}
//
//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_sotetsu11000_capacity_main,vehicle_type_id){
			mu_car:142;
			160;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_sotetsu11000_car_power_main,position_in_vehid_chain_from_end %10){
			0..1:return 140;
			4..7:return 140;
			return 0;
		}
    switch(FEAT_TRAINS, SELF, sw_sotetsu11000_power_main, vehicle_type_id){
			mu_car:sw_sotetsu11000_car_power_main;
			return 0;
		}
