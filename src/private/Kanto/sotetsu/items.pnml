#include "sotetsu5000/sotetsu5000.pnml"

item(FEAT_TRAINS, sotetsu5000) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_sotetsu == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_SOTETSU), string(STR_SHOUDAI,"5000"), string(STR_NAME_SERIES));
    introduction_date: date(1955, 12, 1);
    model_life: 25;
    vehicle_life: 20;
    dual_headed: 1;
    
    cost_factor: 18;
    running_cost_factor: 48;
    speed: 100 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 31 ton;
    badges: ["company/sotetsu"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 2,4)),
    string(STR_USAGE, string(STR_COMMUTER)),
    string(STR_OPERATOR, string(STR_SOTETSU))
    
    );
    
    purchase: sotetsu5000_purchase;
    cargo_capacity:sw_sotetsu5000_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_sotetsu5000_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_3D;
    default:sw_sotetsu5000_lv;
    power:sw_sotetsu5000_power_main()*4*1342/1000;
    purchase_power: sw_sotetsu5000_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_3D;
    cargo_capacity:sw_sotetsu5000_capacity_main()*param_capacity_mod/3;
    power:sw_sotetsu5000_power_main()*4*1342/1000;
    default:sw_sotetsu5000_lv;
    weight: 31;
    
  }
}
