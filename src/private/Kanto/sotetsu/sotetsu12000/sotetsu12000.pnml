spriteset(sotetsu12000_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000.png"){ tmpl_std_v3(0, 0) }
spriteset(sotetsu12000_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000.png"){ tmpl_symm_v3(0, 25) }
spriteset(sotetsu12000_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(sotetsu12000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sw_sotetsu12000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: sotetsu12000_lights_back;
    sotetsu12000_lights_rear;
  }
TRAIN_CONSTRUCTOR_4(sotetsu12000_head, sotetsu12000_head_base, roof_gray_med_h1, sw_sotetsu12000_lights, ac_long_toshiba)
