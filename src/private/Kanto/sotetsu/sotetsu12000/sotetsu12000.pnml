//livery 1
spriteset(sotetsu12000_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000.png"){ tmpl_std_v3(0, 0) }
spriteset(sotetsu12000_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000.png"){ tmpl_symm_v3(0, 25) }
spriteset(sotetsu12000_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(sotetsu12000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sw_sotetsu12000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: sotetsu12000_lights_back;
    sotetsu12000_lights_rear;
  }
TRAIN_CONSTRUCTOR_4(sotetsu12000_head, sotetsu12000_head_base, roof_gray_med_h1, sw_sotetsu12000_lights, ac_long_toshiba)
TRAIN_CONSTRUCTOR_3(sotetsu12000_wag, sotetsu12000_car_base, roof_gray_med, ac_long_toshiba)
TRAIN_CONSTRUCTOR_4(sotetsu12000_mot_2, sotetsu12000_car_base, roof_gray_med, ac_long_toshiba, panto_arm_n)
TRAIN_CONSTRUCTOR_4(sotetsu12000_mot_rev, sotetsu12000_car_base, roof_gray_med, ac_long_toshiba, panto_arm_n_single_rev)

//*purchase
  spriteset(sotetsu12000_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu12000_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/sotetsu/sotetsu12000/sotetsu12000.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu12000_purchase, roof_gray_med_c1, sotetsu12000_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu12000_car_base_c2, ac_long_toshiba_c2)

//*livery 1
	//panto placer
	//1 10
	switch(FEAT_TRAINS, SELF, sw_sotetsu12000_panto_placer_main_1,position_in_vehid_chain %6){
		1: sotetsu12000_mot_rev;
		3: sotetsu12000_mot_2;
		sotetsu12000_wag;
	}
	//1 8
	switch(FEAT_TRAINS, SELF, sw_sotetsu12000_panto_placer_main_2,position_in_vehid_chain %5){
		0: sotetsu12000_mot_rev;
		2: sotetsu12000_mot_2;
		sotetsu12000_wag;
	}
	//1 3-5
	switch(FEAT_TRAINS, SELF, sw_sotetsu12000_panto_placer_main_3,position_in_vehid_chain %5){
		0: sotetsu12000_mot_2;
		2: sotetsu12000_mot_rev;
		sotetsu12000_wag;
	}
	//panto controller
		switch(FEAT_TRAINS, SELF, sw_sotetsu12000_panto_placer_main,num_vehs_in_vehid_chain){
			1..3:sw_sotetsu12000_panto_placer_main_3;
			6..7:sw_sotetsu12000_panto_placer_main_2;
			sw_sotetsu12000_panto_placer_main_1;
		}
	//front-end-fixer
	switch(FEAT_TRAINS, SELF, sw_sotetsu12000_lv,vehicle_type_id){
		mu_car:sw_sotetsu12000_panto_placer_main;
		sotetsu12000_head;
	}
//
//post fixers
//capacity-changer
	switch(FEAT_TRAINS, SELF, sw_sotetsu12000_capacity_main,vehicle_type_id){
    mu_car:140;
    159;
	}
//power fix
	switch(FEAT_TRAINS, SELF, sw_sotetsu12000_power_main,position_in_vehid_chain_from_end %10){
    1..2:return 140;
    5..8:return 140;
    return 0;
	}
//
item(FEAT_TRAINS, sotetsu12000) {
    property {
        OVERRIDEN_TRAIN_DATA
        
        climates_available: param_disable_sotetsu == 0 ? ALL_CLIMATES : NO_CLIMATE;
        name: string(STR_TRAIN_NAME, string(STR_NAME_SOTETSU), "12000", string(STR_NAME_SERIES),);
        introduction_date: date(2019, 4, 20);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 35;
        reliability_decay: 10;

        cost_factor: 21;
        running_cost_factor: 51;
        speed: 120 km/h;
        track_type: TR_1067_DC;
        power: 1 kW;
        weight: 34 ton;
        dual_headed:1;
        badges: ["company/sotetsu"];
    }
	graphics {
    additional_text:
			string(STR_TRAIN_DESC,
      string(STR_NARROWGAUGE),
      string(STR_DENKI, string(STR_DC, 1500)),
      string(STR_LOAD_SPEED, string(STR_DOORS, 4),),
      string(STR_FORMATION, string(STR_NUM_CARS_1, 10)),
      string(STR_USAGE, string(STR_COMMUTER)),
      string(STR_OPERATOR, string(STR_SOTETSU)));
		// cargo_subtype_text:sw_empty_desc;
		// can_attach_wagon: sw_mucar_attach_vehid;
		purchase: sotetsu12000_purchase;
		start_stop: sw_stop_start_3;
    
    
    SET_GRAPHICS_DOUBLE(sw_sotetsu12000_lv,//graphics
    sw_sotetsu12000_capacity_main(),//cargo capacity
    sw_sotetsu12000_power_main()*4*1342/1000,//power
    param_loading_4D,//loading speed
    sw_empty_desc,//subtype
    mu_car,32)//car_fallback,weight
}