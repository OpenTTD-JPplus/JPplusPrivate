	spriteset(sotetsu8000_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu8000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_lights.png"){ tmpl_std_v3(0, 25) }
