	spriteset(sotetsu8000_3_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_3.png"){ tmpl_std_v3(0, 0) }
