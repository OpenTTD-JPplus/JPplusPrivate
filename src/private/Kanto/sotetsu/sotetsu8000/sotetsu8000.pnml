  switch(FEAT_TRAINS, SELF, sotetsu8000_head_timed, current_year){
    0..2007:sotetsu8000_1_head;    2008..2018:sotetsu8000_2_head;    sotetsu8000_3_head;
  }
  switch(FEAT_TRAINS, SELF, sotetsu8000_wag_timed, current_year){
    0..2007:sotetsu8000_1_wag;    2008..2018:sotetsu8000_2_wag;    sotetsu8000_3_wag;
  }
  switch(FEAT_TRAINS, SELF, sotetsu8000_mot_timed, current_year){
    0..2007:sotetsu8000_1_mot;    2008..2018:sotetsu8000_2_mot;    sotetsu8000_3_mot;
  }

  switch(FEAT_TRAINS, SELF, sotetsu8000_head, cargo_subtype){
    0:sotetsu8000_head_timed;    1:sotetsu8000_1_head;    2:sotetsu8000_2_head;    sotetsu8000_3_head;
  }
  switch(FEAT_TRAINS, SELF, sotetsu8000_wag, cargo_subtype){
    0:sotetsu8000_wag_timed;    1:sotetsu8000_1_wag;    2:sotetsu8000_2_wag;    sotetsu8000_3_wag;
  }
  switch(FEAT_TRAINS, SELF, sotetsu8000_mot, cargo_subtype){
    0:sotetsu8000_mot_timed;    1:sotetsu8000_1_mot;    2:sotetsu8000_2_mot;    sotetsu8000_3_mot;
  }
//*livery 1
	//panto placer
		//1 10
			switch(FEAT_TRAINS, SELF, sw_sotetsu8000_panto_placer_main,position_in_vehid_chain %3){
				0: sotetsu8000_mot;
				1: sotetsu8000_mot;
				sotetsu8000_wag;
			}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_sotetsu8000_lv,vehicle_type_id){
			mu_car:sw_sotetsu8000_panto_placer_main;
			sotetsu8000_head;
		}
//*livery logic
	switch(FEAT_TRAINS, SELF, sw_sotetsu8000_lv_desc, cargo_subtype){
		0:string(LV_RANDOM);
		1:string(LV_DATED,string(STR_LIVERY,string(STR_PREFIX_OLD,string(STR_BELT,string(STR_RED)))),1990);
		2:string(LV_DATED,string(STR_LIVERY,string(LV_sotetsu_orange_blue)),2008);
		3:string(LV_DATED,string(STR_LIVERY,string(LV_sotetsu_navyblue)),2019);
	}
//
//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_sotetsu8000_capacity_main,vehicle_type_id){
			mu_car:145;
			154;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_sotetsu8000_power_main,position_in_vehid_chain_from_end %10){
			1..2:return 150;
			4..5:return 150;
			7..8:return 150;
			return 0;
		}
//
item(FEAT_TRAINS, sotetsu8000) {
	property {
		OVERRIDEN_TRAIN_DATA

		climates_available: param_disable_sotetsu == 0 ? ALL_CLIMATES : NO_CLIMATE;
		name: string(STR_TRAIN_NAME, string(STR_NAME_SOTETSU), "8000", string(STR_NAME_SERIES),);
		introduction_date: date(1990, 3, 21);
		model_life: VEHICLE_NEVER_EXPIRES;
		vehicle_life: 35;
		reliability_decay: 10;

		cost_factor: 19;
		running_cost_factor: 50;
		speed: 120 km/h;
		track_type: TR_1067_DC;
		weight: 32 ton;
    dual_headed:1;
    badges: ["company/sotetsu"];
	}
	graphics {
		additional_text:
			string(STR_TRAIN_DESC,
			string(STR_NARROWGAUGE),
			string(STR_DENKI, string(STR_DC, 1500)),
			string(STR_LOAD_SPEED, string(STR_DOORS, 4),),
			string(STR_FORMATION, string(STR_NUM_CARS_1, 10)),
			string(STR_USAGE, string(STR_COMMUTER)),
			string(STR_OPERATOR, string(STR_SOTETSU)));
		cargo_subtype_text:sw_sotetsu8000_lv_desc;
		purchase: sotetsu8000_purchase;
		// can_attach_wagon: sw_mucar_attach_vehid;
		start_stop: sw_stop_start_3;
    
	
    SET_GRAPHICS_DOUBLE(sw_sotetsu8000_lv,//graphics
    sw_sotetsu8000_capacity_main(),//cargo capacity
    sw_sotetsu8000_power_main()*4*1342/1000,//power
    param_loading_4D,//loading speed
    sw_sotetsu8000_lv_desc,//subtype
    mu_car,31)//car_fallback,weight
}