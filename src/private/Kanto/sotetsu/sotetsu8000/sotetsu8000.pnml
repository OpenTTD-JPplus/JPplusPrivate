	panto_arm_n_single;
}
//*purchase
  spriteset(sotetsu8000_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu8000_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu8000_1_purchase, roof_gray_med_c1, sotetsu8000_1_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu8000_1_car_base_c2, ac_long_toshiba_c2)
  
	spriteset(sotetsu8000_2_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu8000_2_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_2.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu8000_2_purchase, roof_gray_med_c1, sotetsu8000_2_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu8000_2_car_base_c2, ac_long_toshiba_c2)
  
	spriteset(sotetsu8000_3_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_3.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu8000_3_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_3.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu8000_3_purchase, roof_gray_med_c1, sotetsu8000_3_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu8000_3_car_base_c2, ac_long_toshiba_c2)

	switch(FEAT_TRAINS, SELF, sotetsu8000_purchase, current_year){
		0..2007: sotetsu8000_1_purchase;
		2008..2018: sotetsu8000_2_purchase;
		sotetsu8000_3_purchase;
	}
//
	spriteset(sotetsu8000_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu8000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_sotetsu8000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: sotetsu8000_lights_back;
    sotetsu8000_lights_rear;
  }
//*livery 1
	spriteset(sotetsu8000_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu8000_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu8000/sotetsu8000_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(sotetsu8000_1_head, sotetsu8000_1_head_base, roof_gray_med_h1, sw_sotetsu8000_lights, ac_long_toshiba)
	TRAIN_CONSTRUCTOR_3(sotetsu8000_1_wag, sotetsu8000_1_car_base, roof_gray_med, ac_long_toshiba)
