	spriteset(sotetsu9000_3_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu9000/sotetsu9000_3.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu9000_3_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu9000/sotetsu9000_3.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu9000_3_purchase, roof_gray_med_c1, sotetsu9000_3_front_base_c1, ac_super_long_h_c1, roof_gray_med_c2, sotetsu9000_3_car_base_c2, ac_super_long_c2)

	switch(FEAT_TRAINS, SELF, sotetsu9000_purchase, current_year){
