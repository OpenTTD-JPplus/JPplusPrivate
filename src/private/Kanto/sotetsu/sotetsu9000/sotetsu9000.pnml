	spriteset(sotetsu9000_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu9000/sotetsu9000_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(sotetsu9000_1_head, sotetsu9000_1_head_base, roof_gray_med, sw_sotetsu9000_lights_1, ac_super_long_h)
