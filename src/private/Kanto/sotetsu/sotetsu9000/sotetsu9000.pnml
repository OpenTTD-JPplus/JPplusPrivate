	spriteset(sotetsu9000_2_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu9000/sotetsu9000_2.png"){ tmpl_std_v3(0, 0) }
