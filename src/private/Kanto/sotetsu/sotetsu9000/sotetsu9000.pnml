  switch(FEAT_TRAINS, SELF, sotetsu9000_head_timed, current_year){
    0..2007:sotetsu9000_1_head;    2008..2019:sotetsu9000_2_head;    sotetsu9000_3_head;
  }
  switch(FEAT_TRAINS, SELF, sotetsu9000_wag_timed, current_year){
    0..2007:sotetsu9000_1_wag;    2008..2019:sotetsu9000_2_wag;    sotetsu9000_3_wag;
  }
  switch(FEAT_TRAINS, SELF, sotetsu9000_mot_timed, current_year){
    0..2007:sotetsu9000_1_mot;    2008..2019:sotetsu9000_2_mot;    sotetsu9000_3_mot;
  }

  switch(FEAT_TRAINS, SELF, sotetsu9000_head, cargo_subtype){
    0:sotetsu9000_head_timed;    1:sotetsu9000_1_head;    2:sotetsu9000_2_head;    3:sotetsu9000_3_head;
  }
  switch(FEAT_TRAINS, SELF, sotetsu9000_wag, cargo_subtype){
    0:sotetsu9000_wag_timed;    1:sotetsu9000_1_wag;    2:sotetsu9000_2_wag;    3:sotetsu9000_3_wag;
  }
  switch(FEAT_TRAINS, SELF, sotetsu9000_mot, cargo_subtype){
    0:sotetsu9000_mot_timed;    1:sotetsu9000_1_mot;    2:sotetsu9000_2_mot;    3:sotetsu9000_3_mot;
  }
//*livery 1
	//panto placer
		//1 10
			switch(FEAT_TRAINS, SELF, sw_sotetsu9000_panto_placer_main,position_in_vehid_chain %3){
				0: sotetsu9000_mot;
				1: sotetsu9000_mot;
				sotetsu9000_wag;
			}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_sotetsu9000_lv,vehicle_type_id){
			mu_car:sw_sotetsu9000_panto_placer_main;
			sotetsu9000_head;
		}
//*livery logic
	switch(FEAT_TRAINS, SELF, sw_sotetsu9000_lv_desc, cargo_subtype){
		0:string(LV_RANDOM);
		1:string(LV_DATED,string(STR_LIVERY,string(STR_PREFIX_OLD,string(STR_BELT,string(STR_RED)))),1993);
		2:string(LV_DATED,string(STR_LIVERY,string(LV_sotetsu_orange_blue)),2008);
		3:string(LV_DATED,string(STR_LIVERY,string(LV_sotetsu_navyblue)),2020);
	}
//
//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_sotetsu9000_capacity,position_in_vehid_chain_from_end){
			1: 154;
			4: 154;
			default: 153;
		}
		switch(FEAT_TRAINS, SELF, sw_sotetsu9000_capacity_1,position_in_vehid_chain){
			0: 142;
			default: sw_sotetsu9000_capacity;
		}
		switch(FEAT_TRAINS, SELF, sw_sotetsu9000_capacity_main,vehicle_type_id){
			mu_car:sw_sotetsu9000_capacity;
			sw_sotetsu9000_capacity_1;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_sotetsu9000_power_main,position_in_vehid_chain_from_end %10){
			1..2:return 180;
			4..5:return 180;
			7..8:return 180;
			return 0;
		}
//
item(FEAT_TRAINS, sotetsu9000) {
	property {
		OVERRIDEN_TRAIN_DATA

		climates_available: param_disable_sotetsu == 0 ? ALL_CLIMATES : NO_CLIMATE;
		name: string(STR_TRAIN_NAME, string(STR_NAME_SOTETSU), "9000", string(STR_NAME_SERIES),);
		introduction_date: date(1993, 3, 14);
		model_life: VEHICLE_NEVER_EXPIRES;
		vehicle_life: 35;
		reliability_decay: 10;

		cost_factor: 19;
		running_cost_factor: 50;
		speed: 120 km/h;
		track_type: TR_1067_DC;
		weight: 32 ton;
    dual_headed:1;
    badges: ["company/sotetsu"];
	}
	graphics {
		additional_text:
			string(STR_TRAIN_DESC,
			string(STR_NARROWGAUGE),
			string(STR_DENKI, string(STR_DC, 1500)),
			string(STR_LOAD_SPEED, string(STR_DOORS, 4),),
			string(STR_FORMATION, string(STR_NUM_CARS_1, 10)),
			string(STR_USAGE, string(STR_COMMUTER)),
			string(STR_OPERATOR, string(STR_SOTETSU)));
		cargo_subtype_text:sw_sotetsu9000_lv_desc;
		// can_attach_wagon: sw_mucar_attach_vehid;
		purchase: sotetsu9000_purchase;
		start_stop: sw_stop_start_3;
    

		SET_GRAPHICS_DOUBLE(sw_sotetsu9000_lv,//graphics
    sw_sotetsu9000_capacity_main(),//cargo capacity
    sw_sotetsu9000_power_main()*4*1342/1000,//power
    param_loading_4D,//loading speed
    sw_sotetsu9000_lv_desc,//subtype
    mu_car,31)//car_fallback,weight
}