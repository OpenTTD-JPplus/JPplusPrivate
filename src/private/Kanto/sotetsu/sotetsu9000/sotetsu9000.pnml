//*livery 3
  spriteset(sotetsu9000_2_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu9000/sotetsu9000_3_lights.png"){ tmpl_std_v3(0, 0) }
