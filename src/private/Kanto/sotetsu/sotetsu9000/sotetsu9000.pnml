  GRAPHIC_STACK_6(sotetsu9000_1_purchase, roof_gray_med_c1, sotetsu9000_1_front_base_c1, ac_super_long_h_c1, roof_gray_med_c2, sotetsu9000_1_car_base_c2, ac_super_long_c2)
  
