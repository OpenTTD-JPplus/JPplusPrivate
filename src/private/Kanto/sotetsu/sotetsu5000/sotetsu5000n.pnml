//*purchase
  spriteset(sotetsu5000n_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu5000/sotetsu5000n_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu5000n_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu5000/sotetsu5000n_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu5000n_purchase, roof_gray_med_c1, sotetsu5000n_1_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, sotetsu5000n_1_car_base_c2, ac_long_toshiba_c2)

//*livery 1
	spriteset(sotetsu5000n_1_front_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu5000/sotetsu5000n_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu5000n_1_end_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu5000/sotetsu5000n_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu5000n_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu5000/sotetsu5000n_1.png"){ tmpl_symm_v3(0, 25) }
	
  spriteset(sotetsu5000n_lights_rear, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu5000/sotetsu5000n_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(sotetsu5000n_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu5000/sotetsu5000n_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: sotetsu5000n_lights_back;
    sotetsu5000n_lights_rear;
  }

	TRAIN_CONSTRUCTOR_4(sotetsu5000n_1_head, sotetsu5000n_1_front_base, roof_gray_med, sw_sotetsu5000n_lights, ac_vents_ac_1)
	TRAIN_CONSTRUCTOR_3(sotetsu5000n_1_end_f, sotetsu5000n_1_end_base, roof_gray_med, ac_vents_ac_1_rev)
	TRAIN_CONSTRUCTOR_4(sotetsu5000n_1_front_mot_f, sotetsu5000n_1_front_base, roof_gray_med, ac_vents_ac_1, panto_d_arm_single)
	TRAIN_CONSTRUCTOR_3(sotetsu5000n_1_wag, sotetsu5000n_1_car_base, roof_gray_med, ac_vents_ac_1)
	TRAIN_CONSTRUCTOR_4(sotetsu5000n_1_mot, sotetsu5000n_1_car_base, roof_gray_med, ac_vents_ac_1_mot_rev, panto_d_arm_single)
//
//*livery 1
	//special gfx
		switch(FEAT_TRAINS, PARENT, sw_sotetsu5000n_1_front_gfx,vehicle_is_reversed){
			1: sotetsu5000n_1_head;
			sotetsu5000n_1_front_mot_f;
		}
		switch(FEAT_TRAINS, PARENT, sw_sotetsu5000n_1_end_gfx,vehicle_is_reversed){
			1: sotetsu5000n_1_front_mot_f;
			sotetsu5000n_1_head;
		}
	//panto placer
		//1 8
			switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_1_panto_placer_main_1,position_in_vehid_chain %2){
				1: sotetsu5000n_1_mot;
				sotetsu5000n_1_wag;
			}
		//2 10
			switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_1_panto_placer_main_2,position_in_vehid_chain %7){
				1: sotetsu5000n_1_mot;
				4: sotetsu5000n_1_mot;
				6: sotetsu5000n_1_mot;
				sotetsu5000n_1_wag;
			}
	//fake head-end placer
		//1 2+2+4
			switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_1_fake_placer_1_gfx,position_in_vehid_chain){
				1: sotetsu5000n_1_front_mot_f;
				3: sotetsu5000n_1_front_mot_f;
				sw_sotetsu5000n_1_panto_placer_main_1;
			}
		//2 4+4
			switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_1_fake_placer_2_gfx,position_in_vehid_chain){
				2: sotetsu5000n_1_end_f;
				3: sotetsu5000n_1_front_mot_f;
				sw_sotetsu5000n_1_panto_placer_main_1;
			}
		//3 5+5
			switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_1_fake_placer_3_gfx,position_in_vehid_chain){
				3: sotetsu5000n_1_end_f;
				4: sotetsu5000n_1_front_mot_f;
				sw_sotetsu5000n_1_panto_placer_main_2;
			}
		//controller
		random_switch(FEAT_TRAINS,PARENT,sw_sotetsu5000n_1_fake_placer_main_0){
			1:sw_sotetsu5000n_1_fake_placer_1_gfx;
			2:sw_sotetsu5000n_1_fake_placer_2_gfx;
		}
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_1_fake_placer_main,num_vehs_in_vehid_chain+1){
			0..7: sw_sotetsu5000n_1_panto_placer_main_1;
			8..9: sw_sotetsu5000n_1_fake_placer_main_0;
			sw_sotetsu5000n_1_fake_placer_3_gfx;
		}
	//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_sotetsu5000n_1_end_gfx;
      sw_sotetsu5000n_1_front_gfx;
    }
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_lv,vehicle_type_id){
			mu_car:sw_sotetsu5000n_1_fake_placer_main;
			sw_sotetsu5000n_head_gfx_main;
		}

//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_capacity_main,vehicle_type_id){
			mu_car:135;
			150;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_power_main_1,position_in_vehid_chain %8){
			1:return 180;
			3:return 180;
			6:return 180;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_head_power,build_year){
			0..1987: return 75*2;
			return 180;
		}
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_car_power_main,build_year){
			0..1987:return 75;
			sw_sotetsu5000n_power_main_1;
		}
    switch(FEAT_TRAINS, SELF, sw_sotetsu5000n_power_main,vehicle_type_id){
			mu_car:sw_sotetsu5000n_car_power_main;
			sw_sotetsu5000n_head_power;
		}
