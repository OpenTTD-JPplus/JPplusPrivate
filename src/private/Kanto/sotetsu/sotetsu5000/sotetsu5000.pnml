//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000_capacity_main,vehicle_type_id){
			mu_car:130;
			120;
		}
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000_car_power_main,build_year){
			0..1955:return 55;
			return 75;
		}
		switch(FEAT_TRAINS, SELF, sw_sotetsu5000_power_main,vehicle_type_id){
			mu_car:sw_sotetsu5000_car_power_main;
			return sw_sotetsu5000_car_power_main()*2;
		}
