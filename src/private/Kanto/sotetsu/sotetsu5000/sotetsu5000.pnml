  spriteset(sotetsu5000_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu5000/sotetsu5000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(sotetsu5000_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/sotetsu/sotetsu5000/sotetsu5000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(sotetsu5000_purchase, roof_gray_med_c1, sotetsu5000_1_front_base_c1, ac_vents_1_c1, roof_gray_med_c2, sotetsu5000_1_car_base_c2, ac_vents_1_c2)

//6000
