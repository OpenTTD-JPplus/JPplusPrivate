spriteset(gfx_tsukuba_2000series_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/tsukuba/tsukuba_2000series/tsukuba_2000series.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(gfx_tsukuba_2000series_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/tsukuba/tsukuba_2000series/tsukuba_2000series.png"){ tmpl_purchase_2c_dual(0, 0) }
GRAPHIC_STACK_2(tsukuba_2000series_purchase, gfx_tsukuba_2000series_purchase_c1, gfx_tsukuba_2000series_purchase_c2)

spriteset(gfx_tsukuba_2000series_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/tsukuba/tsukuba_2000series/tsukuba_2000series.png"){ tmpl_std_v3 (0, 0) }
spriteset(gfx_tsukuba_2000series_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/tsukuba/tsukuba_2000series/tsukuba_2000series.png"){ tmpl_std_v3 (0, 25) }
spriteset(gfx_tsukuba_2000series_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/tsukuba/tsukuba_2000series/tsukuba_2000series.png"){ tmpl_symm_v3 (0, 50) }
spriteset(gfx_tsukuba_2000series_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/tsukuba/tsukuba_2000series/tsukuba_2000series.png"){ tmpl_symm_v3 (0, 75) }

//*Livery 1 
switch(FEAT_TRAINS, SELF, sw_tsukuba_2000series_panto_placer_0_main,position_in_vehid_chain %5){
0:gfx_tsukuba_2000series_mot;
2:gfx_tsukuba_2000series_mot;
gfx_tsukuba_2000series_wag;
}
switch(FEAT_TRAINS, SELF, sw_tsukuba_2000series_panto_placer_1_main,position_in_vehid_chain %3){
0:gfx_tsukuba_2000series_mot;
gfx_tsukuba_2000series_wag;
}
switch(FEAT_TRAINS, SELF, sw_tsukuba_2000series_panto_placer_main, num_vehs_in_vehid_chain){
default:sw_tsukuba_2000series_panto_placer_0_main;
3:sw_tsukuba_2000series_panto_placer_1_main;
1:sw_tsukuba_2000series_panto_placer_1_main;
}
switch(FEAT_TRAINS, SELF, sw_tsukuba_2000series_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
1: gfx_tsukuba_2000series_end;
gfx_tsukuba_2000series_front;
}
switch(FEAT_TRAINS, SELF, sw_tsukuba_2000series_lv,vehicle_type_id){
mu_car:sw_tsukuba_2000series_panto_placer_main;
sw_tsukuba_2000series_head_gfx_main;
}

switch(FEAT_TRAINS, SELF, sw_tsukuba_2000series_capacity_main, vehicle_type_id){
	tsukuba_2000series: 147;
	default: 158;
}
switch(FEAT_TRAINS, SELF, sw_tsukuba_2000series_car_power_main, position_in_vehid_chain%8){
	0..3: 190;
	default: 0;
}
switch(FEAT_TRAINS, SELF, sw_tsukuba_2000series_power_main, vehicle_type_id){
	tsukuba_2000series: 0;
	default: sw_tsukuba_2000series_car_power_main;
}