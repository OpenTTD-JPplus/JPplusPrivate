//purchase
  spriteset(tobu30000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu30000/tobu30000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu30000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu30000/tobu30000.png"){ tmpl_purchase_2c_dual(0, 75) }
  GRAPHIC_STACK_2(tobu30000_purchase,  tobu30000_purchase_c1, tobu30000_purchase_c2)
//livery 1
spriteset(tobu30000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu30000/tobu30000.png"){ tmpl_std_v3(0, 0) }
spriteset(tobu30000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu30000/tobu30000.png"){ tmpl_std_v3(0, 25) }
spriteset(tobu30000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu30000/tobu30000.png"){ tmpl_std_v3(0, 50) }
spriteset(tobu30000_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu30000/tobu30000.png"){ tmpl_symm_v3(0, 75) }
spriteset(tobu30000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu30000/tobu30000.png"){ tmpl_symm_v3(0, 100) }
spriteset(tobu30000_front_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu30000/tobu30000.png"){ tmpl_std_v3(0, 125) }
spriteset(tobu30000_end_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu30000/tobu30000.png"){ tmpl_std_rev_v3(0, 125) }

//*main
  //panto placer
    //1
      switch(FEAT_TRAINS, SELF, sw_tobu30000_panto_placer_main_1,position_in_vehid_chain %6){
          0: tobu30000_mot_2;
          3: tobu30000_mot;
          tobu30000_wag;
      }
    //2
      switch(FEAT_TRAINS, SELF, sw_tobu30000_panto_placer_main_2,position_in_vehid_chain %3){
          0: tobu30000_mot_2;
          tobu30000_wag;
      }
    //3
      switch(FEAT_TRAINS, SELF, sw_tobu30000_panto_placer_main_3,position_in_vehid_chain %3){
          1: tobu30000_mot_2;
          tobu30000_wag;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_tobu30000_panto_placer_main,num_vehs_in_vehid_chain){
        3:sw_tobu30000_panto_placer_main_3;
        5:sw_tobu30000_panto_placer_main_2;
        6:sw_tobu30000_panto_placer_main_3;
        sw_tobu30000_panto_placer_main_1;
      }
  //fake head-end placer
    switch(FEAT_TRAINS, SELF, sw_tobu30000_fake_placer_gfx,position_in_vehid_chain){
      4: tobu30000_end_f;
      5: tobu30000_front_f;
    sw_tobu30000_panto_placer_main;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu30000_fake_placer_main,num_vehs_in_vehid_chain>7){
      1: sw_tobu30000_fake_placer_gfx;
      sw_tobu30000_panto_placer_main;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu30000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tobu30000_end;
      tobu30000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu30000_lv,vehicle_type_id){
      mu_car:sw_tobu30000_fake_placer_main;
      sw_tobu30000_head_gfx_main;
    }

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu30000_capacity_main,vehicle_type_id){
      mu_car: 153;
      139;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu30000_car_power_main,position_in_vehid_chain %6){
      0..1:return 190;
      3:return 190;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu30000_power_main,vehicle_type_id){
      mu_car:sw_tobu30000_car_power_main;
      0;
    }
