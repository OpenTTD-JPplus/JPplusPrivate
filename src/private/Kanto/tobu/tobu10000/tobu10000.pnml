//lvstuff
  switch(FEAT_TRAINS, SELF, tobu10000_front_timed, build_year){
    0..1988:tobu10000_1_front;    tobu10030_1_front;
  }
  switch(FEAT_TRAINS, SELF, tobu10000_end_timed, build_year){
    0..1988:tobu10000_1_end;    tobu10030_1_end;
  }
  switch(FEAT_TRAINS, SELF, tobu10000_front_mot_timed, build_year){
    0..1988:tobu10000_1_front_mot;    tobu10030_1_front_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu10000_end_mot_timed, build_year){
    0..1988:tobu10000_1_end_mot;    tobu10030_1_end_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu10000_mot_timed, build_year){
    0..1988:tobu10000_1_mot;    tobu10030_1_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu10000_wag_timed, build_year){
    0..1988:tobu10000_1_wag;    tobu10030_1_wag;
  }

  switch(FEAT_TRAINS, SELF, tobu10000_front, cargo_subtype){
    0:tobu10000_front_timed;
    1:tobu10000_1_front;
    2:tobu10030_1_front;
    3:tobu10030_2_front;
  }
  switch(FEAT_TRAINS, SELF, tobu10000_end, cargo_subtype){
    0:tobu10000_end_timed;
    1:tobu10000_1_end;
    2:tobu10030_1_end;
    3:tobu10030_2_end;
  }
  switch(FEAT_TRAINS, SELF, tobu10000_front_mot, cargo_subtype){
    0:tobu10000_front_mot_timed;
    1:tobu10000_1_front_mot;
    2:tobu10030_1_front_mot;
    3:tobu10030_2_front_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu10000_end_mot, cargo_subtype){
    0:tobu10000_end_mot_timed;
    1:tobu10000_1_end_mot;
    2:tobu10030_1_end_mot;
    3:tobu10030_2_end_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu10000_mot, cargo_subtype){
    0:tobu10000_mot_timed;
    1:tobu10000_1_mot;
    2:tobu10030_1_mot;
    3:tobu10030_2_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu10000_wag, cargo_subtype){
    0:tobu10000_wag_timed;
    1:tobu10000_1_wag;
    2:tobu10030_1_wag;
    3:tobu10030_2_wag;
  }
//
//*main
  //special gfx
    //front gfx
      switch(FEAT_TRAINS, PARENT, sw_tobu10000_front_gfx_0, vehicle_is_reversed){
          1:tobu10000_front;
          tobu10000_front_mot;
      }
      switch(FEAT_TRAINS, SELF, sw_tobu10000_front_gfx, num_vehs_in_consist){
          2:sw_tobu10000_front_gfx_0;
          tobu10000_front;
      }
    //end gfx
      switch(FEAT_TRAINS, PARENT, sw_tobu10000_end_gfx_0, vehicle_is_reversed){
          1:tobu10000_end_mot;
          tobu10000_end;
      }
      switch(FEAT_TRAINS, SELF, sw_tobu10000_end_gfx, num_vehs_in_consist){
          2:sw_tobu10000_end_gfx_0;
          tobu10000_end;
      }
  //panto placer
    //1
      switch(FEAT_TRAINS, SELF, sw_tobu10000_panto_placer_1,position_in_vehid_chain %3){
          0: tobu10000_mot;
          tobu10000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tobu10000_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
          0: tobu10000_mot;
          tobu10000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tobu10000_panto_placer_main_1,vehicle_is_reversed){
          1: sw_tobu10000_panto_placer_1_rev;
          sw_tobu10000_panto_placer_1;
      }
    //2 
      switch(FEAT_TRAINS, SELF, sw_tobu10000_panto_placer_2,position_in_vehid_chain %4){
          0: tobu10000_mot;
          tobu10000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tobu10000_panto_placer_2_rev,position_in_vehid_chain_from_end %4){
          0: tobu10000_mot;
          tobu10000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tobu10000_panto_placer_main_2,vehicle_is_reversed){
          1: sw_tobu10000_panto_placer_2_rev;
          sw_tobu10000_panto_placer_2;
      }
  //panto controller
    switch(FEAT_TRAINS, SELF, sw_tobu10000_panto_placer_main,num_vehs_in_vehid_chain){
      6:sw_tobu10000_panto_placer_main_2;
      sw_tobu10000_panto_placer_main_1;
      }
//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu10000_head_gfx_main,position_in_consist>0){
      1:sw_tobu10000_end_gfx;
      sw_tobu10000_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu10000_lv,vehicle_type_id){
      mu_car:sw_tobu10000_panto_placer_main;
      sw_tobu10000_head_gfx_main;
    }
//livery controller
switch(FEAT_TRAINS, SELF, sw_tobu10000_lv_desc_main,cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(LV_tobu10000_1),1983);
    2: string(LV_DATED,string(LV_tobu10030_1),1988);
    3: string(LV_DATED,string(LV_tobu10030_2),2013);
}

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu10000_capacity_main_1,vehicle_type_id){
        mu_car:170;
        150;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu10030_capacity_main_2,vehicle_type_id){
        mu_car:152;
        142;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu10030_capacity_main_0,build_year){
        0..1988: sw_tobu10000_capacity_main_1;
        sw_tobu10030_capacity_main_2;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu10000_capacity_main,cargo_subtype){
        0:sw_tobu10030_capacity_main_0;
        1:sw_tobu10000_capacity_main_1;
        sw_tobu10030_capacity_main_2;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu10000_power_0,build_year){
      0..1987 :return 140;
      return 165;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu10000_car_power_main,position_in_vehid_chain_from_end %5){
      0..1:sw_tobu10000_power_0;
      3:sw_tobu10000_power_0;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu10000_head_power_main,num_vehs_in_consist){
      2: sw_tobu10000_car_power_main;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu10000_power_main,vehicle_type_id){
      mu_car:sw_tobu10000_car_power_main;
      sw_tobu10000_head_power_main;
    }
