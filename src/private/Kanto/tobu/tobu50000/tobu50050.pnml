//*Non-selectable timed modifications
//
//*livery controller
  switch(FEAT_TRAINS, SELF, sw_tobu50050_1_front_gfx,cargo_subtype){
    0: tobu50050_front;
    1: tobu50050_1_front;
    2: tobu50050_2_front;
    3: tobu50050_3_front;
    4: tobu50050_4_front;
    5: tobu50050_5_front;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu50050_1_end_gfx,cargo_subtype){
    0: tobu50050_end;
    1: tobu50050_1_end;
    2: tobu50050_2_end;
    3: tobu50050_3_end;
    4: tobu50050_4_end;
    5: tobu50050_5_end;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu50050_1_mot_gfx,cargo_subtype){
    0: tobu50050_mot;
    1: tobu50050_1_mot;
    2: tobu50050_2_mot;
    3: tobu50050_3_mot;
    4: tobu50050_4_mot;
    5: tobu50050_5_mot;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu50050_1_mot_rev_gfx,cargo_subtype){
    0: tobu50050_mot_rev;
    1: tobu50050_1_mot_rev;
    2: tobu50050_2_mot_rev;
    3: tobu50050_3_mot_rev;
    4: tobu50050_4_mot_rev;
    5: tobu50050_5_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu50050_1_wag_gfx,cargo_subtype){
    0: tobu50050_wag;
    1: tobu50050_1_wag;
    2: tobu50050_2_wag;
    3: tobu50050_3_wag;
    4: tobu50050_4_wag;
    5: tobu50050_5_wag;
  }

//
//*main
  //1
  switch(FEAT_TRAINS, SELF, sw_tobu50050_panto_placer_main_1,position_in_vehid_chain %3){
    0: sw_tobu50050_1_mot_gfx;
    sw_tobu50050_1_wag_gfx;
  }
  //2
  switch(FEAT_TRAINS, SELF, sw_tobu50050_panto_placer_main_2,position_in_vehid_chain %5){
    0: sw_tobu50050_1_mot_gfx;
    2: sw_tobu50050_1_mot_gfx;
    sw_tobu50050_1_wag_gfx;
  }
  //3 4 car special
  switch(FEAT_TRAINS, SELF, sw_tobu50050_panto_placer_main_3,position_in_vehid_chain %2){
    0: sw_tobu50050_1_mot_rev_gfx;
    1: sw_tobu50050_1_mot_gfx;
    sw_tobu50050_1_wag_gfx;
  }
  //panto controller
  switch(FEAT_TRAINS, SELF, sw_tobu50050_panto_placer_main,num_vehs_in_vehid_chain){
    2:sw_tobu50050_panto_placer_main_3;
    3:sw_tobu50050_panto_placer_main_2;
    6:sw_tobu50050_panto_placer_main_2;
    sw_tobu50050_panto_placer_main_1;
  }
//
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu50050_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_tobu50050_1_end_gfx;
      sw_tobu50050_1_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu50050_lv,vehicle_type_id){
      mu_car:sw_tobu50050_panto_placer_main;
      sw_tobu50050_head_gfx_main;
    }
//
//*livery desc
  switch(FEAT_TRAINS, SELF, sw_tobu50050_lv_desc_main,cargo_subtype){
    0:string(LV_DATED,string(LV_DEFAULT),2005);
    1:string(LV_DATED,string(LV_tobu50050_2),2016);
    2:string(LV_DATED,string(LV_tobu50050_3),2016);
    3:string(LV_DATED,string(LV_tobu50050_4),2016);
    4:string(LV_DATED,string(LV_tobu50050_5),2016);
    5:string(LV_DATED,string(LV_tobu50050_6),2016);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tobu50050_capacity_1,position_in_vehid_chain){
    0: 154;
    153;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu50050_capacity_2,position_in_vehid_chain_from_end){
    0: 154;
    sw_tobu50050_capacity_1;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu50050_capacity_main,vehicle_type_id){
    mu_car:sw_tobu50050_capacity_2;
    140;
  }
