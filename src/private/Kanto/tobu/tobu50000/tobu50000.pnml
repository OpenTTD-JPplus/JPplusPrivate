//purchase
  spriteset(tobu50000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu50000/tobu50000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu50000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu50000/tobu50000.png"){ tmpl_purchase_2c_dual(88, 50) }
  GRAPHIC_STACK_2(tobu50000_purchase,  tobu50000_purchase_c1, tobu50000_purchase_c2)
//liveries gfx
  spriteset(tobu50000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu50000/tobu50000.png"){ tmpl_std_v3(0, 0) }
  spriteset(tobu50000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu50000/tobu50000.png"){ tmpl_std_v3(0, 25) }
  spriteset(tobu50000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu50000/tobu50000.png"){ tmpl_std_v3(0, 50) }
  spriteset(tobu50000_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu50000/tobu50000.png"){ tmpl_std_rev_v3(0, 50) }
  spriteset(tobu50000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu50000/tobu50000.png"){ tmpl_symm_v3(0, 75) }
//
//*main
//panto placer
//1
switch(FEAT_TRAINS, SELF, sw_tobu50000_panto_placer_main_1,position_in_vehid_chain %3){
    0: tobu50000_mot;
    tobu50000_wag;
}
//2
switch(FEAT_TRAINS, SELF, sw_tobu50000_panto_placer_main_2,position_in_vehid_chain %5){
    0: tobu50000_mot;
    2: tobu50000_mot;
    tobu50000_wag;
}
//3 4 car special
switch(FEAT_TRAINS, SELF, sw_tobu50000_panto_placer_main_3,position_in_vehid_chain %2){
    0: tobu50000_mot_rev;
    1: tobu50000_mot;
}
//panto controller
switch(FEAT_TRAINS, SELF, sw_tobu50000_panto_placer_main,num_vehs_in_vehid_chain){
    2:sw_tobu50000_panto_placer_main_3;
    3:sw_tobu50000_panto_placer_main_2;
    6:sw_tobu50000_panto_placer_main_2;
    sw_tobu50000_panto_placer_main_1;
}

  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu50000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tobu50000_end;
      tobu50000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu50000_lv,vehicle_type_id){
      mu_car:sw_tobu50000_panto_placer_main;
      sw_tobu50000_head_gfx_main;
    }
//
//post fixers
//capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tobu50000_capacity_1,position_in_vehid_chain){
    0: 154;
    153;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu50000_capacity_2,position_in_vehid_chain_from_end){
    0: 154;
    sw_tobu50000_capacity_1;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu50000_capacity_main,vehicle_type_id){
    mu_car: sw_tobu50000_capacity_2;
    139;
  }
//power fix
  switch(FEAT_TRAINS, SELF, sw_tobu50000_car_power_main,position_in_vehid_chain_from_end %5){
      0..1:return 165;
      3:return 165;
      return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu50000_power_main,vehicle_type_id){
    mu_car:sw_tobu50000_car_power_main;
    0;
  }
//
//variant naming shenanigans
switch (FEAT_TRAINS, SELF, sw_tobu50000_name_purchase, getbits(extra_callback_info1, 8, 8)) { 
  1: return CB_RESULT_NO_TEXT; 
  return string(STR_TRAIN_NAME, string(STR_NAME_TOBU), "50000/50050/50090", string(STR_NAME_SERIES));
  } 
switch (FEAT_TRAINS, SELF, sw_tobu50000_name, getbits(extra_callback_info1, 0, 8)) { 
  0x20: sw_tobu50000_name_purchase; 
  return CB_RESULT_NO_TEXT;
}