  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu50090_head_gfx_main,position_in_consist>0){
      1:sw_tobu50090_1_end_gfx;
      sw_tobu50090_1_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu50090_lv,vehicle_type_id){
      mu_car:sw_tobu50090_panto_placer_main;
      sw_tobu50090_head_gfx_main;
