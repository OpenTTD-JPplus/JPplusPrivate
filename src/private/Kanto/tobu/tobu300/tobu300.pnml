//purchase
  spriteset(tobu300_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu300/tobu300.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu300_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu300/tobu300.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(tobu300_purchase,  tobu300_purchase_c1, tobu300_purchase_c2)
//livery 1
    spriteset(tobu300_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu300/tobu300.png"){ tmpl_std_v3(0, 0) }
    spriteset(tobu300_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu300/tobu300.png"){ tmpl_std_v3(0, 25) }
    spriteset(tobu300_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu300/tobu300.png"){ tmpl_std_v3(0, 50) }
    spriteset(tobu300_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu300/tobu300.png"){ tmpl_std_rev_v3(0, 50) }
    spriteset(tobu300_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu300/tobu300.png"){ tmpl_std_v3(0, 75) }
    spriteset(tobu300_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu300/tobu300.png"){ tmpl_std_rev_v3(0, 75) }
    spriteset(tobu300_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu300/tobu300.png"){ tmpl_std_v3(0, 100) }
    spriteset(tobu300_mot_2_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu300/tobu300.png"){ tmpl_std_rev_v3(0, 100) }

//*main
  //panto placer
    //var 1
    switch(FEAT_TRAINS, SELF, sw_tobu300_panto_placer_main_1,position_in_vehid_chain %5){
        1: tobu300_mot_2;
        2: tobu300_wag_rev;
        3: tobu300_mot;
        tobu300_wag;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_tobu300_panto_placer_main_2,position_in_vehid_chain %4){
        0: tobu300_mot_2;
        1: tobu300_wag_rev;
        2: tobu300_mot;
        tobu300_wag;
    }
    //main
    switch(FEAT_TRAINS, SELF, sw_tobu300_panto_placer_main,num_vehs_in_vehid_chain+1){
        0..5:sw_tobu300_panto_placer_main_2;
        sw_tobu300_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu300_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: tobu300_end;
      tobu300_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu300_lv,vehicle_type_id){
      mu_car:sw_tobu300_panto_placer_main;
      sw_tobu300_head_gfx_main;
    }

//capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu300_capacity,position_in_vehid_chain_from_end %6){
        0: 72;
        3: 72;
        default: 68;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu300_capacity_main,vehicle_type_id){
        mu_car:sw_tobu300_capacity;
        64;
    }
    //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu300_car_power_main,position_in_vehid_chain_from_end %6){
        0..3:return 130;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu300_power_main,vehicle_type_id){
        mu_car:sw_tobu300_car_power_main;
        0;
    }