//purchase
  spriteset(tobu_deha1_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/deha1/tobu_deha1.png"){ tmpl_purchase_1c(0, 0) }
  GRAPHIC_STACK_2(tobu_deha1_purchase, logo_tobu_7, tobu_deha1_purchase_c1)
//livery 1
spriteset(tobu_deha1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/deha1/tobu_deha1.png"){ tmpl_std_v3(0, 0) }
spriteset(tobu_deha1_front_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/deha1/tobu_deha1.png"){ tmpl_std_rev_v3(0, 25) }
spriteset(tobu_deha1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/deha1/tobu_deha1.png"){ tmpl_std_v3(0, 50) }
spriteset(tobu_deha1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/deha1/tobu_deha1.png"){ tmpl_std_rev_v3(0, 50) }
spriteset(tobu_deha1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/deha1/tobu_deha1.png"){ tmpl_symm_v3(0, 75) }

//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu_deha1_front_gfx, vehicle_is_reversed){
        1:tobu_deha1_front_rev;
        tobu_deha1_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu_deha1_end_gfx, vehicle_is_reversed){
        1:tobu_deha1_end_rev;
        tobu_deha1_end;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_tobu_deha1_panto_placer,position_in_vehid_chain %2){
        1: tobu_deha1_end;
        tobu_deha1_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu_deha1_panto_placer_rev,position_in_vehid_chain_from_end %2){
        0: tobu_deha1_end_rev;
        tobu_deha1_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu_deha1_panto_placer_main,vehicle_is_reversed){
        1: sw_tobu_deha1_panto_placer_rev;
        sw_tobu_deha1_panto_placer;
    }
  //end car fixer
    switch(FEAT_TRAINS, SELF, sw_tobu_deha1_end_fix, position_in_vehid_chain_from_end){
      0:sw_tobu_deha1_end_gfx;
      sw_tobu_deha1_panto_placer_main;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu_deha1_lv,vehicle_type_id){
      mu_car:sw_tobu_deha1_end_fix;
      sw_tobu_deha1_front_gfx;
    }
//power fix
    switch(FEAT_TRAINS, SELF, sw_tobu_deha1_car_power_main,position_in_vehid_chain%2){
        1:return 60;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu_deha1_power_main,vehicle_type_id){
      mu_car:sw_tobu_deha1_car_power_main;
      return 60;
    }