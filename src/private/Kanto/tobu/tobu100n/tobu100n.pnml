//purchase
  spriteset(tobu100n_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu100n_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_purchase_2c_dual(88, 50) }
  GRAPHIC_STACK_2(tobu100n_purchase,  tobu100n_purchase_c1, tobu100n_purchase_c2)
//livery 1
    spriteset(tobu100n_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_long(0, 0) }
    spriteset(tobu100n_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_long(0, 25) }
    spriteset(tobu100n_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_std_v3(0, 50) }
    spriteset(tobu100n_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_std_rev_v3(0, 50) }
    spriteset(tobu100n_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_std_v3(0, 75) }
    spriteset(tobu100n_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_std_rev_v3(0, 75) }
    spriteset(tobu100n_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_std_v3(0, 100) }
    spriteset(tobu100n_mot_2_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_std_rev_v3(0, 100) }
    spriteset(tobu100n_wag_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_std_v3(0, 125) }
    spriteset(tobu100n_wag_2_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu100n/tobu100n.png"){ tmpl_std_rev_v3(0, 125) }

//*main
  //panto placer
    //var 1
    switch(FEAT_TRAINS, SELF, sw_tobu100n_panto_placer_1,position_in_vehid_chain %6){
        0: tobu100n_mot;
        2: tobu100n_mot_2;
        3: tobu100n_wag_2;
        tobu100n_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu100n_panto_placer_1_rev,position_in_vehid_chain_from_end %6){
        0: tobu100n_mot_rev;
        2: tobu100n_mot_2_rev;
        3: tobu100n_wag_2_rev;
        tobu100n_wag_rev;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu100n_panto_placer_main_1,vehicle_is_reversed){
        1: sw_tobu100n_panto_placer_1_rev;
        sw_tobu100n_panto_placer_1;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_tobu100n_panto_placer_2,position_in_vehid_chain %4){
        0: tobu100n_mot;
        1: tobu100n_wag_rev;
        2: tobu100n_mot_2;
        tobu100n_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu100n_panto_placer_2_rev,position_in_vehid_chain_from_end %4){
        0: tobu100n_mot_rev;
        1: tobu100n_wag;
        2: tobu100n_mot_2_rev;
        tobu100n_wag_rev;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu100n_panto_placer_main_2,vehicle_is_reversed){
        1: sw_tobu100n_panto_placer_2_rev;
        sw_tobu100n_panto_placer_2;
    }
    //main
    switch(FEAT_TRAINS, SELF, sw_tobu100n_panto_placer_main,num_vehs_in_vehid_chain){
        0..3:sw_tobu100n_panto_placer_main_2;
        5..6:sw_tobu100n_panto_placer_main_2;
        sw_tobu100n_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu100n_head_gfx_main,position_in_consist>0){
      1: tobu100n_end;
      tobu100n_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu100n_lv,vehicle_type_id){
      mu_car:sw_tobu100n_panto_placer_main;
      sw_tobu100n_head_gfx_main;
    }

//capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu100n_capacity,position_in_vehid_chain_from_end %4){
        0: 35;
        3: 22;
        4: 23;
        default: 56;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu100n_capacity_1,position_in_consist){
        0: 23;
        20;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu100n_capacity_main,vehicle_type_id){
        mu_car:sw_tobu100n_capacity;
        sw_tobu100n_capacity_1;
    }
    //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu100n_car_power_main,position_in_vehid_chain%7){
        0..4: return 165;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu100n_power_main,vehicle_type_id){
      mu_car: sw_tobu100n_car_power_main;
      0;
    }