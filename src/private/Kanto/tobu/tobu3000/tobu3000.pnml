//lv stuff
  switch(FEAT_TRAINS, SELF, tobu3000_front_timed, build_year){
    0..1985:tobu3000_1_front;    tobu3000_2_front;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_end_timed, build_year){
    0..1985:tobu3000_1_end;    tobu3000_2_end;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_front_mot_timed, build_year){
    0..1985:tobu3000_1_front_mot;    tobu3000_2_front_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_end_mot_timed, build_year){
    0..1985:tobu3000_1_end_mot;    tobu3000_2_end_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_mot_timed, build_year){
    0..1985:tobu3000_1_mot;    tobu3000_2_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_mot_rev_timed, build_year){
    0..1985:tobu3000_1_mot_rev;    tobu3000_2_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_wag_timed, build_year){
    0..1985:tobu3000_1_wag;    tobu3000_2_wag;
  }

  switch(FEAT_TRAINS, SELF, tobu3000_front, cargo_subtype){
    1:tobu3000_1_front;    2:tobu3000_1_front;    tobu3000_front_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_end, cargo_subtype){
    1:tobu3000_1_end;    2:tobu3000_1_end;    tobu3000_end_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_front_mot, cargo_subtype){
    1:tobu3000_1_front_mot;    2:tobu3000_1_front_mot;    tobu3000_front_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_end_mot, cargo_subtype){
    1:tobu3000_1_end_mot;    2:tobu3000_1_end_mot;    tobu3000_end_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_mot, cargo_subtype){
    1:tobu3000_1_mot;    2:tobu3000_1_mot;    tobu3000_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_mot_rev, cargo_subtype){
    1:tobu3000_1_mot_rev;    2:tobu3000_1_mot_rev;    tobu3000_mot_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_wag, cargo_subtype){
    1:tobu3000_1_wag;    2:tobu3000_1_wag;    tobu3000_wag_timed;
  }
//
//*main
  //special gfx
    //head gfx
    switch(FEAT_TRAINS, PARENT, sw_tobu3000_front_gfx, vehicle_is_reversed){
        1:tobu3000_front;
        tobu3000_front_mot;
    }
    //end gfx
    switch(FEAT_TRAINS, PARENT, sw_tobu3000_end_gfx, vehicle_is_reversed){
        1:tobu3000_end_mot;
        tobu3000_end;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_tobu3000_panto_placer_1,position_in_vehid_chain %2){
        1: tobu3000_mot;
        tobu3000_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu3000_panto_placer_1_rev,position_in_vehid_chain_from_end %2){
        1: tobu3000_mot_rev;
        tobu3000_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu3000_panto_placer_main,vehicle_is_reversed){
        1: sw_tobu3000_panto_placer_1_rev;
        sw_tobu3000_panto_placer_1;
    }

  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu3000_head_gfx_main,position_in_consist>0){
      1:sw_tobu3000_end_gfx;
      sw_tobu3000_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu3000_lv,vehicle_type_id){
      mu_car:sw_tobu3000_panto_placer_main;
      sw_tobu3000_head_gfx_main;
    }
//lv controller
  switch(FEAT_TRAINS, SELF, sw_tobu3000_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_tobu3000_1)),1964);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_tobu3000_2)),1985);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu3000_capacity_main,vehicle_type_id){
        mu_car:140;
        150;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu3000_power_0,build_year){
        0..1970: return 97;
        return 110;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu3000_car_power_main, position_in_vehid_chain %2) {
      1: sw_tobu3000_power_0;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu3000_power_main,vehicle_type_id){
      mu_car:sw_tobu3000_car_power_main;
      sw_tobu3000_power_0;
    }
//