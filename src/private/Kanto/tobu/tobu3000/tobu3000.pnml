//purchase
  spriteset(tobu3000_1_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_1.png"){ tmpl_purchase_1c_dual(0, 50) }
  spriteset(tobu3000_1_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_1.png"){ tmpl_purchase_2c_dual(0, 125) }
  spriteset(tobu3000_2_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_2.png"){ tmpl_purchase_1c_dual(0, 50) }
  spriteset(tobu3000_2_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_2.png"){ tmpl_purchase_2c_dual(0, 125) }
  switch(FEAT_TRAINS, SELF, tobu3000_purchase_c1, current_year){
    0..1985:tobu3000_1_purchase_c1;    tobu3000_2_purchase_c1;
  }
  switch(FEAT_TRAINS, SELF, tobu3000_purchase_c2, current_year){
    0..1985:tobu3000_1_purchase_c2;    tobu3000_2_purchase_c2;
  }
  GRAPHIC_STACK_3(tobu3000_purchase, logo_tobu, tobu3000_purchase_c1, tobu3000_purchase_c2)
//livery 1
spriteset(tobu3000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_1.png"){ tmpl_std_v3(0, 0) }
spriteset(tobu3000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_1.png"){ tmpl_std_v3(0, 25) }
spriteset(tobu3000_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_1.png"){ tmpl_std_v3(0, 50) }
spriteset(tobu3000_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_1.png"){ tmpl_std_rev_v3(0, 75) }
spriteset(tobu3000_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_1.png"){ tmpl_std_v3(0, 100) }
spriteset(tobu3000_1_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_1.png"){ tmpl_std_rev_v3(0, 100) }
spriteset(tobu3000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_1.png"){ tmpl_symm_v3(0, 125) }

//livery 2
spriteset(tobu3000_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_2.png"){ tmpl_std_v3(0, 0) }
spriteset(tobu3000_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_2.png"){ tmpl_std_v3(0, 25) }
spriteset(tobu3000_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_2.png"){ tmpl_std_v3(0, 50) }
spriteset(tobu3000_2_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu3000/tobu3000_2.png"){ tmpl_std_rev_v3(0, 75) }
