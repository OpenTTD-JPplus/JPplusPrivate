//*main
//panto placer
//1
switch(FEAT_TRAINS, SELF, sw_tobu60000_panto_placer_1,position_in_vehid_chain %3){
    0: tobu60000_mot;
    tobu60000_wag;
}
switch(FEAT_TRAINS, SELF, sw_tobu60000_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
    0: tobu60000_mot_rev;
    tobu60000_wag;
}
switch(FEAT_TRAINS, PARENT, sw_tobu60000_panto_placer_main_1,vehicle_is_reversed){
    1: sw_tobu60000_panto_placer_1_rev;
    sw_tobu60000_panto_placer_1;
}
//2
switch(FEAT_TRAINS, SELF, sw_tobu60000_panto_placer_2,position_in_vehid_chain %5){
    0: tobu60000_mot;
    2: tobu60000_mot;
    tobu60000_wag;
}
switch(FEAT_TRAINS, SELF, sw_tobu60000_panto_placer_2_rev,position_in_vehid_chain_from_end %5){
    0: tobu60000_mot_rev;
    2: tobu60000_mot_rev;
    tobu60000_wag;
}
switch(FEAT_TRAINS, PARENT, sw_tobu60000_panto_placer_main_2,vehicle_is_reversed){
    1: sw_tobu60000_panto_placer_2_rev;
    sw_tobu60000_panto_placer_2;
}
//3 4 car special
switch(FEAT_TRAINS, SELF, sw_tobu60000_panto_placer_3,position_in_vehid_chain %2){
    0: tobu60000_mot_rev;
    1: tobu60000_mot;
    tobu60000_wag;
}
switch(FEAT_TRAINS, SELF, sw_tobu60000_panto_placer_3_rev,position_in_vehid_chain_from_end %2){
    0: tobu60000_mot;
    1: tobu60000_mot_rev;
    tobu60000_wag;
}
switch(FEAT_TRAINS, PARENT, sw_tobu60000_panto_placer_main_3,vehicle_is_reversed){
    1: sw_tobu60000_panto_placer_3_rev;
    sw_tobu60000_panto_placer_3;
}
//panto controller
switch(FEAT_TRAINS, SELF, sw_tobu60000_panto_placer_main,num_vehs_in_vehid_chain){
    2:sw_tobu60000_panto_placer_main_3;
    3:sw_tobu60000_panto_placer_main_2;
    6:sw_tobu60000_panto_placer_main_2;
    sw_tobu60000_panto_placer_main_1;
}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu60000_head_gfx_main,position_in_consist>0){
      1:tobu60000_end;
      tobu60000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu60000_lv,vehicle_type_id){
      mu_car:sw_tobu60000_panto_placer_main;
      sw_tobu60000_head_gfx_main;
    }

//post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_tobu60000_capacity_main,vehicle_type_id){
      mu_car: 146;
      133;
  }
//power fix
  switch(FEAT_TRAINS, SELF, sw_tobu60000_car_power_main,position_in_vehid_chain %5){
    0..1:return 165;
    3:return 165;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu60000_power_main,vehicle_type_id){
    mu_car:sw_tobu60000_car_power_main;
    0;
  }
