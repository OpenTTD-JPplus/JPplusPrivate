//livery 1
spriteset(tobu60000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu60000/tobu60000.png"){ tmpl_std_v3(0, 0) }
spriteset(tobu60000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu60000/tobu60000.png"){ tmpl_std_v3(0, 25) }
spriteset(tobu60000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu60000/tobu60000.png"){ tmpl_std_v3(0, 50) }
spriteset(tobu60000_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu60000/tobu60000.png"){ tmpl_std_rev_v3(0, 50) }
