//purchase
  spriteset(tobu60000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu60000/tobu60000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu60000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu60000/tobu60000.png"){ tmpl_purchase_2c_dual(88, 50) }
