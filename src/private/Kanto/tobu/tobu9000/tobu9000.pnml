//purchase
  spriteset(tobu9000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu9000/tobu9000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu9000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu9000/tobu9000.png"){ tmpl_purchase_2c_dual(88, 50) }
  GRAPHIC_STACK_2(tobu9000_purchase,  tobu9000_purchase_c1, tobu9000_purchase_c2)
//livery 1
  spriteset(tobu9000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu9000/tobu9000.png"){ tmpl_std_v3(0, 0) }
  spriteset(tobu9000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu9000/tobu9000.png"){ tmpl_std_v3(0, 25) }
  spriteset(tobu9000_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu9000/tobu9000.png"){ tmpl_std_v3(0, 50) }
  spriteset(tobu9000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu9000/tobu9000.png"){ tmpl_symm_v3(0, 75) }
//livery 2
  spriteset(tobu9050_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu9000/tobu9050.png"){ tmpl_std_v3(0, 0) }
  spriteset(tobu9050_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu9000/tobu9050.png"){ tmpl_std_v3(0, 25) }
  spriteset(tobu9050_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu9000/tobu9050.png"){ tmpl_std_v3(0, 50) }
  spriteset(tobu9050_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu9000/tobu9050.png"){ tmpl_symm_v3(0, 75) }
//
  switch(FEAT_TRAINS, SELF, tobu9000_front_timed, build_year){
    0..1993:tobu9000_1_front;    tobu9050_1_front;
  }
  switch(FEAT_TRAINS, SELF, tobu9000_end_timed, build_year){
    0..1993:tobu9000_1_end;    tobu9050_1_end;
  }
  switch(FEAT_TRAINS, SELF, tobu9000_mot_timed, build_year){
    0..1993:tobu9000_1_mot;    tobu9050_1_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu9000_wag_timed, build_year){
    0..1993:tobu9000_1_wag;    tobu9050_1_wag;
  }

  switch(FEAT_TRAINS, SELF, tobu9000_front, cargo_subtype){
    0:tobu9000_front_timed;    1:tobu9000_1_front;    tobu9050_1_front;
  }
  switch(FEAT_TRAINS, SELF, tobu9000_end, cargo_subtype){
    0:tobu9000_end_timed;    1:tobu9000_1_end;    tobu9050_1_end;
  }
  switch(FEAT_TRAINS, SELF, tobu9000_mot, cargo_subtype){
    0:tobu9000_mot_timed;    1:tobu9000_1_mot;    tobu9050_1_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu9000_wag, cargo_subtype){
    0:tobu9000_wag_timed;    1:tobu9000_1_wag;    tobu9050_1_wag;
  }
//*main
  //panto placer
    //1
      switch(FEAT_TRAINS, SELF, sw_tobu9000_panto_placer_main_1,position_in_vehid_chain %3){
          0: tobu9000_mot;
          tobu9000_wag;
      }
    //2 
      switch(FEAT_TRAINS, SELF, sw_tobu9000_panto_placer_main_2,position_in_vehid_chain %2){
          0: tobu9000_mot;
          tobu9000_wag;
      }
  //panto controller
    switch(FEAT_TRAINS, SELF, sw_tobu9000_panto_placer_main,num_vehs_in_vehid_chain){
        3:sw_tobu9000_panto_placer_main_2;
        6:sw_tobu9000_panto_placer_main_2;
        sw_tobu9000_panto_placer_main_1;
    }
  //front-end-fixer
   switch(FEAT_TRAINS, SELF, sw_tobu9000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tobu9000_end;
      tobu9000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu9000_lv,vehicle_type_id){
      mu_car:sw_tobu9000_panto_placer_main;
      sw_tobu9000_head_gfx_main;
    }
//livery_controller
  switch(FEAT_TRAINS, SELF, sw_tobu9000_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(LV_tobu9000_1),1981);
      2:string(LV_DATED,string(LV_tobu9050_1),1994);
  }
//
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu9000_capacity_main_1,vehicle_type_id){
        mu_car: 144;
        0: 136;
    }
    //capacity 2
    switch(FEAT_TRAINS, SELF, sw_tobu9050_capacity_main,vehicle_type_id){
        mu_car: 152;
        0: 141;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu9000_capacity_0, build_year){
        0..1993:sw_tobu9000_capacity_main_1;
        sw_tobu9050_capacity_main;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu9000_capacity_main, cargo_subtype){
        0:sw_tobu9000_capacity_0;
        1:sw_tobu9000_capacity_main_1;
        sw_tobu9050_capacity_main;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu9000_car_power_main,position_in_vehid_chain_from_end %3){
      0..1:150;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu9000_power_main,vehicle_type_id){
      mu_car:sw_tobu9000_car_power_main;
      0;
    }
