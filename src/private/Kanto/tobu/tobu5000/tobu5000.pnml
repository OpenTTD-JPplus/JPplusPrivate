//lv stuff
  switch(FEAT_TRAINS, SELF, tobu5000_front_timed, current_year){
    0..1979:tobu5000_1_front;    tobu5000_2_front;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_end_timed, current_year){
    0..1979:tobu5000_1_end;    tobu5000_2_end;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_front_mot_timed, current_year){
    0..1979:tobu5000_1_front_mot;    tobu5000_2_front_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_end_mot_timed, current_year){
    0..1979:tobu5000_1_end_mot;    tobu5000_2_end_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_mot_timed, current_year){
    0..1979:tobu5000_1_mot;    tobu5000_2_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_wag_timed, current_year){
    0..1979:tobu5000_1_wag;    tobu5000_2_wag;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_front, cargo_subtype){
    1:tobu5000_1_front;
    2:tobu5000_2_front;
    tobu5000_front_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_end, cargo_subtype){
    1:tobu5000_1_end;
    2:tobu5000_2_end;
    tobu5000_end_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_front_mot, cargo_subtype){
    1:tobu5000_1_front_mot;
    2:tobu5000_2_front_mot;
    tobu5000_front_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_end_mot, cargo_subtype){
    1:tobu5000_1_end_mot;
    2:tobu5000_2_end_mot;
    tobu5000_end_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_mot, cargo_subtype){
    1:tobu5000_1_mot;
    2:tobu5000_2_mot;
    tobu5000_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu5000_wag, cargo_subtype){
    1:tobu5000_1_wag;
    2:tobu5000_2_wag;
    tobu5000_wag_timed;
  }
//
//*main
  //special gfx
    //head gfx
    switch(FEAT_TRAINS, PARENT, sw_tobu5000_front_gfx, vehicle_is_reversed){
        1:tobu5000_front;
        tobu5000_front_mot;
    }
    //end gfx
    switch(FEAT_TRAINS, PARENT, sw_tobu5000_end_gfx, vehicle_is_reversed){
        1:tobu5000_end_mot;
        tobu5000_end;
    }
  //panto placer
    //1
    switch(FEAT_TRAINS, SELF, sw_tobu5000_panto_placer_main,position_in_vehid_chain %2){
        1: tobu5000_mot;
        tobu5000_wag;
    }

  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu5000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_tobu5000_end_gfx;
      sw_tobu5000_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu5000_lv,vehicle_type_id){
      mu_car:sw_tobu5000_panto_placer_main;
      sw_tobu5000_head_gfx_main;
    }
//livery controller
switch(FEAT_TRAINS, SELF, sw_tobu5000_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_1)),1979);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_5)),1985);
}

//post fixers
//capacity-changer
switch(FEAT_TRAINS, SELF, sw_tobu5000_capacity_main,vehicle_type_id){
    mu_car: 170;
    150;
}

//power fixer
  switch(FEAT_TRAINS, SELF, sw_tobu5000_car_power_main, position_in_vehid_chain %2) {
    1: return 142;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu5000_power_main,vehicle_type_id){
    mu_car:sw_tobu5000_car_power_main;
    142;
  }