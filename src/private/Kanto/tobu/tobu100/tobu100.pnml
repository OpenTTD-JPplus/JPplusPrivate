//*main
  //panto placer
    //1
    switch(FEAT_TRAINS, SELF, sw_tobu100_panto_placer_main_1,position_in_vehid_chain %6){
        0: tobu100_mot_rev;
        2: tobu100_mot_1;
        3: tobu100_mot;
        tobu100_wag;
    }
    //2 5,8 car
    switch(FEAT_TRAINS, SELF, sw_tobu100_panto_placer_main_2,position_in_vehid_chain %8){
        0: tobu100_mot_rev;
        2: tobu100_mot_1;
        4:tobu100_mot;
        tobu100_wag;
    }
    //2 3-4 car
    switch(FEAT_TRAINS, SELF, sw_tobu100_panto_placer_main_3,position_in_vehid_chain %3){
        0: tobu100_mot_1_rev;
        1: tobu100_mot;
        tobu100_wag;
    }
    //panto controller
    switch(FEAT_TRAINS, SELF, sw_tobu100_panto_placer_main,num_vehs_in_vehid_chain){
        0..2:sw_tobu100_panto_placer_main_3;
        3:sw_tobu100_panto_placer_main_2;
        6:sw_tobu100_panto_placer_main_2;
        sw_tobu100_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu100_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: tobu100_end;
      tobu100_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu100_lv,vehicle_type_id){
      mu_car:sw_tobu100_panto_placer_main;
      sw_tobu100_head_gfx_main;
    }
//*livery controller
  switch(FEAT_TRAINS, SELF, sw_tobu100_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_tobu100_1)),1990);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_tobu100_2)),2012);
      3:string(LV_DATED,string(STR_LIVERY,string(LV_tobu100_3)),2012);
      4:string(LV_DATED,string(STR_LIVERY,string(LV_tobu100_4)),2012);
      5:string(LV_DATED,string(STR_LIVERY,string(LV_tobu100_5)),2021);
      6:string(LV_DATED,string(STR_LIVERY,string(LV_tobu100_6)),2021);
  }

//*post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu100_capacity,position_in_vehid_chain_from_end %4){
        0: 64;
        1: 36;
        2: 56;
        3: 64;
        default: 64;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu100_capacity_1,position_in_consist){
        0: 24;
        44;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu100_capacity_main,vehicle_type_id){
        mu_car:sw_tobu100_capacity;
        sw_tobu100_capacity_1;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_tobu100_car_power_main,position_in_vehid_chain%7){
        0..4: return 150;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu100_power_main,vehicle_type_id){
      mu_car: sw_tobu100_car_power_main;
      0;
    }