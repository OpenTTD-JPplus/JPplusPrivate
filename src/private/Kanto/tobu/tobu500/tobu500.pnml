//purchase
  spriteset(tobu500_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu500/tobu500.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu500_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu500/tobu500.png"){ tmpl_purchase_2c_dual(88, 50) }
  GRAPHIC_STACK_3(tobu500_purchase, logo_tobu, tobu500_purchase_c1, tobu500_purchase_c2)
//livery 1
    spriteset(tobu500_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu500/tobu500.png"){ tmpl_std_v3(0, 0) }
    spriteset(tobu500_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu500/tobu500.png"){ tmpl_std_v3(0, 25) }
    spriteset(tobu500_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu500/tobu500.png"){ tmpl_std_v3(0, 50) }
    spriteset(tobu500_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu500/tobu500.png"){ tmpl_std_rev_v3(0, 50) }
    spriteset(tobu500_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu500/tobu500.png"){ tmpl_std_v3(0, 75) }
    spriteset(tobu500_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu500/tobu500.png"){ tmpl_std_rev_v3(0, 75) }
    spriteset(tobu500_front_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu500/tobu500.png"){ tmpl_std_rev_v3(0, 100) }
    spriteset(tobu500_end_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu500/tobu500.png"){ tmpl_std_v3(0, 100) }

//*main
  //panto placer
    //var 1
    switch(FEAT_TRAINS, SELF, sw_tobu500_panto_placer_1,position_in_vehid_chain %3){
        1: tobu500_mot;
        tobu500_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu500_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
        1: tobu500_mot_rev;
        tobu500_wag_rev;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu500_panto_placer_main_1,vehicle_is_reversed){
        1: sw_tobu500_panto_placer_1_rev;
        sw_tobu500_panto_placer_1;
    }
    //var 2
    switch(FEAT_TRAINS, PARENT, sw_tobu500_panto_placer_main_2,vehicle_is_reversed){
        1: tobu500_wag_rev;
        tobu500_wag;
    }
    //main
    switch(FEAT_TRAINS, SELF, sw_tobu500_panto_placer_main,num_vehs_in_vehid_chain){
        0..2:sw_tobu500_panto_placer_main_2;
        5:sw_tobu500_panto_placer_main_2;
        sw_tobu500_panto_placer_main_1;
    }

  //fake head-end placer
    switch(FEAT_TRAINS, SELF, sw_tobu500_fake_placer,position_in_vehid_chain){
        1: tobu500_front_f;
        2: tobu500_end_f;
    sw_tobu500_panto_placer_main;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu500_fake_placer_rev,position_in_vehid_chain_from_end ){
        1: tobu500_end_f;
        2: tobu500_front_f;
    sw_tobu500_panto_placer_main;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu500_fake_placer_gfx,vehicle_is_reversed){
        1: sw_tobu500_fake_placer_rev;
        sw_tobu500_fake_placer;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu500_fake_placer_main,num_vehs_in_vehid_chain>3){
        1: sw_tobu500_fake_placer_gfx;
    sw_tobu500_panto_placer_main;
    }

  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu500_head_gfx_main,position_in_consist>0){
      1: tobu500_end;
      tobu500_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu500_lv,vehicle_type_id){
      mu_car:sw_tobu500_fake_placer_main;
      sw_tobu500_head_gfx_main;
    }

//capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu500_capacity_main,vehicle_type_id){
        mu_car: 136;
        112;
    }

    //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu500_car_power_main,position_in_vehid_chain_from_end %2){
        1:return 190;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu500_power_main,vehicle_type_id){
        mu_car:sw_tobu500_car_power_main;
        return 190*2;
    }