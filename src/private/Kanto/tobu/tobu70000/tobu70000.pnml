//*main
//panto placer
//1
switch(FEAT_TRAINS, SELF, sw_tobu70000_panto_placer_main_1,position_in_vehid_chain %4){
    0: tobu70000_mot_rev;
    2: tobu70000_mot_2;
    tobu70000_wag;
}
//2 4 car special
switch(FEAT_TRAINS, SELF, sw_tobu70000_panto_placer_main_2,position_in_vehid_chain %2){
    0: tobu70000_mot_2;
    tobu70000_wag;
}
//panto controller
switch(FEAT_TRAINS, SELF, sw_tobu70000_panto_placer_main,num_vehs_in_vehid_chain){
    0..2:sw_tobu70000_panto_placer_main_2;
    sw_tobu70000_panto_placer_main_1;
}
//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu70000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tobu70000_end;
      tobu70000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu70000_lv,vehicle_type_id){
      mu_car:sw_tobu70000_panto_placer_main;
      sw_tobu70000_head_gfx_main;
    }

//lv desc
switch(FEAT_TRAINS, SELF, sw_tobu70000_lv_desc_main, cargo_subtype){
    0:string(LV_DATED,string(LV_tobu70000_1),2017);
    1:string(LV_DATED,string(LV_tobu70000_2),2020);
}
//*post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu70000_capacity_main,vehicle_type_id){
        mu_car:151;
        140;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu70000_car_power_main,position_in_vehid_chain_from_end %8){
    0..5:return 102;
    return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu70000_power_main,vehicle_type_id){
      mu_car:sw_tobu70000_car_power_main;
      205;
    }
