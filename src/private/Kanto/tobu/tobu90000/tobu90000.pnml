//main
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_tobu90000_panto_placer_1,position_in_vehid_chain %2){
        0: tobu90000_mot;
        tobu90000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_tobu90000_panto_placer_1_rev,position_in_vehid_chain_from_end %2){
        0: tobu90000_mot_rev;
        tobu90000_wag;
      }
      switch(FEAT_TRAINS, PARENT, sw_tobu90000_panto_placer_main,vehicle_is_reversed){
        1: sw_tobu90000_panto_placer_1_rev;
        sw_tobu90000_panto_placer_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu90000_head_gfx_main,position_in_consist>0){
      1: tobu90000_end;
      tobu90000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu90000_lv,vehicle_type_id){
      mu_car:sw_tobu90000_panto_placer_main;
      sw_tobu90000_head_gfx_main;
    }
//
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu90000_capacity_1, position_in_vehid_chain){
      0:144;
      146;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu90000_capacity_2, position_in_vehid_chain_from_end){
      0:143;
      sw_tobu90000_capacity_1;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu90000_capacity_main,vehicle_type_id){
        mu_car:sw_tobu90000_capacity_2;
        133;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_tobu90000_car_power_main,position_in_vehid_chain_from_end %4){
      0..1:return 250;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu90000_power_main,vehicle_type_id){
      mu_car: sw_tobu90000_car_power_main;
      0;
    }
