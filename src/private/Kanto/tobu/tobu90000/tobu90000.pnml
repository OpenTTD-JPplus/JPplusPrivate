  TRAIN_CONSTRUCTOR_3(tobu90000_front, tobu90000_head_base, tobu90000_lights_front, ac_long_toshiba)
  TRAIN_CONSTRUCTOR_3(tobu90000_end, tobu90000_head_base, tobu90000_lights_end, ac_long_toshiba)
  TRAIN_CONSTRUCTOR_3(tobu90000_mot, tobu90000_wag_base, ac_long_toshiba,panto_arm_n_single)
  TRAIN_CONSTRUCTOR_3(tobu90000_mot_rev, tobu90000_wag_base, ac_long_toshiba,panto_arm_n_single_rev)
  TRAIN_CONSTRUCTOR_2(tobu90000_wag, tobu90000_wag_base, ac_long_toshiba)
