  //lv stuff
    switch(FEAT_TRAINS, SELF, tobu1800_1_front_timed_1, current_year){
        0..1988:tobu1800_1n_front;        tobu1800_1_o_front;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_1_end_timed_1, current_year){
        0..1988:tobu1800_1n_end;        tobu1800_1_o_end;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_1_mot_timed_1, current_year){
        0..1988:tobu1800_1n_mot;        tobu1800_1_o_mot;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_1_wag_timed_1, current_year){
        0..1988:tobu1800_1n_wag;        tobu1800_1_o_wag;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_1_wag_rev_timed_1, current_year){
        0..1988:tobu1800_1n_wag_rev;        tobu1800_1_o_wag_rev;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_1_mot_2_timed_1, current_year){
        0..1988:tobu1800_1n_mot_2;        tobu1800_1_o_mot_2;
    }

    switch(FEAT_TRAINS, SELF, tobu1800_1_front_timed, current_year){
        0..1985:tobu1800_2_front;        tobu1800_1_front_timed_1;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_1_end_timed, current_year){
        0..1985:tobu1800_2_end;        tobu1800_1_end_timed_1;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_1_mot_timed, current_year){
        0..1985:tobu1800_2_mot;        tobu1800_1_mot_timed_1;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_1_wag_timed, current_year){
        0..1985:tobu1800_2_wag;        tobu1800_1_wag_timed_1;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_1_wag_rev_timed, current_year){
        0..1985:tobu1800_2_wag_rev;        tobu1800_1_wag_rev_timed_1;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_1_mot_2_timed, current_year){
        0..1985:tobu1800_2_mot_2;        tobu1800_1_mot_2_timed_1;
    }

    switch(FEAT_TRAINS, SELF, tobu1800_front, cargo_subtype){
      0:tobu1800_1_front_timed;
      1:tobu1800_2_front;
      2:tobu1800_1_front_timed_1;
      3:tobu1800_3_front;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_end, cargo_subtype){
      0:tobu1800_1_end_timed;
      1:tobu1800_2_end;
      2:tobu1800_1_end_timed_1;
      3:tobu1800_3_end;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_mot, cargo_subtype){
      0:tobu1800_1_mot_timed;
      1:tobu1800_2_mot;
      2:tobu1800_1_mot_timed_1;
      3:tobu1800_3_mot;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_wag, cargo_subtype){
      0:tobu1800_1_wag_timed;
      1:tobu1800_2_wag;
      2:tobu1800_1_wag_timed_1;
      3:tobu1800_3_wag;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_wag_rev, cargo_subtype){
      0:tobu1800_1_wag_rev_timed;
      1:tobu1800_2_wag_rev;
      2:tobu1800_1_wag_rev_timed_1;
      3:tobu1800_3_wag_rev;
    }
    switch(FEAT_TRAINS, SELF, tobu1800_mot_2, cargo_subtype){
      0:tobu1800_1_mot_2_timed;
      1:tobu1800_2_mot_2;
      2:tobu1800_1_mot_2_timed_1;
      3:tobu1800_3_mot_2;
    }


//*main
  //panto placer
    //var 1
    switch(FEAT_TRAINS, SELF, sw_tobu1800_panto_placer_main_1,position_in_vehid_chain %5){
        1: tobu1800_mot_2;
        2: tobu1800_wag_rev;
        3: tobu1800_mot;
        tobu1800_wag;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_tobu1800_panto_placer_main_2,position_in_vehid_chain %4){
        0: tobu1800_mot_2;
        1: tobu1800_wag_rev;
        2: tobu1800_mot;
        tobu1800_wag;
    }
    //main
    switch(FEAT_TRAINS, SELF, sw_tobu1800_panto_placer_main,num_vehs_in_vehid_chain){
        0..3:sw_tobu1800_panto_placer_main_2;
        sw_tobu1800_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu1800_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: tobu1800_end;
      tobu1800_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu1800_lv,vehicle_type_id){
      mu_car:sw_tobu1800_panto_placer_main;
      sw_tobu1800_head_gfx_main;
    }
    
//livery desc controller
    switch(FEAT_TRAINS, SELF, sw_tobu1800_lv_desc_main, cargo_subtype){
        0:string(LV_RANDOM);
        1:string(LV_DATED,string(STR_LIVERY,string(LV_tobu1800_1)),1969);
        2:string(LV_DATED,string(STR_LIVERY,string(LV_tobu1800_2)),1985);
        3:string(LV_DATED,string(LV_tobu1800_3),2001);
    }
//capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu1800_capacity_1_0,position_in_vehid_chain %4){
        0: 72;
        3: 72;
        68;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu1800_capacity_1,vehicle_type_id){
        mu_car: sw_tobu1800_capacity_1_0;
        64;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu1800_capacity_2,vehicle_type_id){
        mu_car: 140;
        130;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu1800_capacity_main,cargo_subtype){
        3:sw_tobu1800_capacity_2;
        sw_tobu1800_capacity_1;
    }
//cargo age
    switch(FEAT_TRAINS, SELF, sw_tobu1800_cargo_age_main,cargo_subtype){
        3:express_cargo_age;
        ltd_express_cargo_age;
    }
//power fix
    switch(FEAT_TRAINS, SELF, sw_tobu1800_car_power_main,position_in_vehid_chain_from_end %5){
        0..1:return 130;
        3:return 130;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu1800_power_main,vehicle_type_id){
      mu_car:sw_tobu1800_car_power_main;
      0;
    }
