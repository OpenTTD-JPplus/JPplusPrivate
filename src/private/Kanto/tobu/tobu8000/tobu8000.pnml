//*main
  //special gfx
    //head gfx
    switch(FEAT_TRAINS, PARENT, sw_tobu8000_front_gfx_0, vehicle_is_reversed){
        1:tobu8000_front;
        tobu8000_front_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu8000_front_gfx, num_vehs_in_consist){
        2:sw_tobu8000_front_gfx_0;
        tobu8000_front;
    }
    //end gfx
    switch(FEAT_TRAINS, PARENT, sw_tobu8000_end_gfx_0, vehicle_is_reversed){
        1:tobu8000_end_mot;
        tobu8000_end;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu8000_end_gfx, num_vehs_in_consist){
        2:sw_tobu8000_end_gfx_0;
        tobu8000_end;
    }
    //panto placer
    //1
    switch(FEAT_TRAINS, SELF, sw_tobu8000_panto_placer_main_1,position_in_vehid_chain %6){
        0: tobu8000_mot_2;
        3: tobu8000_mot;
        tobu8000_wag;
    }
    //2 
    switch(FEAT_TRAINS, SELF, sw_tobu8000_panto_placer_main_2,position_in_vehid_chain %4){
        0: tobu8000_mot_2;
        tobu8000_wag;
    }
    //panto controller
    switch(FEAT_TRAINS, SELF, sw_tobu8000_panto_placer_main,num_vehs_in_vehid_chain){
        0..2:sw_tobu8000_panto_placer_main_1;
        3:sw_tobu8000_panto_placer_main_2;
        4: sw_tobu8000_panto_placer_main_1;
        sw_tobu8000_panto_placer_main_2;
    }
    //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu8000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_tobu8000_end_gfx;
      sw_tobu8000_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu8000_lv,vehicle_type_id){
      mu_car:sw_tobu8000_panto_placer_main;
      sw_tobu8000_head_gfx_main;
    }
//livery controller
switch(FEAT_TRAINS, SELF, sw_tobu8000_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_1)),1963);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_2)),1963);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_3)),2005);
    4:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_4)),2016);
    5:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_5)),1985);
    6:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_6)),1995);
    7:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_7)),2015);
    8:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_8)),2024);
    9:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_9)),2017);
    10:string(LV_DATED,string(STR_LIVERY,string(LV_tobu8000_10)),2024);
}
//post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu8000_car_power_main,position_in_vehid_chain%8){
        0:return 130;
        2..3:return 130;
        5..6:return 130;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu8000_power_main,vehicle_type_id){
      mu_car:sw_tobu8000_car_power_main;
      130;
    }
