//*main
  //special gfx
    //front&end
    switch(FEAT_TRAINS, PARENT, sw_tobu6050_front_gfx, vehicle_is_reversed){
        1: tobu6050_front;
        tobu6050_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu6050_end_gfx, vehicle_is_reversed){
        1: tobu6050_end_mot_rev;
        tobu6050_end_rev;
    }

  //panto placer
    switch(FEAT_TRAINS, SELF, sw_tobu6050_panto_placer,position_in_vehid_chain %2){
        0:tobu6050_end;
        tobu6050_end_mot_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu6050_panto_placer_rev,position_in_vehid_chain_from_end %2){
        0: tobu6050_end_rev;
        tobu6050_end_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu6050_panto_placer_main,vehicle_is_reversed){
        1: sw_tobu6050_panto_placer_rev;
        sw_tobu6050_panto_placer;
    }
  //end car fixer
    switch(FEAT_TRAINS, SELF, sw_tobu6050_head_gfx_main,position_in_consist>0){
      1: sw_tobu6050_end_gfx;
      sw_tobu6050_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu6050_lv_1,vehicle_type_id){
      mu_car:sw_tobu6050_panto_placer_main;
      sw_tobu6050_head_gfx_main;
    }

//*main.5
  //special gfx
    //front&end
    switch(FEAT_TRAINS, PARENT, sw_tobu6050_front_gfx_2, vehicle_is_reversed){
        1: tobu6050_front;
        tobu6050_front_mot_2;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu6050_end_gfx_2, vehicle_is_reversed){
        1: tobu6050_end_mot_2_rev;
        tobu6050_end_rev;
    }

  //end car fixer
    switch(FEAT_TRAINS, SELF, sw_tobu6050_head_gfx_main_2,position_in_consist>0){
      1: sw_tobu6050_end_gfx_2;
      sw_tobu6050_front_gfx_2;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu6050_lv_2,vehicle_type_id){
      mu_car:sw_tobu6050_panto_placer_main;
      sw_tobu6050_head_gfx_main_2;
    }
//*livery controller
    random_switch(FEAT_TRAINS, PARENT, sw_tobu6050_lv){
        2:sw_tobu6050_lv_1;
        1:sw_tobu6050_lv_2;
    }
    //main
    switch(FEAT_TRAINS, SELF, sw_tobu6050_lv_desc_main, cargo_subtype){
        0: string(LV_DATED,string(LV_DEFAULT),1985);
        1: string(LV_DATED,string(LV_tobu6050_2),2020);
    }

//capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu6050_capacity_main,position_in_consist_from_end %2){
        0: 145;
        150;
    }