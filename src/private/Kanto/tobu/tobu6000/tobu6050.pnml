    0:tobu6050_1_end;    tobu6050_2_end;
  }
  switch(FEAT_TRAINS, SELF, tobu6050_end_rev, cargo_subtype){
    0:tobu6050_1_end_rev;    tobu6050_2_end_rev;
  }
  switch(FEAT_TRAINS, SELF, tobu6050_front_mot, cargo_subtype){
    0:tobu6050_1_front_mot;    tobu6050_2_front_mot;
  }
