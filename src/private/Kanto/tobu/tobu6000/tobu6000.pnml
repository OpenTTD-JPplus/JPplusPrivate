//purchase
  spriteset(tobu6000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu6000/tobu6000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu6000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu6000/tobu6000.png"){ tmpl_purchase_2c_dual(0, 75) }
  GRAPHIC_STACK_2(tobu6000_purchase,  tobu6000_purchase_c1, tobu6000_purchase_c2)
//livery 1
    spriteset(tobu6000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu6000/tobu6000.png"){ tmpl_std_v3(0, 0) }
    spriteset(tobu6000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu6000/tobu6000.png"){ tmpl_std_rev_v3(0, 25) }
    spriteset(tobu6000_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu6000/tobu6000.png"){ tmpl_std_v3(0, 25) }
    spriteset(tobu6000_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu6000/tobu6000.png"){ tmpl_std_v3(0, 50) }
    spriteset(tobu6000_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu6000/tobu6000.png"){ tmpl_std_rev_v3(0, 75) }
    spriteset(tobu6000_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu6000/tobu6000.png"){ tmpl_std_v3(0, 75) }

//*main
  //special gfx
    //front&end
    switch(FEAT_TRAINS, PARENT, sw_tobu6000_front_gfx, vehicle_is_reversed){
        1: tobu6000_front;
        tobu6000_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu6000_end_gfx, vehicle_is_reversed){
        1: tobu6000_end_mot_rev;
        tobu6000_end_rev;
    }

  //panto placer
    switch(FEAT_TRAINS, SELF, sw_tobu6000_panto_placer,position_in_vehid_chain %2){
        0:tobu6000_end;
        tobu6000_end_mot_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu6000_panto_placer_rev,position_in_vehid_chain_from_end %2){
        0: tobu6000_end_rev;
        tobu6000_end_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu6000_panto_placer_main,vehicle_is_reversed){
        1: sw_tobu6000_panto_placer_rev;
        sw_tobu6000_panto_placer;
    }
  //end car fixer
    switch(FEAT_TRAINS, SELF, sw_tobu6000_head_gfx_main,position_in_consist>0){
      1: sw_tobu6000_end_gfx;
      sw_tobu6000_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu6000_lv,vehicle_type_id){
      mu_car:sw_tobu6000_panto_placer_main;
      sw_tobu6000_head_gfx_main;
    }


//power fixer
  switch(FEAT_TRAINS, SELF, sw_tobu6000_car_power_main, position_in_vehid_chain %2) {
    0: return 130;
    return 0;
  } 
  switch(FEAT_TRAINS, SELF, sw_tobu6000_power_main,vehicle_type_id){
    mu_car: sw_tobu6000_car_power_main;
    130;
  }
//capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu6000_capacity_1,position_in_consist_from_end %2){
        0: 145;
        default: 150;
    }
    //limited service
    switch(FEAT_TRAINS, SELF, sw_tobu6000_capacity_2,position_in_consist_from_end %2){
        0: 81;
        default: 84;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu6000_capacity_main,cargo_subtype){
        0:sw_tobu6000_capacity_2;
        sw_tobu6000_capacity_1;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu6000_cargo_age_main,cargo_subtype){
        0:ltd_express_cargo_age;
        express_cargo_age;
    }
//*livery controller
  switch(FEAT_TRAINS, SELF, sw_tobu6000_lv_desc_main, cargo_subtype){
    0:string(STR_CONCAT_2,
    string(LV_DEFAULT),
    string(STR_PAX_LTD_AGE));
    1:string(STR_CONCAT_2,
    string(LV_DEFAULT),
    string(STR_PAX_AGE));
  }