//purchase
  spriteset(tobu2000_1_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu2000/tobu2000.png"){ tmpl_purchase_1c_dual(0, 50) }
  spriteset(tobu2000_1_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu2000/tobu2000.png"){ tmpl_purchase_2c_dual(0, 125) }
  spriteset(tobu2000_2_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu2000/tobu2080.png"){ tmpl_purchase_1c_dual(0, 50) }
  spriteset(tobu2000_2_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu2000/tobu2080.png"){ tmpl_purchase_2c_dual(0, 125) }
  switch(FEAT_TRAINS, SELF, tobu2000_purchase_c1, current_year){
    0..1988:tobu2000_1_purchase_c1;    tobu2000_2_purchase_c1;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_purchase_c2, current_year){
    0..1988:tobu2000_1_purchase_c2;    tobu2000_2_purchase_c2;
  }
  GRAPHIC_STACK_2(tobu2000_purchase,  tobu2000_purchase_c1, tobu2000_purchase_c2)
