//lv stuff
  switch(FEAT_TRAINS, SELF, tobu2000_front_timed, build_year){
    0..1988:tobu2000_1_front;    tobu2080_1_front;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_end_timed, build_year){
    0..1988:tobu2000_1_end;    tobu2080_1_end;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_front_mot_timed, build_year){
    0..1988:tobu2000_1_front_mot;    tobu2080_1_front_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_end_mot_timed, build_year){
    0..1988:tobu2000_1_end_mot;    tobu2080_1_end_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_mot_timed, build_year){
    0..1988:tobu2000_1_mot;    tobu2080_1_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_mot_rev_timed, build_year){
    0..1988:tobu2000_1_mot_rev;    tobu2080_1_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_wag_timed, build_year){
    0..1988:tobu2000_1_wag;    tobu2080_1_wag;
  }

  switch(FEAT_TRAINS, SELF, tobu2000_front, cargo_subtype){
    1:tobu2000_1_front;    2:tobu2000_1_front;    tobu2000_front_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_end, cargo_subtype){
    1:tobu2000_1_end;    2:tobu2000_1_end;    tobu2000_end_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_front_mot, cargo_subtype){
    1:tobu2000_1_front_mot;    2:tobu2000_1_front_mot;    tobu2000_front_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_end_mot, cargo_subtype){
    1:tobu2000_1_end_mot;    2:tobu2000_1_end_mot;    tobu2000_end_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_mot, cargo_subtype){
    1:tobu2000_1_mot;    2:tobu2000_1_mot;    tobu2000_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_mot_rev, cargo_subtype){
    1:tobu2000_1_mot_rev;    2:tobu2000_1_mot_rev;    tobu2000_mot_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, tobu2000_wag, cargo_subtype){
    1:tobu2000_1_wag;    2:tobu2000_1_wag;    tobu2000_wag_timed;
  }

//*main
//special gfx
  //head gfx
    switch(FEAT_TRAINS, PARENT, sw_tobu2000_front_gfx, vehicle_is_reversed){
        1:tobu2000_front;
        tobu2000_front_mot;
    }
    //end gfx
    switch(FEAT_TRAINS, PARENT, sw_tobu2000_end_gfx, vehicle_is_reversed){
        1:tobu2000_end_mot;
        tobu2000_end;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_tobu2000_panto_placer,position_in_vehid_chain %2){
        1: tobu2000_mot;
        tobu2000_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu2000_panto_placer_rev,position_in_vehid_chain_from_end %2){
        1: tobu2000_mot_rev;
        tobu2000_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu2000_panto_placer_main,vehicle_is_reversed){
        1: sw_tobu2000_panto_placer_rev;
        sw_tobu2000_panto_placer;
    }
//front-end-fixer
  switch(FEAT_TRAINS, SELF, sw_tobu2000_head_gfx_main,position_in_consist>0){
    1:sw_tobu2000_end_gfx;
    sw_tobu2000_front_gfx;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu2000_lv,vehicle_type_id){
    mu_car:sw_tobu2000_panto_placer_main;
    sw_tobu2000_head_gfx_main;
  }
//
switch(FEAT_TRAINS, SELF, sw_tobu2000_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_tobu2000_1)),1961);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_tobu2080_1)),1989);
}
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu2000_capacity_main,vehicle_type_id){
        mu_car: 156;
        140;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_tobu2000_car_power_main, position_in_vehid_chain %10) {
      0..7: 75;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu2000_power_main,vehicle_type_id){
      mu_car:sw_tobu2000_car_power_main;
      75*2;
    }
