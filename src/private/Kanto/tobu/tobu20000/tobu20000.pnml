//purchase
  spriteset(tobu20000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu20000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000.png"){ tmpl_purchase_2c_dual(0, 100) }
  GRAPHIC_STACK_2(tobu20000_purchase,  tobu20000_purchase_c1, tobu20000_purchase_c2)
//livery 1
  spriteset(tobu20000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000.png"){ tmpl_std_v3(0, 0) }
  spriteset(tobu20000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000.png"){ tmpl_std_v3(0, 25) }
  spriteset(tobu20000_1_mot_2_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000.png"){ tmpl_std_v3(0, 50) }
  spriteset(tobu20000_1_mot_1_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000.png"){ tmpl_std_rev_v3(0, 75) }
  spriteset(tobu20000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000.png"){ tmpl_symm_v3(0, 100) }
//5d
  spriteset(tobu20000_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000_5d.png"){ tmpl_std_v3(0, 0) }
  spriteset(tobu20000_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000_5d.png"){ tmpl_std_v3(0, 25) }
  spriteset(tobu20000_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000_5d.png"){ tmpl_std_rev_v3(0, 50) }
  spriteset(tobu20000_2_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000_5d.png"){ tmpl_std_v3(0, 50) }
  spriteset(tobu20000_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20000_5d.png"){ tmpl_symm_v3(0, 75) }
//20400
  spriteset(tobu20400_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20400.png"){ tmpl_std_v3(0, 0) }
  spriteset(tobu20400_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20400.png"){ tmpl_std_v3(0, 25) }
  spriteset(tobu20400_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20400.png"){ tmpl_symm_v3(0, 50) }
  spriteset(tobu20400_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu20000/tobu20400.png"){ tmpl_symm_v3(0, 75) }
//lv stuff
    switch(FEAT_TRAINS, SELF, tobu20000_1_mot_rev, build_year){
      0..1996:tobu20000_1_mot_1_rev;      tobu20000_1_mot_2_rev;
    }
    
    switch(FEAT_TRAINS, SELF, tobu20000_front_1, cargo_subtype==2||(cargo_subtype==0&&build_year>1991&&build_year<1997)){
      1:tobu20000_2_front;      tobu20000_1_front;
    }
    switch(FEAT_TRAINS, SELF, tobu20000_end_1, cargo_subtype==2||(cargo_subtype==0&&build_year>1991&&build_year<1997)){
      1:tobu20000_2_end;      tobu20000_1_end;
    }
    switch(FEAT_TRAINS, SELF, tobu20000_mot_rev, (position_in_vehid_chain==0||position_in_vehid_chain_from_end==0)
    &&(cargo_subtype==2||(cargo_subtype==0&&build_year>1991&&build_year<1997))){
      1:tobu20000_2_mot_rev;      tobu20000_1_mot_rev;
    }
    switch(FEAT_TRAINS, SELF, tobu20000_wag, (position_in_vehid_chain==0||position_in_vehid_chain_from_end==0)
    &&(cargo_subtype==2||(cargo_subtype==0&&build_year>1991&&build_year<1997))){
      1:tobu20000_2_wag;      tobu20000_1_wag;
    }

    switch(FEAT_TRAINS, SELF, tobu20000_front, cargo_subtype){
      3:tobu20400_front;      tobu20000_front_1;
    }
    switch(FEAT_TRAINS, SELF, tobu20000_end, cargo_subtype){
      3:tobu20400_end;      tobu20000_end_1;
    }
//
//*main
  //panto placer
    //1
    switch(FEAT_TRAINS, SELF, sw_tobu20000_panto_placer_main_1,position_in_vehid_chain %3){
      0: tobu20000_mot_rev;
      tobu20000_wag;
    }
    //2
    switch(FEAT_TRAINS, SELF, sw_tobu20400_panto_placer_main,position_in_vehid_chain %3){
      0: tobu20400_mot;
      tobu20400_wag;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu20000_panto_placer_main,cargo_subtype){
      3: sw_tobu20400_panto_placer_main;
      sw_tobu20000_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu20000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:tobu20000_end;
      tobu20000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu20000_lv,vehicle_type_id){
      mu_car:sw_tobu20000_panto_placer_main;
      sw_tobu20000_head_gfx_main;
    }
//lv selector
  switch(FEAT_TRAINS, SELF, sw_tobu20000_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(LV_DEFAULT),1988);
    2:string(LV_DATED,string(LV_tobu20000_5d),1991);
    3:string(LV_DATED,string(LV_tobu20400_1),2018);
  }
//
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu20000_capacity_main,vehicle_type_id){
      mu_car: 130;
      120;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu20000_power_0,build_year){
      0..1991 :return 140;
      return 150;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu20000_car_power_main,position_in_vehid_chain_from_end %8){
      0..5:sw_tobu20000_power_0;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu20000_power_main,vehicle_type_id){
      mu_car:sw_tobu20000_car_power_main;
      0;
    }
  //loading speed
    switch(FEAT_TRAINS, SELF, sw_tobu20000_5d_loading,position_in_vehid_chain==0||position_in_vehid_chain_from_end==0){
      1:param_loading_5D;
      param_loading_3D;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu20000_loading_speed_main, cargo_subtype){
      0: param_loading_3D;
      1: param_loading_3D;
      2: sw_tobu20000_5d_loading;
    }
