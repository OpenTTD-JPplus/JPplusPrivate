//lv desc
  switch(FEAT_TRAINS, SELF, sw_tobu_deha10_lv_desc_main, cargo_subtype){
    0:string(LV_DATED,string(STR_LIVERY,string(LV_tobu_deha10_1)),1935);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_tobu_deha10_2)),1950);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_tobu_deha10_3)),1950);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_tobu_deha10_4)),1950);
    4:string(LV_DATED,string(STR_LIVERY,string(LV_tobu_deha10_5)),1950);
    5:string(LV_DATED,string(STR_LIVERY,string(LV_tobu_deha10_6)),1950);
    6:string(LV_DATED,string(STR_LIVERY,string(LV_tobu_deha10_7)),1969);
    7:string(LV_DATED,string(STR_LIVERY,string(LV_tobu_deha10_8)),1969);
}
//post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_tobu_deha10_car_power_main,position_in_vehid_chain%2){
      1:return 110;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu_deha10_power_main,vehicle_type_id){
      mu_car:sw_tobu_deha10_car_power_main;
      return 110;
    }
  //speed fix
  switch(FEAT_TRAINS, SELF, sw_tobu_deha10_speed_main, build_year){
      0..1948:return 85;
      return 95;
  }
  //loading speed
  switch(FEAT_TRAINS, SELF, sw_tobu_deha10_loading_speed_main, cargo_subtype){
    7:param_loading_3D;
    param_loading_2D;
  }
