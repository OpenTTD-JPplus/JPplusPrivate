//lv stuff
  switch(FEAT_TRAINS, SELF, tobu200_front, cargo_subtype){
    0:tobu200_1_front;
    1:tobu200_2_front;
    2:tobu200_3_front;
  }
  switch(FEAT_TRAINS, SELF, tobu200_end, cargo_subtype){
    0:tobu200_1_end;
    1:tobu200_2_end;
    2:tobu200_3_end;
  }
  switch(FEAT_TRAINS, SELF, tobu200_mot, cargo_subtype){
    0:tobu200_1_mot;
    1:tobu200_2_mot;
    2:tobu200_3_mot;
  }
  switch(FEAT_TRAINS, SELF, tobu200_mot_rev, cargo_subtype){
    0:tobu200_1_mot_rev;
    1:tobu200_2_mot_rev;
    2:tobu200_3_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, tobu200_mot_1, cargo_subtype){
    0:tobu200_1_mot_1;
    1:tobu200_2_mot_1;
    2:tobu200_3_mot_1;
  }
  switch(FEAT_TRAINS, SELF, tobu200_mot_1_rev, cargo_subtype){
    0:tobu200_1_mot_1_rev;
    1:tobu200_2_mot_1_rev;
    2:tobu200_3_mot_1_rev;
  }
  switch(FEAT_TRAINS, SELF, tobu200_wag, cargo_subtype){
    0:tobu200_1_wag;
    1:tobu200_2_wag;
    2:tobu200_3_wag;
  }
  switch(FEAT_TRAINS, SELF, tobu200_wag_rev, cargo_subtype){
    0:tobu200_1_wag_rev;
    1:tobu200_2_wag_rev;
    2:tobu200_3_wag_rev;
  }
//
//*main
  //panto placer
    //1
    switch(FEAT_TRAINS, SELF, sw_tobu200_panto_placer_main_1,position_in_vehid_chain %6){
        0: tobu200_mot;
        1: tobu200_mot_1;
        3: tobu200_mot_rev;
        tobu200_wag;
    }
    //2 8 car
    switch(FEAT_TRAINS, SELF, sw_tobu200_panto_placer_main_2,position_in_vehid_chain %6){
        1: tobu200_mot;
        2: tobu200_mot_1;
        4: tobu200_mot_rev;
        tobu200_wag;
    }
    //panto controller
    switch(FEAT_TRAINS, SELF, sw_tobu200_panto_placer_main,num_vehs_in_vehid_chain){
        6:sw_tobu200_panto_placer_main_2;
        sw_tobu200_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu200_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: tobu200_end;
      tobu200_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu200_lv,vehicle_type_id){
      mu_car:sw_tobu200_panto_placer_main;
      sw_tobu200_head_gfx_main;
    }
//
//livery desc controller
  switch(FEAT_TRAINS, SELF, sw_tobu200_lv_desc_main, cargo_subtype){
      0:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1991);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_tobu200_2)),2016);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_tobu200_3)),2021);
  }
//*post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu200_capacity,position_in_vehid_chain %6){
        1: 58;
        2: 76;
        4: 60;
        default: 72;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu200_capacity_main,vehicle_type_id){
        mu_car:sw_tobu200_capacity;
        60;
    }
  //power fixer
    //250
    switch(FEAT_TRAINS, SELF, sw_tobu250_power_main_1,position_in_vehid_chain_from_end %4){
        0:return 190;
        2..3:return 190;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu200_power,position_in_vehid_chain_from_end %5){
        0..3:return 75;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu200_power_main_1,vehicle_type_id){
        mu_car:sw_tobu200_power;
        75*2;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu200_power_main, build_year > 1997) {
        1: sw_tobu250_power_main_1;
        sw_tobu200_power_main_1;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu200_car_power_main, build_year > 1997) {
        1: 190;
        75;
    }