//lv stuff
switch(FEAT_TRAINS, SELF, tobu7300_front, cargo_subtype){
  0:tobu7300_1_front;  1:tobu7300_2_front;  2:tobu7300_3_front;
}
switch(FEAT_TRAINS, SELF, tobu7300_end, cargo_subtype){
  0:tobu7300_1_end;  1:tobu7300_2_end;  2:tobu7300_3_end;
}
switch(FEAT_TRAINS, SELF, tobu7300_end_rev, cargo_subtype){
  0:tobu7300_1_end_rev;  1:tobu7300_2_end_rev;  2:tobu7300_3_end_rev;
}
switch(FEAT_TRAINS, SELF, tobu7300_front_mot, cargo_subtype){
  0:tobu7300_1_front_mot;  1:tobu7300_2_front_mot;  2:tobu7300_3_front_mot;
}
switch(FEAT_TRAINS, SELF, tobu7300_end_mot, cargo_subtype){
  0:tobu7300_1_end_mot;  1:tobu7300_2_end_mot;  2:tobu7300_3_end_mot;
}
switch(FEAT_TRAINS, SELF, tobu7300_end_mot_rev, cargo_subtype){
  0:tobu7300_1_end_mot_rev;  1:tobu7300_2_end_mot_rev;  2:tobu7300_3_end_mot_rev;
}
//*main
  //special gfx
    //head gfx
    switch(FEAT_TRAINS, PARENT, sw_tobu7300_front_gfx, vehicle_is_reversed){
        1:tobu7300_front_mot;
        tobu7300_front;
    }
    //end gfx
    switch(FEAT_TRAINS, PARENT, sw_tobu7300_end_gfx, vehicle_is_reversed){
        1:tobu7300_end;
        tobu7300_end_mot;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_tobu7300_panto_placer,position_in_vehid_chain %2){
        1: tobu7300_end;
        tobu7300_end_mot_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu7300_panto_placer_rev,position_in_vehid_chain_from_end %2){
        1: tobu7300_end_rev;
        tobu7300_end_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu7300_panto_placer_main,vehicle_is_reversed){
        1: sw_tobu7300_panto_placer_rev;
        sw_tobu7300_panto_placer;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu7300_head_gfx_main,position_in_consist>0){
      1:sw_tobu7300_end_gfx;
      sw_tobu7300_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu7300_lv,vehicle_type_id){
      mu_car:sw_tobu7300_panto_placer_main;
      sw_tobu7300_head_gfx_main;
    }

//livery controller
switch(FEAT_TRAINS, SELF, sw_tobu7300_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_tobu7300_1)),1947);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_tobu7300_2)),1952);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_tobu7300_3)),1952);
}
//post fixers
  //power fixer
  switch(FEAT_TRAINS, SELF, sw_tobu7300_car_power_main, position_in_vehid_chain %2) {
    1: return 142;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_tobu7300_power_main,vehicle_type_id){
      mu_car:sw_tobu7300_car_power_main;
      142;
    }