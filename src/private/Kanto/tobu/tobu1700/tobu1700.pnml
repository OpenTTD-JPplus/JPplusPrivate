//purchase
  spriteset(tobu1700_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1700.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu1700_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1700.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(tobu1700_purchase,  tobu1700_purchase_c1, tobu1700_purchase_c2)
//livery 1
    spriteset(tobu1700_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1700.png"){ tmpl_std_v3(0, 0) }
    spriteset(tobu1700_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1700.png"){ tmpl_std_v3(0, 25) }
    spriteset(tobu1700_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1700.png"){ tmpl_std_v3(0, 25) }
    spriteset(tobu1700_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1700.png"){ tmpl_std_v3(0, 50) }
    spriteset(tobu1700_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1700.png"){ tmpl_std_rev_v3(0, 75) }
    spriteset(tobu1700_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1700.png"){ tmpl_std_v3(0, 75) }

//*main
  //special gfx
    //front&end
    switch(FEAT_TRAINS, PARENT, sw_tobu1700_front_gfx, vehicle_is_reversed){
        1: tobu1700_front;
        tobu1700_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu1700_end_gfx, vehicle_is_reversed){
        1: tobu1700_end_mot;
        tobu1700_end;
    }

  //panto placer
    switch(FEAT_TRAINS, SELF, sw_tobu1700_panto_placer,position_in_vehid_chain %2){
        0:tobu1700_end;
        tobu1700_end_mot_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu1700_panto_placer_rev,position_in_vehid_chain_from_end %2){
        0: tobu1700_end_rev;
        tobu1700_end_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_tobu1700_panto_placer_main,vehicle_is_reversed){
        1: sw_tobu1700_panto_placer_rev;
        sw_tobu1700_panto_placer;
    }
  //end car fixer
    switch(FEAT_TRAINS, SELF, sw_tobu1700_head_gfx_main,position_in_consist>0){
      1: sw_tobu1700_end_gfx;
      sw_tobu1700_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu1700_lv,vehicle_type_id){
      mu_car:sw_tobu1700_panto_placer_main;
      sw_tobu1700_head_gfx_main;
    }

    
//power fixer
    switch(FEAT_TRAINS, SELF, sw_tobu1700_car_power_main, position_in_vehid_chain %2) {
        1: return 75;
    return 0;
}
switch(FEAT_TRAINS, SELF, sw_tobu1700_power_main,vehicle_type_id){
      mu_car: sw_tobu1700_car_power_main;
      75;
    }