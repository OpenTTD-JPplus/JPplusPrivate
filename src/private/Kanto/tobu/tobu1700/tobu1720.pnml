//purchase
  spriteset(tobu1720_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(tobu1720_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_purchase_2c_dual(88, 50) }
  GRAPHIC_STACK_2(tobu1720_purchase,  tobu1720_purchase_c1, tobu1720_purchase_c2)
//livery 1
    spriteset(tobu1720_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_std_v3(0, 0) }
    spriteset(tobu1720_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_std_v3(0, 25) }
    spriteset(tobu1720_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_std_v3(0, 50) }
    spriteset(tobu1720_wag_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_std_rev_v3(0, 50) }
    spriteset(tobu1720_wag_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_std_v3(0, 75) }
    spriteset(tobu1720_wag_1_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_std_rev_v3(0, 75) }
    spriteset(tobu1720_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_std_v3(0, 100) }
    spriteset(tobu1720_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_std_rev_v3(0, 100) }
    spriteset(tobu1720_wag_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_std_v3(0, 125) }
    spriteset(tobu1720_wag_2_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/tobu/tobu1700/tobu1720.png"){ tmpl_std_rev_v3(0, 125) }

//*main
  //panto placer
    //var 1
    switch(FEAT_TRAINS, SELF, sw_tobu1720_panto_placer_main_1,position_in_vehid_chain %6){
        0: tobu1720_wag;
        1: tobu1720_wag_1;
        2: tobu1720_mot;
        3: tobu1720_wag_2;
        tobu1720_wag_2;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_tobu1720_panto_placer_main_2,position_in_vehid_chain %4){
        0: tobu1720_wag;
        1: tobu1720_wag_1;
        2: tobu1720_mot;
        3: tobu1720_wag_2;
        tobu1720_wag_2;
    }
    //var 3
    switch(FEAT_TRAINS, SELF, sw_tobu1720_panto_placer_main_3,position_in_vehid_chain %8){
        0: tobu1720_wag;
        1: tobu1720_mot_rev;
        2: tobu1720_wag_1;
        4: tobu1720_mot;
        tobu1720_wag_2;
    }
    //main
    switch(FEAT_TRAINS, SELF, sw_tobu1720_panto_placer_main,num_vehs_in_vehid_chain){
        0..3:sw_tobu1720_panto_placer_main_2;
        4..5: sw_tobu1720_panto_placer_main_1;
        10..11: sw_tobu1720_panto_placer_main_1;
        sw_tobu1720_panto_placer_main_3;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_tobu1720_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: tobu1720_end;
      tobu1720_front;
    }
    switch(FEAT_TRAINS, SELF, sw_tobu1720_lv,vehicle_type_id){
      mu_car:sw_tobu1720_panto_placer_main;
      sw_tobu1720_head_gfx_main;
    }

//capacity-changer
    switch(FEAT_TRAINS, SELF, sw_tobu1720_capacity_main,position_in_vehid_chain_from_end %6){
        mu_car: 52;
        54;
    }
   switch(FEAT_TRAINS, SELF, sw_tobu1720_car_power_main, position_in_vehid_chain %8) {
    0..5: return 75;
    return 0;
  } 
  switch(FEAT_TRAINS, SELF, sw_tobu1720_power_main,vehicle_type_id){
    mu_car: sw_tobu1720_car_power_main;
    75*2;
  }