//
  switch(FEAT_TRAINS, SELF, seibu20000_front, cargo_subtype){
    0:seibu20000_1_front;    2:seibu20000_3_front;
  }
  switch(FEAT_TRAINS, SELF, seibu20000_end, cargo_subtype){
    0:seibu20000_1_end;    2:seibu20000_3_end;
  }
  switch(FEAT_TRAINS, SELF, seibu20000_mot_rev, cargo_subtype){
    0:seibu20000_1_mot_rev;    2:seibu20000_3_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, seibu20000_wag, cargo_subtype){
    0:seibu20000_1_wag;    2:seibu20000_3_wag;
  }
//*livery 1
  //panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu20000_panto_placer_main_1,position_in_vehid_chain %3){
				0: seibu20000_mot_rev;
				seibu20000_wag;
			}
		//var 2
			switch(FEAT_TRAINS, SELF, sw_seibu20000_panto_placer_main_2,position_in_vehid_chain %4){
				0: seibu20000_mot_rev;
				seibu20000_wag;
			}
		//var 3
			switch(FEAT_TRAINS, SELF, sw_seibu20000_panto_placer_main_3,position_in_vehid_chain %4){
				1: seibu20000_mot_rev;
				seibu20000_wag;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu20000_panto_placer_main,num_vehs_in_vehid_chain){
				3:sw_seibu20000_panto_placer_main_3;
				6:sw_seibu20000_panto_placer_main_2;
				9:sw_seibu20000_panto_placer_main_2;
				sw_seibu20000_panto_placer_main_1;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu20000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:seibu20000_end;
      seibu20000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu20000_livery_13,vehicle_type_id){
      mu_car:sw_seibu20000_panto_placer_main;
      sw_seibu20000_head_gfx_main;
    }
//
//*livery 2
	//special gfx
		//front
		switch(FEAT_TRAINS, PARENT, sw_seibu20000_2_front_gfx,vehicle_is_reversed){
				1: seibu20000_2_front_1;
				seibu20000_2_front;
		}
		//end
		switch(FEAT_TRAINS, PARENT, sw_seibu20000_2_end_gfx,vehicle_is_reversed){
				1: seibu20000_2_end;
				seibu20000_2_end_1;
		}
	//panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu20000_2_panto_placer_main_1,position_in_vehid_chain %6){
				0: seibu20000_2_mot_1_rev;
				1: seibu20000_2_wag_1_rev;
				2: seibu20000_2_wag_2_rev;
				3: seibu20000_2_mot_2_rev;
				4: seibu20000_2_wag_4_rev;
				seibu20000_2_wag_3_rev;
			}
		//var 2
			switch(FEAT_TRAINS, SELF, sw_seibu20000_2_panto_placer_main_2,position_in_vehid_chain %6){
				0: seibu20000_2_mot_1_rev;
				1: seibu20000_2_wag_1_rev;
				2: seibu20000_2_wag_2_rev;
				3: seibu20000_2_wag_3_rev;
				4: seibu20000_2_mot_2_rev;
				seibu20000_2_wag_4_rev;
			}
		//var 3
			switch(FEAT_TRAINS, SELF, sw_seibu20000_2_panto_placer_main_3,position_in_vehid_chain %4){
				0: seibu20000_2_wag_3_rev;
				1: seibu20000_2_mot_2_rev;
				seibu20000_2_wag_1_rev;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu20000_2_panto_placer_main,num_vehs_in_vehid_chain){
				3:sw_seibu20000_2_panto_placer_main_3;
				6:sw_seibu20000_2_panto_placer_main_2;
				9:sw_seibu20000_2_panto_placer_main_2;
				sw_seibu20000_2_panto_placer_main_1;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu20000_2_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_seibu20000_2_end_gfx;
      sw_seibu20000_2_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu20000_livery_2,vehicle_type_id){
      mu_car:sw_seibu20000_2_panto_placer_main;
      sw_seibu20000_2_head_gfx_main;
    }
//
//*livery controller
    switch(FEAT_TRAINS, PARENT, sw_seibu20000_lv, cargo_subtype){
      1:sw_seibu20000_livery_2;
      sw_seibu20000_livery_13;
		}
	//lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu20000_lv_desc_main, cargo_subtype){
      0:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2000);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_seibu20000_2)),2016);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_seibu20000_3)),2018);
    }
//*post fixers
	//capacity
		switch(FEAT_TRAINS, SELF, sw_seibu20000_capacity_main,vehicle_type_id){
			mu_car: 135;
			145;
		}
	//power
		switch(FEAT_TRAINS, SELF, sw_seibu20000_car_power_main,position_in_vehid_chain_from_end %10){
    	0..1:return 135;
    	4..5:return 135;
			7:return 135;
    	return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu20000_power_main,vehicle_type_id){
			mu_car:sw_seibu20000_car_power_main;
			return 0;
		}