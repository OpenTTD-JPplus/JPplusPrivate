    switch(FEAT_TRAINS, SELF, sw_seibuDeha5560_lv_desc_main, cargo_subtype){
      0:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_BROWN)),1928);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_YELLOW)),1954);
      2:string(LV_DATED,string(LV_seibuDeha5560_3),1958);
    }
//*post fixers
