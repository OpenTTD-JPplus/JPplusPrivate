    switch(FEAT_TRAINS, SELF, sw_seibuDeha5560_loading_speed_main, cargo_subtype){
        2:param_loading_3D;
        param_loading_2D;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_seibuDeha5560_car_power_main,position_in_vehid_chain %2){
        1: return 85;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibuDeha5560_power_main,vehicle_type_id){
        mu_car: sw_seibuDeha5560_car_power_main;
        85;
    }