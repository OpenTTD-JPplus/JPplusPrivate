	spriteset(seibu4000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu4000/seibu4000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(seibu4000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu4000/seibu4000_1.png"){ tmpl_std_v3(0, 25) }
	spriteset(seibu4000_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu4000/seibu4000_1.png"){ tmpl_symm_v3(0, 50) }
	spriteset(seibu4000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu4000/seibu4000_1.png"){ tmpl_symm_v3(0, 75) }

