//*livery 1
  //panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu4000_1_panto_placer_main_1,position_in_vehid_chain %2){
				0: seibu4000_1_mot;
				seibu4000_1_wag;
			}
		//var 2
			switch(FEAT_TRAINS, SELF, sw_seibu4000_1_panto_placer_main_2,position_in_vehid_chain %3){
				1: seibu4000_1_mot;
				seibu4000_1_wag;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu4000_1_panto_placer_main,num_vehs_in_vehid_chain+1){
				5:sw_seibu4000_1_panto_placer_main_2;
				sw_seibu4000_1_panto_placer_main_1;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu4000_1_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:seibu4000_1_end;
      seibu4000_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu4000_lv,vehicle_type_id){
      mu_car:sw_seibu4000_1_panto_placer_main;
      sw_seibu4000_1_head_gfx_main;
    }

//
//*post fixers
	//capacity
		switch(FEAT_TRAINS, SELF, sw_seibu4000_capacity_head,position_in_consist){
			0: 119;
			127;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu4000_capacity_main,vehicle_type_id){
			mu_car:138;
			sw_seibu4000_capacity_head;
		}
	//power
		switch(FEAT_TRAINS, SELF, sw_seibu4000_car_power_main,position_in_vehid_chain %4){
    	0..1:return 150;
    	return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu4000_power_main,vehicle_type_id){
			mu_car:sw_seibu4000_car_power_main;
			return 0;
		}