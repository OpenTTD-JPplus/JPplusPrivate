	// spriteset(seibu4000_3_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu4000/seibu4000_3.png"){ tmpl_std_rev(0, 25) }
