  spriteset(seibu4000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu4000/seibu4000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu4000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu4000/seibu4000_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(seibu4000_purchase,  seibu4000_purchase_c1, seibu4000_purchase_c2)
