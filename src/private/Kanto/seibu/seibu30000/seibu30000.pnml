  switch(FEAT_TRAINS, SELF, seibu30000_front, cargo_subtype){
    0:seibu30000_1_front;    1..2:seibu30000_3_front;    3:seibu30000_4_front;
    4:seibu30000_5_front;
  }
  switch(FEAT_TRAINS, SELF, seibu30000_end, cargo_subtype){
    0:seibu30000_1_end;    1..2:seibu30000_3_end;    3:seibu30000_4_end;
    4:seibu30000_5_end;
  }
  switch(FEAT_TRAINS, SELF, seibu30000_front_mot, cargo_subtype){
    0:seibu30000_1_front_mot;    1..2:seibu30000_3_front_mot;    3:seibu30000_4_front_mot;
    4:seibu30000_5_front_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu30000_end_mot, cargo_subtype){
    0:seibu30000_1_end_mot;    1..2:seibu30000_3_end_mot;    3:seibu30000_4_end_mot;
    4:seibu30000_5_end_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu30000_mot_rev, cargo_subtype){
