//
//*livery 1
	//special gfx
		//front
		switch(FEAT_TRAINS, PARENT, sw_seibu30000_front_gfx_1,vehicle_is_reversed){
				1: seibu30000_front;
				seibu30000_front_mot;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu30000_front_gfx,(num_vehs_in_vehid_chain==num_vehs_in_consist)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
				1: sw_seibu30000_front_gfx_1;
				seibu30000_front;
		}
		//end
		switch(FEAT_TRAINS, PARENT, sw_seibu30000_end_gfx_1,vehicle_is_reversed){
				1: seibu30000_end_mot;
				seibu30000_end;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu30000_end_gfx,(num_vehs_in_vehid_chain==num_vehs_in_consist)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
				1: sw_seibu30000_end_gfx_1;
				seibu30000_end;
		}
  //panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu30000_panto_placer_main_1,position_in_vehid_chain %3){
				0: seibu30000_mot_rev;
				seibu30000_wag;
			}
		//var 2
			switch(FEAT_TRAINS, SELF, sw_seibu30000_panto_placer_main_2,position_in_vehid_chain %4){
				0: seibu30000_mot_rev;
				seibu30000_wag;
			}
		//var 3
			switch(FEAT_TRAINS, SELF, sw_seibu30000_panto_placer_main_3,position_in_vehid_chain %4){
				1: seibu30000_mot_rev;
				seibu30000_wag;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu30000_panto_placer_main,num_vehs_in_vehid_chain){
				3:sw_seibu30000_panto_placer_main_3;
				6:sw_seibu30000_panto_placer_main_2;
				9:sw_seibu30000_panto_placer_main_2;
				sw_seibu30000_panto_placer_main_1;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu30000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_seibu30000_end_gfx;
      sw_seibu30000_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu30000_lv,vehicle_type_id){
      mu_car:sw_seibu30000_panto_placer_main;
      sw_seibu30000_head_gfx_main;
    }
//

//*livery controller
	//lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu30000_lv_desc_main, cargo_subtype){
      0..1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2008);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_seibu30000_3)),2018);
      3:string(LV_DATED,string(STR_LIVERY,string(LV_seibu30000_4)),2020);
      4:string(LV_DATED,string(STR_LIVERY,string(LV_seibu30000_5)),2020);
    }
//*post fixers
	//capacity
		switch(FEAT_TRAINS, SELF, sw_seibu30000_capacity_main,vehicle_type_id){
			mu_car: 141;
			153;
		}
	//power
		switch(FEAT_TRAINS, SELF, sw_seibu30000_car_power_main,position_in_vehid_chain_from_end %10){
    	0..1:return 165;
    	4..5:return 165;
			7:return 165;
    	return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu30000_power_head,num_vehs_in_vehid_chain){
    	2:return 165;
    	return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu30000_power_main,vehicle_type_id){
			mu_car:sw_seibu30000_car_power_main;
			sw_seibu30000_power_head;
		}
