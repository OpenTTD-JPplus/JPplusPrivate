		switch(FEAT_TRAINS, PARENT, sw_seibu40000_1_front_gfx,vehicle_is_reversed){
				1: seibu40000_1_front_1;
				seibu40000_1_front;
		}
		//end
		switch(FEAT_TRAINS, PARENT, sw_seibu40000_1_end_gfx,vehicle_is_reversed){
				1: seibu40000_1_end;
				seibu40000_1_end_1;
		}
  //panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu40000_1_panto_placer_main_1,position_in_vehid_chain %3){
				0: seibu40000_1_mot_rev;
				seibu40000_1_wag;
			}
		//var 2
			switch(FEAT_TRAINS, SELF, sw_seibu40000_1_panto_placer_main_2,position_in_vehid_chain %2){
				0: seibu40000_1_mot_rev;
				seibu40000_1_wag;
			}
		//var 3
			switch(FEAT_TRAINS, SELF, sw_seibu40000_1_panto_placer_main_3,position_in_vehid_chain %4){
				1: seibu40000_1_mot_rev;
				seibu40000_1_wag;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu40000_1_panto_placer_main,num_vehs_in_vehid_chain){
				3:sw_seibu40000_1_panto_placer_main_3;
				6:sw_seibu40000_1_panto_placer_main_2;
				sw_seibu40000_1_panto_placer_main_1;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu40000_1_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_seibu40000_1_end_gfx;
      sw_seibu40000_1_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu40000_livery_1,vehicle_type_id){
      mu_car:sw_seibu40000_1_panto_placer_main;
      sw_seibu40000_1_head_gfx_main;
    }
