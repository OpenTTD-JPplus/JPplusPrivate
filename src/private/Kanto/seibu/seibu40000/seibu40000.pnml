//*livery controller
	//livery 0 controller
  //2017 sw_seibu40000_livery_1
  //2020
    random_switch(FEAT_TRAINS, PARENT, sw_seibu40000_livery_0_1){
      2:sw_seibu40000_livery_1;
      1:sw_seibu40000_livery_2;
    }
	//main
    switch(FEAT_TRAINS, SELF, sw_seibu40000_livery_0, current_year){
      0..2019:sw_seibu40000_livery_1;
      sw_seibu40000_livery_0_1;
    }
	//lv
    switch(FEAT_TRAINS, SELF, sw_seibu40000_lv, cargo_subtype){
      0:sw_seibu40000_livery_0;
      1:sw_seibu40000_livery_1;
      2:sw_seibu40000_livery_2;
		}
	//lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu40000_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2017);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_seibu40000_1)),2020);
    }
//*post fixers
	//capacity
		//0dai
			switch(FEAT_TRAINS, SELF, sw_seibu40000_capacity_main_1,vehicle_type_id){
				mu_car: 132;
				124;
			}
		//50dai
			switch(FEAT_TRAINS, SELF, sw_seibu40050_capacity_main,vehicle_type_id){
				mu_car: 146;
				135;
			}
		switch(FEAT_TRAINS, SELF, sw_seibu40000_capacity_main, build_year){
			0..2018:sw_seibu40000_capacity_main_1;
			sw_seibu40050_capacity_main;
    }
	//power
		switch(FEAT_TRAINS, SELF, sw_seibu40000_car_power_main,position_in_vehid_chain_from_end %10){
    	0..1:return 190;
    	4..5:return 190;
			7:return 190;
    	return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu40000_power_main,vehicle_type_id){
			mu_car:sw_seibu40000_car_power_main;
			return 0;
		}
