//purchase
  spriteset(seibu571_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu571/seibu571.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu571_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu571/seibu571.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(seibu571_purchase,  seibu571_purchase_c1, seibu571_purchase_c2)
//*livery 1
  spriteset(seibu571_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu571/seibu571.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu571_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu571/seibu571.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu571_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu571/seibu571.png"){ tmpl_std_v3(0, 50) }
  spriteset(seibu571_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu571/seibu571.png"){ tmpl_std_v3(0, 75) }
  spriteset(seibu571_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu571/seibu571.png"){ tmpl_std_v3(0, 100) }
  spriteset(seibu571_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu571/seibu571.png"){ tmpl_symm_v3(0, 125) }
//*livery 1
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_seibu571_front_gfx_1, vehicle_is_reversed){
        1: seibu571_front;
        seibu571_front_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu571_front_gfx, (num_vehs_in_vehid_chain==num_vehs_in_consist)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
        1: sw_seibu571_front_gfx_1;
        seibu571_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_seibu571_end_gfx_1, vehicle_is_reversed){
        1: seibu571_end_mot;
        seibu571_end;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu571_end_gfx, (num_vehs_in_vehid_chain==num_vehs_in_consist)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
        1: sw_seibu571_end_gfx_1;
        seibu571_end_mot;
    }

  //panto placer
      switch(FEAT_TRAINS, SELF, sw_seibu571_panto_placer_main,position_in_vehid_chain %4){
          2: seibu571_mot;
          seibu571_wag;
      }
  //front end fixer
    switch(FEAT_TRAINS, SELF, sw_seibu571_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_seibu571_end_gfx;
      sw_seibu571_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu571_lv,vehicle_type_id){
      mu_car:sw_seibu571_panto_placer_main;
      sw_seibu571_head_gfx_main;
    }
