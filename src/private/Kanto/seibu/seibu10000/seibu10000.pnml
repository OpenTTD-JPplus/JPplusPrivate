			switch(FEAT_TRAINS, SELF, sw_seibu10000_panto_placer_main_1,position_in_vehid_chain_from_end %6){
				0: seibu10000_mot;
				1: seibu10000_mot;
				4: seibu10000_mot;
				seibu10000_wag;
			}
    //var 2 0-5 cars
      switch(FEAT_TRAINS, SELF, sw_seibu10000_panto_placer_main_2,position_in_vehid_chain_from_end %6){
				0: seibu10000_mot;
				1: seibu10000_mot;
				seibu10000_wag;
			}
    //var 3 6 cars
      switch(FEAT_TRAINS, SELF, sw_seibu10000_panto_placer_main_3,position_in_vehid_chain_from_end %6){
				0: seibu10000_mot;
				1: seibu10000_mot;
				3: seibu10000_mot;
				seibu10000_wag;
			}
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_seibu10000_panto_placer_main,num_vehs_in_vehid_chain){
        0..3:sw_seibu10000_panto_placer_main_2;
        4:sw_seibu10000_panto_placer_main_3;
        sw_seibu10000_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu10000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:seibu10000_end;
      seibu10000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu10000_lv,vehicle_type_id){
      mu_car:sw_seibu10000_panto_placer_main;
      sw_seibu10000_head_gfx_main;
    }
//*livery controller
  //lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu10000_lv_desc_main, cargo_subtype){
      0:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1993);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_seibu10000_2)),2011);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_seibu10000_3)),2011);
      3:string(LV_DATED,string(STR_LIVERY,string(LV_seibu10000_4)),2016);
      4:string(LV_DATED,string(STR_LIVERY,string(LV_seibu10000_5)),2017);
      5:string(LV_DATED,string(STR_LIVERY,string(LV_seibu10000_6)),2018);
      6:string(LV_DATED,string(STR_LIVERY,string(LV_seibu10000_7)),2018);
    }
//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_seibu10000_capacity_head,position_in_vehid_chain){
			0: 38;
      48;
    }
		switch(FEAT_TRAINS, SELF, sw_seibu10000_capacity_main,vehicle_type_id){
			mu_car:64;
			sw_seibu10000_capacity_head;
    }
	//power fix
    switch(FEAT_TRAINS, SELF, sw_seibu10000_car_power_main,position_in_vehid_chain %3){
			0..1:return 150;
			return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu10000_power_main,vehicle_type_id){
			mu_car:sw_seibu10000_car_power_main;
			return 0;
    }
