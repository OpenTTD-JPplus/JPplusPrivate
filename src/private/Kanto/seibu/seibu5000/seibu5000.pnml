//purchase
  spriteset(seibu5000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu5000/seibu5000.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu5000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu5000/seibu5000.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(seibu5000_purchase,  seibu5000_purchase_c1, seibu5000_purchase_c2)
//*livery 1
	spriteset(seibu5000_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu5000/seibu5000.png"){ tmpl_std_v3(0, 0) }
	spriteset(seibu5000_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu5000/seibu5000.png"){ tmpl_std_v3(0, 25) }
	spriteset(seibu5000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu5000/seibu5000.png"){ tmpl_symm_v3(0, 50) }
	spriteset(seibu5000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu5000/seibu5000.png"){ tmpl_symm_v3(0, 75) }
//
//*livery 1
  //panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu5000_panto_placer_main,position_in_vehid_chain %2){
				0: seibu5000_mot;
				seibu5000_wag;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu5000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:seibu5000_end;
      seibu5000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu5000_lv,vehicle_type_id){
      mu_car:sw_seibu5000_panto_placer_main;
      sw_seibu5000_head_gfx_main;
    }
//
//*post fixers
	//capacity-changer
    // 4/6 car
		switch(FEAT_TRAINS, SELF, sw_seibu5000_capacity_1,num_vehs_in_consist>3&&position_in_consist_from_end==0){
			1: return 64;
			return 56;
    }
		switch(FEAT_TRAINS, SELF, sw_seibu5000_capacity_main,vehicle_type_id){
			mu_car: 72;
			sw_seibu5000_capacity_1;
    }
	//power fix
    switch(FEAT_TRAINS, SELF, sw_seibu5000_car_power_main,position_in_vehid_chain %5){
			0..3:return 150;
			return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu5000_power_main,vehicle_type_id){
			mu_car:sw_seibu5000_car_power_main;
			return 0;
    }
