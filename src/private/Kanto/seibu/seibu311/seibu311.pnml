//
  switch(FEAT_TRAINS, SELF, seibu311_front_mot_timed, current_year){
    0..1959:seibu311_1_front_mot;    seibu311_3_front_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu311_front_timed, current_year){
    0..1959:seibu311_1_front;    seibu311_3_front;
  }
  switch(FEAT_TRAINS, SELF, seibu311_mot_timed, current_year){
    0..1959:seibu311_1_mot;    seibu311_3_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu311_wag_rev_timed, current_year){
    0..1959:seibu311_1_wag_rev;    seibu311_3_wag_rev;
  }

  switch(FEAT_TRAINS, SELF, seibu311_front_mot, cargo_subtype){
    0:seibu311_front_mot_timed;    1:seibu311_1_front_mot;    2:seibu311_2_front_mot;
    3:seibu311_3_front_mot;    seibu311_4_front_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu311_front, cargo_subtype){
    0:seibu311_front_timed;    1:seibu311_1_front;    2:seibu311_2_front;
    3:seibu311_3_front;    seibu311_4_front;
  }
  switch(FEAT_TRAINS, SELF, seibu311_mot, cargo_subtype){
    0:seibu311_mot_timed;    1:seibu311_1_mot;    2:seibu311_2_mot;
    3:seibu311_3_mot;    seibu311_4_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu311_wag_rev, cargo_subtype){
    0:seibu311_wag_rev_timed;    1:seibu311_1_wag_rev;    2:seibu311_2_wag_rev;
    3:seibu311_3_wag_rev;    seibu311_4_wag_rev;
  }
//*livery 1
  //*special gfx
    switch(FEAT_TRAINS, SELF, sw_seibu311_front_gfx, vehicle_is_flipped==0||position_in_consist%2==0){
        1: seibu311_front_mot;
        seibu311_front;
    }
  //*panto placer
    switch(FEAT_TRAINS, SELF, sw_seibu311_panto_placer_main,position_in_vehid_chain %2){
        0: seibu311_wag_rev;
        seibu311_mot;
    }
  //*front end fixer
    GRAPHIC_STACK_2(seibu311_head_light,  sw_seibu311_front_gfx, sw_seibu311_lights)
    switch(FEAT_TRAINS, SELF, sw_seibu311_lv,vehicle_type_id){
        mu_car:sw_seibu311_panto_placer_main;
        seibu311_head_light;
    }
//
//*livery controller
  //lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu311_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_BROWN)),1949);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_BRYELLOW)),1949);
      3:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_AKADEN_A)),1960);
      4:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_AKADEN_B)),1960);
    }
//*post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_seibu311_car_power_main,position_in_vehid_chain %2){
        0: return 85;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu311_power_main,vehicle_type_id){
        mu_car: sw_seibu311_car_power_main;
        return 85;
    }