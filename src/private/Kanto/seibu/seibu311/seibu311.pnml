  spriteset(seibu311_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu311/seibu311_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu311_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu311/seibu311_lights.png"){ tmpl_std_v3(0, 25) }
