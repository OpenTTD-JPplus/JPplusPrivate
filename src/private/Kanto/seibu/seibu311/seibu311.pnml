//
  switch(FEAT_TRAINS, SELF, seibu311_front_mot_timed, current_year){
    0..1959:seibu311_1_front_mot;    seibu311_3_front_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu311_front_timed, current_year){
    0..1959:seibu311_1_front;    seibu311_3_front;
  }
  switch(FEAT_TRAINS, SELF, seibu311_mot_timed, current_year){
    0..1959:seibu311_1_mot;    seibu311_3_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu311_wag_rev_timed, current_year){
    0..1959:seibu311_1_wag_rev;    seibu311_3_wag_rev;
  }

  switch(FEAT_TRAINS, SELF, seibu311_front_mot, cargo_subtype){
    0:seibu311_1_front_mot_timed;    1:seibu311_1_front_mot;    2:seibu311_2_front_mot;
    3:seibu311_3_front_mot;    seibu311_4_front_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu311_front, cargo_subtype){
    0:seibu311_1_front_timed;    1:seibu311_1_front;    2:seibu311_2_front;
    3:seibu311_3_front;    seibu311_4_front;
  }
  switch(FEAT_TRAINS, SELF, seibu311_mot, cargo_subtype){
    0:seibu311_1_mot_timed;    1:seibu311_1_mot;    2:seibu311_2_mot;
    3:seibu311_3_mot;    seibu311_4_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu311_wag_rev, cargo_subtype){
    0:seibu311_1_wag_rev_timed;    1:seibu311_1_wag_rev;    2:seibu311_2_wag_rev;
    3:seibu311_3_wag_rev;    seibu311_4_wag_rev;
  }
//*livery 1
  //*special gfx
    switch(FEAT_TRAINS, PARENT, sw_seibu311_front_gfx, vehicle_is_flipped){
        1: seibu311_front;
        seibu311_front_mot;
    }
  //*panto placer
    switch(FEAT_TRAINS, SELF, sw_seibu311_panto_placer_main,position_in_vehid_chain %2){
        0: seibu311_wag_rev;
        seibu311_mot;
    }
  //*front end fixer
    GRAPHIC_STACK_2(seibu311_head_light,  sw_seibu311_front_gfx, sw_seibu311_lights)
    switch(FEAT_TRAINS, SELF, sw_seibu311_lv,vehicle_type_id){
        mu_car:sw_seibu311_panto_placer_main;
        seibu311_head_light;
    }
//
//*livery controller
  //lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu311_lv_desc, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_seibu311_1)),1949);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_BRYELLOW)),1949);
      3:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_AKADEN_A)),1960);
      4:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_AKADEN_B)),1960);
    }
//*post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_seibu311_car_power_main,position_in_vehid_chain %2){
        1: return 85;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu311_power_main,vehicle_type_id){
        mu_car: sw_seibu311_car_power_main;
        return 85;
    }
item(FEAT_TRAINS, seibu311) {
    property {
        OVERRIDEN_TRAIN_DATA
        
        climates_available: param_disable_seibu == 0 ? ALL_CLIMATES : NO_CLIMATE;
        name: string(STR_TRAIN_NAME, string(STR_NAME_SEIBU), "311", string(STR_NAME_SERIES));
        introduction_date: date(1946, 1, 1);
        model_life: 25;
        vehicle_life: 30;
        reliability_decay: 10;

        cost_factor: 16;
        running_cost_factor: 46;
        speed: 95 km/h;
        track_type: TR_1067_DC;
        power: 340 kW;
        weight: 40 ton;
    }
	graphics {
		additional_text:
      string(STR_TRAIN_DESC,
      string(STR_NARROWGAUGE),
      string(STR_DENKI, string(STR_DC, 1500)),
      string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
      string(STR_FORMATION, string(STR_NUM_CARS_2, 2,3)),
      string(STR_USAGE, string(STR_COMMUTER)),
		  string( STR_OPERATOR, string(STR_SEIBU)));
		cargo_subtype_text:sw_seibu311_lv_desc;
		// can_attach_wagon: sw_mucar_attach_vehid;
		purchase: seibu311_purchase;
		start_stop: sw_stop_start_2;

		SET_GRAPHICS_DOUBLE(sw_seibu311_lv,//graphics
		118*param_capacity_mod/3,//cargo capacity
		sw_seibu311_power_main()*1342/1000,//power
		param_loading_3D,//loading speed
		sw_seibu311_lv_desc,//subtype
		mu_car_narrow,37)//car_fallback,weight
}