//purchase
  spriteset(seibu311_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu311/seibu311_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu311_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu311/seibu311_1.png"){ tmpl_purchase_2c_dual(88, 75) }
  GRAPHIC_STACK_2(seibu311_purchase,  seibu311_purchase_c1, seibu311_purchase_c2)

  spriteset(seibu311_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu311/seibu311_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu311_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu311/seibu311_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_seibu311_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: seibu311_lights_end;
    seibu311_lights_front;
  }
