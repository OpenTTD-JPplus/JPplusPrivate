//purchase
  spriteset(seibu411_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu411_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu411_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu411_1.png"){ tmpl_purchase_2c_dual(0, 75) }
  GRAPHIC_STACK_2(seibu411_purchase,  seibu411_purchase_c1, seibu411_purchase_c2)
//*livery 1
  spriteset(seibu411_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu411_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu411_1_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu411_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu411_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu411_1.png"){ tmpl_std_v3(0, 50) }
  spriteset(seibu411_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu411_1.png"){ tmpl_std_rev_v3(0, 75) }
  spriteset(seibu411_1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu411_1.png"){ tmpl_std_v3(0, 75) }
//livery 2

  spriteset(seibu401_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu401_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu401_1_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu401_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu401_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu401_1.png"){ tmpl_std_v3(0, 50) }
  spriteset(seibu401_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu401_1.png"){ tmpl_std_rev_v3(0, 75) }
  spriteset(seibu401_1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu411/seibu401_1.png"){ tmpl_std_v3(0, 75) }
//
  switch(FEAT_TRAINS, SELF, seibu411_front_mot_timed, current_year){
    0..1978:seibu411_1_front_mot;    seibu401_1_front_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu411_end_mot_rev_timed, current_year){
    0..1978:seibu411_1_end_mot_rev;    seibu401_1_end_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, seibu411_front_timed, current_year){
    0..1978:seibu411_1_front;    seibu401_1_front;
  }
  switch(FEAT_TRAINS, SELF, seibu411_end_timed, current_year){
    0..1978:seibu411_1_end;    seibu401_1_end;
  }
  switch(FEAT_TRAINS, SELF, seibu411_end_rev_timed, current_year){
    0..1978:seibu411_1_end_rev;    seibu401_1_end_rev;
  }

  switch(FEAT_TRAINS, SELF, seibu411_front_mot, cargo_subtype){
    0:seibu411_front_mot_timed;    1:seibu411_1_front_mot;    seibu401_1_front_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu411_end_mot_rev, cargo_subtype){
    0:seibu411_end_mot_rev_timed;    1:seibu411_1_end_mot_rev;    seibu401_1_end_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, seibu411_front, cargo_subtype){
    0:seibu411_front_timed;    1:seibu411_1_front;    seibu401_1_front;
  }
  switch(FEAT_TRAINS, SELF, seibu411_end, cargo_subtype){
    0:seibu411_end_timed;    1:seibu411_1_end;    seibu401_1_end;
  }
  switch(FEAT_TRAINS, SELF, seibu411_end_rev, cargo_subtype){
    0:seibu411_end_rev_timed;    1:seibu411_1_end_rev;    seibu401_1_end_rev;
  }

//*livery 1
  //special gfx
    switch(FEAT_TRAINS, SELF, sw_seibu411_front_gfx, vehicle_is_flipped){
        1: seibu411_front;
        seibu411_front_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu411_end_gfx, vehicle_is_flipped){
        1: seibu411_end_rev;
        seibu411_end_mot_rev;
    }
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_seibu411_panto_placer_main,position_in_vehid_chain %2){
        0: seibu411_end;
        seibu411_end_mot_rev;
    }
  //front end fixer
    switch(FEAT_TRAINS, SELF, sw_seibu411_head_fix, train_is_driving_backwards != vehicle_is_flipped){
        1:sw_seibu411_end_gfx;
        sw_seibu411_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu411_lv,vehicle_type_id){
        mu_car:sw_seibu411_panto_placer_main;
        sw_seibu411_head_fix;
    }
//*livery controller
  //lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu411_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_seibu411_1)),1968);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_seibu411_2)),1979);
    }
//*post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_seibu411_power_1, build_year>1977){
        1: return 120;
        return 100;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu411_car_power_main,position_in_vehid_chain %2){
        1: return sw_seibu411_power_1;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu411_power_main, vehicle_type_id){
        mu_car: sw_seibu411_car_power_main;
        sw_seibu411_power_1()*2;
    }