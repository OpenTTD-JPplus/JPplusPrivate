//purchase
  spriteset(seibu451_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu451_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_1.png"){ tmpl_purchase_2c_dual(0, 75) }
  GRAPHIC_STACK_2(seibu451_purchase,  seibu451_purchase_c1, seibu451_purchase_c2)

  spriteset(seibu451_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu451_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_seibu451_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: seibu451_lights_end;
    seibu451_lights_front;
  }
//*livery 1
  spriteset(seibu451_1_head_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu451_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu451_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_1.png"){ tmpl_std_v3(0, 50) }
  spriteset(seibu451_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_1.png"){ tmpl_symm_v3(0, 75) }
//livery 2

  spriteset(seibu451_2_head_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_2.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu451_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_2.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu451_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_2.png"){ tmpl_std_v3(0, 50) }
  spriteset(seibu451_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu451/seibu451_2.png"){ tmpl_symm_v3(0, 75) }
//
  switch(FEAT_TRAINS, SELF, seibu451_head_mot_timed, current_year){
    0..1960:seibu451_1_head_mot;    seibu451_2_head_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu451_head_timed, current_year){
    0..1960:seibu451_1_head;    seibu451_2_head;
  }
  switch(FEAT_TRAINS, SELF, seibu451_mot_timed, current_year){
    0..1960:seibu451_1_mot;    seibu451_2_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu451_wag_timed, current_year){
    0..1960:seibu451_1_wag;    seibu451_2_wag;
  }

  switch(FEAT_TRAINS, SELF, seibu451_head_mot, cargo_subtype){
    0:seibu451_head_mot_timed;  1:seibu451_1_head_mot;    seibu451_2_head_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu451_head, cargo_subtype){
    0:seibu451_head_timed;  1:seibu451_1_head;    seibu451_2_head;
  }
  switch(FEAT_TRAINS, SELF, seibu451_mot, cargo_subtype){
    0:seibu451_mot_timed;  1:seibu451_1_mot;    seibu451_2_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu451_wag, cargo_subtype){
    0:seibu451_wag_timed;  1:seibu451_1_wag;    seibu451_2_wag;
  }

//*livery 1
  //special gfx
    switch(FEAT_TRAINS, SELF, sw_seibu451_head_gfx_1, vehicle_is_flipped){
        1: seibu451_head;
        seibu451_head_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu451_head_gfx, num_vehs_in_consist>4&&num_vehs_in_consist!=8||num_vehs_in_vehid_chain>1){
        1: sw_seibu451_head_gfx_1;
        seibu451_head_mot;
    }

  //panto placer
      switch(FEAT_TRAINS, SELF, sw_seibu451_panto_placer_main,position_in_vehid_chain %4){
          2: seibu451_mot;
          seibu451_wag;
      }
  //front end fixer
    GRAPHIC_STACK_2(seibu451_head_light,  sw_seibu451_head_gfx, sw_seibu451_lights)
    switch(FEAT_TRAINS, SELF, sw_seibu451_lv,vehicle_type_id){
        mu_car:sw_seibu451_panto_placer_main;
        seibu451_head_light;
    }
//
//*livery controller
  //lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu451_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_YELLOW)),1959);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_AKADEN)),1961);
    }
//*post fixers
  //capacity fix
    switch(FEAT_TRAINS, SELF, sw_seibu451_capacity_main,vehicle_type_id){
      mu_car: 168;
      160;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_seibu451_car_power_main,position_in_vehid_chain %2){
      1: return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu451_power_main,vehicle_type_id){
      mu_car: sw_seibu451_car_power_main;
      return 100;
    }