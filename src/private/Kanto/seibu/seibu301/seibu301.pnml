//*livery 1
  //special gfx
		//2 car 
		switch(FEAT_TRAINS, SELF, seibu301_head_gfx_1, vehicle_is_flipped){
			1:seibu301_head;
			seibu301_head_mot;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu301_head_gfx, num_vehs_in_vehid_chain==num_vehs_in_consist||num_vehs_in_vehid_chain>2){
			1:seibu301_head_gfx_1;
			seibu301_head;
		}
	//panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu301_panto_placer_main_1,position_in_vehid_chain %3){
				0: seibu301_mot;
				seibu301_wag;
			}
		//var 2
			switch(FEAT_TRAINS, SELF, sw_seibu301_panto_placer_main_2,position_in_vehid_chain %4){
				0: seibu301_mot;
				seibu301_wag;
			}
		//var 3
			switch(FEAT_TRAINS, SELF, sw_seibu301_panto_placer_main_3,position_in_vehid_chain %3){
				1: seibu301_mot;
				seibu301_wag;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu301_panto_placer_main,num_vehs_in_vehid_chain){
				3:sw_seibu301_panto_placer_main_3;
				6:sw_seibu301_panto_placer_main_2;
				sw_seibu301_panto_placer_main_1;
			}
  //front-end-fixer
    GRAPHIC_STACK_2(seibu301_head_light,  sw_seibu301_head_gfx, sw_seibu301_lights)
    switch(FEAT_TRAINS, SELF, sw_seibu301_lv,vehicle_type_id){
			mu_car:sw_seibu301_panto_placer_main;
			seibu301_head_light;
    }
//*livery controller
    switch(FEAT_TRAINS, SELF, sw_seibu301_lv_desc_main, cargo_subtype){
			0:string(LV_DATED,string(STR_LIVERY,string(LV_seibu301_1)),1979);
			1:string(LV_DATED,string(STR_LIVERY,string(LV_seibu301_2)),2010);
			2:string(LV_DATED,string(STR_LIVERY,string(LV_seibu301_3)),2018);
			3:string(LV_DATED,string(STR_LIVERY,string(LV_seibu301_4)),2017);
			4:string(LV_DATED,string(STR_LIVERY,string(LV_seibu301_5)),2017);
			5:string(LV_DATED,string(STR_LIVERY,string(LV_seibu301_6)),2018);
    }
//*post fixers
	//capacity
		switch(FEAT_TRAINS, SELF, sw_seibu301_capacity_main,vehicle_type_id){
			mu_car: 168;
			160;
		}
	//power
		switch(FEAT_TRAINS, SELF, sw_seibu301_car_power_main,position_in_vehid_chain %4){
    	0..1:return 150;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu301_head_power_main,num_vehs_in_vehid_chain==num_vehs_in_consist||num_vehs_in_vehid_chain>3){
    	1:return 150;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu301_power_main,vehicle_type_id){
			mu_car: sw_seibu301_car_power_main;
			sw_seibu301_head_power_main;
		}