//*lights
	spriteset(odakyu8000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu8000/odakyu8000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu8000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu8000/odakyu8000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_odakyu8000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: odakyu8000_lights_back;
    odakyu8000_lights_front;
  }
//*livery 1
	spriteset(seibu8000_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu8000/seibu8000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(seibu8000_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu8000/seibu8000_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(seibu8000_head, seibu8000_head_base, roof_gray_med, sw_odakyu8000_lights, ac_double_1_3)
	TRAIN_CONSTRUCTOR_4(seibu8000_mot, seibu8000_car_base, roof_gray_med, ac_double_1_6, panto_arm_n_single_rev)
	TRAIN_CONSTRUCTOR_3(seibu8000_wag, seibu8000_car_base, roof_gray_med, ac_double_1_1)
//
//*purchase
  spriteset(seibu8000_head_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu8000/seibu8000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu8000_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu8000/seibu8000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(seibu8000_purchase, roof_gray_med_c1, seibu8000_head_base_c1, ac_double_1_c1, roof_gray_med_c2, seibu8000_car_base_c2, ac_double_1_c2)
//
//*livery 1
	//panto placer
		//1
			switch(FEAT_TRAINS, SELF, sw_seibu8000_panto_placer_main_1,position_in_vehid_chain %2){
				0: seibu8000_mot;
				seibu8000_wag;
			}
		//2
			switch(FEAT_TRAINS, SELF, sw_seibu8000_panto_placer_main_2,position_in_vehid_chain %3){
				0: seibu8000_mot;
				1: seibu8000_mot;
				seibu8000_wag;
			}
		//controller
			switch(FEAT_TRAINS, SELF, sw_seibu8000_panto_placer_main,num_vehs_in_vehid_chain){
				2: sw_seibu8000_panto_placer_main_2;
				sw_seibu8000_panto_placer_main_1;
			}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_seibu8000_lv,vehicle_type_id){
      mu_car:sw_seibu8000_panto_placer_main;
      seibu8000_head;
    }
//
//post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_seibu8000_capacity_main,vehicle_type_id){
			mu_car: 157;
			147;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_seibu8000_car_power_main,position_in_vehid_chain_from_end %6){
			0..1:return 190;
			2:return 190;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu8000_power_main,vehicle_type_id){
			mu_car:sw_seibu8000_car_power_main;
			return 0;
		}
