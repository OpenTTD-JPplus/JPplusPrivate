//
  switch(FEAT_TRAINS, SELF, seibu3000_front_timed, build_year){
    0..1996:seibu3000_1_front_gfx;    seibu3000_2_front_gfx;
  }
  switch(FEAT_TRAINS, SELF, seibu3000_end_timed, build_year){
    0..1996:seibu3000_1_end_gfx;    seibu3000_2_end_gfx;
  }
  switch(FEAT_TRAINS, SELF, seibu3000_mot_timed, build_year){
    0..1996:seibu3000_1_mot;    seibu3000_2_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu3000_wag_timed, build_year){
    0..1996:seibu3000_1_wag;    seibu3000_2_wag;
  }
  switch(FEAT_TRAINS, SELF, seibu3000_front, cargo_subtype){
    0:seibu3000_front_timed;    1:seibu3000_1_front_gfx;
    2:seibu3000_2_front_gfx;    3:seibu3000_3_front_gfx;    4:seibu3000_4_front;  
  }
  switch(FEAT_TRAINS, SELF, seibu3000_end, cargo_subtype){
    0:seibu3000_end_timed;    1:seibu3000_1_end_gfx;
    2:seibu3000_2_end_gfx;    3:seibu3000_3_end_gfx;  4:seibu3000_4_end;
  }
  switch(FEAT_TRAINS, SELF, seibu3000_mot, cargo_subtype){
    0:seibu3000_mot_timed;    1:seibu3000_1_mot;
    2:seibu3000_2_mot;    3:sw_seibu3000_3_panto_placer_main; 4:seibu3000_4_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu3000_wag, cargo_subtype){
    0:seibu3000_wag_timed;    1:seibu3000_1_wag;
    2:seibu3000_2_wag;    3:sw_seibu3000_3_panto_placer_main; 4:seibu3000_4_wag;
  }
//*livery 1
	//panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu3000_panto_placer_main_1,position_in_vehid_chain %2){
				0: seibu3000_mot;
				seibu3000_wag;
			}
		//var 2
			switch(FEAT_TRAINS, SELF, sw_seibu3000_panto_placer_main_2,position_in_vehid_chain %3){
				1: seibu3000_mot;
				seibu3000_wag;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu3000_panto_placer_main,num_vehs_in_vehid_chain){
				3:sw_seibu3000_panto_placer_main_2;
				sw_seibu3000_panto_placer_main_1;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu3000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:seibu3000_end;
      seibu3000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu3000_lv,vehicle_type_id){
      mu_car:sw_seibu3000_panto_placer_main;
      sw_seibu3000_head_gfx_main;
    }
//*livery controller
    switch(FEAT_TRAINS, SELF, sw_seibu3000_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_seibu3000_1)),1983);
			2:string(LV_DATED,string(STR_LIVERY,string(LV_seibu3000_2)),1997);
			3:string(LV_DATED,string(STR_LIVERY,string(LV_seibu3000_3)),2009);
			4:string(LV_DATED,string(STR_LIVERY,string(LV_seibu3000_4)),2010);
    }
//*post fixers
	//capacity
		switch(FEAT_TRAINS, SELF, sw_seibu3000_capacity_main,vehicle_type_id){
			mu_car: 144;
			136;
		}
	//power
		switch(FEAT_TRAINS, SELF, sw_seibu3000_car_power_main,position_in_vehid_chain_from_end %8){
    	0..5:return 130;
    	return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu3000_power_main,vehicle_type_id){
			mu_car:sw_seibu3000_car_power_main;
			return 0;
		}
