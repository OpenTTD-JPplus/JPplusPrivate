//livery 1
  TRAIN_CONSTRUCTOR_3(seibu7000_head, seibu7000_head_base, sw_tokyu9000_lights, ac_quad_1_wag)
  TRAIN_CONSTRUCTOR_3(seibu7000_mot, seibu7000_wag_base, ac_quad_1_mot,panto_arm_n_single)
