//*livery 1
  //panto placer
    //var 1
      switch(FEAT_TRAINS, SELF, sw_seibu7000_panto_placer_main_1,position_in_vehid_chain %5){
        0: seibu7000_mot;
        2: seibu7000_mot;
        4: seibu7000_mot;
        seibu7000_wag;
      }
    //var 2 5 cars
      switch(FEAT_TRAINS, SELF, sw_seibu7000_panto_placer_main_2,position_in_vehid_chain %4){
        0: seibu7000_mot;
        1: seibu7000_mot;
        2: seibu7000_mot;
        seibu7000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_seibu7000_panto_placer_main,num_vehs_in_vehid_chain){
        0..4: sw_seibu7000_panto_placer_main_2;
        sw_seibu7000_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu7000_lv,vehicle_type_id){
      mu_car:sw_seibu7000_panto_placer_main;
      seibu7000_head;
    }
//post fixers
  //capacity
    switch(FEAT_TRAINS, SELF, sw_seibu7000_car_capacity_main, position_in_vehid_chain){
      1:149;
      default: 150;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu7000_capacity_main, vehicle_type_id){
      mu_car: sw_seibu7000_car_capacity_main;
      default: 139;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_seibu7000_car_power_main, position_in_vehid_chain%4){
      0..1:return 170;
      default: 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu7000_power_main, vehicle_type_id){
      mu_car: sw_seibu7000_car_power_main;
      return 0;
    }