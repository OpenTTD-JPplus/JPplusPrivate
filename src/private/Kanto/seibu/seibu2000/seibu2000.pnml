	spriteset(seibu2000_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu2000/seibu2000_2.png"){ tmpl_symm_v3(0, 150) }
//

//*livery 1
	//special gfx
		//wag
			switch(FEAT_TRAINS, PARENT, seibu2000_1_wag_gfx,current_year>2007){
				1: seibu2000n_1_wag;				seibu2000_1_wag;
			}
		//mot
			switch(FEAT_TRAINS, PARENT, seibu2000_1_mot_gfx,current_year>2007){
				1: seibu2000n_1_mot;				seibu2000_1_mot;
			}
			switch(FEAT_TRAINS, PARENT, seibu2000_1_mot_2_gfx,current_year>2007){
				1: seibu2000n_1_mot_2;				seibu2000_1_mot_2;
			}
		//front
			switch(FEAT_TRAINS, PARENT, seibu2000_1_front_mot_gfx,current_year>2007||build_year>1987){
					1: seibu2000n_1_front_mot;					seibu2000_1_front_mot;
			}
			switch(FEAT_TRAINS, PARENT, seibu2000_1_front_gfx,current_year>2007||build_year>1987){
					1: seibu2000n_1_front;					seibu2000_1_front;
			}
      switch(FEAT_TRAINS, PARENT, sw_seibu2000_1_front_gfx_1,vehicle_is_reversed){
					1: seibu2000_1_front_gfx;					seibu2000_1_front_mot_gfx;
			}
			switch(FEAT_TRAINS, SELF, sw_seibu2000_1_front_gfx,(num_vehs_in_vehid_chain==num_vehs_in_consist||num_vehs_in_consist==4)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
					1: sw_seibu2000_1_front_gfx_1;					seibu2000_1_front_gfx;
			}

      switch(FEAT_TRAINS, PARENT, sw_seibu2000_2_front_gfx_1,vehicle_is_reversed){
					1: seibu2000_2_front;					seibu2000_2_front_mot;
			}
			switch(FEAT_TRAINS, SELF, sw_seibu2000_2_front_gfx,(num_vehs_in_vehid_chain==num_vehs_in_consist||num_vehs_in_consist==4)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
					1: sw_seibu2000_2_front_gfx_1;					seibu2000_2_front;
			}
		//end
			switch(FEAT_TRAINS, PARENT, seibu2000_1_end_mot_gfx,current_year>2007||build_year>1987){
					1: seibu2000n_1_end_mot;					seibu2000_1_end_mot;
			}
			switch(FEAT_TRAINS, PARENT, seibu2000_1_end_gfx,current_year>2007||build_year>1987){
					1: seibu2000n_1_end;					seibu2000_1_end;
			}
      switch(FEAT_TRAINS, PARENT, sw_seibu2000_1_end_gfx_1,vehicle_is_reversed){
					1: seibu2000_1_end_mot_gfx;					seibu2000_1_end_gfx;
			}
			switch(FEAT_TRAINS, SELF, sw_seibu2000_1_end_gfx,(num_vehs_in_vehid_chain==num_vehs_in_consist||num_vehs_in_consist==4)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
					1: sw_seibu2000_1_end_gfx_1;					seibu2000_1_end_gfx;
			}

      switch(FEAT_TRAINS, PARENT, sw_seibu2000_2_end_gfx_1,vehicle_is_reversed){
					1: seibu2000_2_end_mot;					seibu2000_2_end;
			}
			switch(FEAT_TRAINS, SELF, sw_seibu2000_2_end_gfx,(num_vehs_in_vehid_chain==num_vehs_in_consist||num_vehs_in_consist==4)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
					1: sw_seibu2000_2_end_gfx_1;					seibu2000_2_end;
			}

      switch(FEAT_TRAINS, SELF, seibu2000_front, cargo_subtype){
        0:sw_seibu2000_1_front_gfx;        1:sw_seibu2000_2_front_gfx;
      }
      switch(FEAT_TRAINS, SELF, seibu2000_end, cargo_subtype){
        0:sw_seibu2000_1_end_gfx;        1:sw_seibu2000_2_end_gfx;
      }
      switch(FEAT_TRAINS, SELF, seibu2000_mot, cargo_subtype){
        0:seibu2000_1_mot_gfx;        1:seibu2000_2_mot;
      }
      switch(FEAT_TRAINS, SELF, seibu2000_mot_2, cargo_subtype){
        0:seibu2000_1_mot_2_gfx;        1:seibu2000_2_mot_2;
      }
      switch(FEAT_TRAINS, SELF, seibu2000_wag, cargo_subtype){
        0:seibu2000_1_wag_gfx;        1:seibu2000_2_wag;
      }
	//panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu2000_panto_placer_main_1,position_in_vehid_chain %2){
				0: seibu2000_mot;
				seibu2000_wag;
			}
		//var 2 4 cars
			switch(FEAT_TRAINS, SELF, sw_seibu2000_panto_placer_main_2,position_in_vehid_chain_from_end %3){
				0: seibu2000_mot_2;
				seibu2000_wag;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu2000_panto_placer_main,num_vehs_in_vehid_chain){
				0..2:sw_seibu2000_panto_placer_main_2;
				sw_seibu2000_panto_placer_main_1;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu2000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:seibu2000_end;
      seibu2000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu2000_lv,vehicle_type_id){
      mu_car:sw_seibu2000_panto_placer_main;
      sw_seibu2000_head_gfx_main;
    }
// //*livery controller
    switch(FEAT_TRAINS, SELF, sw_seibu2000_lv_desc_main, cargo_subtype){
      0:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1977);
			1:string(LV_DATED,string(STR_LIVERY,string(LV_seibu2000_2)),2023);
    }
//*post fixers
	//capacity
		switch(FEAT_TRAINS, SELF, sw_seibu2000_capacity_main,vehicle_type_id){
			mu_car: 136;
			144;
		}
	//power
		switch(FEAT_TRAINS, SELF, sw_seibu2000_car_power_main,position_in_vehid_chain %8){
    	0..5:return 130;
    	return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu2000_head_power,num_vehs_in_vehid_chain==2){
			1: return 130;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu2000_power_main,vehicle_type_id){
			mu_car:sw_seibu2000_car_power_main;
			sw_seibu2000_head_power;
		}
