  spriteset(seibu2000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu2000/seibu2000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu2000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu2000/seibu2000_1.png"){ tmpl_purchase_2c_dual(0, 100) }
  GRAPHIC_STACK_2(seibu2000_purchase,  seibu2000_purchase_c1, seibu2000_purchase_c2)
