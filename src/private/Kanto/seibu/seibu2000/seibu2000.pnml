	spriteset(seibu2000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu2000/seibu2000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(seibu2000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu2000/seibu2000_1.png"){ tmpl_std_v3(0, 25) }
	spriteset(seibu2000_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu2000/seibu2000_1.png"){ tmpl_std_v3(0, 50) }
	spriteset(seibu2000_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu2000/seibu2000_1.png"){ tmpl_std_v3(0, 75) }
	spriteset(seibu2000_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu2000/seibu2000_1.png"){ tmpl_std_v3(0, 100) }
	spriteset(seibu2000_1_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu2000/seibu2000_1.png"){ tmpl_symm_v3(0, 125) }
	spriteset(seibu2000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu2000/seibu2000_1.png"){ tmpl_symm_v3(0, 150) }
