//
  switch(FEAT_TRAINS, SELF, seibu9000_front, cargo_subtype){
    0:seibu9000_1_front;    1:seibu9000_2_front;    2:seibu9000_3_front;
    3..5:seibu9000_4_front;    6:seibu9000_7_front;
  }
  switch(FEAT_TRAINS, SELF, seibu9000_end, cargo_subtype){
    0:seibu9000_1_end;    1:seibu9000_2_end;    2:seibu9000_3_end;
    3..5:seibu9000_4_end;    6:seibu9000_7_end;
  }
  switch(FEAT_TRAINS, SELF, seibu9000_mot_rev, cargo_subtype){
    0:seibu9000_1_mot_rev;    1:seibu9000_2_mot_rev;    2:seibu9000_3_mot_rev;
    3..5:seibu9000_4_mot_rev;    6:seibu9000_7_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, seibu9000_mot_2, cargo_subtype){
    0:seibu9000_1_mot_2;    1:seibu9000_2_mot_2;    2:seibu9000_3_mot_2;
    3..5:seibu9000_4_mot_2;    6:seibu9000_7_mot_2;
  }
  switch(FEAT_TRAINS, SELF, seibu9000_wag, cargo_subtype){
    0:seibu9000_1_wag;    1:seibu9000_2_wag;    2:seibu9000_3_wag;
    3..5:seibu9000_4_wag;    6:seibu9000_7_wag;
  }
//
//*livery 1
  //panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu9000_panto_placer_main_1,position_in_vehid_chain %3){
				0: seibu9000_mot_rev;
				seibu9000_wag;
			}
		//var 2
			switch(FEAT_TRAINS, SELF, sw_seibu9000_panto_placer_main_2,position_in_vehid_chain %4){
				0: seibu9000_mot_rev;
				seibu9000_wag;
			}
		//var 3
			switch(FEAT_TRAINS, SELF, sw_seibu9000_panto_placer_main_3,position_in_vehid_chain %4){
				1: seibu9000_mot_2;
				seibu9000_wag;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu9000_panto_placer_main,num_vehs_in_vehid_chain){
				2..3:sw_seibu9000_panto_placer_main_3;
				6:sw_seibu9000_panto_placer_main_2;
				sw_seibu9000_panto_placer_main_1;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu9000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:seibu9000_end;
      seibu9000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu9000_lv,vehicle_type_id){
      mu_car:sw_seibu9000_panto_placer_main;
      sw_seibu9000_head_gfx_main;
    }
//
//*livery controller
  switch(FEAT_TRAINS, SELF, sw_seibu9000_lv_desc_main, cargo_subtype){
    0:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1993);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_seibu9000_2)),2014);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_seibu9000_3)),2020);
    3..5:string(LV_DATED,string(STR_LIVERY,string(LV_seibu9000_4)),2016);
    6:string(LV_DATED,string(STR_LIVERY,string(LV_seibu9000_7)),2017);
  }
//*post fixers
	//capacity
		switch(FEAT_TRAINS, SELF, sw_seibu9000_capacity_main,vehicle_type_id){
			mu_car: 137;
			147;
    }
  //speed
		switch(FEAT_TRAINS, SELF, sw_seibu9000_speed_main, date_of_last_service>date(2003,6,1)){
    	1:return 120;
    	return 110;
		}
	//power
		switch(FEAT_TRAINS, SELF, sw_seibu9000_power_1, date_of_last_service>date(2003,6,1)){
    	1:return 135;
    	return 150;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu9000_car_power_main,position_in_vehid_chain %3){
    	0..1:sw_seibu9000_power_1;
    	return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu9000_power_main,vehicle_type_id){
			mu_car:sw_seibu9000_car_power_main;
			return 0;
		}