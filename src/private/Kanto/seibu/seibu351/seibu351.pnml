//purchase
  spriteset(seibu351_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu351/seibu351_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu351_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu351/seibu351_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(seibu351_purchase,  seibu351_purchase_c1, seibu351_purchase_c2)

  spriteset(seibu351_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu351/seibu351_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu351_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu351/seibu351_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_seibu351_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: seibu351_lights_end;
    seibu351_lights_front;
  }
//*livery 1
  spriteset(seibu351_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu351/seibu351_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu351_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu351/seibu351_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu351_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu351/seibu351_1.png"){ tmpl_symm_v3(0, 50) }
//livery 2

  spriteset(seibu351_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu351/seibu351_2.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu351_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu351/seibu351_2.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu351_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu351/seibu351_2.png"){ tmpl_symm_v3(0, 50) }

switch(FEAT_TRAINS, SELF, seibu351_front_timed, current_year){
  0..1959:seibu351_1_front;  seibu351_2_front;
}
switch(FEAT_TRAINS, SELF, seibu351_mot_timed, current_year){
  0..1959:seibu351_1_mot;  seibu351_2_mot;
}
switch(FEAT_TRAINS, SELF, seibu351_wag_timed, current_year){
  0..1959:seibu351_1_wag;  seibu351_2_wag;
}

switch(FEAT_TRAINS, SELF, seibu351_front, cargo_subtype){
  0:seibu351_front_timed;  1:seibu351_1_front;  seibu351_2_front;
}
switch(FEAT_TRAINS, SELF, seibu351_mot, cargo_subtype){
  0:seibu351_mot_timed;  1:seibu351_1_mot;  seibu351_2_mot;
}
switch(FEAT_TRAINS, SELF, seibu351_wag, cargo_subtype){
  0:seibu351_wag_timed;  1:seibu351_1_wag;  seibu351_2_wag;
}

//*livery 1
  //panto placer
    switch(FEAT_TRAINS, SELF, sw_seibu351_panto_placer_main,position_in_vehid_chain %2){
        1: seibu351_mot;
        seibu351_wag;
    }
  //front end fixer
    GRAPHIC_STACK_2(seibu531_head_light,  seibu351_front, sw_seibu351_lights)
    switch(FEAT_TRAINS, SELF, sw_seibu351_lv,vehicle_type_id){
        mu_car:sw_seibu351_panto_placer_main;
        seibu531_head_light;
    }
//

//*livery controller
  switch(FEAT_TRAINS, SELF, sw_seibu351_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_BRYELLOW)),1954);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_AKADEN)),1960);
  }
//*post fixers
//capacity fix
    switch(FEAT_TRAINS, SELF, sw_seibu351_capacity_main,vehicle_type_id){
        mu_car: 135;
        128;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_seibu351_car_power_main,position_in_vehid_chain %2){
        0: return 100;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu351_power_main,vehicle_type_id){
        mu_car: sw_seibu351_car_power_main;
        return 100;
    }