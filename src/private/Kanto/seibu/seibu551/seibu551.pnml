//purchase
  spriteset(seibu551_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu551/seibu551.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu551_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu551/seibu551.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(seibu551_purchase,  seibu551_purchase_c1, seibu551_purchase_c2)
//*livery 1
  spriteset(seibu551_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu551/seibu551.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu551_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu551/seibu551.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu551_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu551/seibu551.png"){ tmpl_std_v3(0, 50) }
  spriteset(seibu551_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu551/seibu551.png"){ tmpl_std_v3(0, 75) }
  spriteset(seibu551_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu551/seibu551.png"){ tmpl_std_v3(0, 100) }
  spriteset(seibu551_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu551/seibu551.png"){ tmpl_symm_v3(0, 125) }
//*livery 1
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_seibu551_front_gfx_1, vehicle_is_reversed){
        1: seibu551_front;
        seibu551_front_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu551_front_gfx, (num_vehs_in_vehid_chain==num_vehs_in_consist)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
        1: sw_seibu551_front_gfx_1;
        seibu551_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_seibu551_end_gfx_1, vehicle_is_reversed){
        1: seibu551_end_mot;
        seibu551_end;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu551_end_gfx, (num_vehs_in_vehid_chain==num_vehs_in_consist)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
        1: sw_seibu551_end_gfx_1;
        seibu551_end_mot;
    }

  //panto placer
      switch(FEAT_TRAINS, SELF, sw_seibu551_panto_placer_main,position_in_vehid_chain %4){
          2: seibu551_mot;
          seibu551_wag;
      }
  //front end fixer
    switch(FEAT_TRAINS, SELF, sw_seibu551_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:sw_seibu551_end_gfx;
      sw_seibu551_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu551_lv,vehicle_type_id){
      mu_car:sw_seibu551_panto_placer_main;
      sw_seibu551_head_gfx_main;
    }
//
//*post fixers
  //capacity fix
    switch(FEAT_TRAINS, SELF, sw_seibu551_capacity_main,vehicle_type_id){
      mu_car:168;
      160;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_seibu551_head_power_main,num_vehs_in_vehid_chain){
      2: return 200;
      return 100;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu551_car_power_main,position_in_vehid_chain%2){
      0: return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu551_power_main,vehicle_type_id){
      mu_car: sw_seibu551_car_power_main;
      sw_seibu551_head_power_main;
    }

  switch (FEAT_TRAINS, SELF, sw_seibu551_name_purchase, getbits(extra_callback_info1, 8, 8)) { 
    1: return CB_RESULT_NO_TEXT; 
    return string(STR_TRAIN_NAME, string(STR_NAME_SEIBU), "551/571", string(STR_NAME_SERIES));
    } 
    switch (FEAT_TRAINS, SELF, sw_seibu551_name, getbits(extra_callback_info1, 0, 8)) { 
      0x20: sw_seibu551_name_purchase; 
      return CB_RESULT_NO_TEXT;
    }