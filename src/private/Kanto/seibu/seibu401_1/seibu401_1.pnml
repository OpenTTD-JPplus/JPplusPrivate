//purchase
  spriteset(seibu401_1_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu401_1_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(seibu401_1_purchase,  seibu401_1_purchase_c1, seibu401_1_purchase_c2)

  spriteset(seibu401_1_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu401_1_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_seibu401_1_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: seibu401_1_lights_end;
    seibu401_1_lights_front;
  }
//*livery 1
  spriteset(seibu401_1_1_head_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu401_1_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu401_1_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_1.png"){ tmpl_std_v3(0, 50) }
  spriteset(seibu401_1_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_1.png"){ tmpl_std_rev_v3(0, 75) }
//livery 2

  spriteset(seibu401_1_2_head_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_2.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu401_1_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_2.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu401_1_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_2.png"){ tmpl_std_v3(0, 50) }
  spriteset(seibu401_1_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu401_1/seibu401_1_2.png"){ tmpl_std_rev_v3(0, 75) }
//
  switch(FEAT_TRAINS, SELF, seibu401_1_head_mot_timed, current_year){
    0..1959:seibu401_1_1_head_mot;    seibu401_1_2_head_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu401_1_mot_timed, current_year){
    0..1959:seibu401_1_1_mot;    seibu401_1_2_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu401_1_head_timed, current_year){
    0..1959:seibu401_1_1_head;    seibu401_1_2_head;
  }
  switch(FEAT_TRAINS, SELF, seibu401_1_wag_timed, current_year){
    0..1959:seibu401_1_1_wag;    seibu401_1_2_wag;
  }

  switch(FEAT_TRAINS, SELF, seibu401_1_head_mot, cargo_subtype){
    0:seibu401_1_head_mot_timed;    1:seibu401_1_1_head_mot;    seibu401_1_2_head_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu401_1_mot, cargo_subtype){
    0:seibu401_1_mot_timed;    1:seibu401_1_1_mot;    seibu401_1_2_mot;
  }
  switch(FEAT_TRAINS, SELF, seibu401_1_head, cargo_subtype){
    0:seibu401_1_head_timed;    1:seibu401_1_1_head;    seibu401_1_2_head;
  }
  switch(FEAT_TRAINS, SELF, seibu401_1_wag, cargo_subtype){
    0:seibu401_1_wag_timed;    1:seibu401_1_1_wag;    seibu401_1_2_wag;
  }
//*livery 1
  //*special gfx
    switch(FEAT_TRAINS, SELF, sw_seibu401_1_head_gfx, vehicle_is_flipped==0||position_in_consist%2==0){
        1: seibu401_1_head_mot;
        seibu401_1_head;
    }
  //*panto placer
    switch(FEAT_TRAINS, SELF, sw_seibu401_1_panto_placer_main,position_in_vehid_chain %2){
        0: seibu401_1_wag;
        seibu401_1_mot;
    }
  //*front end fixer
    GRAPHIC_STACK_2(seibu401_1_head_light,  sw_seibu401_1_head_gfx, sw_seibu401_1_lights)
    switch(FEAT_TRAINS, SELF, sw_seibu401_1_lv,vehicle_type_id){
        mu_car:sw_seibu401_1_panto_placer_main;
        seibu401_1_head_light;
    }
//
//*livery controller
    switch(FEAT_TRAINS, SELF, sw_seibu401_1_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_YELLOW)),1953);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_AKADEN)),1960);
    }
//*post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_seibu401_1_car_power_main,position_in_vehid_chain %2){
        0: return 100;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu401_1_power_main,vehicle_type_id){
        mu_car: sw_seibu401_1_car_power_main;
        return 100;
    }
