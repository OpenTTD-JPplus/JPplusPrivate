  //front-end-fixer
    GRAPHIC_STACK_2(seibu101_head_light,  seibu101_head, sw_seibu101_lights)
    switch(FEAT_TRAINS, SELF, sw_seibu101_lv,vehicle_type_id){
			mu_car:sw_seibu101_panto_placer_main;
			seibu101_head_light;
    }
//*livery controller
	//lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu101_lv_desc_main, cargo_subtype){
      0:string(LV_DATED,string(STR_LIVERY,string(LV_seibu101_1)),1969);
			1:string(LV_DATED,string(STR_LIVERY,string(LV_seibu101_2)),2001);
			2:string(LV_DATED,string(STR_LIVERY,string(LV_seibu101_3)),2004);
    }
//*post fixers
	//capacity
		switch(FEAT_TRAINS, SELF, sw_seibu101_capacity_main,vehicle_type_id){
			mu_car: 168;
			160;
		}
	//power
		switch(FEAT_TRAINS, SELF, sw_seibu101_car_power_main,position_in_vehid_chain %6){
    	0..3:return 150;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu101_power_main,vehicle_type_id){
    	mu_car: sw_seibu101_car_power_main;
			return 0;
		}