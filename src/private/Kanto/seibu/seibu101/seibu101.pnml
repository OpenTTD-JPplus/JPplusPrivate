		//var 2
			switch(FEAT_TRAINS, SELF, sw_seibu101_panto_placer_main_2,position_in_vehid_chain %3){
				1: seibu101_mot;
				seibu101_wag;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu101_panto_placer_main,num_vehs_in_vehid_chain){
				3:sw_seibu101_panto_placer_main_2;
				sw_seibu101_panto_placer_main_1;
