//purchase
  spriteset(seibu501_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu501_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_1.png"){ tmpl_purchase_2c_dual(0, 75) }
  GRAPHIC_STACK_2(seibu501_purchase,  seibu501_purchase_c1, seibu501_purchase_c2)

  spriteset(seibu501_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu501_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_seibu501_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: seibu501_lights_end;
    seibu501_lights_front;
  }
//*livery 1
  spriteset(seibu501_1_head_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu501_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu501_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_1.png"){ tmpl_symm_v3(0, 50) }
  spriteset(seibu501_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_1.png"){ tmpl_symm_v3(0, 75) }
//livery 1 ac
  spriteset(seibu501n_1_head_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501n_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu501n_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501n_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu501n_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501n_1.png"){ tmpl_symm_v3(0, 50) }
  spriteset(seibu501n_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501n_1.png"){ tmpl_symm_v3(0, 75) }
//livery 2
  spriteset(seibu501_2_head_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_2.png"){ tmpl_std_v3(0, 0) }
  spriteset(seibu501_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_2.png"){ tmpl_std_v3(0, 25) }
  spriteset(seibu501_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_2.png"){ tmpl_symm_v3(0, 50) }
  spriteset(seibu501_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu501/seibu501_2.png"){ tmpl_symm_v3(0, 75) }
//*livery 1
  //special gfx
    //front
      switch(FEAT_TRAINS, PARENT, seibu501_1_head_gfx, current_year>1976){
          1: seibu501n_1_head;
          seibu501_1_head;
      }
      switch(FEAT_TRAINS, PARENT, seibu501_1_head_mot_gfx, current_year>1976){
          1: seibu501n_1_head_mot;
          seibu501_1_head_mot;
      }
      switch(FEAT_TRAINS, SELF, sw_seibu501_1_head_gfx_1, vehicle_is_flipped){
          1: seibu501_1_head_gfx;
          seibu501_1_head_mot_gfx;
      }
      switch(FEAT_TRAINS, SELF, sw_seibu501_1_head_gfx, num_vehs_in_vehid_chain>1){
          1: sw_seibu501_1_head_gfx_1;
          seibu501_1_head_gfx;
      }
    //mot
      switch(FEAT_TRAINS, PARENT, seibu501_1_mot_gfx, current_year>1976){
        1: seibu501n_1_mot;
        seibu501_1_mot;
      }
    //wag
      switch(FEAT_TRAINS, PARENT, seibu501_1_wag_gfx, current_year>1976){
        1: seibu501n_1_wag;
        seibu501_1_wag;
      }
    //lv 2
      switch(FEAT_TRAINS, SELF, sw_seibu501_2_head_gfx_1, vehicle_is_flipped){
          1: seibu501_2_head;
          seibu501_2_head_mot;
      }
      switch(FEAT_TRAINS, SELF, sw_seibu501_2_head_gfx, num_vehs_in_vehid_chain>1){
          1: sw_seibu501_2_head_gfx_1;
          seibu501_2_head;
      }
    switch(FEAT_TRAINS, SELF, seibu501_head_timed, current_year){
      0..1976:sw_seibu501_1_head_gfx;      sw_seibu501_2_head_gfx;
    }
    switch(FEAT_TRAINS, SELF, seibu501_mot_timed, current_year){
      0..1976:seibu501_1_mot_gfx;      seibu501_2_mot;
    }
    switch(FEAT_TRAINS, SELF, seibu501_wag_timed, current_year){
      0..1976:seibu501_1_wag_gfx;      seibu501_2_wag;
    }
    switch(FEAT_TRAINS, SELF, seibu501_head, cargo_subtype){
      0:seibu501_head_timed;      1:sw_seibu501_1_head_gfx;      sw_seibu501_2_head_gfx;
    }
    switch(FEAT_TRAINS, SELF, seibu501_mot, cargo_subtype){
      0:seibu501_mot_timed;      1:seibu501_1_mot_gfx;      seibu501_2_mot;
    }
    switch(FEAT_TRAINS, SELF, seibu501_wag, cargo_subtype){
      0:seibu501_wag_timed;      1:seibu501_1_wag_gfx;      seibu501_2_wag;
    }

  //panto placer
    switch(FEAT_TRAINS, SELF, sw_seibu501_panto_placer_main,position_in_vehid_chain %2){
        0: seibu501_mot;
        seibu501_wag;
    }
  //front end fixer
    GRAPHIC_STACK_2(seibu501_head_light,  seibu501_head, sw_seibu501_lights)
    switch(FEAT_TRAINS, SELF, sw_seibu501_lv,vehicle_type_id){
        mu_car:sw_seibu501_panto_placer_main;
        seibu501_head_light;
    }
//*livery controller
  //lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu501_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_AKADEN)),1968);
      2:string(LV_DATED,string(STR_LIVERY,string(LV_SEIBU_YELLOW)),1976);
    }
//*post fixers
  //capacity
		switch(FEAT_TRAINS, SELF, sw_seibu501_capacity_main,cargo_subtype){
			mu_car: 153;
			141;
		}
  //power fix
    switch(FEAT_TRAINS, SELF, sw_seibu501_car_power_main,position_in_consist %6){
        4..5: return 128;
        return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu501_power_main, vehicle_type_id){
        mu_car: sw_seibu501_car_power_main;
        return 128*2;
    }
