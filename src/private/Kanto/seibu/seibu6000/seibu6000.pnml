  spriteset(seibu6000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(seibu6000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(seibu6000_purchase,  seibu6000_purchase_c1, seibu6000_purchase_c2)
//*livery 1
	spriteset(seibu6000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(seibu6000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_1.png"){ tmpl_std_v3(0, 25) }
	spriteset(seibu6000_1_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_1.png"){ tmpl_std_rev_v3(0, 50) }
	spriteset(seibu6000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_1.png"){ tmpl_symm_v3(0, 75) }
//livery 2

	spriteset(seibu6000_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_2.png"){ tmpl_std_v3(0, 0) }
	spriteset(seibu6000_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_2.png"){ tmpl_std_v3(0, 25) }
