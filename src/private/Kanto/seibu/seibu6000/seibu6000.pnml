//livery 1

	spriteset(seibu6000_3_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_3.png"){ tmpl_std_v3(0, 0) }
	spriteset(seibu6000_3_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_3.png"){ tmpl_std_v3(0, 25) }
	spriteset(seibu6000_3_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_3.png"){ tmpl_std_rev_v3(0, 50) }
	spriteset(seibu6000_3_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/seibu/seibu6000/seibu6000_3.png"){ tmpl_symm_v3(0, 75) }
//
  switch(FEAT_TRAINS, SELF, seibu6000_front_timed, build_year){
    0..2005:seibu6000_1_front;    seibu6000_2_front;
  }
  switch(FEAT_TRAINS, SELF, seibu6000_end_timed, build_year){
    0..2005:seibu6000_1_end;    seibu6000_2_end;
  }
  switch(FEAT_TRAINS, SELF, seibu6000_mot_rev_timed, build_year){
    0..2005:seibu6000_1_mot_rev;    seibu6000_2_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, seibu6000_wag_timed, build_year){
    0..2005:seibu6000_1_wag;    seibu6000_2_wag;
  }

  switch(FEAT_TRAINS, SELF, seibu6000_front, cargo_subtype){
    0:seibu6000_front_timed;   1:seibu6000_1_front;    2:seibu6000_2_front;    seibu6000_3_front;
  }
  switch(FEAT_TRAINS, SELF, seibu6000_end, cargo_subtype){
    0:seibu6000_end_timed;   1:seibu6000_1_end;    2:seibu6000_2_end;    seibu6000_3_end;
  }
  switch(FEAT_TRAINS, SELF, seibu6000_mot_rev, cargo_subtype){
    0:seibu6000_mot_rev_timed;   1:seibu6000_1_mot_rev;    2:seibu6000_2_mot_rev;    seibu6000_3_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, seibu6000_wag, cargo_subtype){
    0:seibu6000_wag_timed;   1:seibu6000_1_wag;    2:seibu6000_2_wag;    seibu6000_3_wag;
  }
//*livery 1
  //panto placer
    //var 1
			switch(FEAT_TRAINS, SELF, sw_seibu6000_panto_placer_main_1,position_in_vehid_chain %3){
				0: seibu6000_mot_rev;
				seibu6000_wag;
			}
		//var 2
			switch(FEAT_TRAINS, SELF, sw_seibu6000_panto_placer_main_2,position_in_vehid_chain %4){
				0: seibu6000_mot_rev;
				seibu6000_wag;
			}
		//var 3
			switch(FEAT_TRAINS, SELF, sw_seibu6000_panto_placer_main_3,position_in_vehid_chain %4){
				1: seibu6000_mot_rev;
				seibu6000_wag;
			}
		//main
			switch(FEAT_TRAINS, SELF, sw_seibu6000_panto_placer_main,num_vehs_in_vehid_chain){
				3:sw_seibu6000_panto_placer_main_3;
				6:sw_seibu6000_panto_placer_main_2;
				9:sw_seibu6000_panto_placer_main_2;
				sw_seibu6000_panto_placer_main_1;
			}
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_seibu6000_head_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1:seibu6000_end;
      seibu6000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_seibu6000_lv,vehicle_type_id){
      mu_car:sw_seibu6000_panto_placer_main;
      sw_seibu6000_head_gfx_main;
    }
//*livery controller
	//lv desc
    switch(FEAT_TRAINS, SELF, sw_seibu6000_lv_desc_main, cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_STEEL),1992);
			2:string(LV_DATED,string(STR_ALUMI),2006);
			3:string(LV_DATED,string(LV_seibu6000_3),2015);
    }
//*post fixers
	//capacity
		switch(FEAT_TRAINS, SELF, sw_seibu6000_capacity_main,vehicle_type_id){
			mu_car: 135;
			145;
		}
	//power
		switch(FEAT_TRAINS, SELF, sw_seibu6000_power_1,date_of_last_service<date(2015,1,1)){
    	1:return 155;
    	return 170;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu6000_car_power_main,position_in_vehid_chain %3){
    	0..1:return sw_seibu6000_power_1;
    	return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_seibu6000_power_main,vehicle_type_id){
			mu_car:sw_seibu6000_car_power_main;
			return 0;
		}
