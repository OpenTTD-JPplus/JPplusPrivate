//*lights
	spriteset(odakyu3000n_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000n/odakyu3000n_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu3000n_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000n/odakyu3000n_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_odakyu3000n_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: odakyu3000n_lights_back;
    odakyu3000n_lights_front;
  }
//*livery 1
	spriteset(odakyu3000n_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000n/odakyu3000n_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu3000n_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000n/odakyu3000n_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(odakyu3000n_head, odakyu3000n_1_head_base, roof_gray_med, sw_odakyu3000n_lights, ac_single_1_1)
	TRAIN_CONSTRUCTOR_3(odakyu3000n_wag, odakyu3000n_1_car_base, roof_gray_med, ac_single_1_1)
	TRAIN_CONSTRUCTOR_4(odakyu3000n_mot, odakyu3000n_1_car_base, roof_gray_med, ac_single_1_1, panto_arm_n_single)
