//*purchase
  spriteset(odakyu3000n_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000n/odakyu3000n_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(odakyu3000n_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000n/odakyu3000n_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(odakyu3000n_purchase, roof_gray_med_c1, odakyu3000n_1_front_base_c1, ac_single_1_c1, roof_gray_med_c2, odakyu3000n_1_car_base_c2, ac_single_1_c2)
//
//*livery 1
	//panto placer
		switch(FEAT_TRAINS, SELF, sw_odakyu3000n_panto_placer_main,position_in_vehid_chain_from_end %9-1){
			0: odakyu3000n_mot;
			2: odakyu3000n_mot;
			4: odakyu3000n_mot;
			7: odakyu3000n_mot;
			odakyu3000n_wag;
		}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_odakyu3000n_lv,vehicle_type_id){
      mu_car:sw_odakyu3000n_panto_placer_main;
      odakyu3000n_head;
    }
//
//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_odakyu3000n_capacity_main,vehicle_type_id){
			mu_car: 155;
			144;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_odakyu3000n_power_main_1,position_in_vehid_chain_from_end %10){
			0..1:return 180;
			3:return 180;
			5:return 180;
			7:return 180;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_odakyu3000n_power_main_2,position_in_vehid_chain_from_end %10){
			0..1:return 190;
			3:return 190;
			5:return 190;
			7:return 190;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_odakyu3000n_car_power_main,build_year){
			0..2002:sw_odakyu3000n_power_main_1;
			sw_odakyu3000n_power_main_2;
		}
		switch(FEAT_TRAINS, SELF, sw_odakyu3000n_power_main,vehicle_type_id){
			mu_car:sw_odakyu3000n_car_power_main;
			0;
		}
