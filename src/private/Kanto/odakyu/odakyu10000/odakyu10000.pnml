//*lights
	spriteset(odakyu10000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu10000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_odakyu10000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: odakyu10000_lights_back;
    odakyu10000_lights_front;
  }
//*livery 1
	spriteset(odakyu10000_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_long(0, 0) }
	spriteset(odakyu10000_wag_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_std_v3(0, 25) }
	spriteset(odakyu10000_wag_1_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_std_7_rev_v3(0, 25) }
	spriteset(odakyu10000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_std_v3(0, 50) }
	spriteset(odakyu10000_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_std_7_rev_v3(0, 50) }
	spriteset(odakyu10000_wag_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_std_v3(0, 75) }
	spriteset(odakyu10000_wag_2_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_std_7_rev_v3(0, 75) }
	spriteset(odakyu10000_wag_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_std_v3(0, 100) }
	spriteset(odakyu10000_wag_3_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_std_7_rev_v3(0, 100) }

  switch(FEAT_TRAINS, SELF, sw_odakyu10000_wag_1, position_in_vehid_chain_from_end<2){
    0: odakyu10000_wag_1_rev;    odakyu10000_wag_1;
  }
  switch(FEAT_TRAINS, SELF, sw_odakyu10000_mot, position_in_vehid_chain_from_end<2){
    0: odakyu10000_mot_rev;    odakyu10000_mot;
  }
  switch(FEAT_TRAINS, SELF, sw_odakyu10000_wag_2, position_in_vehid_chain_from_end<2){
    0: odakyu10000_wag_2;    odakyu10000_wag_2_rev;
  }
  switch(FEAT_TRAINS, SELF, sw_odakyu10000_wag_3, position_in_vehid_chain_from_end<2){
