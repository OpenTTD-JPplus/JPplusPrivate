  spriteset(odakyu10000_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(odakyu10000_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu10000/odakyu10000_1.png"){ tmpl_purchase_2c_dual(0, 75) }
  GRAPHIC_STACK_2(odakyu10000_purchase, odakyu10000_1_front_base_c1, odakyu10000_1_car_base_c2)
