  TRAIN_CONSTRUCTOR_2(sw_odakyu10000_head, odakyu10000_head, sw_odakyu10000_lights)
//*livery 1
	//panto placer
		//1 (11)
			switch(FEAT_TRAINS, SELF, sw_odakyu10000_panto_placer_main,position_in_vehid_chain %8){
				0: sw_odakyu10000_mot;
				1: sw_odakyu10000_wag_2;
				2: sw_odakyu10000_wag_3;
				3: sw_odakyu10000_mot;
				4: sw_odakyu10000_wag_3;
				5: sw_odakyu10000_mot;
				7: sw_odakyu10000_wag_2;
				sw_odakyu10000_wag_1;
			}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_odakyu10000_lv,vehicle_type_id){
			mu_car:sw_odakyu10000_panto_placer_main;
      sw_odakyu10000_head;
    }
//
//post fixers
//capacity-changer
	switch(FEAT_TRAINS, SELF, sw_odakyu10000_car_capacity_main,position_in_vehid_chain%9){
    1:28;
    2:32;
    6:32;
    7:28;
    44;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu10000_capacity_main,vehicle_type_id){
    mu_car: sw_odakyu10000_car_capacity_main;
    default: 46;
	}
//power fix
	switch(FEAT_TRAINS, SELF, sw_odakyu10000_car_power_main,position_in_vehid_chain %9){
    1:return 0;
    7:return 0;
    return 140;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu10000_power_main,vehicle_type_id){
    mu_car:sw_odakyu10000_car_power_main;
    return 140*2;
	}
