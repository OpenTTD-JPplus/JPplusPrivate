  TRAIN_CONSTRUCTOR_2(sw_odakyu30000_head, odakyu30000_head_1, sw_odakyu30000_lights)
//*livery 1
	//panto placer
		//1 (11)
			switch(FEAT_TRAINS, SELF, sw_odakyu30000_panto_placer_main,position_in_vehid_chain %8){
				0: odakyu30000_mot_2;
				1: odakyu30000_mot_1;
				3: odakyu30000_mot_1_rev;
				4: odakyu30000_head_2_rev;
				5: odakyu30000_head_2;
				6: odakyu30000_mot_1;
				7: odakyu30000_mot_2;
				odakyu30000_wag;
			}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_odakyu30000_lv,vehicle_type_id){
			mu_car:sw_odakyu30000_panto_placer_main;
      sw_odakyu30000_head;
    }
    switch(FEAT_TRAINS, SELF, sw_odakyu30000_lv_desc_main, cargo_subtype){
      0: string(LV_RANDOM);
      1: string(LV_DATED,string(STR_LIVERY,"EXE"),1996);
      2: string(LV_DATED,string(STR_LIVERY,"EXEa"),2017);
    }
//
//post fixers
//capacity-changer
	switch(FEAT_TRAINS, SELF, sw_odakyu30000_car_capacity_main,position_in_vehid_chain%8){
    1:56;
    2:68;
    3:58;
    4..5:60;
    6:58;
    7:56;
    60;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu30000_head_capacity_main,position_in_consist==0||position_in_consist_from_end==0){
    1:56;
    60;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu30000_capacity_main,vehicle_type_id){
    mu_car: sw_odakyu30000_car_capacity_main;
    sw_odakyu30000_head_capacity_main;
	}
//power fix
	switch(FEAT_TRAINS, SELF, sw_odakyu30000_exe_car_power_main,position_in_vehid_chain %9){
    0:return 195;
    3:return 195;
    6:return 195;
    7:return 195/2;
    return 0;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu30000_exea_car_power_main,position_in_vehid_chain %6){
    0..1:return 195;
    3:return 195;
    return 0;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu30000_car_power_main,(cargo_subtype==0&&build_year<2017)||cargo_subtype==1){
    1:sw_odakyu30000_exe_car_power_main;
    sw_odakyu30000_exea_car_power_main;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu30000_power_main,vehicle_type_id){
    mu_car:sw_odakyu30000_car_power_main;
    return 0;
	}
