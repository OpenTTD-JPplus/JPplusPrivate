  spriteset(odakyu7000_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu7000/odakyu7000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(odakyu7000_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu7000/odakyu7000_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(odakyu7000_1_purchase, odakyu7000_1_front_base_c1, odakyu7000_1_car_base_c2)
  
  spriteset(odakyu7000_2_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu7000/odakyu7000_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(odakyu7000_2_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu7000/odakyu7000_2.png"){ tmpl_purchase_2c_dual(0, 50) }
