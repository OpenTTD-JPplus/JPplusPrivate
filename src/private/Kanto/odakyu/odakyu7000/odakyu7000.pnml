  TRAIN_CONSTRUCTOR_2(odakyu7000_mot_0, odakyu7000_mot_gfx,sw_odakyu7000_panto)
  TRAIN_CONSTRUCTOR_2(odakyu7000_mot_rev_0, odakyu7000_mot_rev_gfx,sw_odakyu7000_panto_rev)

  switch(FEAT_TRAINS, SELF, odakyu7000_wag_1, position_in_vehid_chain_from_end<num_vehs_in_vehid_chain/2){
    0: odakyu7000_wag_1_gfx;    odakyu7000_wag_1_rev_gfx;
  }
  switch(FEAT_TRAINS, SELF, odakyu7000_mot, position_in_vehid_chain_from_end<num_vehs_in_vehid_chain/2){
    0: odakyu7000_mot_rev_0;    odakyu7000_mot_0;
  }
  switch(FEAT_TRAINS, SELF, odakyu7000_wag_2, position_in_vehid_chain_from_end<num_vehs_in_vehid_chain/2){
    0: odakyu7000_wag_2_gfx;    odakyu7000_wag_2_rev_gfx;
  }
  switch(FEAT_TRAINS, SELF, odakyu7000_wag_3, position_in_vehid_chain_from_end<num_vehs_in_vehid_chain/2){
    0: odakyu7000_wag_3_gfx;    odakyu7000_wag_3_rev_gfx;
