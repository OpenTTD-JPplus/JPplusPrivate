//

  TRAIN_CONSTRUCTOR_2(sw_odakyu7000_head, odakyu7000_head, sw_odakyu7000_lights)
//*livery 1
	//panto placer
		//1 (11)
			switch(FEAT_TRAINS, SELF, sw_odakyu7000_panto_placer_main,position_in_vehid_chain %8){
				0: odakyu7000_mot;
				1: odakyu7000_wag_2;
				2: odakyu7000_wag_3;
				3: odakyu7000_mot;
				5: odakyu7000_mot;
				6: odakyu7000_wag_3;
				7: odakyu7000_wag_2;
				odakyu7000_wag_1;
			}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_odakyu7000_lv,vehicle_type_id){
			mu_car:sw_odakyu7000_panto_placer_main;
      sw_odakyu7000_head;
    }
  //lv desc
		switch(FEAT_TRAINS, SELF, sw_odakyu7000_lv_desc_main,cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1980);
      2:string(LV_DATED,string(STR_LIVERY,string(STR_RENEWAL)),1994);
    }
//
//post fixers
//capacity-changer
	switch(FEAT_TRAINS, SELF, sw_odakyu7000_car_capacity_main,position_in_vehid_chain%9){
    1:30;
    2:36;
    6:36;
    7:32;
    44;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu7000_capacity_main,vehicle_type_id){
    mu_car: sw_odakyu7000_car_capacity_main;
    default: 46;
	}
//power fix
	switch(FEAT_TRAINS, SELF, sw_odakyu7000_car_power_main,position_in_vehid_chain %9){
    1:return 0;
    7:return 0;
    return 140;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu7000_power_main,vehicle_type_id){
    mu_car:sw_odakyu7000_car_power_main;
    return 140*2;
	}
