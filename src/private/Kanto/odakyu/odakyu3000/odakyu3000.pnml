  TRAIN_CONSTRUCTOR_2(sw_odakyu9000_head, odakyu3000_head, sw_odakyu3000_lights)
//*livery 1
	//panto placer
		//1 (10)
			switch(FEAT_TRAINS, SELF, sw_odakyu3000_panto_placer_main_1,position_in_vehid_chain_from_end %7){
				0: odakyu3000_mot_rev;
				5: odakyu3000_mot;
				odakyu3000_wag_1;
			}
			switch(FEAT_TRAINS, SELF, sw_odakyu3000_panto_placer_main_2,position_in_vehid_chain_from_end %4){
				0: odakyu3000_mot_rev;
				2: odakyu3000_mot;
				odakyu3000_wag_1;
			}
		//2 (5)
			switch(FEAT_TRAINS, SELF, sw_odakyu3000_panto_placer_main_3,position_in_vehid_chain_from_end %4){
				0: odakyu3000_mot_rev;
				1: odakyu3000_wag_2;
				2: odakyu3000_mot;
				odakyu3000_wag_1;
			}
		//controller
			switch(FEAT_TRAINS, SELF, sw_odakyu3000_panto_placer_main,num_vehs_in_vehid_chain){
				0..3: sw_odakyu3000_panto_placer_main_3;
        4..5: sw_odakyu3000_panto_placer_main_2;
				sw_odakyu3000_panto_placer_main_1;
			}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_odakyu3000_lv,vehicle_type_id){
			mu_car:sw_odakyu3000_panto_placer_main;
      sw_odakyu9000_head;
    }
  //lv desc
		switch(FEAT_TRAINS, SELF, sw_odakyu3000_lv_desc_main,cargo_subtype){
      0:string(LV_RANDOM);
      1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1957);
      2:string(LV_DATED,string(STR_LIVERY,string(STR_RENEWAL)),1984);
    }
//
//post fixers
//capacity-changer
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_car_capacity_main_8,position_in_vehid_chain%3){
    1:38;
    2..3:44;
    4:38;
    40;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_car_capacity_main_5,position_in_vehid_chain%6){
    0:38;
    1:44;
    44;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_car_capacity_main,num_vehs_in_vehid_chain){
    3:sw_odakyu3000_car_capacity_main_5;
    sw_odakyu3000_car_capacity_main_8;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_capacity_main,vehicle_type_id){
    mu_car: sw_odakyu3000_car_capacity_main;
    default: 52;
	}
//power fix
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_power_main_1,position_in_vehid_chain %8){
    0..5:return 100;
    return 0;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_power_main_2,position_in_vehid_chain %3){
    0..1:return 100;
    return 0;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_car_power_main,num_vehs_in_vehid_chain){
    3:sw_odakyu3000_power_main_2;
    sw_odakyu3000_power_main_1;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_power_main,vehicle_type_id){
    mu_car:sw_odakyu3000_car_power_main;
    return 100*2;
	}
