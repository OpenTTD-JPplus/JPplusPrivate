  spriteset(odakyu3000_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(odakyu3000_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1.png"){ tmpl_purchase_2c_dual_7(0, 50) }
  GRAPHIC_STACK_2(odakyu3000_purchase, odakyu3000_1_front_base_c1, odakyu3000_1_car_base_c2)
//
//*livery 1
	//panto placer
		//1 (10)
			switch(FEAT_TRAINS, SELF, sw_odakyu3000_1_panto_placer_main_1,position_in_vehid_chain_from_end %10-1){
				1: odakyu3000_1_mot;
				2: odakyu3000_1_mot;
				5: odakyu3000_1_mot;
				6: odakyu3000_1_mot;
				7: odakyu3000_1_mot;
				odakyu3000_1_wag;
			}
		//controller
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_odakyu3000_1_end_gfx_main,position_in_vehid_chain_from_end){
			0: odakyu3000_1_end;
			default: sw_odakyu3000_1_panto_placer_main;
		}
		switch(FEAT_TRAINS, SELF, sw_odakyu3000_1_front_gfx_main,position_in_vehid_chain_from_end){
			0: odakyu3000_1_front;
			default: sw_odakyu3000_1_panto_placer_main;
		}
		switch(FEAT_TRAINS, SELF, sw_odakyu3000_lv,vehicle_type_id){
			100..102:sw_odakyu3000_1_end_gfx_main;
						sw_odakyu3000_1_front_gfx_main;
		}
//
//post fixers
//capacity-changer
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_capacity_main,position_in_vehid_chain_from_end){
    0: 144;
    default: 157;
	}
//power fix
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_power_main_1,position_in_vehid_chain_from_end %10){
    1..2:return 175;
    4:return 175;
    6:return 175;
    8:return 175;
    return 0;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_power_main_2,position_in_vehid_chain_from_end %10){
    1..2:return 190;
    4:return 190;
    6:return 190;
    8:return 190;
    return 0;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu3000_power_main,build_year){
		0..2015:sw_odakyu3000_power_main_1;
		sw_odakyu3000_power_main_2;
	}
//
item(FEAT_TRAINS, odakyu3000) {
  property {
      OVERRIDEN_TRAIN_DATA
      
      climates_available: param_disable_odakyu == 0 ? ALL_CLIMATES : NO_CLIMATE;
      name: string(STR_TRAIN_NAME, string(STR_NAME_ODAKYU), "1000", string(STR_NAME_TYPE),);
      introduction_date: date(1957, 7, 6);
      model_life: VEHICLE_NEVER_EXPIRES;
      vehicle_life: 35;
      reliability_decay: 10;

      cost_factor: 22;
      running_cost_factor: 51;
      speed: 120 km/h;
      track_type: TR_1067_DC;
      power: 1 kW;
      weight: 34 ton;
  }
	graphics {
    additional_text:
			string(STR_TRAIN_DESC,
      string(STR_NARROWGAUGE),
      string(STR_DENKI, string(STR_DC, 1500)),
      string(STR_LOAD_SPEED, string(STR_DOORS, 4),),
      string(STR_FORMATION, string(STR_NUM_CARS_4, 4,6,8,10)),
      string(STR_USAGE, string(STR_METRO_ACCESS)),
      string(STR_OPERATOR, string(STR_ODAKYU)));
		// cargo_subtype_text:sw_empty_desc;
		// can_attach_wagon: sw_mucar_attach_vehid;
		purchase: odakyu3000_purchase;
		start_stop: sw_stop_start_3;

    SET_GRAPHICS_DOUBLE(sw_odakyu3000_lv,//graphics
    sw_odakyu3000_capacity_main()*param_capacity_mod/3,//cargo capacity
    sw_odakyu3000_power_main()*4*1342/1000,//power
    param_loading_4D,//loading speed
    sw_empty_desc,//subtype
    mu_car_narrow,32)//car_fallback,weight
}
