//*lights
	spriteset(odakyu3000_1_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu3000_1_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_odakyu3000_1_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: odakyu3000_1_lights_back;
    odakyu3000_1_lights_front;
  }
	spriteset(odakyu3000_2_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_2_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu3000_2_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_2_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_odakyu3000_2_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: odakyu3000_2_lights_back;
    odakyu3000_2_lights_front;
  }

  switch(FEAT_TRAINS, SELF, sw_odakyu3000_lights_0,current_year<1984||cargo_subtype==1){
    1:sw_odakyu3000_1_lights; sw_odakyu3000_2_lights;
  }
  switch(FEAT_TRAINS, SELF, sw_odakyu3000_lights,position_in_consist==0||position_in_consist_from_end==0){
    1:sw_odakyu3000_lights_0; gfx_empty;
  }
//*livery 1
	spriteset(odakyu3000_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu3000_1_wag_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1.png"){ tmpl_std_v3(0, 25) }
	spriteset(odakyu3000_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1.png"){ tmpl_std_v3(0, 50) }
	spriteset(odakyu3000_1_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1.png"){ tmpl_std_7_rev_v3(0, 50) }
	spriteset(odakyu3000_1_wag_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1.png"){ tmpl_std_v3(0, 75) }

	spriteset(odakyu3000_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_2.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu3000_2_wag_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_2.png"){ tmpl_std_v3(0, 25) }
	spriteset(odakyu3000_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_2.png"){ tmpl_std_v3(0, 50) }
	spriteset(odakyu3000_2_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_2.png"){ tmpl_std_7_rev_v3(0, 50) }
	spriteset(odakyu3000_2_wag_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_2.png"){ tmpl_std_v3(0, 75) }

  switch(FEAT_TRAINS, SELF, odakyu3000_head_timed, current_year){
    0..1983:odakyu3000_1_head; odakyu3000_2_head;
  }
  switch(FEAT_TRAINS, SELF, odakyu3000_mot_timed, current_year){
    0..1983:odakyu3000_1_mot; odakyu3000_2_mot;
  }
  switch(FEAT_TRAINS, SELF, odakyu3000_mot_rev_timed, current_year){
    0..1983:odakyu3000_1_mot_rev; odakyu3000_2_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, odakyu3000_wag_1_timed, current_year){
    0..1983:odakyu3000_1_wag_1; odakyu3000_2_wag_1;
  }
  switch(FEAT_TRAINS, SELF, odakyu3000_wag_2_timed, current_year){
    0..1983:odakyu3000_1_wag_2; odakyu3000_2_wag_2;
  }

  switch(FEAT_TRAINS, SELF, odakyu3000_head, cargo_subtype){
    1:odakyu3000_1_head;    2:odakyu3000_2_head;    odakyu3000_head_timed;
  }
  switch(FEAT_TRAINS, SELF, odakyu3000_mot, cargo_subtype){
    1:odakyu3000_1_mot;    2:odakyu3000_2_mot;    odakyu3000_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, odakyu3000_mot_rev, cargo_subtype){
    1:odakyu3000_1_mot_rev;    2:odakyu3000_2_mot_rev;    odakyu3000_mot_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, odakyu3000_wag_1, cargo_subtype){
    1:odakyu3000_1_wag_1;    2:odakyu3000_2_wag_1;    odakyu3000_wag_1_timed;
  }
  switch(FEAT_TRAINS, SELF, odakyu3000_wag_2, cargo_subtype){
    1:odakyu3000_1_wag_2;    2:odakyu3000_2_wag_2;    odakyu3000_wag_2_timed;
  }
