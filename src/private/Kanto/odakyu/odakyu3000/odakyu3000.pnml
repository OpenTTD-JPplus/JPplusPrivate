  spriteset(odakyu3000_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(odakyu3000_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  spriteset(odakyu3000_2_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu3000/odakyu3000_2.png"){ tmpl_purchase_1c_dual(0, 0) }
