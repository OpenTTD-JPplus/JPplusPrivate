//*lights
	spriteset(odakyu20000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu20000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_odakyu20000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: odakyu20000_lights_back;
    odakyu20000_lights_front;
  }
//*livery 1
	spriteset(odakyu20000_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_1.png"){ tmpl_long(0, 0) }
	spriteset(odakyu20000_wag_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_1.png"){ tmpl_std_v3(0, 75) }
	spriteset(odakyu20000_wag_1_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_1.png"){ tmpl_std_rev_v3(0, 75) }
	spriteset(odakyu20000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_1.png"){ tmpl_std_v3(0, 50) }
	spriteset(odakyu20000_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_1.png"){ tmpl_std_rev_v3(0, 50) }
	spriteset(odakyu20000_wag_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_1.png"){ tmpl_std_v3(0, 25) }
	spriteset(odakyu20000_wag_2_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_1.png"){ tmpl_std_rev_v3(0, 25) }

  switch(FEAT_TRAINS, SELF, sw_odakyu20000_wag_1, position_in_vehid_chain_from_end<2){
    0: odakyu20000_wag_1;    odakyu20000_wag_1_rev;
  }
  switch(FEAT_TRAINS, SELF, sw_odakyu20000_mot, position_in_vehid_chain_from_end<2){
    0: odakyu20000_mot;    odakyu20000_mot_rev;
  }
