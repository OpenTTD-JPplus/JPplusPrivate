//*purchase
  spriteset(odakyu20000_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(odakyu20000_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu20000/odakyu20000_1.png"){ tmpl_purchase_2c_dual(0, 75) }
  GRAPHIC_STACK_2(odakyu20000_purchase, odakyu20000_1_front_base_c1, odakyu20000_1_car_base_c2)
//

  TRAIN_CONSTRUCTOR_2(sw_odakyu20000_head, odakyu20000_head, sw_odakyu20000_lights)
//*livery 1
	//panto placer
		//1 (11)
			switch(FEAT_TRAINS, SELF, sw_odakyu20000_panto_placer_main,position_in_vehid_chain %5){
				0: sw_odakyu20000_mot;
				1: odakyu20000_wag_2;
				2: odakyu20000_wag_2_rev;
				4: sw_odakyu20000_mot;
				sw_odakyu20000_wag_1;
			}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_odakyu20000_lv,vehicle_type_id){
			mu_car:sw_odakyu20000_panto_placer_main;
      sw_odakyu20000_head;
    }
//
//post fixers
//capacity-changer
	switch(FEAT_TRAINS, SELF, sw_odakyu20000_car_capacity_main,position_in_vehid_chain%5){
    1:50;
    2:44;
    3:68;
    60;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu20000_capacity_main,vehicle_type_id){
    mu_car: sw_odakyu20000_car_capacity_main;
    default: 60;
	}
//power fix
	switch(FEAT_TRAINS, SELF, sw_odakyu20000_car_power_main,position_in_vehid_chain %9){
    1..2:return 0;
    4:return 0;
    return 140;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu20000_power_main,vehicle_type_id){
    mu_car:sw_odakyu20000_car_power_main;
    return 140*2;
	}
