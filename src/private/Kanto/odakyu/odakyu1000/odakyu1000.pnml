//*lights
	spriteset(odakyu1000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu1000/odakyu1000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu1000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu1000/odakyu1000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_odakyu1000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: odakyu1000_lights_back;
    odakyu1000_lights_front;
  }
//*livery 1
	spriteset(odakyu1000_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu1000/odakyu1000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu1000_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu1000/odakyu1000_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(odakyu1000_head, odakyu1000_1_head_base, roof_gray_med, sw_odakyu1000_lights, ac_double_1_1)
	TRAIN_CONSTRUCTOR_4(odakyu1000_mot, odakyu1000_1_car_base, roof_gray_med, ac_double_1_6, panto_arm_n_single_rev)
	TRAIN_CONSTRUCTOR_3(odakyu1000_wag, odakyu1000_1_car_base, roof_gray_med, ac_double_1_1)
