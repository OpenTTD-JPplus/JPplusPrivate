//post fixers
//capacity-changer
	switch(FEAT_TRAINS, SELF, sw_odakyu3100_car_capacity_main,position_in_vehid_chain%5){
    1..2:36;
    44;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu3100_capacity_main,vehicle_type_id){
    mu_car: sw_odakyu3100_car_capacity_main;
    default: 50;
	}
//power fix
	switch(FEAT_TRAINS, SELF, sw_odakyu3100_car_power_main,position_in_vehid_chain %11){
    0..9:return 110;
    return 0;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu3100_power_main,vehicle_type_id){
    mu_car:sw_odakyu3100_car_power_main;
    return 110*2;
	}
