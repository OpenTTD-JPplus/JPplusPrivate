  TRAIN_CONSTRUCTOR_3(sw_odakyu3100_head, odakyu3100_head, sw_odakyu3100_lights, odakyu3100_head_ac)
//*livery 1
	//panto placer
		//1 (11)
			switch(FEAT_TRAINS, SELF, sw_odakyu3100_panto_placer_main,position_in_vehid_chain %8){
				0: odakyu3100_mot;
				1: odakyu3100_wag_2;
				2: odakyu3100_wag_3;
				3: odakyu3100_mot_rev;
				5: odakyu3100_mot_rev;
				6: odakyu3100_wag_3;
				7: odakyu3100_wag_2;
				odakyu3100_wag_1;
			}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_odakyu3100_lv,vehicle_type_id){
			mu_car:sw_odakyu3100_panto_placer_main;
      sw_odakyu3100_head;
    }
