//panto logic
//*lights
	spriteset(odakyu9000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu9000/odakyu9000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu9000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu9000/odakyu9000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_odakyu9000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: odakyu9000_lights_back;
    odakyu9000_lights_front;
  }
//*livery 1
	spriteset(odakyu9000_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu9000/odakyu9000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu9000_end_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu9000/odakyu9000_1.png"){ tmpl_std_rev_v3(0, 0) }
	spriteset(odakyu9000_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu9000/odakyu9000_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(odakyu9000_head, odakyu9000_head_base, roof_gray_med, sw_odakyu9000_lights, ac_odakyu_wag)
	TRAIN_CONSTRUCTOR_5(odakyu9000_head_mot, odakyu9000_head_base, roof_gray_med, sw_odakyu9000_lights, ac_odakyu_1, panto_odakyu_d)
	TRAIN_CONSTRUCTOR_4(odakyu9000_mot, odakyu9000_car_base, roof_gray_med, ac_odakyu_1, panto_odakyu_d)
	TRAIN_CONSTRUCTOR_4(odakyu9000_mot_rev, odakyu9000_car_base, roof_gray_med, ac_odakyu_2, panto_odakyu_d_rev)
	TRAIN_CONSTRUCTOR_3(odakyu9000_wag, odakyu9000_car_base, roof_gray_med, ac_odakyu_wag)
//
//*purchase
  spriteset(odakyu9000_head_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu9000/odakyu9000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(odakyu9000_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu9000/odakyu9000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_7(odakyu9000_purchase, roof_gray_med_c1, odakyu9000_head_base_c1, ac_odakyu_c1, panto_odakyu_c1, roof_gray_med_c2, odakyu9000_car_base_c2, ac_odakyu_c2)
//
//*livery 1
  //head gfx
    switch(FEAT_TRAINS, SELF, sw_odakyu9000_head_gfx,(num_vehs_in_vehid_chain==num_vehs_in_consist)||(position_in_consist!=0&&position_in_consist_from_end!=0)||position_in_consist==0){
				1: odakyu9000_head_mot;
			  odakyu9000_head;
			}
    switch(FEAT_TRAINS, SELF, sw_odakyu9000_end_gfx,(num_vehs_in_vehid_chain==num_vehs_in_consist)||(position_in_consist!=0&&position_in_consist_from_end!=0)){
				1: odakyu9000_head_mot;
				odakyu9000_head;
			}
	//panto placer
		//1
			switch(FEAT_TRAINS, SELF, sw_odakyu9000_panto_placer_main_1,position_in_vehid_chain %5){
				0: odakyu9000_mot;
				3: odakyu9000_mot_rev;
				odakyu9000_wag;
			}
		//2
			switch(FEAT_TRAINS, SELF, sw_odakyu9000_panto_placer_main_2,position_in_vehid_chain %2){
				1: odakyu9000_mot;
				odakyu9000_wag;
			}
		//controller
			switch(FEAT_TRAINS, SELF, sw_odakyu9000_panto_placer_main,num_vehs_in_vehid_chain){
			  2..3: sw_odakyu9000_panto_placer_main_2;
				8: sw_odakyu9000_panto_placer_main_2;
				sw_odakyu9000_panto_placer_main_1;
			}
	//front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_odakyu9000_head_gfx_main, position_in_vehid_chain){
      0:sw_odakyu9000_head_gfx;
      sw_odakyu9000_end_gfx;
    }
		switch(FEAT_TRAINS, SELF, sw_odakyu9000_lv,vehicle_type_id){
      mu_car:sw_odakyu9000_panto_placer_main;
      sw_odakyu9000_head_gfx_main;
    }
//
//post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_odakyu9000_capacity_main,vehicle_type_id){
			mu_car:144;
			136;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_odakyu9000_car_power_main,position_in_vehid_chain_from_end %4){
			0..1:return 140;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_odakyu9000_power_main,vehicle_type_id){
			mu_car:sw_odakyu9000_car_power_main;
			return 140*2;
		}
