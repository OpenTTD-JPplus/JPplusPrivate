#include "odakyu9000/odakyu9000.pnml"

item(FEAT_TRAINS, odakyu9000) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_odakyu == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_ODAKYU), "9000", string(STR_NAME_TYPE),);
    introduction_date: date(1972, 2, 1);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;
    
    cost_factor: 21;
    running_cost_factor: 51;
    speed: 120 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 38 ton;
    badges: ["company/odakyu"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 4,6)),
    string(STR_USAGE, string(STR_ACCESS_COMMUTER)),
    string(STR_OPERATOR, string(STR_ODAKYU))
    
    );
    
    purchase: odakyu9000_purchase;
    cargo_capacity:sw_odakyu9000_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_4D;
    default:sw_odakyu9000_lv;
    power:sw_odakyu9000_power_main()*4*1342/1000;
    purchase_power: sw_odakyu9000_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_odakyu9000_capacity_main()*param_capacity_mod/3;
    power:sw_odakyu9000_power_main()*4*1342/1000;
    default:sw_odakyu9000_lv;
    weight: 35;
    
  }
}
