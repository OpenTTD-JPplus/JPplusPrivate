//*livery 1
	//panto placer
		//1
			switch(FEAT_TRAINS, SELF, sw_odakyu2000n_panto_placer_main_1,position_in_vehid_chain %6){
				0: odakyu2000n_mot;
				1: odakyu2000n_mot;
				4: odakyu2000n_mot;
				odakyu2000n_wag;
			}
		//2
			switch(FEAT_TRAINS, SELF, sw_odakyu2000n_panto_placer_main_2,position_in_vehid_chain %2){
				0: odakyu2000n_mot;
				odakyu2000n_wag;
			}
		//controller
			switch(FEAT_TRAINS, SELF, sw_odakyu2000n_panto_placer_main,num_vehs_in_vehid_chain){
				2: sw_odakyu2000n_panto_placer_main_1;
				5..6: sw_odakyu2000n_panto_placer_main_1;
				8: sw_odakyu2000n_panto_placer_main_1;
				sw_odakyu2000n_panto_placer_main_2;
			}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_odakyu2000n_lv,vehicle_type_id){
      mu_car:sw_odakyu2000n_panto_placer_main;
      odakyu2000n_head;
    }
//
//post fixers
//capacity-changer
	switch(FEAT_TRAINS, SELF, sw_odakyu2000n_capacity_main,vehicle_type_id){
    mu_car: 158;
    146;
	}
//power fix
	switch(FEAT_TRAINS, SELF, sw_odakyu2000n_car_power_main,position_in_vehid_chain %4){
    0..1:return 190;
    return 0;
	}
	switch(FEAT_TRAINS, SELF, sw_odakyu2000n_power_main,vehicle_type_id){
    mu_car:sw_odakyu2000n_car_power_main;
    return 0;
	}
