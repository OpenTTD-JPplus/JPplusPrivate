	spriteset(odakyu2000n_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu2000n/odakyu2000n_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu2000n_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu2000n/odakyu2000n_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(odakyu2000n_head, odakyu2000n_1_head_base, roof_gray_med, sw_odakyu2000n_lights, ac_double_1_3)
	TRAIN_CONSTRUCTOR_4(odakyu2000n_mot, odakyu2000n_1_car_base, roof_gray_med, ac_double_1_6, panto_arm_n_single_rev)
	TRAIN_CONSTRUCTOR_3(odakyu2000n_wag, odakyu2000n_1_car_base, roof_gray_med, ac_double_1_1)
