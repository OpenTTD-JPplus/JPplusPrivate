//*lights
	spriteset(odakyu2000n_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu2000n/odakyu2000n_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(odakyu2000n_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu2000n/odakyu2000n_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_odakyu2000n_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: odakyu2000n_lights_back;
    odakyu2000n_lights_front;
  }
