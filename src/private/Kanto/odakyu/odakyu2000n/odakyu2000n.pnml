//*purchase
  spriteset(odakyu2000n_1_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu2000n/odakyu2000n_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(odakyu2000n_1_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/odakyu/odakyu2000n/odakyu2000n_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(odakyu2000n_purchase, roof_gray_med_c1, odakyu2000n_1_front_base_c1, ac_double_1_c1, roof_gray_med_c2, odakyu2000n_1_car_base_c2, ac_double_1_c2)
