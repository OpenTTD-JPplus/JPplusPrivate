//purchase
  spriteset(keisei3500_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3500/keisei3500_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei3500_purchase_c2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3500/keisei3500_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(keisei3500_purchase_1, keisei3500_purchase_c1_1, keisei3500_purchase_c2_1)
  spriteset(keisei3500_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3500/keisei3500_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei3500_purchase_c2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3500/keisei3500_2.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(keisei3500_purchase_2, keisei3500_purchase_c1_2, keisei3500_purchase_c2_2)

  switch(FEAT_TRAINS, SELF, keisei3500_purchase, current_year){
    0..1991: keisei3500_purchase_1;
    keisei3500_purchase_2;
  }
