  switch(FEAT_TRAINS, SELF, keisei3500_front_timed, current_year){
    0..1991:keisei3500_1_front;      1992..1995:keisei3500_2_front;      keisei3500_3_front;
  }
  switch(FEAT_TRAINS, SELF, keisei3500_end_timed, current_year){
    0..1991:keisei3500_1_end;      1992..1995:keisei3500_2_end;      keisei3500_3_end;
  }
  switch(FEAT_TRAINS, SELF, keisei3500_end_rev_timed, current_year){
    0..1991:keisei3500_1_end_rev;      1992..1995:keisei3500_2_end_rev;      keisei3500_3_end_rev;
  }
  switch(FEAT_TRAINS, SELF, keisei3500_mot_timed, current_year){
    0..1991:keisei3500_1_mot;      1992..1995:keisei3500_2_mot;      keisei3500_3_mot;
  }
  switch(FEAT_TRAINS, SELF, keisei3500_mot_rev_timed, current_year){
    0..1991:keisei3500_1_mot_rev;      1992..1995:keisei3500_2_mot_rev;      keisei3500_3_mot_rev;
  }

  switch(FEAT_TRAINS, SELF, keisei3500_front, cargo_subtype){
    0:keisei3500_front_timed;    1:keisei3500_1_front;
    2:keisei3500_2_front;    keisei3500_3_front;
  }
  switch(FEAT_TRAINS, SELF, keisei3500_end, cargo_subtype){
    0:keisei3500_end_timed;    1:keisei3500_1_end;
    2:keisei3500_2_end;    keisei3500_3_end;
  }
  switch(FEAT_TRAINS, SELF, keisei3500_end_rev, cargo_subtype){
    0:keisei3500_end_rev_timed;    1:keisei3500_1_end_rev;
    2:keisei3500_2_end_rev;    keisei3500_3_end_rev;
  }
  switch(FEAT_TRAINS, SELF, keisei3500_mot, cargo_subtype){
    0:keisei3500_mot_timed;    1:keisei3500_1_mot;
    2:keisei3500_2_mot;    keisei3500_3_mot;
  }
  switch(FEAT_TRAINS, SELF, keisei3500_mot_rev, cargo_subtype){
    0:keisei3500_mot_rev_timed;    1:keisei3500_1_mot_rev;
    2:keisei3500_2_mot_rev;    keisei3500_3_mot_rev;
  }
//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei3500_panto_placer_main,position_in_vehid_chain %2){
        0: keisei3500_mot_rev;
        keisei3500_mot;
      }
  //fake-head-placer
    //var 1 4+4
      switch(FEAT_TRAINS, SELF, sw_keisei3500_fake_head_placer_1,position_in_vehid_chain){
        2: keisei3500_end_rev;
        3: keisei3500_end;
        sw_keisei3500_panto_placer_main;
      }
    //2+4+2 / 2+4
      switch(FEAT_TRAINS, SELF, sw_keisei3500_fake_head_placer_2,position_in_vehid_chain){
        1: keisei3500_end;
        4: keisei3500_end_rev;
        sw_keisei3500_panto_placer_main;
      }
    //4+2
      switch(FEAT_TRAINS, SELF, sw_keisei3500_fake_head_placer_3,position_in_vehid_chain){
        2: keisei3500_end_rev;
        sw_keisei3500_panto_placer_main;
      }
      random_switch(FEAT_TRAINS, PARENT, sw_keisei3500_fake_head_placer_8c){
        2: sw_keisei3500_fake_head_placer_1;
        1: sw_keisei3500_fake_head_placer_2;
      }
      random_switch(FEAT_TRAINS, PARENT, sw_keisei3500_fake_head_placer_6c){
        1: sw_keisei3500_fake_head_placer_2;
        1: sw_keisei3500_fake_head_placer_3;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei3500_fake_head_placer_main,num_vehs_in_vehid_chain){
        0..3: sw_keisei3500_panto_placer_main;
        4:sw_keisei3500_fake_head_placer_6c;
        sw_keisei3500_fake_head_placer_8c;
      }
  switch(FEAT_TRAINS, SELF, sw_keisei3500_head, train_is_driving_backwards != vehicle_is_flipped){
    1: keisei3500_end;
    keisei3500_front;
  }
  switch(FEAT_TRAINS, SELF, sw_keisei3500_lv,vehicle_type_id){
    mu_car: sw_keisei3500_fake_head_placer_main;
    sw_keisei3500_head;
  }
//
//*liveries
  switch(FEAT_TRAINS, SELF, sw_keisei3500_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1972);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_MODERN)),1992);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_RENEW)),1996);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keisei3500_capacity_main,vehicle_type_id){
      mu_car: 133;
      122;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei3500_car_power_main,position_in_vehid_chain_from_end %6){
      0..3:return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei3500_power_main,vehicle_type_id){
      mu_car: sw_keisei3500_car_power_main;
      default: 100*2;
    }
