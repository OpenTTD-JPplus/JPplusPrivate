  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei600_car_power_main,position_in_vehid_chain %2){
      0:return 110;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei600_power_main,vehicle_type_id){
      mu_car:sw_keisei600_car_power_main;
      return 110;
    }
