  switch(FEAT_TRAINS, SELF, keisei600_head_timed, current_year){
    0..1950:keisei600_1_head;    1951..1953:keisei600_2_head;
    1954..1960:keisei600_3_head;    keisei600_4_head;
  }
  switch(FEAT_TRAINS, SELF, keisei600_head, cargo_subtype){
    0:keisei600_head_timed;    1:keisei600_1_head;    2:keisei600_2_head;
    3:keisei600_3_head;    keisei600_4_head;
  }

  switch(FEAT_TRAINS, SELF, keisei600_head_rev_timed, current_year){
    0..1950:keisei600_1_head_rev;    1951..1953:keisei600_2_head_rev;
    1954..1960:keisei600_3_head_rev;    keisei600_4_head_rev;
  }
  switch(FEAT_TRAINS, SELF, keisei600_head_rev, cargo_subtype){
    0:keisei600_head_rev_timed;    1:keisei600_1_head_rev;    2:keisei600_2_head_rev;
    3:keisei600_3_head_rev;    keisei600_4_head_rev;
  }
  TRAIN_CONSTRUCTOR_3(keisei600_head_mot,  keisei600_head,sw_keisei600_lights, panto_d_arm_single)
  TRAIN_CONSTRUCTOR_2(sw_keisei600_head,  keisei600_head,sw_keisei600_lights)
  TRAIN_CONSTRUCTOR_2(keisei600_mot,  keisei600_head,  panto_d_arm_single)
//*livery 1
  //panto
    switch(FEAT_TRAINS, PARENT, sw_keisei600_panto_placer_main,position_in_vehid_chain %2){
      0: keisei600_head_rev;
      keisei600_mot;
    }
	//main
    switch(FEAT_TRAINS, SELF, sw_keisei33_head_gfx,vehicle_is_flipped){
      1: sw_keisei600_head;
      keisei600_head_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei600_lv,vehicle_type_id){
      mu_car: sw_keisei600_panto_placer_main;
      sw_keisei33_head_gfx;
    }
//

//liveries
  switch(FEAT_TRAINS, SELF, sw_keisei600_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_BLUE)),1948);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_EXPRESS)),1950);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AODEN)),1951);
    4:string(LV_DATED,string(STR_LIVERY,string(LV_MODERN)),1954);
  }

