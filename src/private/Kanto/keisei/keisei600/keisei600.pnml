//purchase
  spriteset(keisei600_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei600/keisei600_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei600_purchase_c2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei600/keisei600_1.png"){ tmpl_purchase_2c_dual(0, 0) }
  GRAPHIC_STACK_2(keisei600_purchase_1, keisei600_purchase_c1_1, keisei600_purchase_c2_1)
  spriteset(keisei600_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei600/keisei600_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei600_purchase_c2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei600/keisei600_2.png"){ tmpl_purchase_2c_dual(0, 0) }
  GRAPHIC_STACK_2(keisei600_purchase_2, keisei600_purchase_c1_2, keisei600_purchase_c2_2)
  spriteset(keisei600_purchase_c1_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei600/keisei600_3.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei600_purchase_c2_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei600/keisei600_3.png"){ tmpl_purchase_2c_dual(0, 0) }
  GRAPHIC_STACK_2(keisei600_purchase_3, keisei600_purchase_c1_3, keisei600_purchase_c2_3)
  spriteset(keisei600_purchase_c1_4, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei600/keisei600_4.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei600_purchase_c2_4, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei600/keisei600_4.png"){ tmpl_purchase_2c_dual(0, 0) }
  GRAPHIC_STACK_2(keisei600_purchase_4, keisei600_purchase_c1_4, keisei600_purchase_c2_4)

  switch(FEAT_TRAINS, SELF, keisei600_purchase,current_year){
    0..1950:keisei600_purchase_1;
    1951..1953:keisei600_purchase_2;
    1954..1960:keisei600_purchase_3;
    keisei600_purchase_4;
  }
//*main
  spriteset(keisei600_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei600/keisei600_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(keisei600_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei600/keisei600_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei600_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keisei600_lights_end;
    keisei600_lights_front;
  }

