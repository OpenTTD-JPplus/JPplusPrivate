//purchase
  spriteset(keisei700_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei700/keisei700.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei700_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei700/keisei700.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(keisei700_purchase, keisei700_purchase_c1, keisei700_purchase_c2)
//*main
  spriteset(keisei700_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei700/keisei700_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(keisei700_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei700/keisei700_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei700_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: gfx_empty;
    keisei700_lights_front;
  }
spriteset (keisei700_head_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei700/keisei700.png") { tmpl_std_v3(0, 0) }
spriteset (keisei700_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei700/keisei700.png") { tmpl_std_v3(0, 25) }
spriteset (keisei700_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei700/keisei700.png") { tmpl_std_rev_v3(0, 25) }
spriteset (keisei700_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei700/keisei700.png") { tmpl_symm_v3(0, 50) }
spriteset (keisei700_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei700/keisei700.png") { tmpl_std_v3(0, 75) }
spriteset (keisei700_wag_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei700/keisei700.png") { tmpl_symm_v3(0, 100) }

//*livery 1
  //special gfx
    switch(FEAT_TRAINS, SELF, sw_keisei700_head_gfx,position_in_vehid_chain==1){
      1: keisei700_head;
      keisei700_head_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei700_wag_gfx,current_year<1967||cargo_subtype==1){
      1: keisei700_wag;
      keisei700_wag_2;
    }
  //panto
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei700_panto_placer_1,position_in_vehid_chain %4){
      0:keisei700_head_rev;
      1:keisei700_head;
      2:keisei700_head_rev;
      keisei700_head_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei700_panto_placer_2,position_in_vehid_chain %4){
      1: keisei700_mot_2;
      2: keisei700_head_rev;
      3: keisei700_head_mot;
      keisei700_wag_2;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei700_panto_placer_timed, current_year){
      0..1966:sw_keisei700_panto_placer_2;
      sw_keisei700_panto_placer_1;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei700_panto_placer_main_1, cargo_subtype){
      0:sw_keisei700_panto_placer_timed;
      1:sw_keisei700_panto_placer_1;
      2:sw_keisei700_panto_placer_2;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei700_panto_placer_main, num_vehs_in_vehid_chain<2){
      1:sw_keisei700_wag_gfx;
      sw_keisei700_panto_placer_main_1;
    }
	//main
    TRAIN_CONSTRUCTOR_2(keisei700_head_gfx,  sw_keisei700_head_gfx,  sw_keisei700_lights)
    switch(FEAT_TRAINS, SELF, sw_keisei700_lv,vehicle_type_id){
      mu_car: sw_keisei700_panto_placer_main;
      keisei700_head_gfx;
    }
//
//liveries
  switch(FEAT_TRAINS, SELF, sw_keisei700_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AODEN)),1954);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_keisei700_2)),1967);
  }
