spriteset(keisei3600_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3600/keisei3600_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(keisei3600_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3600/keisei3600_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei3600_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keisei3600_lights_back;
    keisei3600_lights_front;
  }
spriteset (keisei3600_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3600/keisei3600_1.png") { tmpl_std_v3(0, 25) }
spriteset (keisei3600_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3600/keisei3600_1.png") { tmpl_std_rev_v3(0, 50) }
spriteset (keisei3600_1_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3600/keisei3600_1.png") { tmpl_symm_v3(0, 75) }
spriteset (keisei3600_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3600/keisei3600_1.png") { tmpl_symm_v3(0, 100) }

spriteset (keisei3600_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3600/keisei3600_2.png") { tmpl_std_v3(0, 25) }
spriteset (keisei3600_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3600/keisei3600_2.png") { tmpl_std_rev_v3(0, 50) }
spriteset (keisei3600_2_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3600/keisei3600_2.png") { tmpl_symm_v3(0, 75) }
spriteset (keisei3600_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3600/keisei3600_2.png") { tmpl_symm_v3(0, 100) }

switch(FEAT_TRAINS, SELF, keisei3600_head_timed, current_year){
  0..1992:keisei3600_1_head;  keisei3600_2_head;
}
switch(FEAT_TRAINS, SELF, keisei3600_mot_timed, current_year){
  0..1992:keisei3600_1_mot;  keisei3600_2_mot;
}
switch(FEAT_TRAINS, SELF, keisei3600_mot_2_timed, current_year){
  0..1992:keisei3600_1_mot_2;  keisei3600_2_mot_2;
}
switch(FEAT_TRAINS, SELF, keisei3600_wag_timed, current_year){
  0..1992:keisei3600_1_wag;  keisei3600_2_wag;
}

switch(FEAT_TRAINS, SELF, keisei3600_head, cargo_subtype){
  0:keisei3600_head_timed;  1:keisei3600_1_head;  keisei3600_2_head;
}
switch(FEAT_TRAINS, SELF, keisei3600_mot, cargo_subtype){
  0:keisei3600_mot_timed;  1:keisei3600_1_mot;  keisei3600_2_mot;
}
switch(FEAT_TRAINS, SELF, keisei3600_mot_2, cargo_subtype){
  0:keisei3600_mot_2_timed;  1:keisei3600_1_mot_2;  keisei3600_2_mot_2;
}
switch(FEAT_TRAINS, SELF, keisei3600_wag, cargo_subtype){
  0:keisei3600_wag_timed;  1:keisei3600_1_wag;  keisei3600_2_wag;
}

//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei3600_panto_placer_main_1,position_in_vehid_chain_from_end %2){
        0: keisei3600_mot_2;
        keisei3600_wag;
      }
    //var 3
      switch(FEAT_TRAINS, SELF, sw_keisei3600_panto_placer_main_2,position_in_vehid_chain_from_end %6){
        0: keisei3600_mot_2;
        2: keisei3600_mot;
        4: keisei3600_mot_2;
        default: keisei3600_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei3600_panto_placer_main,num_vehs_in_vehid_chain){
        0..4:sw_keisei3600_panto_placer_main_1;
        sw_keisei3600_panto_placer_main_2;
      }
    //
    TRAIN_CONSTRUCTOR_2(keisei3600_head_gfx, keisei3600_head, sw_keisei3600_lights)
    switch(FEAT_TRAINS, SELF, sw_keisei3600_lv,vehicle_type_id){
      mu_car: sw_keisei3600_panto_placer_main;
      keisei3600_head_gfx;
    }
//*liveries
  switch(FEAT_TRAINS, SELF, sw_keisei3600_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1982);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_MODERN)),1992);
  }
//post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei3600_car_power_main,position_in_vehid_chain_from_end %8){
      0..5:return 130;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei3600_power_main,vehicle_type_id){
      mu_car:sw_keisei3600_car_power_main;
      return 0;
    }
