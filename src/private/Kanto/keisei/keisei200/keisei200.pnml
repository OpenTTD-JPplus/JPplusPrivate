//purchase
  spriteset(keisei200_purchase_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei200/keisei200_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei200_purchase_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei200/keisei200_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei200_purchase_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei200/keisei200_3.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei200_purchase_4, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei200/keisei200_4.png"){ tmpl_purchase_1c_dual(0, 0) }

  switch(FEAT_TRAINS, SELF, keisei200_purchase,current_year){
    0..1940:keisei200_purchase_1;
    1941..1945:keisei200_purchase_2;
    1946..1949:keisei200_purchase_3;
    keisei200_purchase_4;
  }
