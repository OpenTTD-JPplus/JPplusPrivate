  //panto
	  switch(FEAT_TRAINS, SELF, sw_keisei200_panto_placer_main,position_in_vehid_chain %2){
      0: keisei200_head_rev;
      keisei200_head;
    }
	//main
    TRAIN_CONSTRUCTOR_2(sw_keisei200_head_gfx,  keisei200_head,  sw_keisei200_lights)
    switch(FEAT_TRAINS, SELF, sw_keisei200_lv,vehicle_type_id){
      mu_car:sw_keisei200_panto_placer_main;
      sw_keisei200_head_gfx;
    }
