//lv stuff
  switch(FEAT_TRAINS, SELF, keisei200_front_timed, current_year){
    0..1940:keisei200_1_front;
    1941..1945:keisei200_2_front;
    1946..1949:keisei200_3_front;
    keisei200_4_front;
  }
  switch(FEAT_TRAINS, SELF, keisei200_end_timed, current_year){
    0..1940:keisei200_1_end;
    1941..1945:keisei200_2_end;
    1946..1949:keisei200_3_end;
    keisei200_4_end;
  }
  switch(FEAT_TRAINS, SELF, keisei200_end_rev_timed, current_year){
    0..1940:keisei200_1_end_rev;
    1941..1945:keisei200_2_end_rev;
    1946..1949:keisei200_3_end_rev;
    keisei200_4_end_rev;
  }

  switch(FEAT_TRAINS, SELF, keisei200_front, cargo_subtype){
    1:keisei200_1_front;    2:keisei200_2_front;
    3:keisei200_3_front;    4:keisei200_4_front;
    keisei200_front_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei200_end, cargo_subtype){
    1:keisei200_1_end;    2:keisei200_2_end;
    3:keisei200_3_end;    4:keisei200_4_end;
    keisei200_end_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei200_end_rev, cargo_subtype){
    1:keisei200_1_end_rev;    2:keisei200_2_end_rev;
    3:keisei200_3_end_rev;    4:keisei200_4_end_rev;
    keisei200_end_rev_timed;
  }
//
//*main
  //panto
	  switch(FEAT_TRAINS, SELF, sw_keisei200_panto_placer_1,position_in_vehid_chain %2){
      0: keisei200_end;
      keisei200_end_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei200_panto_placer_1_rev,position_in_vehid_chain_from_end %2){
      0: keisei200_end_rev;
      keisei200_end;
    }
    switch(FEAT_TRAINS, PARENT, sw_keisei200_panto_placer_main,vehicle_is_reversed){
      1: sw_keisei200_panto_placer_1_rev;
      sw_keisei200_panto_placer_1;
    }
	//main
    switch(FEAT_TRAINS, SELF, sw_keisei200_head_gfx_main,position_in_consist>0){
      1:keisei200_end_rev;
      keisei200_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei200_lv,vehicle_type_id){
      mu_car:sw_keisei200_panto_placer_main;
      sw_keisei200_head_gfx_main;
    }
//
//liveries
  switch(FEAT_TRAINS, SELF, sw_keisei200_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_GREEN),1931));
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_WAR),1941));
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_BLUE),1946));
    4:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AODEN),1950));
  }