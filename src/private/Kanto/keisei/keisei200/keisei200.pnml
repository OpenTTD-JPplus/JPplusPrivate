//lv stuff
  switch(FEAT_TRAINS, SELF, keisei200_head_timed, current_year){
    0..1940:keisei200_1_head;
    1941..1945:keisei200_2_head;
    1946..1949:keisei200_3_head;
    keisei200_4_head;
  }
  switch(FEAT_TRAINS, SELF, keisei200_head_rev_timed, current_year){
    0..1940:keisei200_1_head_rev;
    1941..1945:keisei200_2_head_rev;
    1946..1949:keisei200_3_head_rev;
    keisei200_4_head_rev;
  }

  switch(FEAT_TRAINS, SELF, keisei200_head, cargo_subtype){
    1:keisei200_1_head;    2:keisei200_2_head;
    3:keisei200_3_head;    4:keisei200_4_head;
    keisei200_head_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei200_head_rev, cargo_subtype){
    1:keisei200_1_head_rev;    2:keisei200_2_head_rev;
    3:keisei200_3_head_rev;    4:keisei200_4_head_rev;
    keisei200_head_rev_timed;
  }
