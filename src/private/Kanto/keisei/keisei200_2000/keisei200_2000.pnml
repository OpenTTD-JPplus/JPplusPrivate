//purchase
  spriteset(keisei200_2000_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei200_2000_purchase_c2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(keisei200_2000_purchase_1, keisei200_2000_purchase_c1_1, keisei200_2000_purchase_c2_1)
  spriteset(keisei200_2000_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei200_2000_purchase_c2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(keisei200_2000_purchase_2, keisei200_2000_purchase_c1_2, keisei200_2000_purchase_c2_2)

  switch(FEAT_TRAINS, SELF, keisei200_2000_purchase, current_year){
    0..1979:keisei200_2000_purchase_1;
    keisei200_2000_purchase_2;
  }
//*main
spriteset (keisei200_2000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png") { tmpl_std_v3(0, 0) }
spriteset (keisei200_2000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png") { tmpl_std_v3(0, 25) }
spriteset (keisei200_2000_1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png") { tmpl_std_v3(0, 25) }
spriteset (keisei200_2000_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png") { tmpl_std_v3(0, 50) }
spriteset (keisei200_2000_1_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png") { tmpl_std_rev_v3(0, 50) }

spriteset (keisei200_2000_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png") { tmpl_std_v3(0, 0) }
spriteset (keisei200_2000_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png") { tmpl_std_v3(0, 25) }
spriteset (keisei200_2000_2_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png") { tmpl_std_v3(0, 25) }
