//purchase
  spriteset(keisei200_2000_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei200_2000_purchase_c2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_2(keisei200_2000_purchase_1, keisei200_2000_purchase_c1_1, keisei200_2000_purchase_c2_1)
  spriteset(keisei200_2000_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei200_2000_purchase_c2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_2(keisei200_2000_purchase_2, keisei200_2000_purchase_c1_2, keisei200_2000_purchase_c2_2)

  switch(FEAT_TRAINS, SELF, keisei200_2000_purchase, current_year){
    0..1979:keisei200_2000_purchase_1;
    keisei200_2000_purchase_2;
  }
//*main
  spriteset(keisei200_2000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(keisei200_2000_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei200_2000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keisei200_2000_lights_end;
    keisei200_2000_lights_front;
  }
spriteset (keisei200_2000_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png") { tmpl_std_v3(0, 0) }
spriteset (keisei200_2000_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png") { tmpl_std_v3(0, 25) }
spriteset (keisei200_2000_1_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_1.png") { tmpl_std_rev_v3(0, 25) }

spriteset (keisei200_2000_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png") { tmpl_std_v3(0, 0) }
spriteset (keisei200_2000_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png") { tmpl_std_v3(0, 25) }
spriteset (keisei200_2000_2_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png") { tmpl_std_rev_v3(0, 25) }

//lv stuff
  switch(FEAT_TRAINS, SELF, keisei200_2000_head_timed, current_year){
    0..1979:keisei200_2000_1_head;    keisei200_2000_2_head;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_mot_timed, current_year){
    0..1979:keisei200_2000_1_mot;    keisei200_2000_2_mot;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_mot_rev_timed, current_year){
    0..1979:keisei200_2000_1_mot_rev;    keisei200_2000_2_mot_rev;
  }

  switch(FEAT_TRAINS, SELF, keisei200_2000_head, cargo_subtype){
    1:keisei200_2000_1_head;    2:keisei200_2000_2_head;
    keisei200_2000_head_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_mot, cargo_subtype){
    1:keisei200_2000_1_mot;    2:keisei200_2000_2_mot;
    keisei200_2000_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_mot_rev, cargo_subtype){
    1:keisei200_2000_1_mot_rev;    2:keisei200_2000_2_mot_rev;
    keisei200_2000_mot_rev_timed;
  }
