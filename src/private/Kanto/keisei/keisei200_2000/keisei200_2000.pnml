//*main
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei200_2000_panto_placer_main,position_in_vehid_chain %2){
        0: keisei200_2000_mot_rev;
        keisei200_2000_mot;
      }
    //
    TRAIN_CONSTRUCTOR_2(sw_keisei200_2000_head_gfx,  keisei200_2000_head,  sw_keisei200_2000_lights)
    switch(FEAT_TRAINS, SELF, sw_keisei200_2000_lv,vehicle_type_id){
      mu_car:sw_keisei200_2000_panto_placer_main;
      sw_keisei200_2000_head_gfx;
    }
//

//*liveries
  switch(FEAT_TRAINS, SELF, sw_keisei200_2000_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AODEN)),1966);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AKADEN)),1980);
  }
//post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei200_2000_car_power_main,position_in_vehid_chain%4){
      0..1:return 110;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei200_2000_power_main,vehicle_type_id){
      mu_car:sw_keisei200_2000_car_power_main;
      return 0;
    }
