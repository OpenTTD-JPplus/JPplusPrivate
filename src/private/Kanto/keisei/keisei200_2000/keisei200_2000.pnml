spriteset (keisei200_2000_2_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei200_2000/keisei200_2000_2.png") { tmpl_std_rev_v3(0, 50) }
//lv stuff
  switch(FEAT_TRAINS, SELF, keisei200_2000_front_timed, current_year){
    0..1979:keisei200_2000_1_front;    keisei200_2000_2_front;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_end_timed, current_year){
    0..1979:keisei200_2000_1_end;    keisei200_2000_2_end;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_end_rev_timed, current_year){
    0..1979:keisei200_2000_1_end_rev;    keisei200_2000_2_end_rev;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_mot_timed, current_year){
    0..1979:keisei200_2000_1_mot;    keisei200_2000_2_mot;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_mot_rev_timed, current_year){
    0..1979:keisei200_2000_1_mot_rev;    keisei200_2000_2_mot_rev;
  }

  switch(FEAT_TRAINS, SELF, keisei200_2000_front, cargo_subtype){
    1:keisei200_2000_1_front;    2:keisei200_2000_2_front;
    keisei200_2000_front_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_end, cargo_subtype){
    1:keisei200_2000_1_end;    2:keisei200_2000_2_end;
    keisei200_2000_end_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_end_rev, cargo_subtype){
    1:keisei200_2000_1_end_rev;    2:keisei200_2000_2_end_rev;
    keisei200_2000_end_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_mot, cargo_subtype){
    1:keisei200_2000_1_mot;    2:keisei200_2000_2_mot;
    keisei200_2000_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei200_2000_mot_rev, cargo_subtype){
    1:keisei200_2000_1_mot_rev;    2:keisei200_2000_2_mot_rev;
    keisei200_2000_mot_rev_timed;
  }
//
//*main
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei200_2000_panto_placer_1,position_in_vehid_chain %4){
        0: keisei200_2000_mot_rev;
        1: keisei200_2000_mot;
        2: keisei200_2000_end;
        keisei200_2000_end_rev;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei200_2000_panto_placer_1_rev,position_in_vehid_chain_from_end %4){
        0: keisei200_2000_mot;
        1: keisei200_2000_mot_rev;
        2: keisei200_2000_end_rev;
        keisei200_2000_end;
      }
      switch(FEAT_TRAINS, PARENT, sw_keisei200_2000_panto_placer_main,vehicle_is_reversed){
        1: sw_keisei200_2000_panto_placer_1_rev;
        sw_keisei200_2000_panto_placer_1;
      }
  switch(FEAT_TRAINS, SELF, sw_keisei200_2000_head_gfx_main,position_in_consist>0){
      1:keisei200_2000_end;
      keisei200_2000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei200_2000_lv,vehicle_type_id){
      mu_car:sw_keisei200_2000_panto_placer_main;
      sw_keisei200_2000_head_gfx_main;
    }
//

//*liveries
  switch(FEAT_TRAINS, SELF, sw_keisei200_2000_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AODEN)),1966);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AKADEN)),1980);
  }
//post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei200_2000_car_power_main,position_in_vehid_chain%4){
      0..1:return 110;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei200_2000_power_main,vehicle_type_id){
      mu_car:sw_keisei200_2000_car_power_main;
      0;
    }
