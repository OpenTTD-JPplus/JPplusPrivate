// liveries
  switch(FEAT_TRAINS, SELF, sw_keisei1500_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1952);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_keisei1500_2)),1955);
  }
