spriteset (keisei1500_2_head_mot_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei1500/keisei1500_2.png") { tmpl_std_v3(0, 0) }
