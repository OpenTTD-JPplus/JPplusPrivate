// post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei1500_car_power_main,position_in_vehid_chain %4){
      2..3:return 55;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei1500_power_main,position_in_vehid_chain %2){
      mu_car:sw_keisei1500_car_power_main;
      return 55*2;
    }
