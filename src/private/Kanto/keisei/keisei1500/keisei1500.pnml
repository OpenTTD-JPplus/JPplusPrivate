  switch(FEAT_TRAINS, SELF, keisei1500_head_mot_base_timed, current_year){
    0..1954:keisei1500_1_head_mot_base;    keisei1500_2_head_mot_base;
  }
  switch(FEAT_TRAINS, SELF, keisei1500_head_base_timed, current_year){
    0..1954:keisei1500_1_head_base;    keisei1500_2_head_base;
  }
  switch(FEAT_TRAINS, SELF, keisei1500_head_base_rev_timed, current_year){
    0..1954:keisei1500_1_head_base_rev;    keisei1500_2_head_base_rev;
  }

  switch(FEAT_TRAINS, SELF, keisei1500_head_mot_base, cargo_subtype){
    0:keisei1500_head_mot_base_timed;    1:keisei1500_1_head_mot_base;    keisei1500_2_head_mot_base;
  }
  switch(FEAT_TRAINS, SELF, keisei1500_head_base, cargo_subtype){
    0:keisei1500_head_base_timed;    1:keisei1500_1_head_base;    keisei1500_2_head_base;
  }
  switch(FEAT_TRAINS, SELF, keisei1500_head_base_rev, cargo_subtype){
    0:keisei1500_head_base_rev_timed;    1:keisei1500_1_head_base_rev;    keisei1500_2_head_base_rev;
  }
//*livery 1
  //panto
	  switch(FEAT_TRAINS, SELF, sw_keisei1500_panto_placer_main,position_in_vehid_chain %4){
      0:keisei1500_head_base_rev;
      1:keisei1500_head_base;
      2:keisei1500_head_base_rev;
      keisei1500_head_mot_base;
    }
	//main
    TRAIN_CONSTRUCTOR_2(keisei1500_head,  keisei1500_head_mot_base,  sw_keisei1500_lights)
    switch(FEAT_TRAINS, SELF, sw_keisei1500_lv,vehicle_type_id){
      mu_car: sw_keisei1500_panto_placer_main;
      keisei1500_head;
    }
