//purchase
  spriteset(keisei1500_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei1500/keisei1500_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei1500_purchase_c2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei1500/keisei1500_1.png"){ tmpl_purchase_2c_dual_7(0, 25) }
  GRAPHIC_STACK_2(keisei1500_purchase_1, keisei1500_purchase_c1_1, keisei1500_purchase_c2_1)
  spriteset(keisei1500_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei1500/keisei1500_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei1500_purchase_c2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei1500/keisei1500_2.png"){ tmpl_purchase_2c_dual_7(0, 25) }
  GRAPHIC_STACK_2(keisei1500_purchase_2, keisei1500_purchase_c1_2, keisei1500_purchase_c2_2)
  
  switch(FEAT_TRAINS, SELF, keisei1500_purchase,current_year){
    0..1954:keisei1500_purchase_1;
    keisei1500_purchase_2;
  }
//*main
  spriteset(keisei1500_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei1500/keisei1500_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(keisei1500_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei1500/keisei1500_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei1500_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: gfx_empty;
    keisei1500_lights_front;
  }
