//purchase
  spriteset(keisei300_purchase_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei300/keisei300_1.png"){ tmpl_purchase_1c(0, 0) }
  spriteset(keisei300_purchase_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei300/keisei300_2.png"){ tmpl_purchase_1c(0, 0) }
  spriteset(keisei300_purchase_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei300/keisei300_3.png"){ tmpl_purchase_1c(0, 0) }
  
  switch(FEAT_TRAINS, SELF, keisei300_purchase,current_year){
    0..1940:keisei300_purchase_1;
    1941..1949:keisei300_purchase_2;
    keisei300_purchase_3;
  }
//*main
  spriteset(keisei300_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei300/keisei300_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(keisei300_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei300/keisei300_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei300_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keisei300_lights_end;
    keisei300_lights_front;
  }

spriteset (keisei300_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei300/keisei300_1.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keisei300_1_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei300/keisei300_1.png") { tmpl_std_v3(0, 0) }

spriteset (keisei300_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei300/keisei300_2.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keisei300_2_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei300/keisei300_2.png") { tmpl_std_v3(0, 0) }

spriteset (keisei300_3_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei300/keisei300_3.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keisei300_3_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei300/keisei300_3.png") { tmpl_std_v3(0, 0) }
//
  switch(FEAT_TRAINS, SELF, keisei300_head_timed, current_year){
    0..1940:keisei300_1_head;    1941..1949:keisei300_2_head;    keisei300_3_head;
  }
  switch(FEAT_TRAINS, SELF, keisei300_head_rev_timed, current_year){
    0..1940:keisei300_1_head_rev;    1941..1949:keisei300_2_head_rev;    keisei300_3_head_rev;
  }

  switch(FEAT_TRAINS, SELF, keisei300_head, cargo_subtype){
    0:keisei300_head_timed;    1:keisei300_1_head;    2:keisei300_2_head;    3:keisei300_3_head;
  }
  switch(FEAT_TRAINS, SELF, keisei300_head_rev, cargo_subtype){
    0:keisei300_head_rev_timed;    1:keisei300_1_head_rev;    2:keisei300_2_head_rev;    3:keisei300_3_head_rev;
  }

//*livery 1
  //panto
	  switch(FEAT_TRAINS, SELF, sw_keisei300_panto_placer_main,position_in_vehid_chain %2){
      0: keisei300_head_rev;
      keisei300_head;
    }
	//main
    switch(FEAT_TRAINS, SELF, sw_keisei300_end_placer,position_in_vehid_chain_from_end){
      0: keisei300_head;
      sw_keisei300_panto_placer_main;
    }
    TRAIN_CONSTRUCTOR_2(sw_keisei300_lv,  sw_keisei300_end_placer,  sw_keisei300_lights)
//
//liveries
  switch(FEAT_TRAINS, SELF, sw_keisei300_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_GREEN)),1938);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_WAR)),1941);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AODEN)),1950);
  }
