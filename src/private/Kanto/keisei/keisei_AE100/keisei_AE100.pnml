//purchase
  spriteset(keisei_AE100_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE100/keisei_AE100.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei_AE100_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE100/keisei_AE100.png"){ tmpl_purchase_2c_dual(88, 100) }
  GRAPHIC_STACK_2(keisei_AE100_purchase, keisei_AE100_purchase_c1, keisei_AE100_purchase_c2)
//*main
spriteset (keisei_AE100_1_front_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE100/keisei_AE100.png") { tmpl_std_v3(0, 0) }
spriteset (keisei_AE100_1_end_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE100/keisei_AE100.png") { tmpl_std_v3(0, 25) }
spriteset (keisei_AE100_1_front_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE100/keisei_AE100.png") { tmpl_std_v3(0, 50) }
spriteset (keisei_AE100_1_end_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE100/keisei_AE100.png") { tmpl_std_v3(0, 75) }
spriteset (keisei_AE100_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE100/keisei_AE100.png") { tmpl_std_v3(0, 100) }
spriteset (keisei_AE100_1_wag_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE100/keisei_AE100.png") { tmpl_std_v3(0, 125) }
spriteset (keisei_AE100_1_wag_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE100/keisei_AE100.png") { tmpl_std_v3(0, 150) }
spriteset (keisei_AE100_1_wag_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE100/keisei_AE100.png") { tmpl_std_v3(0, 175) }

//*livery 1
  //special gfx
  switch(FEAT_TRAINS, PARENT, sw_keisei_AE100_1_front,vehicle_is_reversed){
      1: keisei_AE100_1_front_1;
      keisei_AE100_1_front_2;
    }
  switch(FEAT_TRAINS, PARENT, sw_keisei_AE100_1_end,vehicle_is_reversed){
      1: keisei_AE100_1_end_1;
      keisei_AE100_1_end_2;
    }
  //panto-placers
    //var 1 (6 car)
      switch(FEAT_TRAINS, SELF, sw_keisei_AE100_1_panto_placer_main_1,position_in_vehid_chain %4){
        0: keisei_AE100_1_mot;
        2: keisei_AE100_1_mot;
        3: keisei_AE100_1_wag_2;
        keisei_AE100_1_wag_1;
      }
    //var 2 (8 car)
      switch(FEAT_TRAINS, SELF, sw_keisei_AE100_1_panto_placer_main_2,position_in_vehid_chain %7){
        0: keisei_AE100_1_mot;
        2: keisei_AE100_1_wag_3;
        3: keisei_AE100_1_wag_2;
        5: keisei_AE100_1_mot;
        keisei_AE100_1_wag_1;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_keisei_AE100_1_panto_placer_main,num_vehs_in_vehid_chain){
        3..4:sw_keisei_AE100_1_panto_placer_main_1;
        sw_keisei_AE100_1_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keisei_AE100_head_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
      1:sw_keisei_AE100_1_end;
      sw_keisei_AE100_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei_AE100_lv,vehicle_type_id){
      mu_car:sw_keisei_AE100_1_panto_placer_main;
      sw_keisei_AE100_head_gfx_main;
    }

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keisei_AE100_capacity,position_in_vehid_chain_from_end){
      2: 48;
      3: 46;
      60;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei_AE100_capacity_main,vehicle_type_id){
      mu_car: sw_keisei_AE100_capacity;
      48;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei_AE100_car_power_main,position_in_vehid_chain%6){
      0:return 130;
      2..3:return 130;
      5:return 130;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei_AE100_power_main,vehicle_type_id){
      mu_car:sw_keisei_AE100_car_power_main;
      130*2;
    }
//