#include "keisei_AE1/keisei_AE1.pnml"

item(FEAT_TRAINS, keisei_AE1) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_keisei == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_KEISEI), "AE I", string(STR_NAME_TYPE));
    introduction_date: date(1973, 12, 30);
    model_life: 25;
    vehicle_life: 20;
    dual_headed: 1;
    
    cost_factor: 23;
    running_cost_factor: 53;
    speed: 120 km/h;
    track_type:TR_1435_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 35 ton;
    badges: ["company/keisei"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 1)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 6,8)),
    string(STR_USAGE, string(STR_LIMITED_EXPRESS)),
    string(STR_OPERATOR, string(STR_KEISEI))
    
    );
    cargo_subtype_text: sw_keisei_AE1_lv_desc_main;
    purchase: keisei_AE1_purchase;
    cargo_capacity:sw_keisei_AE1_capacity_main()*param_capacity_mod/3*boost_rapid_mod/2;
    purchase_cargo_capacity:sw_keisei_AE1_capacity_main()*param_capacity_mod/3*boost_rapid_mod/2-1;
    loading_speed:param_loading_1D;
    default:sw_keisei_AE1_lv;
    power:sw_keisei_AE1_power_main()*4*1342/1000;
    purchase_power: sw_keisei_AE1_car_power_main()*4*1342/1000;
    
    
    sound_effect: sw_KSAE1_start_sound;
    cargo_age_period: ltd_express_cargo_age;
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_keisei_AE1_lv_desc_main;
    loading_speed:param_loading_1D;
    cargo_capacity:sw_keisei_AE1_capacity_main()*param_capacity_mod/3*boost_rapid_mod/2;
    power:sw_keisei_AE1_power_main()*4*1342/1000;
    default:sw_keisei_AE1_lv;
    weight: 35;
    
  }
}
