//lv stuff
  switch(FEAT_TRAINS, SELF, keisei20_front_rev_timed, current_year){
    0..1940:keisei20_2_front_rev;
    1941..1949:keisei20_3_front_rev;
    keisei20_4_front_rev;
  }
  switch(FEAT_TRAINS, SELF, keisei20_front_timed, current_year){
    0..1940:keisei20_2_front;
    1941..1949:keisei20_3_front;
    keisei20_4_front;
  }
  switch(FEAT_TRAINS, SELF, keisei20_end_timed, current_year){
    0..1940:keisei20_2_end;
    1941..1949:keisei20_3_end;
    keisei20_4_end;
  }
  switch(FEAT_TRAINS, SELF, keisei20_end_rev_timed, current_year){
    0..1940:keisei20_2_end_rev;
    1941..1949:keisei20_3_end_rev;
    keisei20_4_end_rev;
  }

  switch(FEAT_TRAINS, SELF, keisei20_front_rev, cargo_subtype){
    2:keisei20_2_front_rev;
    3:keisei20_3_front_rev;
    4:keisei20_4_front_rev;
    keisei20_front_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei20_front, cargo_subtype){
    2:keisei20_2_front;
    3:keisei20_3_front;
    4:keisei20_4_front;
    keisei20_front_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei20_end, cargo_subtype){
    2:keisei20_2_end;
    3:keisei20_3_end;
    4:keisei20_4_end;
    keisei20_end_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei20_end_rev, cargo_subtype){
    2:keisei20_2_end_rev;
    3:keisei20_3_end_rev;
    4:keisei20_4_end_rev;
    keisei20_end_rev_timed;
  }
//
  
//*livery 2-4
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_keisei20_front_gfx_1,vehicle_is_reversed){
      1: keisei20_front_rev;
      keisei20_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_keisei20_front_gfx,vehicle_is_reversed==1&&num_vehs_in_consist>1){
      1: keisei20_front;
      sw_keisei20_front_gfx_1;
    }
  //panto
	  switch(FEAT_TRAINS, SELF, sw_keisei20_panto_placer_1,position_in_vehid_chain %2){
      0: keisei20_end;
      keisei20_end_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei20_panto_placer_1_rev,position_in_vehid_chain_from_end %2){
      0: keisei20_end;
      keisei20_end_rev;
    }
    switch(FEAT_TRAINS, PARENT, sw_keisei20_panto_placer_main,vehicle_is_reversed){
      1: sw_keisei20_panto_placer_1_rev;
      sw_keisei20_panto_placer_1;
    }
	//main
    switch(FEAT_TRAINS, SELF, sw_keisei20_gfx_main,position_in_vehid_chain_from_end){
      0: keisei20_end;
      sw_keisei20_panto_placer_main;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei20_lv_2,vehicle_type_id){
      mu_car: sw_keisei20_gfx_main;
      sw_keisei20_front_gfx;
    }
//
//liveries
  switch(FEAT_TRAINS, SELF, sw_keisei20_lv,build_year<1925||cargo_subtype==1){
    1:sw_keisei20_livery_1;
    sw_keisei20_lv_2;
  }
  switch(FEAT_TRAINS, SELF, sw_keisei20_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1921);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_GREEN)),1924);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_WAR)),1941);
    4:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AODEN)),1950);
  }
