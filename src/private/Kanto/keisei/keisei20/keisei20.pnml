//purchase
  spriteset(keisei20_purchase_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei20/keisei20_1.png"){ tmpl_purchase_1c(0, 0) }
  spriteset(keisei20_purchase_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei20/keisei20_2.png"){ tmpl_purchase_1c(0, 0) }
  spriteset(keisei20_purchase_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei20/keisei20_3.png"){ tmpl_purchase_1c(0, 0) }
  spriteset(keisei20_purchase_4, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei20/keisei20_4.png"){ tmpl_purchase_1c(0, 0) }
  
  switch(FEAT_TRAINS, SELF, keisei20_purchase,current_year){
    0..1924:keisei20_purchase_1;
    1925..1940:keisei20_purchase_2;
    1941..1949:keisei20_purchase_3;
    keisei20_purchase_4;
  }
//*main
  spriteset(keisei20_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei20/keisei20_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(keisei20_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei20/keisei20_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei20_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keisei20_lights_end;
    keisei20_lights_front;
  }
  
spriteset (sw_keisei20_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei20/keisei20_1.png") { tmpl_std_v3(0, 0) }
spriteset (sw_keisei20_1_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei20/keisei20_1.png") { tmpl_std_rev_v3(0, 0) }
switch(FEAT_TRAINS, PARENT, sw_keisei20_livery_1, vehicle_is_reversed){
  1: sw_keisei20_1_head_rev;
  sw_keisei20_1_head;
}

spriteset (keisei20_2_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei20/keisei20_2.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keisei20_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei20/keisei20_2.png") { tmpl_std_v3(0, 0) }

spriteset (keisei20_3_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei20/keisei20_3.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keisei20_3_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei20/keisei20_3.png") { tmpl_std_v3(0, 0) }

spriteset (keisei20_4_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei20/keisei20_4.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keisei20_4_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei20/keisei20_4.png") { tmpl_std_v3(0, 0) }

//lv stuff
  switch(FEAT_TRAINS, SELF, keisei20_head_timed, current_year){
    0..1940:keisei20_2_head;
    1941..1949:keisei20_3_head;
    keisei20_4_head;
  }
  switch(FEAT_TRAINS, SELF, keisei20_head, cargo_subtype){
    2:keisei20_2_head;
    3:keisei20_3_head;
    4:keisei20_4_head;
    keisei20_head_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei20_head_rev_timed, current_year){
    0..1940:keisei20_2_head_rev;
    1941..1949:keisei20_3_head_rev;
    keisei20_4_head_rev;
  }
  switch(FEAT_TRAINS, SELF, keisei20_head_rev, cargo_subtype){
    2:keisei20_2_head_rev;
    3:keisei20_3_head_rev;
    4:keisei20_4_head_rev;
    keisei20_head_rev_timed;
  }
//
  
//*livery 2-4
  //panto
	  switch(FEAT_TRAINS, SELF, sw_keisei20_panto_placer_main,position_in_vehid_chain %2){
      0: keisei20_head;
      keisei20_head_rev;
    }
	//main
    switch(FEAT_TRAINS, SELF, sw_keisei20_end_placer,position_in_vehid_chain_from_end){
      0: keisei20_head_rev;
      sw_keisei20_panto_placer_main;
    }
    TRAIN_CONSTRUCTOR_2(sw_keisei20_lv_2,  sw_keisei20_end_placer,  sw_keisei20_lights)
//
//liveries
  switch(FEAT_TRAINS, SELF, sw_keisei20_lv,(build_year<1925&&cargo_subtype==0)||cargo_subtype==1){
    1:sw_keisei20_livery_1;
    sw_keisei20_lv_2;
  }
  switch(FEAT_TRAINS, SELF, sw_keisei20_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1921);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_GREEN)),1924);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_WAR)),1941);
    4:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AODEN)),1950);
  }
