//*main
  spriteset(keisei3400_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3700/keisei3700_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(keisei3400_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3700/keisei3700_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, keisei3400_lights, train_is_driving_backwards != vehicle_is_flipped){
    1:keisei3400_lights_back;    keisei3400_lights_front;
  }
  spriteset(keisei3700_lights_n_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3700/keisei3700_lights_n.png"){ tmpl_std_v3(0, 0) }
  spriteset(keisei3700_lights_n_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3700/keisei3700_lights_n.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, keisei3700_lights, train_is_driving_backwards != vehicle_is_flipped){
    1:keisei3700_lights_n_back;    keisei3700_lights_n_front;
  }
  switch(FEAT_TRAINS, SELF, sw_keisei3700_lights, (build_year<2000&&cargo_subtype==0)||cargo_subtype==1){
    1: keisei3400_lights;
    keisei3700_lights;
  }
//
  switch(FEAT_TRAINS, SELF, keisei3700_panto_single, build_year){
    0..1999:panto_d_arm_single;    panto_arm_n_single;
