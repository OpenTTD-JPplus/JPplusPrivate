      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_keisei3700_panto_placer_main_2,position_in_vehid_chain_from_end %3){
        0: keisei3700_mot_2;
        keisei3700_car;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei3700_panto_placer_main,num_vehs_in_vehid_chain){
        4..5: sw_keisei3700_panto_placer_main_2;
        sw_keisei3700_panto_placer_main_1;
