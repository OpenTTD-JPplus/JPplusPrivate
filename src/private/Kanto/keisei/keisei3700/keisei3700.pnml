  switch(FEAT_TRAINS, SELF, keisei3700_panto, build_year){
    0..1999:panto_d_arm;    panto_arm_n;
  }
spriteset (keisei3700_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3700/keisei3700_1.png") { tmpl_std_v3(0, 0) }
spriteset (keisei3700_1_head_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3700/keisei3700_2.png") { tmpl_std_v3(0, 0) }
spriteset (keisei3700_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3700/keisei3700_1.png") { tmpl_symm_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, keisei3700_1_head_gfx,current_year>1994){
    1:keisei3700_1_head_1;
    keisei3700_1_head;
