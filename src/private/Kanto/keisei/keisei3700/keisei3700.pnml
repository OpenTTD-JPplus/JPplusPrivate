  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei3700_panto_placer_main_1,position_in_vehid_chain %8){
        0: keisei3700_mot_2;
        2: keisei3700_mot;
        5: keisei3700_mot_2;
