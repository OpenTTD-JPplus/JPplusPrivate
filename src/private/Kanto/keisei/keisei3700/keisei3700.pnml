spriteset (keisei3700_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3700/keisei3700_3.png") { tmpl_std_v3(0, 0) }
  switch(FEAT_TRAINS, SELF, keisei3700_head_timed,(build_year<2000&&cargo_subtype==0)||cargo_subtype==1){
    1:keisei3700_1_head_gfx;    keisei3700_2_head;
  }
  TRAIN_CONSTRUCTOR_3(keisei3700_head, keisei3700_head_timed, sw_keisei3700_lights, ac_double_1_1)
  TRAIN_CONSTRUCTOR_2(keisei3700_car, keisei3700_wag, ac_double_1_1)
  TRAIN_CONSTRUCTOR_3(keisei3700_mot, keisei3700_wag, ac_double_1_1, keisei3700_panto_single)
