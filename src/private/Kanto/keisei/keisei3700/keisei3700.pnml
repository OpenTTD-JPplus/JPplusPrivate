    switch(FEAT_TRAINS, SELF, sw_keisei3700_capacity_main,vehicle_type_id){
      mu_car: 136;
      126;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei3700_car_power_main,position_in_vehid_chain%4){
      0..1:return 130;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei3700_power_main,vehicle_type_id){
      mu_car: sw_keisei3700_car_power_main;
      return 130*2;
