  spriteset(keisei3700_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3700/keisei3700_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei3700_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3700/keisei3700_1.png"){ tmpl_purchase_2c_dual(0, 25) }
