//purchase
  spriteset(keisei3200n_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3200n/keisei3200n_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei3200n_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3200n/keisei3200n_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_5(keisei3200n_purchase, keisei3200n_purchase_c1, keisei3200n_purchase_c2, ac_single_1_c1, ac_single_1_c2, panto_arm_n_single_c1)
//*main
  spriteset(keisei3200n_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3200n/keisei3200n_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(keisei3200n_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3200n/keisei3200n_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei3200n_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keisei3200n_lights_back;
    keisei3200n_lights_front;
  }
spriteset (keisei3200n_head_f_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3200n/keisei3200n_1.png") { tmpl_std_v3(0, 0) }
