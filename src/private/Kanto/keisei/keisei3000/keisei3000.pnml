  //var 1
    switch(FEAT_TRAINS, SELF, sw_keisei3000_panto_placer_main,position_in_vehid_chain %2){
      1: keisei3000_mot_rev;
      keisei3000_wag;
    }
	//fake-head-placer
    //var 1 (6+)
      switch(FEAT_TRAINS, SELF, sw_keisei3000_fake_head_placer_gfx,position_in_vehid_chain){
        2: keisei3000_end_rev;
        3: keisei3000_end_mot;
        sw_keisei3000_panto_placer_main;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei3000_fake_head_placer_main,[(num_vehs_in_vehid_chain>3&&current_year<1978)||(num_vehs_in_vehid_chain>5)]){
        1: sw_keisei3000_fake_head_placer_gfx;
        sw_keisei3000_panto_placer_main;
      }
  //main
    switch(FEAT_TRAINS, SELF, sw_keisei3000_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
      1: sw_keisei3000_end_gfx;
      sw_keisei3000_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei3000_lv,vehicle_type_id){
      mu_car: sw_keisei3000_fake_head_placer_main;
      sw_keisei3000_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_keisei3000_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AODEN)),1958);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AKADEN)),1959);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AKADEN)),1980);
  }
