      1: keisei3000_front;
      keisei3000_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_keisei3000_end_gfx,vehicle_is_reversed){
      1: keisei3000_end_mot;
      keisei3000_end;
