//purchase
  spriteset(keisei_AE2_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei_AE2_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png"){ tmpl_purchase_2c_dual(88, 125) }
  GRAPHIC_STACK_2(keisei_AE2_purchase, keisei_AE2_purchase_c1, keisei_AE2_purchase_c2)
//livery 1
spriteset (keisei_AE2_1_front_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png") { tmpl_std_v3(0, 0) }
spriteset (keisei_AE2_1_end_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png") { tmpl_std_v3(0, 25) }
spriteset (keisei_AE2_1_front_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png") { tmpl_std_v3(0, 50) }
spriteset (keisei_AE2_1_end_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png") { tmpl_std_v3(0, 75) }
spriteset (keisei_AE2_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png") { tmpl_std_v3(0, 100) }
spriteset (keisei_AE2_1_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png") { tmpl_std_rev_v3(0, 100) }
spriteset (keisei_AE2_1_wag_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png") { tmpl_std_v3(0, 125) }
spriteset (keisei_AE2_1_wag_1_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png") { tmpl_std_rev_v3(0, 125) }
spriteset (keisei_AE2_1_wag_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png") { tmpl_std_v3(0, 150) }
spriteset (keisei_AE2_1_wag_2_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei_AE2/keisei_AE2.png") { tmpl_std_rev_v3(0, 150) }

//*livery 1
  //special gfx
  switch(FEAT_TRAINS, PARENT, sw_keisei_AE2_1_front,vehicle_is_reversed){
      1: keisei_AE2_1_front_2;
      keisei_AE2_1_front_1;
    }
  switch(FEAT_TRAINS, PARENT, sw_keisei_AE2_1_end,vehicle_is_reversed){
      1: keisei_AE2_1_end_1;
      keisei_AE2_1_end_2;
    }
  //panto-placers
    //var 1 (6 car)
      switch(FEAT_TRAINS, SELF, sw_keisei_AE2_1_panto_placer_1,position_in_vehid_chain %3){
        1: keisei_AE2_1_mot;
        2: keisei_AE2_1_mot;
        keisei_AE2_1_wag_1;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei_AE2_1_panto_placer_1_rev,position_in_vehid_chain_from_end %3){
        0: keisei_AE2_1_mot_rev;
        1: keisei_AE2_1_mot_rev;
        keisei_AE2_1_wag_1_rev;
      }
      switch(FEAT_TRAINS, PARENT, sw_keisei_AE2_1_panto_placer_main_1,vehicle_is_reversed){
        1: sw_keisei_AE2_1_panto_placer_1_rev;
        sw_keisei_AE2_1_panto_placer_1;
      }
    //var 2 (8 car)
      switch(FEAT_TRAINS, SELF, sw_keisei_AE2_1_panto_placer_2,position_in_vehid_chain %7){
        1: keisei_AE2_1_mot;
        2: keisei_AE2_1_wag_2;
        3: keisei_AE2_1_mot;
        keisei_AE2_1_wag_1;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei_AE2_1_panto_placer_2_rev,position_in_vehid_chain_from_end %7){
        1: keisei_AE2_1_mot_rev;
        2: keisei_AE2_1_wag_2_rev;
        3: keisei_AE2_1_mot_rev;
        keisei_AE2_1_wag_1_rev;
      }
      switch(FEAT_TRAINS, PARENT, sw_keisei_AE2_1_panto_placer_main_2,vehicle_is_reversed){
        1: sw_keisei_AE2_1_panto_placer_2_rev;
        sw_keisei_AE2_1_panto_placer_2;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_keisei_AE2_1_panto_placer_main,num_vehs_in_vehid_chain){
        3..4:sw_keisei_AE2_1_panto_placer_main_1;
        sw_keisei_AE2_1_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keisei_AE2_head_gfx_main,position_in_consist>0){
      1:sw_keisei_AE2_1_end;
      sw_keisei_AE2_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei_AE2_lv,vehicle_type_id){
      mu_car:sw_keisei_AE2_1_panto_placer_main;
      sw_keisei_AE2_head_gfx_main;
    }

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keisei_AE2_capacity,position_in_vehid_chain_from_end){
      2: 42;
      3: 52;
      56;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei_AE2_capacity_main,vehicle_type_id){
      mu_car: sw_keisei_AE2_capacity;
      40;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei_AE2_car_power_main,position_in_vehid_chain%6){
      0..2:return 175;
      5:return 175;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei_AE2_power_main,vehicle_type_id){
      mu_car:sw_keisei_AE2_car_power_main;
      175*2;
    }
