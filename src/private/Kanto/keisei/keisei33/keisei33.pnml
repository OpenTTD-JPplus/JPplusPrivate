//purchase
  spriteset(keisei33_purchase_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei33/keisei33_1.png"){ tmpl_purchase_1c(-88, 0) }
  spriteset(keisei33_purchase_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei33/keisei33_2.png"){ tmpl_purchase_1c(-88, 0) }
  spriteset(keisei33_purchase_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei33/keisei33_3.png"){ tmpl_purchase_1c(-88, 0) }
  
  switch(FEAT_TRAINS, SELF, keisei33_purchase,current_year){
    0..1924:keisei33_purchase_1;
    1925..1942:keisei33_purchase_2;
    keisei33_purchase_3;
  }
//*main
  spriteset(keisei33_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei33/keisei33_lights.png"){ tmpl_std_v3(0, 0) }
  spriteset(keisei33_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keisei/keisei33/keisei33_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei33_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keisei33_lights_end;
    keisei33_lights_front;
  }

spriteset (sw_keisei33_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_1.png") { tmpl_std_v3(0, 0) }
spriteset (sw_keisei33_1_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei33/keisei33_1.png") { tmpl_std_rev_v3(0, 0) }
switch(FEAT_TRAINS, PARENT, sw_keisei33_livery_1, vehicle_is_reversed){
  1: sw_keisei33_1_head_rev;
  sw_keisei33_1_head;
}

spriteset (keisei33_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_2.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keisei33_2_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_2.png") { tmpl_std_v3(0, 0) }

spriteset (keisei33_3_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_3.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keisei33_3_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_3.png") { tmpl_std_v3(0, 0) }
//lv stuff
  switch(FEAT_TRAINS, SELF, keisei33_head_timed, current_year){
    0..1940:keisei33_2_head;    keisei33_3_head;
  }
  switch(FEAT_TRAINS, SELF, keisei33_head_rev_timed, current_year){
    0..1940:keisei33_2_head_rev;    keisei33_3_head_rev;
  }

  switch(FEAT_TRAINS, SELF, keisei33_head, cargo_subtype){
    2:keisei33_2_head;    3:keisei33_3_head;
    keisei33_head_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei33_head_rev, cargo_subtype){
    2:keisei33_2_head_rev;    3:keisei33_3_head_rev;
    keisei33_head_rev_timed;
  }
//
//*livery 2-3
  //panto
	  switch(FEAT_TRAINS, SELF, sw_keisei33_panto_placer_main,position_in_vehid_chain %2){
      0: keisei33_head;
      keisei33_head_rev;
    }
	//main
    switch(FEAT_TRAINS, SELF, sw_keisei33_end_placer,position_in_vehid_chain_from_end){
      0: keisei33_head_rev;
      sw_keisei33_panto_placer_main;
    }
    TRAIN_CONSTRUCTOR_2(sw_keisei33_lv_2,  sw_keisei33_end_placer,  sw_keisei33_lights)
    
//

//liveries
  switch(FEAT_TRAINS, SELF, sw_keisei33_lv,(build_year<1925&&cargo_subtype==0)||cargo_subtype==1){
    1:sw_keisei33_livery_1;
    sw_keisei33_lv_2;
  }
  switch(FEAT_TRAINS, SELF, sw_keisei33_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1922);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_GREEN)),1924);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_WAR)),1941);
  }