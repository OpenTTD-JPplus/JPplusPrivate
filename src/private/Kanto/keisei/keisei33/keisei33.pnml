//purchase
  spriteset(keisei33_purchase_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei33/keisei33_1.png"){ tmpl_purchase_1c(-88, 0) }
  spriteset(keisei33_purchase_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei33/keisei33_2.png"){ tmpl_purchase_1c(-88, 0) }
  spriteset(keisei33_purchase_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei33/keisei33_3.png"){ tmpl_purchase_1c(-88, 0) }
  
  switch(FEAT_TRAINS, SELF, keisei33_purchase,current_year){
    0..1924:keisei33_purchase_1;
    1925..1942:keisei33_purchase_2;
    keisei33_purchase_3;
  }
//*main
spriteset (sw_keisei33_livery_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_1.png") { tmpl_std_rev_v3(0, 0) }

spriteset (keisei33_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_2.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keisei33_2_front_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_2.png") { tmpl_std_v3(0, 25) }
spriteset (keisei33_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_2.png") { tmpl_std_v3(0, 50) }
spriteset (keisei33_2_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_2.png") { tmpl_std_rev_v3(0, 50) }

spriteset (keisei33_3_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_3.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keisei33_3_front_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_3.png") { tmpl_std_v3(0, 25) }
spriteset (keisei33_3_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_3.png") { tmpl_std_v3(0, 50) }
spriteset (keisei33_3_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei33/keisei33_3.png") { tmpl_std_rev_v3(0, 50) }
//lv stuff
  switch(FEAT_TRAINS, SELF, keisei33_front_timed, current_year){
    0..1940:keisei33_2_front;    keisei33_3_front;
  }
  switch(FEAT_TRAINS, SELF, keisei33_front_rev_timed, current_year){
    0..1940:keisei33_2_front_rev;    keisei33_3_front_rev;
  }
  switch(FEAT_TRAINS, SELF, keisei33_end_timed, current_year){
    0..1940:keisei33_2_end;    keisei33_3_end;
  }
  switch(FEAT_TRAINS, SELF, keisei33_end_rev_timed, current_year){
    0..1940:keisei33_2_end_rev;    keisei33_3_end_rev;
  }

  switch(FEAT_TRAINS, SELF, keisei33_front, cargo_subtype){
    2:keisei33_2_front;    3:keisei33_3_front;
    keisei33_front_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei33_front_rev, cargo_subtype){
    2:keisei33_2_front_rev;    3:keisei33_3_front_rev;
    keisei33_front_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei33_end, cargo_subtype){
    2:keisei33_2_end;    3:keisei33_3_end;
    keisei33_end_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei33_end_rev, cargo_subtype){
    2:keisei33_2_end_rev;    3:keisei33_3_end_rev;
    keisei33_end_rev_timed;
  }
//
//*livery 2-3
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_keisei33_front_gfx_1,vehicle_is_reversed){
      1: keisei33_front_rev;
      keisei33_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_keisei33_front_gfx,vehicle_is_reversed==1&&num_vehs_in_consist>1){
      1: keisei33_front;
      sw_keisei33_front_gfx_1;
    }
  //panto
	  switch(FEAT_TRAINS, SELF, sw_keisei33_panto_placer_1,position_in_vehid_chain %2){
      0: keisei33_end;
      keisei33_end_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei33_panto_placer_1_rev,position_in_vehid_chain_from_end %2){
      0: keisei33_end;
      keisei33_end_rev;
    }
    switch(FEAT_TRAINS, PARENT, sw_keisei33_panto_placer_main,vehicle_is_reversed){
      1: sw_keisei33_panto_placer_1_rev;
      sw_keisei33_panto_placer_1;
    }
	//main
    switch(FEAT_TRAINS, SELF, sw_keisei33_gfx_main,position_in_vehid_chain_from_end){
      0: keisei33_end;
      sw_keisei33_panto_placer_main;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei33_lv_2,vehicle_type_id){
      mu_car: sw_keisei33_gfx_main;
      sw_keisei33_front_gfx;
    }
//

//liveries
  switch(FEAT_TRAINS, PARENT, sw_keisei33_lv,build_year<1925||cargo_subtype==1){
    1:sw_keisei33_livery_1;
    sw_keisei33_lv_2;
  }
  switch(FEAT_TRAINS, SELF, sw_keisei33_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1922);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_GREEN)),1924);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_WAR)),1941);
  }