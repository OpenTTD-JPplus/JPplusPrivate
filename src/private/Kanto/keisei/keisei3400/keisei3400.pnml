spriteset (keisei3400_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3400/keisei3400_1.png") { tmpl_std_v3(0, 0) }
spriteset (keisei3400_1_head_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3400/keisei3400_2.png") { tmpl_std_v3(0, 0) }
