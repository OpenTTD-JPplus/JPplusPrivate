  spriteset(keisei3400_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3400/keisei3400_1.png"){ tmpl_purchase_2c_dual(0, 25) }
