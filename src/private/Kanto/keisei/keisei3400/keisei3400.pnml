//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keisei3400_capacity_main,vehicle_type_id){
      mu_car: 133;
      123;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei3400_car_power_main,position_in_vehid_chain%4){
      0..1:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei3400_power_main,vehicle_type_id){
      mu_car: sw_keisei3400_car_power_main;
      return 140*2;
