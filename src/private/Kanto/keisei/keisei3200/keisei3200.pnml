  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei3200_panto_placer_main_1,position_in_vehid_chain %8){
        0: sw_keisei3200_mot_rev;
        3: sw_keisei3200_mot_2;
        sw_keisei3200_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_keisei3200_panto_placer_main_2,position_in_vehid_chain %4){
        0: sw_keisei3200_mot_rev;
        1: sw_keisei3200_mot;
        sw_keisei3200_wag;
      }
    switch(FEAT_TRAINS, SELF, sw_keisei3200_panto_placer_main,num_vehs_in_vehid_chain){
        4: sw_keisei3200_panto_placer_main_1;
        sw_keisei3200_panto_placer_main_2;
      }
  //fake-head-placer
    //var 1 (8+)
      switch(FEAT_TRAINS, SELF, sw_keisei3200_fake_head_placer_gfx,position_in_vehid_chain%4){
        2: sw_keisei3200_end_rev;
        3: sw_keisei3200_end;
        sw_keisei3200_panto_placer_main;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei3200_fake_head_placer_main,num_vehs_in_vehid_chain){
        0..7: sw_keisei3200_panto_placer_main;
        sw_keisei3200_fake_head_placer_gfx;
      }
  switch(FEAT_TRAINS, SELF, sw_keisei3200_gfx_main,position_in_vehid_chain_from_end){
    0: sw_keisei3200_end;
    sw_keisei3200_front;
  }
  switch(FEAT_TRAINS, SELF, sw_keisei3200_lv,vehicle_type_id){
    mu_car: sw_keisei3200_fake_head_placer_main;
    sw_keisei3200_gfx_main;
  }
//
//*liveries
  switch(FEAT_TRAINS, SELF, sw_keisei3200_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AKADEN)),1964);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AKADEN)),1980);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_WHITE)),1989);
    4:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_TEST_1)),1993);
    5:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_TEST_2)),1993);
  }
//post fixers
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei3200_car_power_main,position_in_vehid_chain_from_end %6){
      0..3:return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei3200_power_main,position_in_vehid_chain_from_end %6){
      mu_car:sw_keisei3200_car_power_main;
      return 100*2;
    }
