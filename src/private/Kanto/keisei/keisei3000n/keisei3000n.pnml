//purchase
  spriteset(keisei3000n_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3000n/keisei3000n_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei3000n_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3000n/keisei3000n_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_5(keisei3000n_purchase, keisei3000n_purchase_c1, keisei3000n_purchase_c2, ac_single_1_c1, ac_single_1_c2, panto_arm_n_c2)
//*main
  spriteset(keisei3000n_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3000n/keisei3000n_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(keisei3000n_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3000n/keisei3000n_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei3000n_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keisei3000n_lights_back;
    keisei3000n_lights_front;
  }
spriteset (keisei3000n_1_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3000n/keisei3000n_1.png") { tmpl_std_v3(0, 0) }
spriteset (keisei3000n_1_car, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3000n/keisei3000n_1.png") { tmpl_symm_v3(0, 25) }

spriteset (keisei3000n_2_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3000n/keisei3000n_2.png") { tmpl_std_v3(0, 0) }
spriteset (keisei3000n_2_car, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3000n/keisei3000n_2.png") { tmpl_symm_v3(0, 25) }

spriteset (keisei3000n_3_head, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3000n/keisei3000n_3.png") { tmpl_std_v3(0, 0) }
spriteset (keisei3000n_3_car, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei3000n/keisei3000n_3.png") { tmpl_symm_v3(0, 25) }
//
  switch(FEAT_TRAINS, SELF, sw_keisei3000n_head, cargo_subtype){
    0:keisei3000n_1_head;    1:keisei3000n_2_head;    keisei3000n_3_head;
  }
  switch(FEAT_TRAINS, SELF, sw_keisei3000n_car, cargo_subtype){
    0:keisei3000n_1_car;    1:keisei3000n_2_car;    keisei3000n_3_car;
  }
  TRAIN_CONSTRUCTOR_3(keisei3000n_head, sw_keisei3000n_head, sw_keisei3000n_lights, ac_single_1_1)
  TRAIN_CONSTRUCTOR_2(keisei3000n_wag, sw_keisei3000n_car, ac_single_1_1)
  TRAIN_CONSTRUCTOR_3(keisei3000n_mot, sw_keisei3000n_car, ac_single_1_1, panto_arm_n_single)
  TRAIN_CONSTRUCTOR_3(keisei3000n_mot_2, sw_keisei3000n_car, ac_single_1_1, panto_arm_n)
//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei3000n_panto_placer_main_1,position_in_vehid_chain %8){
        0: keisei3000n_mot_2;
        2: keisei3000n_mot;
        5: keisei3000n_mot_2;
        keisei3000n_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_keisei3000n_panto_placer_main_2,position_in_vehid_chain_from_end %3){
        0: keisei3000n_mot_2;
        default: keisei3000n_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei3000n_panto_placer_main,num_vehs_in_vehid_chain){
        4..5: sw_keisei3000n_panto_placer_main_2;
        sw_keisei3000n_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keisei3000n_lv,vehicle_type_id){
        mu_car: sw_keisei3000n_panto_placer_main;
        keisei3000n_head;
    }
//
//*liveries
  switch(FEAT_TRAINS, SELF, sw_keisei3000n_lv_desc_main,cargo_subtype){
    0:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2003);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_keisei3000n_2)),2010);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_keisei3000n_3)),2019);
  }
//post fixers
    switch(FEAT_TRAINS, SELF, sw_keisei3000n_capacity_main,vehicle_type_id){
      mu_car: 133;
      122;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei3000n_car_power_main,position_in_vehid_chain_from_end %8){
      0..1:return 125;
      4..5:return 125;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei3000n_power_main,vehicle_type_id){
      mu_car:sw_keisei3000n_car_power_main;
      return 125*2;
    }
  //speed fix
    switch(FEAT_TRAINS, SELF, sw_keisei3000n_speed_main,build_year){
      0..2009: 120;
      130;
    }
