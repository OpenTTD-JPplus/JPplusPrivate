  }
  switch(FEAT_TRAINS, SELF, keisei3100_mot, cargo_subtype){
    0:keisei3100_mot_timed;    1:keisei3100_1_mot;
    2:sw_keisei3100_2_mot;    keisei3100_3_mot;
  }
  switch(FEAT_TRAINS, SELF, keisei3100_wag, cargo_subtype){
    0:keisei3100_wag_timed;    1:keisei3100_1_wag;
    2:sw_keisei3100_2_wag;    keisei3100_3_wag;
  }
//
//*livery 1
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_keisei3100_front, vehicle_is_reversed){
      1:keisei3100_front;
      keisei3100_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_keisei3100_end, vehicle_is_reversed){
      1:keisei3100_end_mot;
      keisei3100_end;
    }  
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei3100_panto_placer_main,position_in_vehid_chain %2){
        1: keisei3100_mot;
        keisei3100_wag;
      }
  //fake-head-placer
    //var 1 (8+)
      switch(FEAT_TRAINS, SELF, sw_keisei3100_fake_head_placer_gfx,position_in_vehid_chain){
        2: keisei3100_end_rev;
        3: keisei3100_end_mot;
        sw_keisei3100_panto_placer_main;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei3100_fake_head_placer_main,num_vehs_in_vehid_chain>5){
        1: sw_keisei3100_fake_head_placer_gfx;
        sw_keisei3100_panto_placer_main;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keisei3100_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: sw_keisei3100_end;
        sw_keisei3100_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei3100_lv,vehicle_type_id){
        mu_car: sw_keisei3100_fake_head_placer_main;
        sw_keisei3100_gfx_main;
    }
//

//liveries
  switch(FEAT_TRAINS, SELF, sw_keisei3100_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AKADEN)),1960);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AKADEN)),1981);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_WHITE)),1992);
  }
