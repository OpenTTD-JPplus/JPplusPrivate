//purchase
  spriteset(keisei3100n_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3100n/keisei3100n_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei3100n_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3100n/keisei3100n_1.png"){ tmpl_purchase_2c_dual(88, 25) }
  GRAPHIC_STACK_2(keisei3100n_purchase, keisei3100n_purchase_c1, keisei3100n_purchase_c2)
//*main
  spriteset(keisei3100n_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3100n/keisei3100n_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(keisei3100n_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3100n/keisei3100n_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keisei3100n_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keisei3100n_lights_back;
    keisei3100n_lights_front;
  }
spriteset (keisei3100n_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3100n/keisei3100n_1.png") { tmpl_std_v3(0, 0) }
spriteset (keisei3100n_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei3100n/keisei3100n_1.png") { tmpl_std_v3(0, 25) }

TRAIN_CONSTRUCTOR_2(keisei3100n_head, keisei3100n_head_base, sw_keisei3100n_lights)
TRAIN_CONSTRUCTOR_2(keisei3100n_mot, keisei3100n_wag, panto_arm_n_single)
TRAIN_CONSTRUCTOR_2(keisei3100n_mot_2, keisei3100n_wag, panto_arm_n)
//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei3100n_panto_placer_main_1,position_in_vehid_chain %8){
        0: keisei3100n_mot_2;
        2: keisei3100n_mot;
        5: keisei3100n_mot_2;
        keisei3100n_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_keisei3100n_panto_placer_main_2,position_in_vehid_chain_from_end %3){
        0: keisei3100n_mot_2;
        default: keisei3100n_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei3100n_panto_placer_main,num_vehs_in_vehid_chain){
        4..5: sw_keisei3100n_panto_placer_main_2;
        sw_keisei3100n_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keisei3100n_lv,vehicle_type_id){
        mu_car: sw_keisei3100n_panto_placer_main;
        keisei3100n_head;
    }
//
//post fixers
    switch(FEAT_TRAINS, SELF, sw_keisei3100n_capacity_main,vehicle_type_id){
      mu_car: 133;
      122;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei3100n_car_power_main,position_in_vehid_chain %3){
      0:return 140;
      2:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei3100n_power_main,position_in_vehid_chain_from_end %8){
      mu_car:sw_keisei3100n_car_power_main;
      return 140*2;
    }
