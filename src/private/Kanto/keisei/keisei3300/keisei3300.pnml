//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keisei3300_panto_placer_main_1,position_in_vehid_chain %8){
        0: sw_keisei3300_mot_rev;
        1: sw_keisei3300_mot;
        3: sw_keisei3300_mot;
        sw_keisei3300_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_keisei3300_panto_placer_main_2,position_in_vehid_chain %2){
        0: sw_keisei3300_mot_rev;
        1: sw_keisei3300_mot;
        sw_keisei3300_wag;
      }
    switch(FEAT_TRAINS, SELF, sw_keisei3300_panto_placer_main,num_vehs_in_vehid_chain){
        0..5: sw_keisei3300_panto_placer_main_1;
        6..8:sw_keisei3300_panto_placer_main_2;
        sw_keisei3300_panto_placer_main_1;
      }
  //fake-head-placer
    //var 1 (8+)
      switch(FEAT_TRAINS, SELF, sw_keisei3300_fake_head_placer_gfx,position_in_vehid_chain%4){
        2: sw_keisei3300_end_rev;
        3: sw_keisei3300_end;
        sw_keisei3300_panto_placer_main;
      }
      switch(FEAT_TRAINS, SELF, sw_keisei3300_fake_head_placer_main,num_vehs_in_vehid_chain){
        0..5: sw_keisei3300_panto_placer_main;
        sw_keisei3300_fake_head_placer_gfx;
      }
  switch(FEAT_TRAINS, SELF, sw_keisei3300_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
    1: sw_keisei3300_end;
    sw_keisei3300_front;
  }
  switch(FEAT_TRAINS, SELF, sw_keisei3300_lv,vehicle_type_id){
    mu_car: sw_keisei3300_fake_head_placer_main;
    sw_keisei3300_gfx_main;
  }
//
//*liveries
  switch(FEAT_TRAINS, SELF, sw_keisei3300_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1968);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AKADEN)),1980);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_keisei3300_3)),1989);
    4:string(LV_DATED,string(STR_LIVERY,string(LV_keisei3300_4)),1995);
    5:string(LV_DATED,string(STR_LIVERY,string(LV_KEISEI_AODEN)),2009);
  }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei3300_car_power_main,position_in_vehid_chain_from_end %4){
      0..1:return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei3300_power_main,vehicle_type_id){
      mu_car:sw_keisei3300_car_power_main;
      return 100*2;
    }
//