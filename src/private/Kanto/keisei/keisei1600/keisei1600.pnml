spriteset (keisei1600_1_head_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,  "src/private/Kanto/keisei/keisei1600/keisei1600.png") { tmpl_std_rev_v3(0, 25) }
