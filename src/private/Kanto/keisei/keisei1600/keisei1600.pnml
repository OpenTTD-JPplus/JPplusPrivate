  spriteset(keisei1600_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei1600/keisei1600.png"){ tmpl_purchase_2c_dual(0, 50) }
