//purchase
  spriteset(keisei_AE1_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei_AE1/keisei_AE1_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei_AE1_purchase_c2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei_AE1/keisei_AE1_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(keisei_AE1_purchase_1, keisei_AE1_purchase_c1_1, keisei_AE1_purchase_c2_1)
  spriteset(keisei_AE1_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei_AE1/keisei_AE1_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keisei_AE1_purchase_c2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,"src/private/Kanto/keisei/keisei_AE1/keisei_AE1_2.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(keisei_AE1_purchase_2, keisei_AE1_purchase_c1_2, keisei_AE1_purchase_c2_2)
  
  switch(FEAT_TRAINS, SELF, keisei_AE1_purchase, current_year){
    0..1982: keisei_AE1_purchase_1;
    keisei_AE1_purchase_2;
  }
//*main
spriteset (keisei_AE1_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE1/keisei_AE1_1.png") { tmpl_std_v3(0, 0) }
spriteset (keisei_AE1_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE1/keisei_AE1_1.png") { tmpl_std_v3(0, 25) }
spriteset (keisei_AE1_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE1/keisei_AE1_1.png") { tmpl_std_v3(0, 50) }
spriteset (keisei_AE1_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE1/keisei_AE1_1.png") { tmpl_std_v3(0, 75) }

spriteset (keisei_AE1_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE1/keisei_AE1_2.png") { tmpl_std_v3(0, 0) }
spriteset (keisei_AE1_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE1/keisei_AE1_2.png") { tmpl_std_v3(0, 25) }
spriteset (keisei_AE1_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE1/keisei_AE1_2.png") { tmpl_std_v3(0, 50) }
spriteset (keisei_AE1_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keisei/keisei_AE1/keisei_AE1_2.png") { tmpl_std_v3(0, 75) }
//lv stuff
  switch(FEAT_TRAINS, SELF, keisei_AE1_front_timed, current_year){
    0..1982:keisei_AE1_1_front;    keisei_AE1_2_front;
  }
  switch(FEAT_TRAINS, SELF, keisei_AE1_end_timed, current_year){
    0..1982:keisei_AE1_1_end;    keisei_AE1_2_end;
  }
  switch(FEAT_TRAINS, SELF, keisei_AE1_mot_timed, current_year){
    0..1982:keisei_AE1_1_mot;    keisei_AE1_2_mot;
  }
  switch(FEAT_TRAINS, SELF, keisei_AE1_wag_timed, current_year){
    0..1982:keisei_AE1_1_wag;    keisei_AE1_2_wag;
  }

  switch(FEAT_TRAINS, SELF, keisei_AE1_front, cargo_subtype){
    1:keisei_AE1_1_front;    2:keisei_AE1_2_front;
    keisei_AE1_front_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei_AE1_end, cargo_subtype){
    1:keisei_AE1_1_end;    2:keisei_AE1_2_end;
    keisei_AE1_end_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei_AE1_mot, cargo_subtype){
    1:keisei_AE1_1_mot;    2:keisei_AE1_2_mot;
    keisei_AE1_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, keisei_AE1_wag, cargo_subtype){
    1:keisei_AE1_1_wag;    2:keisei_AE1_2_wag;
    keisei_AE1_wag_timed;
  }
//*main
  //panto-placers
    //var 1 (6 car)
      switch(FEAT_TRAINS, SELF, sw_keisei_AE1_panto_placer_main_1,position_in_vehid_chain %4){
        0: keisei_AE1_mot;
        2: keisei_AE1_mot;
        keisei_AE1_wag;
      }
    //var 2 (8 car)
      switch(FEAT_TRAINS, SELF, sw_keisei_AE1_panto_placer_main_2,position_in_vehid_chain %4){
        0: keisei_AE1_mot;
        keisei_AE1_wag;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_keisei_AE1_panto_placer_main,num_vehs_in_vehid_chain){
        3..4:sw_keisei_AE1_panto_placer_main_1;
        sw_keisei_AE1_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keisei_AE1_head_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
      1:keisei_AE1_end;
      keisei_AE1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei_AE1_lv,vehicle_type_id){
      mu_car:sw_keisei_AE1_panto_placer_main;
      sw_keisei_AE1_head_gfx_main;
    }
//lv desc
  switch(FEAT_TRAINS, SELF, sw_keisei_AE1_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1973);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_keisei_AE1_2)),1983);
  }

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keisei_AE1_capacity_main,vehicle_type_id){
      mu_car: 60;
      48;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keisei_AE1_car_power_main,position_in_vehid_chain%8){
      0..3:return 140;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keisei_AE1_power_main,vehicle_type_id){
      mu_car:sw_keisei_AE1_car_power_main;
      0;
    }
