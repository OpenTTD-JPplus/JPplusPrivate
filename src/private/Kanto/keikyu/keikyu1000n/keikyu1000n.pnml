    //panto controller
      switch(FEAT_TRAINS, PARENT, sw_keikyu1000n_panto_placer_main_0_8,build_year){
        0..2006: sw_keikyu1000n_panto_placer_main_1;
        sw_keikyu1000n_panto_placer_main_2;
      }
      switch(FEAT_TRAINS, PARENT, sw_keikyu1000n_panto_placer_main_0_6,build_year){
        0..2012: sw_keikyu1000n_panto_placer_main_6;
        sw_keikyu1000n_panto_placer_main_3;
      }
      switch(FEAT_TRAINS, PARENT, sw_keikyu1000n_panto_placer_main_0_4,build_year){
        0..2002: sw_keikyu1000n_panto_placer_main_4;
        2003..2007:sw_keikyu1000n_panto_placer_main_7;
        2008..2022:sw_keikyu1000n_panto_placer_main_5;
        sw_keikyu1000n_panto_placer_main_7;
      }

      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_panto_placer_main_0,num_vehs_in_vehid_chain){
        2:sw_keikyu1000n_panto_placer_main_0_4;
        4..5: sw_keikyu1000n_panto_placer_main_0_6;
        8: sw_keikyu1000n_panto_placer_main_3;
        sw_keikyu1000n_panto_placer_main_0_8;
      }
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_panto_placer_main,num_vehs_in_vehid_chain==2&&cargo_subtype==3){
        1:sw_keikyu1000n_panto_placer_main_ciel;
        sw_keikyu1000n_panto_placer_main_0;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: keikyu1000n_end;
        keikyu1000n_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_lv,vehicle_type_id){
        mu_car: sw_keikyu1000n_panto_placer_main;
        sw_keikyu1000n_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_keikyu1000n_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),2002);
    2:string(LV_DATED,string(STR_LIVERY,string(STR_SUTEN)),2007);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_KEIKYU1000N_3)),2020);
  }

//post fixers
  //capacity-changer
    //1-5
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_capacity_main_1,vehicle_type_id){
        mu_car: 130;
        122;
      }
    //6-9
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_capacity_2_0,position_in_vehid_chain_from_end){
          0: 119;
          default: 130;
      }
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_capacity_2,position_in_vehid_chain){
          0: 119;
          default: sw_keikyu1000n_capacity_2_0;
      }
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_capacity_main_2,vehicle_type_id){
        mu_car: sw_keikyu1000n_capacity_2_0;
        sw_keikyu1000n_capacity_2;
      }
    //10-15
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_capacity_main_3,vehicle_type_id){
        mu_car: 129;
        118;
      }
    //16
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_capacity_main_4,vehicle_type_id){
        mu_car: 126;
        116;
      }
    switch(FEAT_TRAINS, PARENT, sw_keikyu1000n_capacity_main, build_year){
      0..2006:sw_keikyu1000n_capacity_main_1;
      2007..2009:sw_keikyu1000n_capacity_main_2;
      2010..2015:sw_keikyu1000n_capacity_main_3;
      sw_keikyu1000n_capacity_main_4;
    }
  
  //power fix
    //1-2
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_power_main_1,position_in_vehid_chain %4){
      2..3:return 190;
      return 0;
    }
    //3
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_power_main_2,position_in_vehid_chain %8){
      1..4:return 190;
      return 0;
    }
    //6-19
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_power_main_3_def,position_in_vehid_chain %3){
      0..1:return 155;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_power_main_3_6,position_in_vehid_chain %3){
      0:return 155;
      3:return 155;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_power_main_3,num_vehs_in_vehid_chain){
      4:sw_keikyu1000n_power_main_3_6;
      sw_keikyu1000n_power_main_3_def;
    }
    //20
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_power_main_4_def,position_in_vehid_chain %3){
      0:return 190;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_power_main_4_4,position_in_vehid_chain %4){
      2..3:return 190;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_power_main_4,num_vehs_in_vehid_chain){
      4:sw_keikyu1000n_power_main_4_4;
      sw_keikyu1000n_power_main_4_def;
    }
    switch(FEAT_TRAINS, PARENT, sw_keikyu1000n_car_power_main,build_year){
      0..2004: sw_keikyu1000n_power_main_1;
      2005..2006:sw_keikyu1000n_power_main_2;
      2007..2019:sw_keikyu1000n_power_main_3;
      sw_keikyu1000n_power_main_4;
    }
    switch(FEAT_TRAINS, PARENT, sw_keikyu1000n_head_power_main,build_year){
      2007..2019: return 155*2;
      return 190*2;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu1000n_power_main,vehicle_type_id){
      mu_car: sw_keikyu1000n_car_power_main;
      sw_keikyu1000n_head_power_main;
    }
