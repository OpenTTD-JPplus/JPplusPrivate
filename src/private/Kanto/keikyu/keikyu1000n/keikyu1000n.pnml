        0: keikyu1000n_mot_2;
        5: keikyu1000n_mot_2;
        9: keikyu1000n_mot_2;
        default: keikyu1000n_wag;
      }
    //var 2 (8 car 2)
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_panto_placer_main_2,position_in_vehid_chain %11){
        0: keikyu1000n_mot_2;
        2: keikyu1000n_mot;
        5: keikyu1000n_mot_2;
        9: keikyu1000n_mot_2;
        default: keikyu1000n_wag;
      }
    //var 3 (alt + 6 22batch)
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_panto_placer_main_3,position_in_vehid_chain %3){
        0: keikyu1000n_mot_2;
        default: keikyu1000n_wag;
      }
    //var 4 (4 car)
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_panto_placer_main_4,position_in_vehid_chain %3){
        0: keikyu1000n_mot;
        1: keikyu1000n_mot;
        default: keikyu1000n_wag;
      }
    //var 5 (4 car 2)
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_panto_placer_main_5,position_in_vehid_chain %3){
        0: keikyu1000n_mot_rev;
        1: keikyu1000n_mot_rev;
        default: keikyu1000n_wag;
      }
    //var 6 (6 car)
      switch(FEAT_TRAINS, SELF, sw_keikyu1000n_panto_placer_main_6,position_in_vehid_chain %6){
        0: keikyu1000n_mot_rev;
        3: keikyu1000n_mot_2;
        default: keikyu1000n_wag;
