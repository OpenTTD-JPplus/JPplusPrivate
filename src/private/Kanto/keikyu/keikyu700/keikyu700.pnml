//purchase
  spriteset(keikyu700_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu700/keikyu700_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keikyu700_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu700/keikyu700_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(keikyu700_purchase, keikyu700_purchase_c1, keikyu700_purchase_c2)
//livery 1
spriteset (keikyu700_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu700/keikyu700_1.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keikyu700_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu700/keikyu700_1.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu700_1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu700/keikyu700_1.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu700_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu700/keikyu700_1.png") { tmpl_symm_v3(0, 50) }

spriteset (keikyu700_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu700/keikyu700_2.png") { tmpl_std_rev_v3(0, 0) }
spriteset (keikyu700_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu700/keikyu700_2.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu700_2_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu700/keikyu700_2.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu700_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu700/keikyu700_2.png") { tmpl_symm_v3(0, 50) }

//*livery 1
  //special gfx timed
    switch(FEAT_TRAINS, SELF, sw_keikyu700_1_front_gfx, current_year>1980){
      1:keikyu700_2_front;      keikyu700_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu700_1_end_gfx, current_year>1980){
      1:keikyu700_2_end;      keikyu700_1_end;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu700_1_end_rev_gfx, current_year>1980){
      1:keikyu700_2_end_rev;      keikyu700_1_end_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu700_1_wag_gfx, current_year>1980){
      1:keikyu700_2_wag;      keikyu700_1_wag;
    }
  //fake head (panto)
    //var 1 4+x
      switch(FEAT_TRAINS, SELF, sw_keikyu700_1_panto_placer_main_1,position_in_vehid_chain %4){
        2: sw_keikyu700_1_end_rev_gfx;
        3: sw_keikyu700_1_end_gfx;
        default: sw_keikyu700_1_wag_gfx;
      }
    //var 2 3+x
      switch(FEAT_TRAINS, SELF, sw_keikyu700_1_panto_placer_main_2,position_in_vehid_chain %3){
        1: sw_keikyu700_1_end_rev_gfx;
        2: sw_keikyu700_1_end_gfx;
        default: sw_keikyu700_1_wag_gfx;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_keikyu700_1_panto_placer_main,num_vehs_in_vehid_chain){
        0..2: sw_keikyu700_1_wag_gfx;
        3..4: sw_keikyu700_1_panto_placer_main_2;
        7: sw_keikyu700_1_panto_placer_main_2;
        sw_keikyu700_1_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keikyu700_1_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: sw_keikyu700_1_end_gfx;
        sw_keikyu700_1_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu700_lv,vehicle_type_id){
        mu_car: sw_keikyu700_1_panto_placer_main;
        sw_keikyu700_1_gfx_main;
    }

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keikyu700_capacity_main,vehicle_type_id){
      mu_car: 140;
      135;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keikyu700_car_power_main,position_in_vehid_chain %4){
      2..3:return 150;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu700_power_main,vehicle_type_id){
      mu_car:sw_keikyu700_car_power_main;
      return 150*2;
    }
