//purchase
  spriteset(keikyu600_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keikyu600_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_1.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(keikyu600_purchase, keikyu600_purchase_c1, keikyu600_purchase_c2)
//livery 1
spriteset (keikyu600_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_1.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu600_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_1.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu600_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_1.png") { tmpl_std_v3(0, 50) }
spriteset (keikyu600_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_1.png") { tmpl_std_v3(0, 75) }
spriteset (keikyu600_1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_1.png") { tmpl_std_rev_v3(0, 75) }
spriteset (keikyu600_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_1.png") { tmpl_std_v3(0, 100) }
spriteset (keikyu600_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_1.png") { tmpl_symm_v3(0, 125) }

spriteset (keikyu600_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_2.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu600_2_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_2.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu600_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_2.png") { tmpl_std_v3(0, 50) }
spriteset (keikyu600_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_2.png") { tmpl_std_v3(0, 75) }
spriteset (keikyu600_2_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_2.png") { tmpl_std_rev_v3(0, 75) }
spriteset (keikyu600_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_2.png") { tmpl_std_v3(0, 100) }
spriteset (keikyu600_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu600/keikyu600_2.png") { tmpl_symm_v3(0, 125) }

//*livery 1
  //special gfx timed
    switch(FEAT_TRAINS, SELF, sw_keikyu600_1_front_mot_gfx, current_year>1980){
      1:keikyu600_2_front_mot;      keikyu600_1_front_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600_1_end_mot_gfx, current_year>1980){
      1:keikyu600_2_end_mot;      keikyu600_1_end_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600_1_front_gfx, current_year>1980){
      1:keikyu600_2_front;      keikyu600_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600_1_end_gfx, current_year>1980){
      1:keikyu600_2_end;      keikyu600_1_end;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600_1_end_rev_gfx, current_year>1980){
      1:keikyu600_2_end_rev;      keikyu600_1_end_rev;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600_1_mot_gfx, current_year>1980){
      1:keikyu600_2_mot;      keikyu600_1_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600_1_wag_gfx, current_year>1980){
      1:keikyu600_2_wag;      keikyu600_1_wag;
    }
  //head
    switch(FEAT_TRAINS, PARENT, sw_keikyu600_1_front, vehicle_is_reversed){
      1:sw_keikyu600_1_front_gfx;
      sw_keikyu600_1_front_mot_gfx;
    }
    switch(FEAT_TRAINS, PARENT, sw_keikyu600_1_end, vehicle_is_reversed){
      1:sw_keikyu600_1_end_mot_gfx;
      sw_keikyu600_1_end_gfx;
    }
  //panto placer
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keikyu600_1_panto_placer_main,position_in_vehid_chain %2){
        1: sw_keikyu600_1_mot_gfx;
        default: sw_keikyu600_1_wag_gfx;
      }
  //fake head placer
    //var 1 4+x
      switch(FEAT_TRAINS, SELF, sw_keikyu600_1_fake_head_placer_main_1,position_in_vehid_chain){
        2: sw_keikyu600_1_end_rev_gfx;
        3: sw_keikyu600_1_end_mot_gfx;
        default: sw_keikyu600_1_panto_placer_main;
      }
    //var 2 6+x
      switch(FEAT_TRAINS, SELF, sw_keikyu600_1_fake_head_placer_main_2,position_in_vehid_chain){
        4: sw_keikyu600_1_end_rev_gfx;
        5: sw_keikyu600_1_end_mot_gfx;
        default: sw_keikyu600_1_panto_placer_main;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_keikyu600_1_fake_head_placer_main,num_vehs_in_vehid_chain){
        0..5: sw_keikyu600_1_panto_placer_main;
        6..9:sw_keikyu600_1_fake_head_placer_main_1;
        sw_keikyu600_1_fake_head_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keikyu600_1_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: sw_keikyu600_1_end;
        sw_keikyu600_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600_lv,vehicle_type_id){
        mu_car: sw_keikyu600_1_fake_head_placer_main;
        sw_keikyu600_1_gfx_main;
    }

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keikyu600_capacity_main,vehicle_type_id){
      mu_car: 130;
      120;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keikyu600_car_power_main,position_in_vehid_chain_from_end %8){
      0..5:return 120;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600_head_power_main,position_in_vehid_chain){
      0:return 120;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600_power_main,position_in_vehid_chain_from_end %8){
      mu_car:sw_keikyu600_car_power_main;
      sw_keikyu600_head_power_main;
    }
//