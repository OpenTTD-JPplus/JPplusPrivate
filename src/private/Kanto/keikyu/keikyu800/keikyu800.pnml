//purchase
  spriteset(keikyu800_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu800/keikyu800_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keikyu800_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu800/keikyu800_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(keikyu800_purchase, keikyu800_purchase_c1, keikyu800_purchase_c2)
//livery 1
spriteset (keikyu800_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu800/keikyu800_1.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu800_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu800/keikyu800_1.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu800_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu800/keikyu800_1.png") { tmpl_symm_v3(0, 50) }
spriteset (keikyu800_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu800/keikyu800_1.png") { tmpl_symm_v3(0, 75) }

spriteset (keikyu800_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu800/keikyu800_2.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu800_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu800/keikyu800_2.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu800_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu800/keikyu800_2.png") { tmpl_symm_v3(0, 50) }
spriteset (keikyu800_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu800/keikyu800_2.png") { tmpl_symm_v3(0, 75) }

switch(FEAT_TRAINS, SELF, keikyu800_front_timed, current_year){
  0..2000:keikyu800_1_front;  keikyu800_2_front;
}
switch(FEAT_TRAINS, SELF, keikyu800_end_timed, current_year){
  0..2000:keikyu800_1_end;  keikyu800_2_end;
}
switch(FEAT_TRAINS, SELF, keikyu800_mot_timed, current_year){
  0..2000:keikyu800_1_mot;  keikyu800_2_mot;
}
switch(FEAT_TRAINS, SELF, keikyu800_wag_timed, current_year){
  0..2000:keikyu800_1_wag;  keikyu800_2_wag;
}

switch(FEAT_TRAINS, SELF, keikyu800_front, cargo_subtype){
 0:keikyu800_front_timed;  1:keikyu800_1_front;  keikyu800_2_front;
}
switch(FEAT_TRAINS, SELF, keikyu800_end, cargo_subtype){
 0:keikyu800_end_timed;  1:keikyu800_1_end;  keikyu800_2_end;
}
switch(FEAT_TRAINS, SELF, keikyu800_mot, cargo_subtype){
 0:keikyu800_mot_timed;  1:keikyu800_1_mot;  keikyu800_2_mot;
}
switch(FEAT_TRAINS, SELF, keikyu800_wag, cargo_subtype){
 0:keikyu800_wag_timed;  1:keikyu800_1_wag;  keikyu800_2_wag;
}
//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keikyu800_panto_placer_main_1,position_in_vehid_chain %3){
        0: keikyu800_mot;
        default: keikyu800_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_keikyu800_panto_placer_main_2,position_in_vehid_chain %3){
        1: keikyu800_mot;
        default: keikyu800_wag;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_keikyu800_panto_placer_main,num_vehs_in_vehid_chain){
        3: sw_keikyu800_panto_placer_main_2;
        6..7: sw_keikyu800_panto_placer_main_2;
        sw_keikyu800_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keikyu800_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: keikyu800_end;
        keikyu800_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu800_lv,vehicle_type_id){
        mu_car: sw_keikyu800_panto_placer_main;
        sw_keikyu800_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_keikyu800_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1978);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_RENEW)),2001);
  }

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keikyu800_capacity_main,vehicle_type_id){
      mu_car: 144;
      138;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keikyu800_car_power_main,position_in_vehid_chain_from_end %6){
      0..3:return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu800_power_main,position_in_vehid_chain_from_end %8){
      mu_car:sw_keikyu800_car_power_main;
      return 100*2;
    }
