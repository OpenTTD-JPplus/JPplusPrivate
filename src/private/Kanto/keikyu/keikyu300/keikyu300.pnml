  }
  switch(FEAT_TRAINS, SELF, keikyu300_end_mot_2_timed_1, current_year){
    0..1957:keikyu300_1_end_mot_2;    keikyu300_3_end_mot_2;
  }
  switch(FEAT_TRAINS, SELF, keikyu300_end_timed_1, current_year){
    0..1957:keikyu300_1_end;    keikyu300_3_end;
  }
  switch(FEAT_TRAINS, SELF, keikyu300_end_rev_timed_1, current_year){
    0..1957:keikyu300_1_end_rev;    keikyu300_3_end_rev;
  }
  switch(FEAT_TRAINS, SELF, keikyu300_wag_timed_1, current_year){
    0..1957:keikyu300_1_wag;    keikyu300_3_wag;
  }

  switch(FEAT_TRAINS, SELF, keikyu300_front_mot_2_timed, build_year){
    0..1964:keikyu300_front_mot_2_timed_1;    keikyu400_1_front_mot_1;
  }
switch(FEAT_TRAINS, SELF, keikyu300_end_mot_2_timed, build_year){
