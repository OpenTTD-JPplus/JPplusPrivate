    0..1964:keikyu300_end_rev_timed_1;    keikyu400_1_end_rev;
  }
switch(FEAT_TRAINS, SELF, keikyu300_wag_timed, build_year){
    0..1964:keikyu300_wag_timed_1;    keikyu400_1_wag;
  }

  switch(FEAT_TRAINS, SELF, keikyu300_front_mot_2, cargo_subtype){
    1:keikyu300_1_front_mot_2;    2:keikyu300_2_front_mot_2;
    3:keikyu300_3_front_mot_2;    4:keikyu400_1_front_mot_1;
    keikyu300_front_mot_2_timed;
  }
  switch(FEAT_TRAINS, SELF, keikyu300_end_mot_2, cargo_subtype){
    1:keikyu300_1_end_mot_2;    2:keikyu300_2_end_mot_2;
    3:keikyu300_3_end_mot_2;    4:keikyu400_1_end_mot_1;
    keikyu300_end_mot_2_timed;
  }
  switch(FEAT_TRAINS, SELF, keikyu300_end_rev, cargo_subtype){
    1:keikyu300_1_end_rev;    2:keikyu300_2_end_rev;
    3:keikyu300_3_end_rev;    4:keikyu400_1_end_rev;
    keikyu300_end_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, keikyu300_wag, cargo_subtype){
    1:keikyu300_1_wag;    2:keikyu300_2_wag;
    3:keikyu300_3_wag;    4:keikyu400_1_wag;
    keikyu300_wag_timed;
  }
//*livery 1
  //fake head (panto)
    //var 1 2+x
      switch(FEAT_TRAINS, SELF, sw_keikyu300_panto_placer_main_1,position_in_vehid_chain %2){
        0: keikyu300_end_rev;
        1: keikyu300_end_mot_2;
        default: keikyu300_wag;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_keikyu300_panto_placer_main,num_vehs_in_vehid_chain){
        0..2: keikyu300_wag;
        sw_keikyu300_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keikyu300_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: keikyu300_end_mot_2;
        keikyu300_front_mot_2;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu300_lv,vehicle_type_id){
        mu_car: sw_keikyu300_panto_placer_main;
        sw_keikyu300_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_keikyu300_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_keikyu_old)),1942);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_keikyu_red)),1958);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_keikyu_new)),1958);
    4:string(LV_DATED,string(STR_LIVERY,string(LV_keikyu400_1)),1965);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keikyu300_capacity_main,vehicle_type_id){
      mu_car: 140;
      135;
    }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keikyu300_car_power_main,position_in_vehid_chain_from_end %4){
      0..1:return 110;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu300_power_main,vehicle_type_id){
      mu_car:sw_keikyu300_car_power_main;
      return 110*2;
    }
