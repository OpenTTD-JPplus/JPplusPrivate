//purchase
  spriteset(keikyu2100_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keikyu2100_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_1.png"){ tmpl_purchase_2c_dual(0, 75) }
  GRAPHIC_STACK_2(keikyu2100_purchase, keikyu2100_purchase_c1, keikyu2100_purchase_c2)
//livery 1
spriteset (keikyu2100_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_1.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu2100_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_1.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu2100_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_1.png") { tmpl_symm_v3(0, 50) }
spriteset (keikyu2100_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_1.png") { tmpl_symm_v3(0, 75) }

spriteset (keikyu2100_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_2.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu2100_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_2.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu2100_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_2.png") { tmpl_symm_v3(0, 50) }
spriteset (keikyu2100_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_2.png") { tmpl_symm_v3(0, 75) }

spriteset (keikyu2100_3_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_3.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu2100_3_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_3.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu2100_3_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2100/keikyu2100_3.png") { tmpl_symm_v3(0, 50) }
