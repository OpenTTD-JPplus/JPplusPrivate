switch(FEAT_TRAINS, SELF, keikyu2100_front, cargo_subtype){
  0:keikyu2100_1_front;  1:keikyu2100_2_front;  keikyu2100_3_front;
}
switch(FEAT_TRAINS, SELF, keikyu2100_end, cargo_subtype){
  0:keikyu2100_1_end;  1:keikyu2100_2_end;  keikyu2100_3_end;
}
switch(FEAT_TRAINS, SELF, keikyu2100_mot, cargo_subtype){
  0:keikyu2100_1_mot;  1:keikyu2100_2_mot;  keikyu2100_3_mot;
}
switch(FEAT_TRAINS, SELF, keikyu2100_wag, cargo_subtype){
  0:keikyu2100_1_wag;  1:keikyu2100_2_wag;  keikyu2100_3_wag;
}
//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keikyu2100_panto_placer_main_1,position_in_vehid_chain %4){
        1: keikyu2100_mot;
        default: keikyu2100_wag;
      }
    //var 2 (8 car 2)
      switch(FEAT_TRAINS, SELF, sw_keikyu2100_panto_placer_main_2,position_in_vehid_chain %3){
        0: keikyu2100_mot;
        default: keikyu2100_wag;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_keikyu2100_panto_placer_main,num_vehs_in_vehid_chain){
        1: sw_keikyu2100_panto_placer_main_2;
        4..5: sw_keikyu2100_panto_placer_main_2;
        8..9: sw_keikyu2100_panto_placer_main_2;
        sw_keikyu2100_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keikyu2100_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: keikyu2100_end;
        keikyu2100_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu2100_lv,vehicle_type_id){
        mu_car: sw_keikyu2100_panto_placer_main;
        sw_keikyu2100_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_keikyu2100_lv_desc_main,cargo_subtype){
    0:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1998);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_keikyu_blue)),2005);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEIKYU2100_2)),2016);
  }

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keikyu2100_capacity_main,vehicle_type_id){
      mu_car: 120;
      111;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keikyu2100_car_power_main,position_in_vehid_chain %6){
      2..3:return 190;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu2100_power_main,vehicle_type_id){
      mu_car:sw_keikyu2100_car_power_main;
      return 190*2;
    }
