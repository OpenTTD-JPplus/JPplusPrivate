//purchase
  spriteset(keikyu2000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2000/keikyu2000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keikyu2000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2000/keikyu2000_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(keikyu2000_purchase, keikyu2000_purchase_c1, keikyu2000_purchase_c2)
//livery 1
spriteset (keikyu2000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2000/keikyu2000_1.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu2000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2000/keikyu2000_1.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu2000_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2000/keikyu2000_1.png") { tmpl_symm_v3(0, 50) }
spriteset (keikyu2000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2000/keikyu2000_1.png") { tmpl_symm_v3(0, 75) }

spriteset (keikyu2000_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2000/keikyu2000_2.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu2000_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2000/keikyu2000_2.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu2000_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2000/keikyu2000_2.png") { tmpl_symm_v3(0, 50) }
spriteset (keikyu2000_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu2000/keikyu2000_2.png") { tmpl_symm_v3(0, 75) }

switch(FEAT_TRAINS, SELF, keikyu2000_front, cargo_subtype){
  0..1:keikyu2000_1_front;  keikyu2000_2_front;
}
switch(FEAT_TRAINS, SELF, keikyu2000_end, cargo_subtype){
  0..1:keikyu2000_1_end;  keikyu2000_2_end;
}
switch(FEAT_TRAINS, SELF, keikyu2000_mot, cargo_subtype){
  0..1:keikyu2000_1_mot;  keikyu2000_2_mot;
}
switch(FEAT_TRAINS, SELF, keikyu2000_wag, cargo_subtype){
  0..1:keikyu2000_1_wag;  keikyu2000_2_wag;
}
//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keikyu2000_panto_placer_main_1,position_in_vehid_chain %5){
        0: keikyu2000_mot;
        default: keikyu2000_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_keikyu2000_panto_placer_main_2,position_in_vehid_chain %3){
        0: keikyu2000_mot;
        default: keikyu2000_wag;
      }
    //var 3
      switch(FEAT_TRAINS, SELF, sw_keikyu2000_panto_placer_main_3,position_in_vehid_chain %3){
        1: keikyu2000_mot;
        default: keikyu2000_wag;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_keikyu2000_panto_placer_main,num_vehs_in_vehid_chain){
        3: sw_keikyu2000_panto_placer_main_3;
        6..7: sw_keikyu2000_panto_placer_main_1;
        sw_keikyu2000_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keikyu2000_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: keikyu2000_end;
        keikyu2000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu2000_lv,vehicle_type_id){
        mu_car: sw_keikyu2000_panto_placer_main;
        sw_keikyu2000_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_keikyu2000_lv_desc_main,cargo_subtype){
    0..1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1982);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_KEIKYU2000_3)),2000);
  }

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keikyu2000_capacity_main,vehicle_type_id){
      mu_car: 120;
      111;
    }
  //load speed
  switch(FEAT_TRAINS, SELF, sw_keikyu2000_loading_speed_main,cargo_subtype){
    0..1:param_loading_2D;
    param_loading_3D;
  }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keikyu2000_car_power_main,position_in_vehid_chain_from_end %4){
      2..3:return 120;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu2000_power_main,vehicle_type_id){
      mu_car:sw_keikyu2000_car_power_main;
      return 120*2;
    }
  //sound fix
    switch(FEAT_TRAINS, SELF, sw_KQ2000_sound,build_year){
      0..1999:sw_KQ20002_start_sound;
      sw_KQ20003_start_sound;
    }
//