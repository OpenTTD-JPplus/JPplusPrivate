switch(FEAT_TRAINS, SELF, keikyu600n_front_mot, cargo_subtype){
  0:keikyu600n_1_front_mot;  1:keikyu600n_1_front_mot_1;  2:keikyu600n_1_front_mot_2;
  keikyu600n_2_front_mot;
}
switch(FEAT_TRAINS, SELF, keikyu600n_end_mot, cargo_subtype){
  0:keikyu600n_1_end_mot;  1:keikyu600n_1_end_mot_1;  2:keikyu600n_1_end_mot_2;
  keikyu600n_2_end_mot;
}
switch(FEAT_TRAINS, SELF, keikyu600n_front, cargo_subtype){
  0:keikyu600n_1_front;  1:keikyu600n_1_front_1;  2:keikyu600n_1_front_2;
  keikyu600n_2_front;
}
switch(FEAT_TRAINS, SELF, keikyu600n_end, cargo_subtype){
  0:keikyu600n_1_end;  1:keikyu600n_1_end_1;  2:keikyu600n_1_end_2;
  keikyu600n_2_end;
}
switch(FEAT_TRAINS, SELF, keikyu600n_mot, cargo_subtype){
  0..2:keikyu600n_1_mot;  keikyu600n_2_mot;
}
switch(FEAT_TRAINS, SELF, keikyu600n_mot_2, cargo_subtype){
  0..2:keikyu600n_1_mot_2;  keikyu600n_2_mot_2;
}
switch(FEAT_TRAINS, SELF, keikyu600n_mot_2n, cargo_subtype){
  0..2:keikyu600n_1_mot_2n;  keikyu600n_2_mot_2n;
}
switch(FEAT_TRAINS, SELF, keikyu600n_wag, cargo_subtype){
  0..2:keikyu600n_1_wag;  keikyu600n_2_wag;
}
//*Livery 1
  //special gfx
    switch(FEAT_TRAINS, PARENT, sw_keikyu600n_front_gfx,vehicle_is_reversed==0&&build_year<1996){
      1: keikyu600n_front_mot;
      keikyu600n_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_keikyu600n_end_gfx,vehicle_is_reversed==1&&build_year<1996){
      1: keikyu600n_end_mot;
      keikyu600n_end;
    }
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_keikyu600n_panto_placer_main_1,position_in_vehid_chain %2){
        1: keikyu600n_mot;
        keikyu600n_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_keikyu600n_panto_placer_main_2,position_in_vehid_chain_from_end %6){
        0: keikyu600n_mot;
        2: keikyu600n_mot_2;
        keikyu600n_wag;
      }
    //var 4 (batch 4)
      switch(FEAT_TRAINS, SELF, sw_keikyu600n_panto_placer_main_4,position_in_vehid_chain_from_end %3){
        0: keikyu600n_mot_2n;
        keikyu600n_wag;
      }
    switch(FEAT_TRAINS, SELF, sw_keikyu600n_panto_placer_main_0,num_vehs_in_vehid_chain){
      0..5:sw_keikyu600n_panto_placer_main_1;
      sw_keikyu600n_panto_placer_main_2;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600n_panto_placer_main,build_year){
      0..1995:sw_keikyu600n_panto_placer_main_0;
      sw_keikyu600n_panto_placer_main_4;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600n_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
      1: sw_keikyu600n_end_gfx;
      sw_keikyu600n_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600n_lv,vehicle_type_id){
      mu_car: sw_keikyu600n_panto_placer_main;
      sw_keikyu600n_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_keikyu600n_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_BATCH,1),1994);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1995);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_keikyu_blue)),2005);
  }

//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keikyu600n_capacity_main,vehicle_type_id){
      mu_car: 132;
      123;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keikyu600n_power_main_1,position_in_vehid_chain_from_end %8){
      2..5:return 120;
      return 0;
    }
    //4
    switch(FEAT_TRAINS, SELF, sw_keikyu600n_power_main_2,position_in_vehid_chain_from_end %4){
      2..3:return 180;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600n_car_power_main,build_year){
      0..1995:sw_keikyu600n_power_main_1;
      sw_keikyu600n_power_main_2;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600n_head_power_main,build_year){
      0..1995:return 120*2;
      return 180*2;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu600n_power_main,vehicle_type_id){
      mu_car: sw_keikyu600n_car_power_main;
      sw_keikyu600n_head_power_main;
    }
