//purchase
  spriteset(keikyu1500_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keikyu1500_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_1.png"){ tmpl_purchase_2c_dual(0, 150) }
  GRAPHIC_STACK_2(keikyu1500_purchase, keikyu1500_purchase_c1, keikyu1500_purchase_c2)
//livery 1
spriteset (keikyu1500_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_1.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu1500_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_1.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu1500_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_1.png") { tmpl_std_v3(0, 50) }
spriteset (keikyu1500_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_1.png") { tmpl_std_v3(0, 75) }
spriteset (keikyu1500_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_1.png") { tmpl_std_v3(0, 100) }
spriteset (keikyu1500_1_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_1.png") { tmpl_std_rev_v3(0, 100) }
spriteset (keikyu1500_1_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_1.png") { tmpl_symm_v3(0, 125) }
spriteset (keikyu1500_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_1.png") { tmpl_symm_v3(0, 150) }

spriteset (keikyu1500_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_2.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu1500_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_2.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu1500_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_2.png") { tmpl_std_v3(0, 50) }
spriteset (keikyu1500_2_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu1500/keikyu1500_2.png") { tmpl_std_v3(0, 75) }

//*Livery 1
  //special gfx
    //timed
    switch(FEAT_TRAINS, PARENT, sw_keikyu1500_1_front_mot,build_year>1989||current_year>2007){
      1: keikyu1500_2_front_mot;
      keikyu1500_1_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_keikyu1500_1_end_mot,build_year>1989||current_year>2007){
      1: keikyu1500_2_end_mot;
      keikyu1500_1_end_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_keikyu1500_1_front,build_year>1989||current_year>2007){
      1: keikyu1500_2_front;
      keikyu1500_1_front;
    }
    switch(FEAT_TRAINS, PARENT, sw_keikyu1500_1_end,build_year>1989||current_year>2007){
      1: keikyu1500_2_end;
      keikyu1500_1_end;
    }
    //head fixer
    switch(FEAT_TRAINS, PARENT, sw_keikyu1500_1_front_gfx,vehicle_is_reversed){
      1: sw_keikyu1500_1_front;
      sw_keikyu1500_1_front_mot;
    }
    switch(FEAT_TRAINS, PARENT, sw_keikyu1500_1_end_gfx,vehicle_is_reversed){
      1: sw_keikyu1500_1_end_mot;
      sw_keikyu1500_1_end;
    }
  //panto-placers
    //var 1 1988
      switch(FEAT_TRAINS, SELF, sw_keikyu1500_1_panto_placer_main_1,position_in_vehid_chain %2){
        1: keikyu1500_1_mot;
        keikyu1500_1_wag;
      }
    //var 2 1988 8 car
      switch(FEAT_TRAINS, SELF, sw_keikyu1500_1_panto_placer_main_2,position_in_vehid_chain %7){
        1: keikyu1500_1_mot_2;
        3: keikyu1500_1_mot_2;
        5: keikyu1500_1_mot;
        keikyu1500_1_wag;
      }
    //var 3 1989 8 car
      switch(FEAT_TRAINS, SELF, sw_keikyu1500_1_panto_placer_main_3,position_in_vehid_chain %7){
        3: keikyu1500_1_mot_2;
        5: keikyu1500_1_mot;
        keikyu1500_1_wag;
      }
      random_switch(FEAT_TRAINS,PARENT,sw_keikyu1500_1_panto_placer_main_8c){
        1:sw_keikyu1500_1_panto_placer_main_1;
        1:sw_keikyu1500_1_panto_placer_main_3;
      }
    //8 car main
    switch(FEAT_TRAINS, PARENT, sw_keikyu1500_1_panto_placer_main_0,build_year){
      0..1987: sw_keikyu1500_1_panto_placer_main_1;
      1988:sw_keikyu1500_1_panto_placer_main_2;
      sw_keikyu1500_1_panto_placer_main_8c;
      }
    switch(FEAT_TRAINS, SELF, sw_keikyu1500_1_panto_placer_main,num_vehs_in_vehid_chain){
      0..4:sw_keikyu1500_1_panto_placer_main_1;
      sw_keikyu1500_1_panto_placer_main_0;
    }
    //
    switch(FEAT_TRAINS, SELF, sw_keikyu1500_1_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
      1: sw_keikyu1500_1_end_gfx;
      sw_keikyu1500_1_front_gfx;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu1500_lv,vehicle_type_id){
      mu_car: sw_keikyu1500_1_panto_placer_main;
      sw_keikyu1500_1_gfx_main;
    }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keikyu1500_capacity_main,vehicle_type_id){
      mu_car: 132;
      123;
    }
  
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keikyu1500_car_power_main,position_in_vehid_chain_from_end %8){
      0..4:return 100;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu1500_power_main,vehicle_type_id){
      mu_car:sw_keikyu1500_car_power_main;
      return 100*2;
    }
