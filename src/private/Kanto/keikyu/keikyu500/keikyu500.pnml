//purchase
  spriteset(keikyu500_purchase_c1_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keikyu500_purchase_c2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_1.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(keikyu500_purchase_1, keikyu500_purchase_c1_1, keikyu500_purchase_c2_1)
  spriteset(keikyu500_purchase_c1_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_2.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keikyu500_purchase_c2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_2.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(keikyu500_purchase_2, keikyu500_purchase_c1_2, keikyu500_purchase_c2_2)
  spriteset(keikyu500_purchase_c1_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_3.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keikyu500_purchase_c2_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_3.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(keikyu500_purchase_3, keikyu500_purchase_c1_3, keikyu500_purchase_c2_3)

  switch(FEAT_TRAINS, SELF, keikyu500_purchase, current_year){
    0..1964: keikyu500_purchase_1;
    1965..1968: keikyu500_purchase_2;
    keikyu500_purchase_3;
  }
//livery 1
spriteset (keikyu500_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_1.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu500_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_1.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu500_1_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_1.png") { tmpl_std_rev_v3(0, 25) }
spriteset (keikyu500_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_1.png") { tmpl_symm_v3(0, 125) }

spriteset (keikyu500_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_2.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu500_2_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_2.png") { tmpl_std_v3(0, 25) }
spriteset (keikyu500_2_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_2.png") { tmpl_std_rev_v3(0, 25) }
spriteset (keikyu500_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_2.png") { tmpl_symm_v3(0, 125) }

spriteset (keikyu500_3_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_3.png") { tmpl_std_v3(0, 0) }
spriteset (keikyu500_3_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_3.png") { tmpl_std_v3(0, 25) }
