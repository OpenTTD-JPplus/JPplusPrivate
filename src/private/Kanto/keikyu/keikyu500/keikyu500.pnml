spriteset (keikyu500_3_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "src/private/Kanto/keikyu/keikyu500/keikyu500_3.png") { tmpl_symm_v3(0, 125) }

switch(FEAT_TRAINS, SELF, keikyu500_front_mot_timed, current_year){
  0..1964:keikyu500_1_front_mot;  keikyu500_2_front_mot;
}
switch(FEAT_TRAINS, SELF, keikyu500_end_mot_timed, current_year){
  0..1964:keikyu500_1_end_mot;  keikyu500_2_end_mot;
}
switch(FEAT_TRAINS, SELF, keikyu500_end_mot_rev_timed, current_year){
  0..1964:keikyu500_1_end_mot_rev;  keikyu500_2_end_mot_rev;
}
switch(FEAT_TRAINS, SELF, keikyu500_wag_timed, current_year){
  0..1964:keikyu500_1_wag;  keikyu500_2_wag;
}

switch(FEAT_TRAINS, SELF, keikyu500_front_mot_timed_2, build_year){
  0..1968:keikyu500_front_mot_timed;  keikyu500_3_front_mot;
}
switch(FEAT_TRAINS, SELF, keikyu500_end_mot_timed_2, build_year){
  0..1968:keikyu500_end_mot_timed;  keikyu500_3_end_mot;
}
switch(FEAT_TRAINS, SELF, keikyu500_end_mot_rev_timed_2, build_year){
  0..1968:keikyu500_end_mot_rev_timed;  keikyu500_3_end_mot_rev;
}
switch(FEAT_TRAINS, SELF, keikyu500_wag_timed_2, build_year){
  0..1968:keikyu500_wag_timed;  keikyu500_3_wag;
}

switch(FEAT_TRAINS, SELF, keikyu500_front_mot, cargo_subtype){
  0:keikyu500_front_mot_timed_2;  1:keikyu500_1_front_mot;
  keikyu500_2_front_mot;
}
switch(FEAT_TRAINS, SELF, keikyu500_end_mot, cargo_subtype){
  0:keikyu500_end_mot_timed_2;  1:keikyu500_1_end_mot;
  keikyu500_2_end_mot;
}
switch(FEAT_TRAINS, SELF, keikyu500_end_mot_rev, cargo_subtype){
  0:keikyu500_end_mot_rev_timed_2;  1:keikyu500_1_end_mot_rev;
  keikyu500_2_end_mot_rev;
}
switch(FEAT_TRAINS, SELF, keikyu500_wag, cargo_subtype){
  0:keikyu500_wag_timed_2;  1:keikyu500_1_wag;
  keikyu500_2_wag;
}
//*livery 1
  //fake head (panto)
    //var 1 4+x
      switch(FEAT_TRAINS, SELF, sw_keikyu500_panto_placer_main_1,position_in_vehid_chain %4){
        2: keikyu500_end_mot;
        3: keikyu500_end_mot_rev;
        default: keikyu500_wag;
      }
    //var 2 3+x
      switch(FEAT_TRAINS, SELF, sw_keikyu500_panto_placer_main_2,position_in_vehid_chain %3){
        1: keikyu500_end_mot;
        2: keikyu500_end_mot_rev;
        default: keikyu500_wag;
      }
    //panto controller
      switch(FEAT_TRAINS, SELF, sw_keikyu500_panto_placer_main,num_vehs_in_vehid_chain){
        0..2: keikyu500_wag;
        3..4: sw_keikyu500_panto_placer_main_2;
        7: sw_keikyu500_panto_placer_main_2;
        sw_keikyu500_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_keikyu500_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
        1: keikyu500_end_mot;
        keikyu500_front_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu500_lv,vehicle_type_id){
        mu_car: sw_keikyu500_panto_placer_main;
        sw_keikyu500_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_keikyu500_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_keikyu_old)),1951);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_keikyu_new)),1965);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_keikyu500_3)),1969);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_keikyu500_capacity_main,vehicle_type_id){
      mu_car: 140;
      135;
    }
  //load speed
    switch(FEAT_TRAINS, SELF, sw_keikyu500_load_0,build_year){
    0..1968:param_loading_2D;
    param_loading_4D;
  }
  switch(FEAT_TRAINS, SELF, sw_keikyu500_loading_speed_main,cargo_subtype){
    0:sw_keikyu500_load_0;
    1..2:param_loading_2D;
    param_loading_4D;
  }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_keikyu500_car_power_main,position_in_vehid_chain_from_end %4){
      2..3:return 110;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_keikyu500_power_main,vehicle_type_id){
      mu_car:sw_keikyu500_car_power_main;
      return 110*2;
    }
