				0: keio1000n_mot;
				1: keio1000n_mot;
				2: keio1000n_mot;
				keio1000n_wag;
			}
		//2
			switch(FEAT_TRAINS, SELF, sw_keio1000n_panto_placer_main_2,position_in_vehid_chain %2){
				0: keio1000n_mot;
				keio1000n_wag;
			}
		//panto controller
		switch(FEAT_TRAINS, SELF, sw_keio1000n_panto_placer_main,num_vehs_in_vehid_chain){
			0..4:sw_keio1000n_panto_placer_main_1;
			sw_keio1000n_panto_placer_main_2;
		}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_keio1000n_lv,vehicle_type_id){
      mu_car:sw_keio1000n_panto_placer_main;
      keio1000n_head;
    }
//*lv desc
  switch(FEAT_TRAINS,SELF,sw_keio1000n_lv_desc_main,cargo_subtype){
    0:string(LV_DATED,string(STR_LIVERY,string(LV_keio_blue_green)),1996);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_keio_ivory)),1996);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_keio_salmon)),1996);
    3:string(LV_DATED,string(STR_LIVERY,string(LV_keio_lt_green)),1996);
    4:string(LV_DATED,string(STR_LIVERY,string(LV_keio_violet)),1996);
    5:string(LV_DATED,string(STR_LIVERY,string(LV_keio_orange)),1996);
    6:string(LV_DATED,string(STR_LIVERY,string(LV_keio_lt_blue)),1996);
    7:string(LV_DATED,string(STR_LIVERY,string(LV_keio_rainbow)),2012);
  }

//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_keio1000n_capacity_main,vehicle_type_id){
			mu_car:154;
			143;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_keio1000n_power_main_1,position_in_vehid_chain_from_end %6){
			1:return 180;
			3..4:return 180;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_keio1000n_power_main_2,position_in_vehid_chain_from_end %6){
			1..4:return 160;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_keio1000n_car_power_main,build_year){
			0..2007:sw_keio1000n_power_main_1;
      sw_keio1000n_power_main_2;
		}
		switch(FEAT_TRAINS, SELF, sw_keio1000n_power_main,vehicle_type_id){
			mu_car:sw_keio1000n_car_power_main;
      return 0;
		}
