//*panto logic
	switch(FEAT_TRAINS,SELF, sw_keio6000_panto,current_year){
		0..2004:panto_d_arm_single;
		panto_arm_n_single;
	}
	switch(FEAT_TRAINS,SELF, sw_keio6000_panto_rev,current_year){
		0..2004:panto_d_arm_single_rev;
		panto_arm_n_single_rev;
	}
//*purchase
  spriteset(keio6000_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/keio/keio6000/keio6000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keio6000_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/keio/keio6000/keio6000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(keio6000_purchase, roof_gray_med_c1, keio6000_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, keio6000_car_base_c2, ac_long_toshiba_c2)
//*lights
	spriteset(keio6000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keio/keio6000/keio6000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(keio6000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keio/keio6000/keio6000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keio6000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keio6000_lights_back;
    keio6000_lights_front;
  }
//*livery 1
	spriteset(keio6000_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/keio/keio6000/keio6000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(keio6000_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/keio/keio6000/keio6000_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(keio6000_1_head, keio6000_1_head_base, roof_gray_med, sw_keio6000_lights, ac_long_toshiba)
	TRAIN_CONSTRUCTOR_5(keio6000_1_head_mot_1, keio6000_1_head_base, roof_gray_med, sw_keio6000_lights, ac_long_toshiba, sw_keio6000_panto)
	TRAIN_CONSTRUCTOR_5(keio6000_1_head_mot_2, keio6000_1_head_base, roof_gray_med, sw_keio6000_lights, ac_long_toshiba, sw_keio6000_panto_rev)
	TRAIN_CONSTRUCTOR_3(keio6000_1_wag, keio6000_1_car_base, roof_gray_med, ac_long_toshiba)
	TRAIN_CONSTRUCTOR_4(keio6000_1_mot, keio6000_1_car_base, roof_gray_med, ac_long_toshiba, sw_keio6000_panto)
//
//*livery 1
	//special gfx
		//head
			switch(FEAT_TRAINS, SELF, keio6000_1_head_gfx_1,vehicle_is_flipped){
				1: keio6000_1_head_mot_2;
				keio6000_1_head_mot_1;
			}
      //3 5+3
        switch(FEAT_TRAINS, SELF, keio6000_1_head_gfx_11,position_in_consist_from_end==0){
				1: keio6000_1_head_gfx_1;
				keio6000_1_head;
			}
			switch(FEAT_TRAINS, PARENT, keio6000_1_head_gfx_12,count_veh_id(2263)>2||num_vehs_in_consist==3){
				1: keio6000_1_head_gfx_11;
				keio6000_1_head;
			}
      //2 2+8 8+2
      switch(FEAT_TRAINS, SELF, keio6000_1_head_gfx_21,position_in_consist_from_end==2||position_in_consist==2){
				1: keio6000_1_head;
				keio6000_1_head_gfx_1;
			}
			switch(FEAT_TRAINS, SELF, keio6000_1_head_gfx_22,num_vehs_in_vehid_chain==3||num_vehs_in_consist==2){
				1: keio6000_1_head_gfx_21;
				keio6000_1_head;
			}
			switch(FEAT_TRAINS, SELF, keio6000_1_head_gfx,num_vehs_in_consist){
				3: keio6000_1_head_gfx_12;
				8: keio6000_1_head_gfx_12;
				keio6000_1_head_gfx_22;
			}

	//panto placer
		//1 
			switch(FEAT_TRAINS, SELF, sw_keio6000_1_panto_placer_main_1,position_in_vehid_chain %2){
				0: keio6000_1_mot;
				keio6000_1_wag;
			}
		//2
			switch(FEAT_TRAINS, SELF, sw_keio6000_1_panto_placer_main_2,position_in_vehid_chain %7){
				0: keio6000_1_mot;
				2: keio6000_1_mot;
				4: keio6000_1_mot;
				5: keio6000_1_mot;
				keio6000_1_wag;
			}
		//panto controller
		switch(FEAT_TRAINS, PARENT, sw_keio6000_1_panto_placer_main_0,build_year){
				0..1978: sw_keio6000_1_panto_placer_main_1;
				sw_keio6000_1_panto_placer_main_2;
			}
		switch(FEAT_TRAINS, SELF, sw_keio6000_1_panto_placer_main,num_vehs_in_vehid_chain){
			0..1:sw_keio6000_1_panto_placer_main_1;
			2:sw_keio6000_1_panto_placer_main_2;
			6..8:sw_keio6000_1_panto_placer_main_0;
			sw_keio6000_1_panto_placer_main_1;
		}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_keio6000_lv,vehicle_type_id){
			mu_car:sw_keio6000_1_panto_placer_main;
			keio6000_1_head_gfx;
		}
//
//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_keio6000_capacity_main,vehicle_type_id){
			mu_car: 170;
			150;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_keio6000_car_power_main_1,position_in_vehid_chain_from_end %3){
			0..1:return 150;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_keio6000_car_power_main_2,position_in_vehid_chain_from_end %6){
			0..4:return 150;
			return 0;
		}
    switch(FEAT_TRAINS, SELF, sw_keio6000_car_power_main, build_year<1979||num_vehs_in_vehid_chain<6){
      1:sw_keio6000_car_power_main_1;
      sw_keio6000_car_power_main_2;
    }
		switch(FEAT_TRAINS, SELF, sw_keio6000_power_main,vehicle_type_id){
			mu_car: sw_keio6000_car_power_main;
			150;
		}
