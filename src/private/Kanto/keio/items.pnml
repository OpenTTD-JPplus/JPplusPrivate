#include "keio1000n/keio1000n.pnml"

item(FEAT_TRAINS, keio1000n) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_keio == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME_LONG, string(STR_NAME_KEIO), "1000", string(STR_NAME_2_GEN), string(STR_NAME_SERIES),);
    introduction_date: date(1996, 1, 9);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;
    
    cost_factor: 20;
    running_cost_factor: 50;
    speed: 110 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 33 ton;
    badges: ["company/keio"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 5)),
    string(STR_USAGE, string(STR_COMMUTER)),
    string(STR_OPERATOR, string(STR_KEIO))
    
    );
    cargo_subtype_text: sw_keio1000n_lv_desc_main;
    purchase: keio1000n_purchase;
    cargo_capacity:sw_keio1000n_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_keio1000n_capacity_main()*param_capacity_mod/3;
    loading_speed:param_loading_4D;
    default:sw_keio1000n_lv;
    power:sw_keio1000n_power_main()*4*1342/1000;
    purchase_power: sw_keio1000n_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_keio1000n_lv_desc_main;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_keio1000n_capacity_main()*param_capacity_mod/3;
    power:sw_keio1000n_power_main()*4*1342/1000;
    default:sw_keio1000n_lv;
    weight: 31;
    
  }
}
