//*panto logic
	switch(FEAT_TRAINS,PARENT, sw_keio7000_panto,current_year){
		0..2004:panto_d_arm_single;
		panto_arm_n_single;
	}
	switch(FEAT_TRAINS,PARENT, sw_keio7000_panto_rev,current_year){
		0..2004:panto_d_arm_single_rev;
		panto_arm_n_single_rev;
	}
//*purchase
  spriteset(keio7000_front_base_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/keio/keio7000/keio7000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(keio7000_car_base_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/keio/keio7000/keio7000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_6(keio7000_purchase, roof_gray_med_c1, keio7000_front_base_c1, ac_long_toshiba_c1, roof_gray_med_c2, keio7000_car_base_c2, ac_long_toshiba_c2)
//*lights
	spriteset(keio7000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keio/keio7000/keio7000_lights.png"){ tmpl_std_v3(0, 0) }
	spriteset(keio7000_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kanto/keio/keio7000/keio7000_lights.png"){ tmpl_std_v3(0, 25) }
  switch(FEAT_TRAINS, SELF, sw_keio7000_lights, train_is_driving_backwards != vehicle_is_flipped){
    1: keio7000_lights_back;
    keio7000_lights_front;
  }
//*livery 1
	spriteset(keio7000_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/keio/keio7000/keio7000_1.png"){ tmpl_std_v3(0, 0) }
	spriteset(keio7000_1_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,	"src/private/Kanto/keio/keio7000/keio7000_1.png"){ tmpl_symm_v3(0, 25) }

	TRAIN_CONSTRUCTOR_4(keio7000_1_head, keio7000_1_head_base, roof_gray_med, sw_keio7000_lights, ac_long_toshiba)
	TRAIN_CONSTRUCTOR_5(keio7000_1_head_f_1, keio7000_1_head_base, roof_gray_med, sw_keio7000_lights, ac_long_toshiba, sw_keio7000_panto)
	TRAIN_CONSTRUCTOR_5(keio7000_1_head_f_2, keio7000_1_head_base, roof_gray_med, sw_keio7000_lights, ac_long_toshiba, sw_keio7000_panto_rev)
	TRAIN_CONSTRUCTOR_3(keio7000_1_wag, keio7000_1_car_base, roof_gray_med, ac_long_toshiba)
	TRAIN_CONSTRUCTOR_4(keio7000_1_mot, keio7000_1_car_base, roof_gray_med, ac_long_toshiba, sw_keio7000_panto)
//
//*livery 1
	//special gfx
		//head
			switch(FEAT_TRAINS, SELF, keio7000_1_head_gfx_1,vehicle_is_flipped){
				1: keio7000_1_head_f_2;
				keio7000_1_head_f_1;
			}
			switch(FEAT_TRAINS, SELF, keio7000_1_head_gfx,num_vehs_in_consist){
				2: keio7000_1_head_gfx_1;
				keio7000_1_head;
			}
	//panto placer
		//1 
			switch(FEAT_TRAINS, SELF, sw_keio7000_1_panto_placer_main_1,position_in_vehid_chain %2){
				0: keio7000_1_mot;
				keio7000_1_wag;
			}
		//2
			switch(FEAT_TRAINS, SELF, sw_keio7000_1_panto_placer_main_2,position_in_vehid_chain_from_end %7){
				0: keio7000_1_mot;
				1: keio7000_1_mot;
				3: keio7000_1_mot;
				5: keio7000_1_mot;
				keio7000_1_wag;
			}
		//3 (10)
			switch(FEAT_TRAINS, SELF, sw_keio7000_1_panto_placer_main_3,position_in_vehid_chain %9){
				0: keio7000_1_mot;
				3: keio7000_1_mot;
				6: keio7000_1_mot;
				7: keio7000_1_mot;
				keio7000_1_wag;
			}
		//4 renew 8
			switch(FEAT_TRAINS, SELF, sw_keio7000_1_panto_placer_main_4,position_in_vehid_chain %4){
				0: keio7000_1_mot;
				1: keio7000_1_mot;
				keio7000_1_wag;
			}
		//5 renew 10
			switch(FEAT_TRAINS, SELF, sw_keio7000_1_panto_placer_main_5,position_in_vehid_chain %6){
				0: keio7000_1_mot;
				1: keio7000_1_mot;
				4: keio7000_1_mot;
				keio7000_1_wag;
			}
		//panto controller
		switch(FEAT_TRAINS, PARENT, sw_keio7000_1_panto_placer_main_0_1, build_year){
			0..2004: sw_keio7000_1_panto_placer_main_2;
			sw_keio7000_1_panto_placer_main_4;
		}
		switch(FEAT_TRAINS, PARENT, sw_keio7000_1_panto_placer_main_0_2, build_year){
			0..2004: sw_keio7000_1_panto_placer_main_3;
			sw_keio7000_1_panto_placer_main_5;
		}
		switch(FEAT_TRAINS, SELF, sw_keio7000_1_panto_placer_main,num_vehs_in_vehid_chain){
			2:sw_keio7000_1_panto_placer_main_2;
			3:sw_keio7000_1_panto_placer_main_1;
			4..5:sw_keio7000_1_panto_placer_main_2;
			6:sw_keio7000_1_panto_placer_main_0_1;
			7:sw_keio7000_1_panto_placer_main_2;
			8:sw_keio7000_1_panto_placer_main_0_2;
			sw_keio7000_1_panto_placer_main_3;
		}
	//front-end-fixer
		switch(FEAT_TRAINS, SELF, sw_keio7000_lv,vehicle_type_id){
			mu_car:sw_keio7000_1_panto_placer_main;
			keio7000_1_head_gfx;
		}
//
//*post fixers
	//capacity-changer
		switch(FEAT_TRAINS, SELF, sw_keio7000_capacity_main,vehicle_type_id){
			mu_car: 170;
			150;
		}
	//power fix
		switch(FEAT_TRAINS, SELF, sw_keio7000_car_power_main_1,position_in_vehid_chain_from_end %10){
			0..3:return 150;
			5..6:return 150;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_keio7000_car_power_main_2,position_in_vehid_chain_from_end %10){
			0..1:return 150;
			3..4:return 150;
			7:return 150;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_keio7000_car_power_main,build_year){
			0..2003:sw_keio7000_car_power_main_1;
			sw_keio7000_car_power_main_2;
		}
		switch(FEAT_TRAINS, SELF, sw_keio7000_head_power_main,num_vehs_in_vehid_chain>1){
			1:return 150;
			return 0;
		}
		switch(FEAT_TRAINS, SELF, sw_keio7000_power_main,vehicle_type_id){
			mu_car:sw_keio7000_car_power_main;
			sw_keio7000_head_power_main;
		}
