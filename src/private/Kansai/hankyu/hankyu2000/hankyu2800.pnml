//*livery 1
  //special gfx
    //timed gfx
      switch(FEAT_TRAINS, PARENT, hankyu2800_front,current_year<1972){
        1: hankyu2800_1_front;
        hankyu2800_2_front;
      }
      switch(FEAT_TRAINS, PARENT, hankyu2800_end,current_year<1972){
        1: hankyu2800_1_end;
        hankyu2800_2_end;
      }
      switch(FEAT_TRAINS, PARENT, hankyu2800_end_rev,current_year<1972){
        1: hankyu2800_1_end_rev;
        hankyu2800_2_end_rev;
      }
      switch(FEAT_TRAINS, PARENT, hankyu2800_front_mot,current_year<1972){
        1: hankyu2800_1_front_mot;
        hankyu2800_2_front_mot;
      }
      switch(FEAT_TRAINS, PARENT, hankyu2800_end_mot,current_year<1972){
        1: hankyu2800_1_end_mot;
        hankyu2800_2_end_mot;
      }
      switch(FEAT_TRAINS, PARENT, hankyu2800_mot,current_year<1972){
        1: hankyu2800_1_mot;
        hankyu2800_2_mot;
      }
      switch(FEAT_TRAINS, PARENT, hankyu2800_wag,current_year<1972){
        1: hankyu2800_1_wag;
        hankyu2800_2_wag;
      }
      
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu2800_front,vehicle_is_reversed){
        1: hankyu2800_front;
        hankyu2800_front_mot;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu2800_end,vehicle_is_reversed){
        1: hankyu2800_end_mot;
        hankyu2800_end;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu2800_panto_placer_main_1,position_in_vehid_chain %4){
      3: hankyu2800_mot;
      hankyu2800_wag;
    }
    // //var 2
    // switch(FEAT_TRAINS, SELF, sw_hankyu2800_panto_placer_main_2,position_in_vehid_chain %2){
    //   1: hankyu2800_mot;
    //   hankyu2800_wag;
    // }
  //fake-head-placer
    //var 1  (2+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu2800_fake_head_placer_main_1,position_in_vehid_chain){
        0: hankyu2800_end_rev;
        1: hankyu2800_end_mot;
        sw_hankyu2800_panto_placer_main_1;
      }
    //var 2  (4+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu2800_fake_head_placer_main_2,position_in_vehid_chain){
        2: hankyu2800_end_rev;
        3: hankyu2800_end_mot;
        sw_hankyu2800_panto_placer_main_1;
      }
    //var 3  (3+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu2800_fake_head_placer_main_3,position_in_vehid_chain){
        1: hankyu2800_end_rev;
        2: hankyu2800_end_mot;
        sw_hankyu2800_panto_placer_main_1;
      }
    //var 4  (2+2+...)
      switch(FEAT_TRAINS, SELF, sw_hankyu2800_fake_head_placer_main_4,position_in_vehid_chain%2){
        0: hankyu2800_end_rev;
        1: hankyu2800_end_mot;
        sw_hankyu2800_panto_placer_main_1;
      }
    //main
      random_switch(FEAT_TRAINS, PARENT, sw_hankyu2800_fake_head_placer_main_0_1){
        1:sw_hankyu2800_fake_head_placer_main_2;
        1:sw_hankyu2800_fake_head_placer_main_3;
      }
      random_switch(FEAT_TRAINS, PARENT, sw_hankyu2800_fake_head_placer_main_0_2){
        1:sw_hankyu2800_fake_head_placer_main_1;
        2:sw_hankyu2800_panto_placer_main_1;
      }
      random_switch(FEAT_TRAINS, PARENT, sw_hankyu2800_fake_head_placer_main_0_3){
        1:sw_hankyu2800_fake_head_placer_main_4;
        2:sw_hankyu2800_fake_head_placer_main_2;
      }
      switch(FEAT_TRAINS, SELF, sw_hankyu2800_fake_head_placer_main,num_vehs_in_vehid_chain){
        2: sw_hankyu2800_fake_head_placer_main_0_2;
        3: sw_hankyu2800_fake_head_placer_main_1;
        5: sw_hankyu2800_fake_head_placer_main_0_1;
        6: sw_hankyu2800_fake_head_placer_main_0_3;
        sw_hankyu2800_fake_head_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu2800_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu2800_end;
      default: sw_hankyu2800_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu2800_lv,vehicle_type_id){
      mu_car: sw_hankyu2800_fake_head_placer_main;
      default: sw_hankyu2800_gfx_main;
    }

//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu2800_capacity_main,vehicle_type_id){
    mu_car: 150;
    140;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu2800_car_power_main,position_in_vehid_chain_from_end %2){
    0:return 150;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu2800_power_main,vehicle_type_id){
    mu_car: sw_hankyu2800_car_power_main;
    return 150;
  }
