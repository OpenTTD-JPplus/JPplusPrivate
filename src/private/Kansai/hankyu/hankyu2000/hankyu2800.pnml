//purchase
spriteset(hankyu2800_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_1.png"){ tmpl_purchase_1c_dual(0, 50) }
spriteset(hankyu2800_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_1.png"){ tmpl_purchase_2c_dual(0, 125) }
GRAPHIC_STACK_2(hankyu2800_purchase, hankyu2800_purchase_c1, hankyu2800_purchase_c2)
//livery 1
  spriteset(hankyu2800_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu2800_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu2800_1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_1.png"){ tmpl_std_rev_v3(0, 25) }
  spriteset(hankyu2800_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_1.png"){ tmpl_std_v3(0, 50) }
  spriteset(hankyu2800_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_1.png"){ tmpl_std_v3(0, 75) }
  spriteset(hankyu2800_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_1.png"){ tmpl_symm_v3(0, 100) }
  spriteset(hankyu2800_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_1.png"){ tmpl_symm_v3(0, 125) }
//ac
  
  spriteset(hankyu2800_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_2.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu2800_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_2.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu2800_2_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_2.png"){ tmpl_std_rev_v3(0, 25) }
  spriteset(hankyu2800_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2800_2.png"){ tmpl_std_v3(0, 50) }
