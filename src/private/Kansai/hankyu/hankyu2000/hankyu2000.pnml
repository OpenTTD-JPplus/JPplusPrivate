  spriteset(hankyu2000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2000_1.png"){ tmpl_symm_v3(0, 125) }
