  spriteset(hankyu2000_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2000_2.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu2000_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2000_2.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu2000_2_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000/hankyu2000_2.png"){ tmpl_std_rev_v3(0, 25) }
