switch(FEAT_TRAINS, PARENT, hankyu2000_front_timed, current_year){
  0..1978:hankyu2000_1_front;  hankyu2000_2_front;
}
switch(FEAT_TRAINS, PARENT, hankyu2000_end_timed, current_year){
  0..1978:hankyu2000_1_end;  hankyu2000_2_end;
}
switch(FEAT_TRAINS, PARENT, hankyu2000_front_mot_timed, current_year){
  0..1978:hankyu2000_1_front_mot;  hankyu2000_2_front_mot;
}
switch(FEAT_TRAINS, PARENT, hankyu2000_end_mot_timed, current_year){
  0..1978:hankyu2000_1_end_mot;  hankyu2000_2_end_mot;
}
switch(FEAT_TRAINS, PARENT, hankyu2000_end_mot_rev_timed, current_year){
  0..1978:hankyu2000_1_end_mot_rev;  hankyu2000_2_end_mot_rev;
}
switch(FEAT_TRAINS, PARENT, hankyu2000_mot_timed, current_year){
  0..1978:hankyu2000_1_mot;  hankyu2000_2_mot;
}
switch(FEAT_TRAINS, PARENT, hankyu2000_wag_timed, current_year){
  0..1978:hankyu2000_1_wag;  hankyu2000_2_wag;
}

switch(FEAT_TRAINS, SELF, hankyu2000_front, cargo_subtype){
  1:hankyu2000_1_front;  2:hankyu2000_2_front;  hankyu2000_front_timed;
}
switch(FEAT_TRAINS, SELF, hankyu2000_end, cargo_subtype){
  1:hankyu2000_1_end;  2:hankyu2000_2_end;  hankyu2000_end_timed;
}
switch(FEAT_TRAINS, SELF, hankyu2000_front_mot, cargo_subtype){
  1:hankyu2000_1_front_mot;  2:hankyu2000_2_front_mot;  hankyu2000_front_mot_timed;
}
switch(FEAT_TRAINS, SELF, hankyu2000_end_mot, cargo_subtype){
  1:hankyu2000_1_end_mot;  2:hankyu2000_2_end_mot;  hankyu2000_end_mot_timed;
}
switch(FEAT_TRAINS, SELF, hankyu2000_end_mot_rev, cargo_subtype){
  1:hankyu2000_1_end_mot_rev;  2:hankyu2000_2_end_mot_rev;  hankyu2000_end_mot_rev_timed;
}
switch(FEAT_TRAINS, SELF, hankyu2000_mot, cargo_subtype){
  1:hankyu2000_1_mot;  2:hankyu2000_2_mot;  hankyu2000_mot_timed;
}
switch(FEAT_TRAINS, SELF, hankyu2000_wag, cargo_subtype){
  1:hankyu2000_1_wag;  2:hankyu2000_2_wag;  hankyu2000_wag_timed;
}

//*livery 1 (old, made as livery for variety sake)
  //special gfx
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu2000_front,vehicle_is_reversed){
        1: hankyu2000_front_mot;
        hankyu2000_front;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu2000_end,vehicle_is_reversed){
        1: hankyu2000_end;
        hankyu2000_end_mot;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu2000_panto_placer_main_1,position_in_vehid_chain %3){
      0: hankyu2000_mot;
      hankyu2000_wag;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_hankyu2000_panto_placer_main_2,position_in_vehid_chain %2){
      0: hankyu2000_mot;
      hankyu2000_wag;
    }
  //fake-head-placer
    //var 1  (7 car 1)
      switch(FEAT_TRAINS, SELF, sw_hankyu2000_fake_head_placer_main_1,position_in_vehid_chain){
        1: hankyu2000_end_mot_rev;
        2: hankyu2000_end;
        sw_hankyu2000_panto_placer_main_1;
      }
    //var 2 (7 car 2)
      switch(FEAT_TRAINS, SELF, sw_hankyu2000_fake_head_placer_main_2,position_in_vehid_chain){
        1: hankyu2000_end_mot_rev;
        2: hankyu2000_end;
        3: hankyu2000_end_mot_rev;
        4: hankyu2000_end;
        sw_hankyu2000_panto_placer_main_1;
      }
    //var 3 (8 car)
      switch(FEAT_TRAINS, SELF, sw_hankyu2000_fake_head_placer_main_3,position_in_vehid_chain){
        2: hankyu2000_end_mot_rev;
        3: hankyu2000_end;
        sw_hankyu2000_panto_placer_main_2;
      }
    //main
      random_switch(FEAT_TRAINS, PARENT, sw_hankyu2000_fake_head_placer_main_0) {
        1:sw_hankyu2000_fake_head_placer_main_1;
        1:sw_hankyu2000_fake_head_placer_main_2;
      }
      switch(FEAT_TRAINS, SELF, sw_hankyu2000_fake_head_placer_main,num_vehs_in_vehid_chain){
        0..2: sw_hankyu2000_panto_placer_main_2;
        3: sw_hankyu2000_fake_head_placer_main_2;
        5: sw_hankyu2000_fake_head_placer_main_0;
        sw_hankyu2000_fake_head_placer_main_3;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu2000_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu2000_end;
      default: sw_hankyu2000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu2000_lv,vehicle_type_id){
      mu_car: sw_hankyu2000_fake_head_placer_main;
      default: sw_hankyu2000_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_hankyu2000_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1960);
    2: string(LV_DATED,string(STR_LIVERY,string(LV_MODERN)),1979);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu2000_capacity_main,vehicle_type_id){
    mu_car: 150;
    140;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu2000_car_power_main,position_in_vehid_chain_from_end %2){
    0:return 150;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu2000_power_main,vehicle_type_id){
    mu_car: sw_hankyu2000_car_power_main;
    return 150;
  }
  //variant naming shenanigans
    switch (FEAT_TRAINS, SELF, sw_hankyu2000_name_purchase, getbits(extra_callback_info1, 8, 8)) { 
      1: return CB_RESULT_NO_TEXT; 
      return string(STR_TRAIN_NAME, string(STR_NAME_HANKYU), "2000/2300/2800", string(STR_NAME_SERIES));
      } 
    switch (FEAT_TRAINS, SELF, sw_hankyu2000_name, getbits(extra_callback_info1, 0, 8)) { 
      0x20: sw_hankyu2000_name_purchase; 
      return CB_RESULT_NO_TEXT;
    }
