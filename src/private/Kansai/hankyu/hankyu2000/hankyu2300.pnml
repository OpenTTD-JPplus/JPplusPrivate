//*livery 1 (old, made as livery for variety sake)
  //special gfx
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu2300_front,vehicle_is_reversed){
        1: hankyu2300_front;
        hankyu2300_front_mot;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu2300_end,vehicle_is_reversed){
        1: hankyu2300_end_mot;
        hankyu2300_end;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu2300_panto_placer_main_1,position_in_vehid_chain %3){
      1: hankyu2300_mot;
      hankyu2300_wag;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_hankyu2300_panto_placer_main_2,position_in_vehid_chain %2){
      1: hankyu2300_mot;
      hankyu2300_wag;
    }
  //fake-head-placer
    //var 1  (2+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu2300_fake_head_placer_main_1,position_in_vehid_chain){
        0: hankyu2300_end_rev;
        1: hankyu2300_end_mot;
        sw_hankyu2300_panto_placer_main_1;
      }
    //var 2  (3+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu2300_fake_head_placer_main_2,position_in_vehid_chain){
        1: hankyu2300_end_mot_rev;
        2: hankyu2300_end;
        sw_hankyu2300_panto_placer_main_2;
      }
    //main
      switch(FEAT_TRAINS, SELF, sw_hankyu2300_fake_head_placer_main,num_vehs_in_vehid_chain){
        0..1: sw_hankyu2300_panto_placer_main_2;
        2..3: sw_hankyu2300_fake_head_placer_main_1;
        4: sw_hankyu2300_fake_head_placer_main_2;
        sw_hankyu2300_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu2300_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu2300_end;
      default: sw_hankyu2300_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu2300_lv,vehicle_type_id){
      mu_car: sw_hankyu2300_fake_head_placer_main;
      default: sw_hankyu2300_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_hankyu2300_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1960);
    2: string(LV_DATED,string(STR_LIVERY,string(LV_MODERN)),1982);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu2300_capacity_main,vehicle_type_id){
    mu_car: 150;
    140;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu2300_car_power_main,position_in_vehid_chain_from_end %2){
    0:return 150;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu2300_power_main,vehicle_type_id){
    mu_car: sw_hankyu2300_car_power_main;
    return 150;
  }
