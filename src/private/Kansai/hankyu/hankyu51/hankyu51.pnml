//purchase
spriteset(hankyu51_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu51/hankyu51.png"){ tmpl_purchase_1c(0, 0) }

spriteset(hankyu51_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu51/hankyu51_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(hankyu51_lights_front_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu51/hankyu51_lights.png"){ tmpl_std_rev_v3(0, 0) }
switch(FEAT_TRAINS, SELF, sw_hankyu51_lights_front, position_in_consist){
  0:hankyu51_lights_front; gfx_empty;
  }
switch(FEAT_TRAINS, SELF, sw_hankyu51_lights_front_rev, position_in_consist_from_end){
  0:hankyu51_lights_front_rev; gfx_empty;
  }
switch(FEAT_TRAINS, SELF, sw_hankyu51_lights, train_is_driving_backwards != vehicle_is_flipped){
  1: sw_hankyu51_lights_front_rev;
  sw_hankyu51_lights_front;
}
spriteset(hankyu51_mot_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu51/hankyu51.png"){ tmpl_std_v3(0, 0) }
spriteset(hankyu51_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu51/hankyu51.png"){ tmpl_symm_v3(0, 25) }

//panto placer
switch(FEAT_TRAINS, SELF, sw_hankyu51_panto_placer_main,position_in_vehid_chain %2){
    0: hankyu51_mot_base;
    hankyu51_car_base;
}
//end car fixer
TRAIN_CONSTRUCTOR_2(sw_hankyu51_lv, sw_hankyu51_panto_placer_main, sw_hankyu51_lights)
//
  switch(FEAT_TRAINS, SELF, sw_hankyu51_car_power_main,position_in_vehid_chain%2){
      1:return 48;
      return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu51_power_main,vehicle_type_id){
    mu_car:sw_hankyu51_car_power_main;
    return 48;
  }