  //ac
//

//*livery 1
  //special gfx
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu1010_1_front,vehicle_is_reversed){
        1: hankyu1010_1_front;
        hankyu1010_1_front_mot;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu1010_1_end,vehicle_is_reversed){
        1: hankyu1010_1_end_mot;
        hankyu1010_1_end;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu1010_1_panto_placer_main_1,position_in_vehid_chain %3){
      2: hankyu1010_1_mot;
      hankyu1010_1_wag;
    }
    //var 2 (pre 1977)
    switch(FEAT_TRAINS, SELF, sw_hankyu1010_1_panto_placer_main_2,position_in_vehid_chain %2){
      0: hankyu1010_1_end_rev;
      hankyu1010_1_end_mot;
    }
  //fake-head-placer
    //var 1  (4+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu1010_1_fake_head_placer_main_1,position_in_vehid_chain){
        2: hankyu1010_1_end_rev;
        3: hankyu1010_1_end_mot;
        sw_hankyu1010_1_panto_placer_main_1;
      }
    //var 2  (3+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu1010_1_fake_head_placer_main_2,position_in_vehid_chain){
        1: hankyu1010_1_end_rev;
        2: hankyu1010_1_end_mot;
        sw_hankyu1010_1_panto_placer_main_1;
      }
    //var 3  (3.5+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu1010_1_fake_head_placer_main_3,position_in_vehid_chain){
        2: hankyu1010_1_end_mot;
        sw_hankyu1010_1_panto_placer_main_1;
      }
    //var 4  (2+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu1010_1_fake_head_placer_main_4,position_in_vehid_chain){
        0: hankyu1010_1_end_rev;
        1: hankyu1010_1_end_mot;
        sw_hankyu1010_1_panto_placer_main_1;
      }
    //main
      random_switch(FEAT_TRAINS, PARENT, sw_hankyu1010_1_fake_head_placer_main_0) {
        1: sw_hankyu1010_1_fake_head_placer_main_1;
        1: sw_hankyu1010_1_fake_head_placer_main_2;
        1: sw_hankyu1010_1_fake_head_placer_main_3;
      }
      switch(FEAT_TRAINS, SELF, sw_hankyu1010_1_fake_head_placer_main_0_1,num_vehs_in_vehid_chain){
        0..3: sw_hankyu1010_1_fake_head_placer_main_4;
        4: sw_hankyu1010_1_fake_head_placer_main_2;
        sw_hankyu1010_1_fake_head_placer_main_0;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu1010_1_fake_head_placer_main, current_date>1976){
        1: sw_hankyu1010_1_fake_head_placer_main_0_1;
        sw_hankyu1010_1_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu1010_1_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu1010_1_end;
      default: sw_hankyu1010_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu1010_livery_1,vehicle_type_id){
      mu_car: sw_hankyu1010_1_fake_head_placer_main;
      default: sw_hankyu1010_1_gfx_main;
    }
//*livery 2 1030F
  //special gfx
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu1010_2_front,vehicle_is_reversed){
        1: hankyu1010_2_front;
        hankyu1010_2_front_mot;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu1010_2_end,vehicle_is_reversed){
        1: hankyu1010_2_end_mot;
        hankyu1010_2_end;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu1010_2_panto_placer_main_1,position_in_vehid_chain %3){
      1: hankyu1010_2_mot;
      hankyu1010_2_wag;
    }
  //fake head placer
    //var 1
      switch(FEAT_TRAINS, SELF, sw_hankyu1010_2_fake_head_placer_main_1,position_in_vehid_chain){
        0: hankyu1010_2_end_rev;
        1: hankyu1010_2_end_mot;
        sw_hankyu1010_2_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu1010_2_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu1010_2_end;
      default: sw_hankyu1010_2_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu1010_livery_2,vehicle_type_id){
      mu_car: sw_hankyu1010_2_fake_head_placer_main_1;
      default: sw_hankyu1010_2_gfx_main;
    }
//liveries
  random_switch(FEAT_TRAINS, PARENT, sw_hankyu1010_livery_0_0){
    3: sw_hankyu1010_livery_1;
    1: sw_hankyu1010_livery_2;
  }
  switch(FEAT_TRAINS, PARENT, sw_hankyu1010_livery_0, current_year>1976){
    1:sw_hankyu1010_livery_0_0;
    sw_hankyu1010_livery_1;
  }

  switch(FEAT_TRAINS, SELF, sw_hankyu1010_lv, cargo_subtype){
    0:sw_hankyu1010_livery_0;
    1:sw_hankyu1010_livery_1;
    2:sw_hankyu1010_livery_2;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu1010_lv_desc_main,cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1956);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_RENEW)),1976);
  }

//*post fixers
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu1010_car_power_main,position_in_vehid_chain_from_end %2){
    0:return 150;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu1010_power_main,vehicle_type_id){
    mu_car: sw_hankyu1010_car_power_main;
    return 150;
  }
