  spriteset(hankyu1010_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu1010_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu1010_1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_1.png"){ tmpl_std_rev_v3(0, 25) }
  spriteset(hankyu1010_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_1.png"){ tmpl_std_v3(0, 50) }
  spriteset(hankyu1010_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_1.png"){ tmpl_std_v3(0, 75) }
  spriteset(hankyu1010_1_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_1.png"){ tmpl_std_rev_v3(0, 75) }
  spriteset(hankyu1010_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_1.png"){ tmpl_std_v3(0, 100) }
  spriteset(hankyu1010_1_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_1.png"){ tmpl_std_rev_v3(0, 100) }
  spriteset(hankyu1010_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_1.png"){ tmpl_symm_v3(0, 125) }
  //ac
  
  spriteset(hankyu1010_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_2.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu1010_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_2.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu1010_2_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_2.png"){ tmpl_std_rev_v3(0, 25) }
  spriteset(hankyu1010_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_2.png"){ tmpl_std_v3(0, 50) }
