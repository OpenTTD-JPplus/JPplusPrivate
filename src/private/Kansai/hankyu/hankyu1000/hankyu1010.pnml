spriteset(hankyu1010_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu1000/hankyu1010_1.png"){ tmpl_purchase_1c_dual(0, 50) }
