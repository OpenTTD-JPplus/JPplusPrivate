  spriteset(hankyu5300_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_1.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu5300_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_1.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu5300_1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_1.png"){ tmpl_std_rev_v3(0, 25) }
  spriteset(hankyu5300_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_1.png"){ tmpl_std_v3(0, 50) }
  spriteset(hankyu5300_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_1.png"){ tmpl_std_v3(0, 75) }
  spriteset(hankyu5300_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_1.png"){ tmpl_symm_v3(0, 100) }
  spriteset(hankyu5300_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_1.png"){ tmpl_symm_v3(0, 125) }
