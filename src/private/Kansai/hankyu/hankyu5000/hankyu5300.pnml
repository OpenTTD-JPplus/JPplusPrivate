  spriteset(hankyu5300_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_2.png"){ tmpl_std_v3(0, 50) }
