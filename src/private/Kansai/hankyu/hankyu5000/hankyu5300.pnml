//
  switch(FEAT_TRAINS, SELF, hankyu5300_front_timed, current_year){
    0..1988:hankyu5300_1_front;    hankyu5300_2_front;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_end_timed, current_year){
    0..1988:hankyu5300_1_end;    hankyu5300_2_end;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_end_rev_timed, current_year){
    0..1988:hankyu5300_1_end_rev;    hankyu5300_2_end_rev;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_front_mot_timed, current_year){
    0..1988:hankyu5300_1_front_mot;    hankyu5300_2_front_mot;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_end_mot_timed, current_year){
    0..1988:hankyu5300_1_end_mot;    hankyu5300_2_end_mot;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_mot_timed, current_year){
    0..1988:hankyu5300_1_mot;    hankyu5300_2_mot;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_wag_timed, current_year){
    0..1988:hankyu5300_1_wag;    hankyu5300_2_wag;
  }

  switch(FEAT_TRAINS, SELF, hankyu5300_front, cargo_subtype){
    1:hankyu5300_1_front;    2:hankyu5300_2_front;    hankyu5300_front_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_end, cargo_subtype){
    1:hankyu5300_1_end;    2:hankyu5300_2_end;    hankyu5300_end_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_end_rev, cargo_subtype){
    1:hankyu5300_1_end_rev;    2:hankyu5300_2_end_rev;    hankyu5300_end_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_front_mot, cargo_subtype){
    1:hankyu5300_1_front_mot;    2:hankyu5300_2_front_mot;    hankyu5300_front_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_end_mot, cargo_subtype){
    1:hankyu5300_1_end_mot;    2:hankyu5300_2_end_mot;    hankyu5300_end_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_mot, cargo_subtype){
    1:hankyu5300_1_mot;    2:hankyu5300_2_mot;    hankyu5300_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5300_wag, cargo_subtype){
    1:hankyu5300_1_wag;    2:hankyu5300_2_wag;    hankyu5300_wag_timed;
  }
//*livery 1
  //special gfx
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu5300_front,vehicle_is_reversed){
        1: hankyu5300_front;
        hankyu5300_front_mot;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu5300_end,vehicle_is_reversed){
        1: hankyu5300_end_mot;
        hankyu5300_end;
      }
  //panto-placers
    //var 1 (4+x 1)
    switch(FEAT_TRAINS, SELF, sw_hankyu5300_panto_placer_main_1,position_in_vehid_chain %4){
      1: hankyu5300_mot;
      hankyu5300_wag;
    }
    //var 3 (7)
    switch(FEAT_TRAINS, SELF, sw_hankyu5300_panto_placer_main_3,position_in_vehid_chain %5){
      0: hankyu5300_mot;
      hankyu5300_wag;
    }
  //fake-head-placer
    //var 1 (8)
      switch(FEAT_TRAINS, SELF, sw_hankyu5300_fake_head_placer_main_1,position_in_vehid_chain){
        0: hankyu5300_end_rev;
        1: hankyu5300_end_mot;
        sw_hankyu5300_panto_placer_main_1;
      }
    //var 2 (8)
      switch(FEAT_TRAINS, SELF, sw_hankyu5300_fake_head_placer_main_2,position_in_vehid_chain){
        1: hankyu5300_end_rev;
        2: hankyu5300_end_mot;
        sw_hankyu5300_panto_placer_main_1;
      }
    //var 3 (8)
      switch(FEAT_TRAINS, SELF, sw_hankyu5300_fake_head_placer_main_3,position_in_vehid_chain){
        2: hankyu5300_end_rev;
        3: hankyu5300_end_mot;
        hankyu5300_wag;
      }
    //main
      random_switch(FEAT_TRAINS, PARENT, sw_hankyu5300_fake_head_placer_main_0){
        2: sw_hankyu5300_fake_head_placer_main_2;
        1: sw_hankyu5300_fake_head_placer_main_1;
        1: sw_hankyu5300_fake_head_placer_main_3;
      }
      random_switch(FEAT_TRAINS, PARENT, sw_hankyu5300_fake_head_placer_main_0_1){
        1: sw_hankyu5300_fake_head_placer_main_2;
        1: sw_hankyu5300_fake_head_placer_main_1;
        1: sw_hankyu5300_fake_head_placer_main_3;
        1: sw_hankyu5300_panto_placer_main_3;
      }
      switch(FEAT_TRAINS, SELF, sw_hankyu5300_fake_head_placer_main,num_vehs_in_vehid_chain){
        0..3: sw_hankyu5300_panto_placer_main_1;
        4..5: sw_hankyu5300_fake_head_placer_main_0_1;
        6: sw_hankyu5300_fake_head_placer_main_0;
        sw_hankyu5300_fake_head_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu5300_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu5300_end;
      sw_hankyu5300_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu5300_lv,vehicle_type_id){
      mu_car: sw_hankyu5300_fake_head_placer_main;
      sw_hankyu5300_gfx_main;
    }
//
//liveries
  // livery 0
  switch(FEAT_TRAINS, SELF, sw_hankyu5300_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1972);
    2: string(LV_DATED,string(STR_LIVERY,string(LV_RENEW)),1989);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu5300_capacity_main,vehicle_type_id){
    mu_car: 150;
    140;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu5300_car_power_main,position_in_vehid_chain_from_end %2){
    1:return 140;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu5300_power_main,vehicle_type_id){
    mu_car: sw_hankyu5300_car_power_main;
    return 140*2;
  }
