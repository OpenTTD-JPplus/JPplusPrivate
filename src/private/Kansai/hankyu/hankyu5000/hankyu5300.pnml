  spriteset(hankyu5300_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_2.png"){ tmpl_symm_v3(0, 100) }
