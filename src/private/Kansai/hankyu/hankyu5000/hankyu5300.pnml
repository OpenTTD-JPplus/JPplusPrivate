  spriteset(hankyu5300_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_1.png"){ tmpl_purchase_1c_dual(0, 50) }
  spriteset(hankyu5300_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu5000/hankyu5300_1.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(hankyu5300_purchase, hankyu5300_purchase_c1, hankyu5300_purchase_c2)
