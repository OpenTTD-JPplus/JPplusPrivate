//
  switch(FEAT_TRAINS, SELF, hankyu5000_front_timed, current_year){
    0..1972:sw_hankyu5000_1_front;    1973..1999:hankyu5000_3_front;
    hankyu5000_4_front;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_end_timed, current_year){
    0..1972:sw_hankyu5000_1_end;    1973..1999:hankyu5000_3_end;
    hankyu5000_4_end;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_end_rev_timed, current_year){
    0..1972:sw_hankyu5000_1_end_rev;    1973..1999:hankyu5000_3_end_rev;
    hankyu5000_4_end_rev;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_front_mot_timed, current_year){
    0..1972:sw_hankyu5000_1_front_mot;    1973..1999:hankyu5000_3_front_mot;
    hankyu5000_4_front_mot;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_end_mot_timed, current_year){
    0..1972:sw_hankyu5000_1_end_mot;    1973..1999:hankyu5000_3_end_mot;
    hankyu5000_4_end_mot;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_end_mot_rev_timed, current_year){
    0..1972:sw_hankyu5000_1_end_mot_rev;    1973..1999:hankyu5000_3_end_mot_rev;
    hankyu5000_4_end_mot_rev;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_mot_timed, current_year){
    0..1972:sw_hankyu5000_1_mot;    1973..1999:hankyu5000_2_mot;
    hankyu5000_4_mot;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_wag_timed, current_year){
    0..1972:sw_hankyu5000_1_wag;    1973..1999:hankyu5000_2_wag;
    hankyu5000_4_wag;
  }

  switch(FEAT_TRAINS, SELF, hankyu5000_front, cargo_subtype){
    1:sw_hankyu5000_1_front;    2:hankyu5000_3_front;    3:hankyu5000_4_front;
    hankyu5000_front_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_end, cargo_subtype){
    1:sw_hankyu5000_1_end;    2:hankyu5000_3_end;    3:hankyu5000_4_end;
    hankyu5000_end_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_end_rev, cargo_subtype){
    1:sw_hankyu5000_1_end_rev;    2:hankyu5000_3_end_rev;    3:hankyu5000_4_end_rev;
    hankyu5000_end_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_front_mot, cargo_subtype){
    1:sw_hankyu5000_1_front_mot;    2:hankyu5000_3_front_mot;    3:hankyu5000_4_front_mot;
    hankyu5000_front_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_end_mot, cargo_subtype){
    1:sw_hankyu5000_1_end_mot;    2:hankyu5000_3_end_mot;    3:hankyu5000_4_end_mot;
    hankyu5000_end_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_end_mot_rev, cargo_subtype){
    1:sw_hankyu5000_1_end_mot_rev;    2:hankyu5000_3_end_mot_rev;    3:hankyu5000_4_end_mot_rev;
    hankyu5000_end_mot_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_mot, cargo_subtype){
    1:sw_hankyu5000_1_mot;    2:hankyu5000_2_mot;    3:hankyu5000_4_mot;
    hankyu5000_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, hankyu5000_wag, cargo_subtype){
    1:sw_hankyu5000_1_wag;    2:hankyu5000_2_wag;    3:hankyu5000_4_wag;
    hankyu5000_wag_timed;
  }
//*livery 1
  //special gfx
    //head
      switch(FEAT_TRAINS, PARENT, sw_hankyu5000_front,vehicle_is_reversed==0&&num_vehs_in_consist<4){
        1: hankyu5000_front_mot;
        hankyu5000_front;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu5000_end,vehicle_is_reversed==1&&num_vehs_in_consist<4){
        1: hankyu5000_end_mot;
        hankyu5000_end;
      }
  //panto-placers
    //var 1 (4+x 1)
    switch(FEAT_TRAINS, SELF, sw_hankyu5000_panto_placer_main_1,position_in_vehid_chain %3){
      2: hankyu5000_mot;
      hankyu5000_wag;
    }
    //var 2 (4+x 2)
    switch(FEAT_TRAINS, SELF, sw_hankyu5000_panto_placer_main_2,position_in_vehid_chain %2){
      1: hankyu5000_mot;
      hankyu5000_wag;
    }
  //fake-head-placer
    //var 1  (4+x 1)
      switch(FEAT_TRAINS, SELF, sw_hankyu5000_fake_head_placer_main_1,position_in_vehid_chain){
        2: hankyu5000_end_mot_rev;
        3: hankyu5000_end;
        sw_hankyu5000_panto_placer_main_1;
      }
    //var 1  (4+x 2)
      switch(FEAT_TRAINS, SELF, sw_hankyu5000_fake_head_placer_main_2,position_in_vehid_chain){
        2: hankyu5000_end_rev;
        3: hankyu5000_end;
        sw_hankyu5000_panto_placer_main_2;
      }
    //var 2  (3+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu5000_fake_head_placer_main_3,position_in_vehid_chain){
        1: hankyu5000_end_mot_rev;
        2: hankyu5000_end;
        sw_hankyu5000_panto_placer_main_2;
      }
    //main
      random_switch(FEAT_TRAINS, PARENT, sw_hankyu5000_fake_head_placer_main_0){
        1: sw_hankyu5000_fake_head_placer_main_2;
        1: sw_hankyu5000_fake_head_placer_main_1;
      }
      switch(FEAT_TRAINS, SELF, sw_hankyu5000_fake_head_placer_main,num_vehs_in_vehid_chain){
        4..5: sw_hankyu5000_fake_head_placer_main_3;
        6: sw_hankyu5000_fake_head_placer_main_0;
        sw_hankyu5000_fake_head_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu5000_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu5000_end;
      default: sw_hankyu5000_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu5000_lv,vehicle_type_id){
      mu_car: sw_hankyu5000_fake_head_placer_main;
      default: sw_hankyu5000_gfx_main;
    }
//liveries
  switch(FEAT_TRAINS, SELF, sw_hankyu5000_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1968);
    2: string(LV_DATED,string(STR_LIVERY,string(LV_MODERN)),1973);
    3: string(LV_DATED,string(STR_LIVERY,string(LV_RENEW)),2000);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu5000_capacity_main,vehicle_type_id){
    mu_car: 150;
    140;
  }
  //power fix
    switch(FEAT_TRAINS, SELF, sw_hankyu5000_car_power_main,position_in_vehid_chain_from_end %2){
      1:return 170;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu5000_head_power_main,num_vehs_in_vehid_chain){
      2:return 170*2;
      return 170;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu5000_power_main,vehicle_type_id){
      mu_car:sw_hankyu5000_car_power_main;
      sw_hankyu5000_head_power_main;
    }
  //variant naming shenanigans
    switch (FEAT_TRAINS, SELF, sw_hankyu5000_name_purchase, getbits(extra_callback_info1, 8, 8)) { 
      1: return CB_RESULT_NO_TEXT; 
      return string(STR_TRAIN_NAME, string(STR_NAME_HANKYU), "5000/5300", string(STR_NAME_SERIES));
      } 
    switch (FEAT_TRAINS, SELF, sw_hankyu5000_name, getbits(extra_callback_info1, 0, 8)) { 
      0x20: sw_hankyu5000_name_purchase; 
      return CB_RESULT_NO_TEXT;
    }
