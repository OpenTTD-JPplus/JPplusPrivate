//purchase
  spriteset(hankyu8000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_purchase_1c_dual(0, 50) }
  spriteset(hankyu8000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_purchase_2c_dual(0, 200) }
  GRAPHIC_STACK_2(hankyu8000_purchase, hankyu8000_purchase_c1, hankyu8000_purchase_c2)
//livery 1
  spriteset(hankyu8000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu8000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu8000_1_front_mot_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_v3(0, 50) }
  spriteset(hankyu8000_1_end_mot_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_v3(0, 75) }
  spriteset(hankyu8000_1_front_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_v3(0, 100) }
  spriteset(hankyu8000_1_end_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_v3(0, 125) }
  spriteset(hankyu8000_1_mot_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_symm_v3(0, 150) }
  spriteset(hankyu8000_1_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_symm_v3(0, 175) }
  spriteset(hankyu8000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_symm_v3(0, 200) }
  spriteset(hankyu8000_1_front_mot_1_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_symm_v3(0, 225) }
  spriteset(hankyu8000_1_end_mot_1_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_rev_v3(0, 225) }
  spriteset(hankyu8000_1_front_mot_2_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_v3(0, 250) }
  spriteset(hankyu8000_1_end_mot_2_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_rev_v3(0, 250) }
  spriteset(hankyu8000_1_front_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_v3(0, 275) }
  spriteset(hankyu8000_1_end_f, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu8000/hankyu8000.png"){ tmpl_std_rev_v3(0, 275) }

//*livery 1
  //special gfx
    //timed
      switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_front_mot_gfx, build_year>1996){
        1:hankyu8000_1_front_mot_2;
        hankyu8000_1_front_mot_1;
      }
      switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_end_mot_gfx, build_year>1996){
        1:hankyu8000_1_end_mot_2;
        hankyu8000_1_end_mot_1;
      }
      switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_mot_gfx, build_year>1996){
        1:hankyu8000_1_mot_2;
        hankyu8000_1_mot_1;
      }
      switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_front_mot_f_gfx, build_year>1996){
        1:hankyu8000_1_front_mot_2_f;
        hankyu8000_1_front_mot_1_f;
      }
    //mot
      switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_mot,position_in_vehid_chain_from_end-1){
        0..1: hankyu8000_1_wag;
        sw_hankyu8000_1_mot_gfx;
      }
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu8000_1_front,vehicle_is_reversed){
        1: hankyu8000_1_front;
        sw_hankyu8000_1_front_mot_gfx;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu8000_1_end,vehicle_is_reversed){
        1: sw_hankyu8000_1_end_mot_gfx;
        hankyu8000_1_end;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_panto_placer_main_1,position_in_vehid_chain %4){
      0: sw_hankyu8000_1_mot;
      hankyu8000_1_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_panto_placer_main,num_vehs_in_vehid_chain){
      0..2: hankyu8000_1_wag;
      sw_hankyu8000_1_panto_placer_main_1;
    }
    //var 2 (8200)
    switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_panto_placer_main_2,position_in_vehid_chain){
      0: sw_hankyu8000_1_mot;
      hankyu8000_1_wag;
    }
  //fake-head-placer
    //var 1  (8200 imitation)
      switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_fake_head_placer_main_1,position_in_vehid_chain){
        0: hankyu8000_1_end_f;
        1: sw_hankyu8000_1_front_mot_f_gfx;
        sw_hankyu8000_1_panto_placer_main_2;
      }
    switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_fake_head_placer_main,num_vehs_in_vehid_chain){
        8: sw_hankyu8000_1_fake_head_placer_main_1;
        sw_hankyu8000_1_panto_placer_main;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu8000_1_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu8000_1_end;
      default: sw_hankyu8000_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu8000_lv,vehicle_type_id){
      mu_car: sw_hankyu8000_1_fake_head_placer_main;
      sw_hankyu8000_1_gfx_main;
    }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu8000_capacity_main,vehicle_type_id){
    mu_car: 142;
    132;
  }
  //spped fix
  switch(FEAT_TRAINS, SELF, sw_hankyu8000_speed_main,build_year>1996){
    1:return 130;
    return 120;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu8000_power_main_0,build_year>1996){
    1:return 190;
    return 170;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu8000_car_power_main,position_in_vehid_chain_from_end %6){
    0:sw_hankyu8000_power_main_0;
    5:sw_hankyu8000_power_main_0;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu8000_power_head_main,num_vehs_in_vehid_chain){
    2:sw_hankyu8000_power_main_0;
    sw_hankyu8000_power_main_0()*2;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu8000_power_main, vehicle_type_id){
    mu_car: sw_hankyu8000_car_power_main;
    sw_hankyu8000_power_head_main;
  }
//