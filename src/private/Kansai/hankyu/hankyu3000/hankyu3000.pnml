//
//*livery 1 (old, made as livery for variety sake)
  //special gfx
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu3000_1_front,vehicle_is_reversed){
        1: hankyu3000_1_front_mot;
        hankyu3000_1_front;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu3000_1_end,vehicle_is_reversed){
        1: hankyu3000_1_end;
        hankyu3000_1_end_mot;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_1_panto_placer_main_1,position_in_vehid_chain %5){
      0: hankyu3000_1_mot;
      2: hankyu3000_1_mot;
      hankyu3000_1_wag;
    }
    //var 2 (special for 8 cars)
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_1_panto_placer_main_2,position_in_vehid_chain %4){
      1: hankyu3000_1_mot;
      hankyu3000_1_wag;
    }
    random_switch(FEAT_TRAINS, PARENT, sw_hankyu3000_1_panto_placer_main_0){
      1: sw_hankyu3000_1_panto_placer_main_1;
      1: sw_hankyu3000_1_panto_placer_main_2;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_1_panto_placer_main,num_vehs_in_vehid_chain){
        6: sw_hankyu3000_1_panto_placer_main_0;
        sw_hankyu3000_1_panto_placer_main_1;
      }
  //fake-head-placer
    //var 1  (4+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu3000_1_fake_head_placer_main_1,position_in_vehid_chain){
        2: hankyu3000_1_end_mot;
        3: hankyu3000_1_end_rev;
        sw_hankyu3000_1_panto_placer_main;
      }
    //var 2  (3+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu3000_1_fake_head_placer_main_2,position_in_vehid_chain){
        1: hankyu3000_1_end_mot;
        2: hankyu3000_1_end_rev;
        sw_hankyu3000_1_panto_placer_main_1;
      }
    //main
      switch(FEAT_TRAINS, SELF, sw_hankyu3000_1_fake_head_placer_main,num_vehs_in_vehid_chain){
        0..2: sw_hankyu3000_1_panto_placer_main_1;
        3..4: sw_hankyu3000_1_fake_head_placer_main_2;
        sw_hankyu3000_1_fake_head_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_1_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu3000_1_end;
      sw_hankyu3000_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_livery_1,vehicle_type_id){
      mu_car: sw_hankyu3000_1_fake_head_placer_main;
      default: sw_hankyu3000_1_gfx_main;
    }

//*livery 2 (new)
  //special gfx
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu3000_2_front,vehicle_is_reversed==0&&num_vehs_in_consist==2){
        1: hankyu3000_2_front_mot;
        hankyu3000_2_front;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu3000_2_end,vehicle_is_reversed==1&&num_vehs_in_consist==2){
        1: hankyu3000_2_end_mot;
        hankyu3000_2_end;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_2_panto_placer_main_1,position_in_vehid_chain %3){
      0: hankyu3000_2_mot;
      hankyu3000_2_wag;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_2_panto_placer_main_2,position_in_vehid_chain %7){
      0: hankyu3000_2_mot;
      4: hankyu3000_2_mot;
      hankyu3000_2_wag;
    }
    //var 3
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_2_panto_placer_main_3,position_in_vehid_chain %3){
      1: hankyu3000_2_mot;
      hankyu3000_2_wag;
    }
    //main
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_2_panto_placer_main,num_vehs_in_vehid_chain){
      3: sw_hankyu3000_2_panto_placer_main_3;
      4: sw_hankyu3000_2_panto_placer_main_1;
      sw_hankyu3000_2_panto_placer_main_2;
    }
  //fake-head-placer
    //var 1  (4+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu3000_2_fake_head_placer_main_1,position_in_vehid_chain){
        2: hankyu3000_2_end;
        3: hankyu3000_2_end_rev;
        sw_hankyu3000_2_panto_placer_main;
      }
    //var 2  (3+x)
      switch(FEAT_TRAINS, SELF, sw_hankyu3000_2_fake_head_placer_main_2,position_in_vehid_chain){
        1: hankyu3000_2_end;
        2: hankyu3000_2_end_rev;
        sw_hankyu3000_2_panto_placer_main_1;
      }
    //main
      random_switch(FEAT_TRAINS, PARENT, sw_hankyu3000_2_fake_head_placer_main_0){
        2: sw_hankyu3000_2_panto_placer_main_1;
        1: sw_hankyu3000_2_fake_head_placer_main_2;
      }
      switch(FEAT_TRAINS, SELF, sw_hankyu3000_2_fake_head_placer_main_0_1,num_vehs_in_vehid_chain){
        0..3: sw_hankyu3000_2_panto_placer_main_1;
        4: sw_hankyu3000_2_fake_head_placer_main_0;
        sw_hankyu3000_2_fake_head_placer_main_1;
      }
      random_switch(FEAT_TRAINS, PARENT, sw_hankyu3000_2_fake_head_placer_main_0_2) {
        2: sw_hankyu3000_2_fake_head_placer_main_0_1;
        1: sw_hankyu3000_2_panto_placer_main;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu3000_2_fake_head_placer_main, current_year>1996){
        1: sw_hankyu3000_2_fake_head_placer_main_0_2;
        sw_hankyu3000_2_fake_head_placer_main_0_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_2_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu3000_2_end;
      default: sw_hankyu3000_2_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_livery_2,vehicle_type_id){
      mu_car: sw_hankyu3000_2_fake_head_placer_main;
      default: sw_hankyu3000_2_gfx_main;
    }
//*livery 3
  //special gfx
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu3000_3_front,vehicle_is_reversed==0&&num_vehs_in_consist==2){
        1: hankyu3000_3_front_mot;
        hankyu3000_3_front;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu3000_3_end,vehicle_is_reversed==1&&num_vehs_in_consist==2){
        1: hankyu3000_3_end_mot;
        hankyu3000_3_end;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_3_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu3000_3_end;
      default: sw_hankyu3000_3_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_livery_3,vehicle_type_id){
      mu_car: sw_hankyu3000_2_fake_head_placer_main;
      default: sw_hankyu3000_3_gfx_main;
    }
//*livery 4
  //special gfx
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu3000_4_front,vehicle_is_reversed==0&&num_vehs_in_consist==2){
        1: hankyu3000_4_front_mot;
        hankyu3000_4_front;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu3000_4_end,vehicle_is_reversed==1&&num_vehs_in_consist==2){
        1: hankyu3000_4_end_mot;
        hankyu3000_4_end;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_4_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu3000_4_end;
      default: sw_hankyu3000_4_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu3000_livery_4,vehicle_type_id){
      mu_car: sw_hankyu3000_2_fake_head_placer_main;
      default: sw_hankyu3000_4_gfx_main;
    }
//
//liveries
  //livery 0
  switch(FEAT_TRAINS, PARENT, sw_hankyu3000_livery_0, current_year){
    0..1974: sw_hankyu3000_livery_1;
    1975..1980: sw_hankyu3000_livery_2;
    1981..1994: sw_hankyu3000_livery_3;
    sw_hankyu3000_livery_4;
  }
  switch(FEAT_TRAINS, PARENT, sw_hankyu3000_livery_2_1, current_year){
    0..1980: sw_hankyu3000_livery_2;
    1981..1994: sw_hankyu3000_livery_3;
    sw_hankyu3000_livery_4;
  }
  //lv selector
  switch(FEAT_TRAINS, SELF, sw_hankyu3000_lv, cargo_subtype){
    0: sw_hankyu3000_livery_0;
    1: sw_hankyu3000_livery_1;
    2: sw_hankyu3000_livery_2_1;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu3000_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1964);
    2: string(LV_DATED,string(STR_LIVERY,string(LV_MODERN)),1975);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu3000_capacity_main,vehicle_type_id){
    mu_car: 150;
    140;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu3000_car_power_main,position_in_vehid_chain_from_end %2){
    1:return 170;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu3000_power_main,vehicle_type_id){
    mu_car: sw_hankyu3000_car_power_main;
    return 170;
  }
