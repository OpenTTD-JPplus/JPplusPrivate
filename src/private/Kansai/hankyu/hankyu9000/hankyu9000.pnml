//purchase
  spriteset(hankyu9000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu9000/hankyu9000.png"){ tmpl_purchase_1c_dual(0, 50) }
  spriteset(hankyu9000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu9000/hankyu9000.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(hankyu9000_purchase, hankyu9000_purchase_c1, hankyu9000_purchase_c2)
//livery 1
  spriteset(hankyu9000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu9000/hankyu9000.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu9000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu9000/hankyu9000.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu9000_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu9000/hankyu9000.png"){ tmpl_std_v3(0, 50) }
  spriteset(hankyu9000_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu9000/hankyu9000.png"){ tmpl_std_v3(0, 75) }
  spriteset(hankyu9000_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu9000/hankyu9000.png"){ tmpl_symm_v3(0, 100) }
  spriteset(hankyu9000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu9000/hankyu9000.png"){ tmpl_symm_v3(0, 125) }
//TODO more liveries

//*livery 1
  //special gfx
    //mot
    switch(FEAT_TRAINS, SELF, sw_hankyu9000_1_mot,position_in_vehid_chain_from_end){
      0..1: hankyu9000_1_wag;
      hankyu9000_1_mot;
    }
    //head
      switch(FEAT_TRAINS, PARENT, sw_hankyu9000_1_front,vehicle_is_reversed){
        1: hankyu9000_1_front;
        hankyu9000_1_front_mot;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu9000_1_end,vehicle_is_reversed){
        1: hankyu9000_1_end_mot;
        hankyu9000_1_end;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu9000_1_panto_placer_main_1,position_in_vehid_chain %4){
      0: sw_hankyu9000_1_mot;
      hankyu9000_1_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu9000_1_panto_placer_main,num_vehs_in_vehid_chain){
      0..2: hankyu9000_1_wag;
      sw_hankyu9000_1_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu9000_1_gfx_main,train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu9000_1_end;
      default: sw_hankyu9000_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu9000_lv,vehicle_type_id){
      mu_car: sw_hankyu9000_1_panto_placer_main;
      sw_hankyu9000_1_gfx_main;
    }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu9000_capacity_main,vehicle_type_id){
    mu_car: 131;
    121;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu9000_car_power_main,position_in_vehid_chain_from_end %8){
    0:return 200;
    6..7:return 200;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu9000_power_main,vehicle_type_id){
    mu_car: sw_hankyu9000_car_power_main;
    return 200*2;
  }
