//purchase
spriteset(hankyu2000n_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000n/hankyu2000n.png"){ tmpl_purchase_1c_dual(0, 0) }
spriteset(hankyu2000n_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000n/hankyu2000n.png"){ tmpl_purchase_2c_dual(0, 75) }
GRAPHIC_STACK_2(hankyu2000n_purchase, hankyu2000n_purchase_c1, hankyu2000n_purchase_c2)
//livery 1
  spriteset(hankyu2000n_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000n/hankyu2000n.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu2000n_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000n/hankyu2000n.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu2000n_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000n/hankyu2000n.png"){ tmpl_symm_v3(0, 50) }
  spriteset(hankyu2000n_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu2000n/hankyu2000n.png"){ tmpl_symm_v3(0, 75) }
//TODO more liveries

//*livery 1
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu2000n_1_panto_placer_main_1,position_in_vehid_chain %6){
      0: hankyu2000n_1_mot;
      4: hankyu2000n_1_mot;
      hankyu2000n_1_wag;
    }
    //var 2
    switch(FEAT_TRAINS, SELF, sw_hankyu2000n_1_panto_placer_main_2,position_in_vehid_chain %3){
      1: hankyu2000n_1_mot;
      hankyu2000n_1_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu2000n_1_panto_placer_main,num_vehs_in_vehid_chain){
      3: sw_hankyu2000n_1_panto_placer_main_2;
      sw_hankyu2000n_1_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu2000n_1_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: hankyu2000n_1_end;
      default: hankyu2000n_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu2000n_lv,vehicle_type_id){
      mu_car: sw_hankyu2000n_1_panto_placer_main;
      default: sw_hankyu2000n_1_gfx_main;
    }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu2000n_capacity_main,vehicle_type_id){
    mu_car: 129;
    117;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu2000n_car_power_main,position_in_vehid_chain_from_end %8){
    0..1:return 190;
    4..5:return 190;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu2000n_power_main,position_in_vehid_chain_from_end %8){
    mu_car: sw_hankyu2000n_car_power_main;
    return 0;
  }
