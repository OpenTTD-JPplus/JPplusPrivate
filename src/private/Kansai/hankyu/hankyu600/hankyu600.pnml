//purchase
spriteset(hankyu600_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu600/hankyu600.png"){ tmpl_purchase_1c(0, 0) }

spriteset(hankyu600_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu600/hankyu600_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(hankyu600_lights_front_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu600/hankyu600_lights.png"){ tmpl_std_rev_v3(0, 0) }
switch(FEAT_TRAINS, SELF, sw_hankyu600_lights_front, position_in_consist){
  0:hankyu600_lights_front; gfx_empty;
  }
switch(FEAT_TRAINS, SELF, sw_hankyu600_lights_front_rev, position_in_consist_from_end){
  0:hankyu600_lights_front_rev; gfx_empty;
  }
switch(FEAT_TRAINS, SELF, sw_hankyu600_lights, train_is_driving_backwards != vehicle_is_flipped){
  1: sw_hankyu600_lights_front_rev;
  sw_hankyu600_lights_front;
}
spriteset(hankyu600_mot_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu600/hankyu600.png"){ tmpl_std_v3(0, 0) }
spriteset(hankyu600_car_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu600/hankyu600.png"){ tmpl_symm_v3(0, 25) }

//panto placer
switch(FEAT_TRAINS, SELF, sw_hankyu600_panto_placer_main,position_in_vehid_chain %2){
    0: hankyu600_mot_base;
    hankyu600_car_base;
}
//end car fixer
TRAIN_CONSTRUCTOR_2(sw_hankyu600_lv, sw_hankyu600_panto_placer_main, sw_hankyu600_lights)
//
  switch(FEAT_TRAINS, SELF, sw_hankyu600_car_power_main,position_in_vehid_chain%2){
      1:return 71;
      return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu600_power_main,vehicle_type_id){
    mu_car:sw_hankyu600_car_power_main;
    return 71;
  }
