//purchase
  spriteset(hankyu6000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000.png"){ tmpl_purchase_1c_dual(0, 50) }
  spriteset(hankyu6000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000.png"){ tmpl_purchase_2c_dual(0, 125) }
  GRAPHIC_STACK_2(hankyu6000_purchase, hankyu6000_purchase_c1, hankyu6000_purchase_c2)
//livery 1
  spriteset(hankyu6000_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu6000_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu6000_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000.png"){ tmpl_std_v3(0, 50) }
  spriteset(hankyu6000_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000.png"){ tmpl_std_v3(0, 75) }
  spriteset(hankyu6000_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000.png"){ tmpl_symm_v3(0, 100) }
  spriteset(hankyu6000_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000.png"){ tmpl_symm_v3(0, 125) }
//livery 2
  
  spriteset(hankyu6000_2_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000_n.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu6000_2_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000_n.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu6000_2_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000_n.png"){ tmpl_std_v3(0, 50) }
  spriteset(hankyu6000_2_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000_n.png"){ tmpl_std_v3(0, 75) }
  spriteset(hankyu6000_2_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000_n.png"){ tmpl_symm_v3(0, 100) }
  spriteset(hankyu6000_2_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6000_n.png"){ tmpl_symm_v3(0, 125) }

//*livery 1
  //special gfx
    //mot
      switch(FEAT_TRAINS, SELF, sw_hankyu6000_1_mot,position_in_vehid_chain_from_end-1){
        0..1: hankyu6000_1_wag;
        hankyu6000_1_mot;
      }
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu6000_1_front,vehicle_is_reversed){
        1: hankyu6000_1_front;
        hankyu6000_1_front_mot;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu6000_1_end,vehicle_is_reversed){
        1: hankyu6000_1_end_mot;
        hankyu6000_1_end;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu6000_1_panto_placer_main_1,position_in_vehid_chain %4){
      0: sw_hankyu6000_1_mot;
      hankyu6000_1_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu6000_1_panto_placer_main,num_vehs_in_vehid_chain+1){
      0..3: hankyu6000_1_wag;
      sw_hankyu6000_1_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu6000_1_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu6000_1_end;
      default: sw_hankyu6000_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu6000_livery_1,vehicle_type_id){
      mu_car: sw_hankyu6000_1_panto_placer_main;
      sw_hankyu6000_1_gfx_main;
    }
//*livery 2
  //special gfx
    //mot
      switch(FEAT_TRAINS, SELF, sw_hankyu6000_2_mot_rev,position_in_vehid_chain){
        0..1: hankyu6000_2_wag;
        hankyu6000_2_mot;
      }
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu6000_2_front,vehicle_is_reversed){
        1: hankyu6000_2_front;
        hankyu6000_2_front_mot;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu6000_2_end,vehicle_is_reversed){
        1: hankyu6000_2_end_mot;
        hankyu6000_2_end;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu6000_2_panto_placer_main_1,position_in_vehid_chain_from_end %4){
      0: sw_hankyu6000_2_mot_rev;
      hankyu6000_2_wag;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu6000_2_panto_placer_main,num_vehs_in_vehid_chain){
      1: hankyu6000_2_wag;
      sw_hankyu6000_2_panto_placer_main_1;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu6000_2_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: sw_hankyu6000_2_end;
      default: sw_hankyu6000_2_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu6000_livery_2,vehicle_type_id){
      mu_car: sw_hankyu6000_2_panto_placer_main;
      default: sw_hankyu6000_2_gfx_main;
    }
//liveries
  //livery 0
  switch(FEAT_TRAINS, PARENT, sw_hankyu6000_livery_0, current_year<1990){
    1: sw_hankyu6000_livery_1;
    sw_hankyu6000_livery_2;
  }
  //lv selector
  switch(FEAT_TRAINS, PARENT, sw_hankyu6000_lv, cargo_subtype){
    0: sw_hankyu6000_livery_0;
    1: sw_hankyu6000_livery_1;
    2: sw_hankyu6000_livery_2;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu6000_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1976);
    2: string(LV_DATED,string(STR_LIVERY,string(LV_MODERN)),1990);
  }
//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu6000_capacity_main,vehicle_type_id){
    mu_car: 150;
    140;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu6000_car_power_main,position_in_vehid_chain_from_end %6){
    0:return 140;
    3:return 140;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu6000_power_main,vehicle_type_id){
    mu_car: sw_hankyu6000_car_power_main;
    return 140*2;
  }
//