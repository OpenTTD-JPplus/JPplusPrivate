//purchase
  spriteset(hankyu6300_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6300.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(hankyu6300_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6300.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_2(hankyu6300_purchase, hankyu6300_purchase_c1, hankyu6300_purchase_c2)
//livery 1
  spriteset(hankyu6300_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6300.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu6300_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6300.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu6300_1_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6300.png"){ tmpl_symm_v3(0, 50) }
  spriteset(hankyu6300_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu6000/hankyu6300.png"){ tmpl_symm_v3(0, 75) }

//*livery 1
  //panto-placers
    //var 1
      switch(FEAT_TRAINS, SELF, sw_hankyu6300_1_panto_placer_main_1,position_in_vehid_chain %2){
        0: hankyu6300_1_mot;
        hankyu6300_1_wag;
      }
    //var 2
      switch(FEAT_TRAINS, SELF, sw_hankyu6300_1_panto_placer_main_2,position_in_vehid_chain %4){
        0: hankyu6300_1_mot;
        hankyu6300_1_wag;
      }
    //main
      switch(FEAT_TRAINS, SELF, sw_hankyu6300_1_panto_placer_main,num_vehs_in_vehid_chain){
        2..4:sw_hankyu6300_1_panto_placer_main_1;
        sw_hankyu6300_1_panto_placer_main_2;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu6300_1_gfx_main, train_is_driving_backwards != vehicle_is_flipped){
      1: hankyu6300_1_end;
      default: hankyu6300_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu6300_lv,vehicle_type_id){
      mu_car: sw_hankyu6300_1_panto_placer_main;
      default: sw_hankyu6300_1_gfx_main;
    }

//*post fixers
  //capacity-changer
  switch(FEAT_TRAINS, SELF, sw_hankyu6300_capacity_main,vehicle_type_id){
    mu_car: 141;
    129;
  }
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu6300_car_power_main,position_in_vehid_chain_from_end %8){
    0:return 140;
    3:return 140;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu6300_power_main,vehicle_type_id){
    mu_car: sw_hankyu6300_car_power_main;
    return 140*2;
  }
