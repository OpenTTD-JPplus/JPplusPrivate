//purchase
spriteset(hankyu900_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu900/hankyu900.png"){ tmpl_purchase_1c_dual(0, 50) }
spriteset(hankyu900_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu900/hankyu900.png"){ tmpl_purchase_2c_dual(0, 25) }
GRAPHIC_STACK_2(hankyu900_purchase, hankyu900_purchase_c1, hankyu900_purchase_c2)
//livery 1
  spriteset(hankyu900_1_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu900/hankyu900.png"){ tmpl_std_v3(0, 0) }
  spriteset(hankyu900_1_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu900/hankyu900.png"){ tmpl_std_v3(0, 25) }
  spriteset(hankyu900_1_end_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu900/hankyu900.png"){ tmpl_std_rev_v3(0, 25) }
  spriteset(hankyu900_1_front_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu900/hankyu900.png"){ tmpl_std_v3(0, 50) }
  spriteset(hankyu900_1_end_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu900/hankyu900.png"){ tmpl_std_v3(0, 75) }
  spriteset(hankyu900_1_end_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu900/hankyu900.png"){ tmpl_std_rev_v3(0, 75) }
//

//*livery 1
  //special gfx
    //head 
      switch(FEAT_TRAINS, PARENT, sw_hankyu900_1_front,vehicle_is_reversed){
        1: hankyu900_1_front;
        hankyu900_1_front_mot;
      }
      switch(FEAT_TRAINS, PARENT, sw_hankyu900_1_end,vehicle_is_reversed){
        1: hankyu900_1_end_mot;
        hankyu900_1_end;
      }
  //panto-placers
    //var 1
    switch(FEAT_TRAINS, SELF, sw_hankyu900_1_panto_placer_main_1,position_in_vehid_chain %2){
      0: hankyu900_1_end_rev;
      hankyu900_1_end_mot;
    }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu900_1_gfx_main,position_in_vehid_chain_from_end){
      1: sw_hankyu900_1_end;
      default: sw_hankyu900_1_front;
    }
    switch(FEAT_TRAINS, SELF, sw_hankyu900_lv,vehicle_type_id){
      mu_car: sw_hankyu900_1_panto_placer_main_1;
      default: sw_hankyu900_1_gfx_main;
    }

//*post fixers
  //power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu900_car_power_main,position_in_vehid_chain_from_end %2){
    0:return 150;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu900_power_main,vehicle_type_id){
    mu_car: sw_hankyu900_car_power_main;
    return 150;
  }
