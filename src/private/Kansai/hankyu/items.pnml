#include "hankyu5000/hankyu5000.pnml"

item(FEAT_TRAINS, hankyu5000) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_hankyu == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_HANKYU), "5000", string(STR_NAME_SERIES));
    introduction_date: date(1968, 1, 1);
    model_life: 53;
    vehicle_life: 48;
    dual_headed: 1;
    
    cost_factor: 19;
    running_cost_factor: 50;
    speed: 110 km/h;
    track_type:TR_1435_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 33 ton;
    badges: ["company/hankyu"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_3, 2,6,8)),
    string(STR_USAGE, string(STR_COMMUTER)),
    string(STR_OPERATOR, string(STR_HANKYU))
    
    );
    cargo_subtype_text: sw_hankyu5000_lv_desc_main;
    purchase: hankyu5000_purchase;
    cargo_capacity:sw_hankyu5000_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_hankyu5000_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_3D;
    default:sw_hankyu5000_lv;
    power:sw_hankyu5000_power_main()*4*1342/1000;
    purchase_power: sw_hankyu5000_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_hankyu5000_lv_desc_main;
    loading_speed:param_loading_3D;
    cargo_capacity:sw_hankyu5000_capacity_main()*param_capacity_mod/3;
    power:sw_hankyu5000_power_main()*4*1342/1000;
    default:sw_hankyu5000_lv;
    weight: 34;
    
  }
}
