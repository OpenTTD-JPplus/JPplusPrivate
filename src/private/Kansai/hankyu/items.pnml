#include "hankyu1/hankyu1.pnml"

item(FEAT_TRAINS, hankyu1) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_hankyu == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_HANKYU), "1", string(STR_NAME_TYPE));
    introduction_date: date(1910, 3, 1);
    model_life: 51;
    vehicle_life: 46;
    dual_headed: 0;
    
    cost_factor: 12;
    running_cost_factor: 42;
    speed: 75 km/h;
    track_type:TR_1435_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 25 ton;
    badges: ["company/hankyu"];
    length: 7;
  }
	graphics {
    can_attach_wagon: sw_same_attach_main;
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
    string(STR_FORMATION, string(STR_NUM_CARS_1, 1)),
    string(STR_USAGE, string(STR_COMMUTER)),
    string(STR_OPERATOR, string(STR_HANKYU))
    
    );
    
    purchase: hankyu1_purchase;
    cargo_capacity:80*param_capacity_mod/3;
    
    loading_speed:param_loading_3D;
    default:sw_hankyu1_lv;
    power:sw_hankyu1_power_main()*4*1342/1000;
    purchase_power: sw_hankyu1_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_3D;
    cargo_capacity:80*param_capacity_mod/3;
    power:sw_hankyu1_power_main()*4*1342/1000;
    default:sw_hankyu1_lv;
    weight: 25;
    length: 7;
  }
}
