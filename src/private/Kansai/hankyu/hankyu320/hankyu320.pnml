//purchase
spriteset(hankyu320_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu320/hankyu320.png"){ tmpl_purchase_1c_dual(0, 25) }
spriteset(hankyu320_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu320/hankyu320.png"){ tmpl_purchase_2c_dual_7(0, 0) }
GRAPHIC_STACK_2(hankyu320_purchase, hankyu320_purchase_c1, hankyu320_purchase_c2)

spriteset(hankyu320_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu320/hankyu320_lights.png"){ tmpl_std_v3(0, 0) }
switch(FEAT_TRAINS, SELF, sw_hankyu320_lights, train_is_driving_backwards != vehicle_is_flipped){
  1: gfx_empty;
  hankyu320_lights_front;
}
spriteset(hankyu320_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu320/hankyu320.png"){ tmpl_std_v3(0, 0) }
spriteset(hankyu320_head_base_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu320/hankyu320.png"){ tmpl_std_rev_v3(0, 0) }
spriteset(hankyu320_head_mot_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hankyu/hankyu320/hankyu320.png"){ tmpl_std_v3(0, 25) }

//front-end-fixer
switch(FEAT_TRAINS, SELF, sw_hankyu320_head_gfx, vehicle_is_flipped){
  1: hankyu320_head_base;
  hankyu320_head_mot_base;
}
TRAIN_CONSTRUCTOR_2(sw_hankyu320_head, sw_hankyu320_head_gfx, sw_hankyu320_lights)
//panto placer
  switch(FEAT_TRAINS, SELF, sw_hankyu320_panto_placer_main,position_in_vehid_chain %2){
      0: hankyu320_head_base_rev;
      hankyu320_head_mot_base;
  }
//end car fixer
    switch(FEAT_TRAINS, SELF, sw_hankyu320_lv,vehicle_type_id){
      mu_car: sw_hankyu320_panto_placer_main;
      default: sw_hankyu320_head;
    }
//power fix
  switch(FEAT_TRAINS, SELF, sw_hankyu320_car_power_main,position_in_vehid_chain %2){
    1:return 150;
    return 0;
  }
  switch(FEAT_TRAINS, SELF, sw_hankyu320_power_main,vehicle_type_id){
    mu_car: sw_hankyu320_car_power_main;
    return 150;
  }
