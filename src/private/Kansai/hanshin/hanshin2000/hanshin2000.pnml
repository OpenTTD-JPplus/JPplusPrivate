  TRAIN_CONSTRUCTOR_2(hanshin2000_head, hanshin2000_head_base, sw_hanshin2000_lights)
//main
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_hanshin2000_panto_placer_main_1,position_in_vehid_chain %5){
        0: hanshin2000_mot_1;
        3: hanshin2000_mot_2;
        hanshin2000_wag;
      }
    //2215
      switch(FEAT_TRAINS, SELF, sw_hanshin2000_panto_placer_main_2,position_in_vehid_chain %5){
        0: hanshin2000_mot_2_2;
        1: hanshin2000_wag_h;
        3: hanshin2000_mot_2_2;
        hanshin2000_wag;
      }
    random_switch(FEAT_TRAINS,PARENT,sw_hanshin2000_panto_placer_main_2215){
      3:sw_hanshin2000_panto_placer_main_1;
      1: sw_hanshin2000_panto_placer_main_2;
    }
    switch(FEAT_TRAINS, PARENT, sw_hanshin2000_panto_placer_main,current_year){
        0..1994: sw_hanshin2000_panto_placer_main_1;
        sw_hanshin2000_panto_placer_main_2215;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hanshin2000_lv,vehicle_type_id){
      mu_car:sw_hanshin2000_panto_placer_main;
      hanshin2000_head;
    }
