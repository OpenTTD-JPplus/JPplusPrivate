spriteset(hanshin2000_mot_2_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hanshin/hanshin2000/hanshin2000.png"){ tmpl_std_v3(0, 75) }
spriteset(hanshin2000_mot_2_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hanshin/hanshin2000/hanshin2000.png"){ tmpl_std_v3(0, 100) }
