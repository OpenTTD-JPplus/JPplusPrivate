  spriteset(hanshin2000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hanshin/hanshin2000/hanshin2000.png"){ tmpl_purchase_2c_dual(0, 25) }
