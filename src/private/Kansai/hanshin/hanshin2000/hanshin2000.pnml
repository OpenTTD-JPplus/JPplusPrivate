//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_hanshin2000_capacity_main,vehicle_type_id){
        mu_car:150;
        140;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_hanshin2000_car_power_main,position_in_vehid_chain_from_end %6){
      0..3:return 110;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_hanshin2000_power_main,vehicle_type_id){
      mu_car: sw_hanshin2000_car_power_main;
      return 0;
    }
