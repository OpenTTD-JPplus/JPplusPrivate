//base
spriteset(hanshin2000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/hanshin/hanshin2000/hanshin2000_lights.png"){ tmpl_std_v3(0, 0) }
