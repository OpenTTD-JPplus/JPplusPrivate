//post fixers
  //power
    switch(FEAT_TRAINS, SELF, sw_hanshin3801_car_power_main,position_in_vehid_chain_from_end %6){
      0..3:return 130;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_hanshin3801_head_power_main,position_in_vehid_chain){
      1:return 130;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_hanshin3801_power_main,vehicle_type_id){
      mu_car: sw_hanshin3801_car_power_main;
      sw_hanshin3801_head_power_main;
    }
