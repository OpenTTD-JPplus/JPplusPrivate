  TRAIN_CONSTRUCTOR_2(hanshin3801_head, hanshin3801_head_base, sw_hanshin2000_lights)
//main
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_hanshin3801_panto_placer_main,position_in_vehid_chain_from_end %4){
        0: hanshin2000_mot_2_1;
        2: hanshin2000_mot_2_2;
        hanshin2000_wag;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_hanshin3801_head, position_in_vehid_chain){
      1:hanshin3801_head;
      hanshin2000_head;
    }
    switch(FEAT_TRAINS, SELF, sw_hanshin3801_lv,vehicle_type_id){
      mu_car:sw_hanshin3801_panto_placer_main;
      sw_hanshin3801_head;
    }
