#include "nankai6200/nankai6200.pnml"

item(FEAT_TRAINS, nankai6200) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_nankai == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_NANKAI), "6200", string(STR_NAME_SERIES));
    introduction_date: date(1974, 11, 22);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;
    
    cost_factor: 19;
    running_cost_factor: 49;
    speed: 110 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 34 ton;
    badges: ["company/nankai"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_2, 4,6)),
    string(STR_USAGE, string(STR_COMMUTER)),
    string(STR_OPERATOR, string(STR_NANKAI))
    
    );
    cargo_subtype_text: sw_nankai6200_lv_desc_main;
    purchase: nankai6200_purchase;
    cargo_capacity:sw_nankai6200_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_nankai6200_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_nankai6200_lv;
    power:sw_nankai6200_power_main()*4*1342/1000;
    purchase_power: sw_nankai6200_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_nankai6200_lv_desc_main;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_nankai6200_capacity_main()*param_capacity_mod/3;
    power:sw_nankai6200_power_main()*4*1342/1000;
    default:sw_nankai6200_lv;
    weight: 34;
    
  }
}
