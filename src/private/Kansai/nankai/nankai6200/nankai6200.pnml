//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_nankai6200_capacity_main,vehicle_type_id){
        mu_car:170;
        160;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_nankai6200_car_power_main,position_in_vehid_chain_from_end %6){
      0..3:return 145;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_nankai6200_power_main,vehicle_type_id){
      mu_car: sw_nankai6200_car_power_main;
      return 0;
    }
