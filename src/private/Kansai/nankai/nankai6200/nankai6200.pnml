// purchase
  spriteset(nankai6200_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/nankai/nankai6200/nankai6200_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(nankai6200_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/nankai/nankai6200/nankai6200_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_2(nankai6200_purchase,  nankai6200_purchase_c1, nankai6200_purchase_c2)
//base
spriteset(nankai6200_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/nankai/nankai6200/nankai6200_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(nankai6200_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/nankai/nankai6200/nankai6200_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sw_nankai6200_lights, train_is_driving_backwards != vehicle_is_flipped){
  1: nankai6200_lights_end;
  nankai6200_lights_front;
}
spriteset(nankai6200_head_base_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/nankai/nankai6200/nankai6200_1.png"){ tmpl_std_v3(0, 0) }
spriteset(nankai6200_head_base_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/nankai/nankai6200/nankai6200_1.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, nankai6200_head_base, current_year){
  0..2008:nankai6200_head_base_1;  nankai6200_head_base_2;
}
spriteset(nankai6200_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/nankai/nankai6200/nankai6200_1.png"){ tmpl_std_v3(0, 50) }
spriteset(nankai6200_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/nankai/nankai6200/nankai6200_1.png"){ tmpl_std_v3(0, 75) }
//
  TRAIN_CONSTRUCTOR_2(nankai6200_head, nankai6200_head_base, sw_nankai6200_lights)
//main
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_nankai6200_panto_placer_main,position_in_vehid_chain %2){
        0: nankai6200_mot;
        nankai6200_wag;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_nankai6200_lv,vehicle_type_id){
      mu_car:sw_nankai6200_panto_placer_main;
      nankai6200_head;
    }
