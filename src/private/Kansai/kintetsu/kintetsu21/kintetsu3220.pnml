  spriteset(kintetsu3220_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu3220_1.png"){ tmpl_purchase_1c_dual(0, 25) }
  spriteset(kintetsu3220_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu3220_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_4(kintetsu3220_purchase,  kintetsu3220_purchase_c1,ac_long_toshiba_c1, kintetsu3220_purchase_c2,ac_long_toshiba_c2)
//base
spriteset(kintetsu21_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu21_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(kintetsu21_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu21_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sw_kintetsu21_lights_1, train_is_driving_backwards != vehicle_is_flipped){
  1: kintetsu21_lights_end;
  kintetsu21_lights_front;
}
switch(FEAT_TRAINS, SELF, sw_kintetsu21_lights, position_in_consist==0||position_in_vehid_chain==0){
  1: sw_kintetsu21_lights_1;
  gfx_empty;
}
spriteset(kintetsu3220_head_base_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu3220_1.png"){ tmpl_std_v3(0, 0) }
spriteset(kintetsu3220_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu3220_1.png"){ tmpl_std_v3(0, 25) }
spriteset(kintetsu3220_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu3220_1.png"){ tmpl_symm_v3(0, 50) }
spriteset(kintetsu3220_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu3220_1.png"){ tmpl_std_v3(0, 75) }
spriteset(kintetsu3220_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu3220_1.png"){ tmpl_std_rev_v3(0, 75) }

//main
  //head gfx
    switch(FEAT_TRAINS, SELF, sw_kintetsu3220_head_2,vehicle_is_flipped){
      1:kintetsu3220_head_base;
      kintetsu3220_head_base_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu3220_head_main,num_vehs_in_vehid_chain==2&&position_in_vehid_chain==0||num_vehs_in_vehid_chain==3&&position_in_vehid_chain==1){
      1:sw_kintetsu3220_head_2;
      kintetsu3220_head_base;
    }
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_kintetsu3220_panto_placer_main,position_in_vehid_chain %6){
        0: kintetsu3220_mot;
        1: kintetsu3220_mot;
        3: kintetsu3220_mot_rev;
        kintetsu3220_wag;
      }
  //front-end-fixer
    TRAIN_CONSTRUCTOR_2(sw_kintetsu3220_head_lights, sw_kintetsu3220_head_main, sw_kintetsu21_lights)
    switch(FEAT_TRAINS, SELF, sw_kintetsu3220_lv,vehicle_type_id){
      mu_car:sw_kintetsu3220_panto_placer_main;
      sw_kintetsu3220_head_lights;
    }
//
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_kintetsu3220_capacity_main,vehicle_type_id){
        mu_car:147;
        134;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_kintetsu3220_car_power_main,position_in_vehid_chain_from_end %6){
      0..1:return 185;
      3:return 185;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu3220_head_power_main,num_vehs_in_vehid_chain>1&&position_in_vehid_chain==0){
      1:return 185;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu3220_power_main,vehicle_type_id){
      mu_car: sw_kintetsu3220_car_power_main;
      sw_kintetsu3220_head_power_main;
    }
