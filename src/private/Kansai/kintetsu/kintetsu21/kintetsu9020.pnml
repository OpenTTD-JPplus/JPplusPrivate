// purchase
  spriteset(kintetsu9020_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu9020_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(kintetsu9020_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu9020_1.png"){ tmpl_purchase_2c_dual(0, 50) }
  GRAPHIC_STACK_4(kintetsu9020_purchase,  kintetsu9020_purchase_c1,ac_long_toshiba_c1, kintetsu9020_purchase_c2,ac_long_toshiba_c2)
//base
spriteset(kintetsu9020_head_base_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu9020_1.png"){ tmpl_std_v3(0, 0) }
spriteset(kintetsu9020_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu21/kintetsu9020_1.png"){ tmpl_std_v3(0, 25) }
spriteset(kintetsu9020_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_1.png"){ tmpl_symm_v3(0, 50) }
spriteset(kintetsu9020_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_1.png"){ tmpl_symm_v3(88, 50) }
