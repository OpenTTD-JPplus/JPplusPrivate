//main
  //head gfx
    switch(FEAT_TRAINS, SELF, sw_kintetsu9020_head_2,vehicle_is_flipped){
      1:kintetsu9020_head_base;
      kintetsu9020_head_base_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu9020_head_main,num_vehs_in_vehid_chain==2&&position_in_vehid_chain==0||num_vehs_in_vehid_chain==3&&position_in_vehid_chain==1){
      1:sw_kintetsu9020_head_2;
      kintetsu9020_head_base;
    }
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_kintetsu9020_panto_placer_main,position_in_vehid_chain %6){
        0: kintetsu9020_mot;
        1: kintetsu9020_mot;
        3: kintetsu9020_mot_2;
        kintetsu9020_wag;
      }
  //front-end-fixer
    TRAIN_CONSTRUCTOR_2(sw_kintetsu9020_head_lights, sw_kintetsu9020_head_main, sw_kintetsu21_lights)
    switch(FEAT_TRAINS, SELF, sw_kintetsu9020_lv,vehicle_type_id){
      mu_car:sw_kintetsu9020_panto_placer_main;
      sw_kintetsu9020_head_lights;
    }
