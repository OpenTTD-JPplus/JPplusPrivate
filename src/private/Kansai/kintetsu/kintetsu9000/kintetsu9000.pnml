// purchase
  spriteset(kintetsu9000_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(kintetsu9000_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_4(kintetsu9000_purchase,  kintetsu9000_purchase_c1,ac_long_toshiba_c1, kintetsu9000_purchase_c2,ac_long_toshiba_c2)
//base
spriteset(kintetsu9000_lights_front, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(kintetsu9000_lights_end, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_lights.png"){ tmpl_std_v3(0, 25) }
switch(FEAT_TRAINS, SELF, sw_kintetsu9000_lights_1, train_is_driving_backwards != vehicle_is_flipped){
  1: kintetsu9000_lights_end;
  kintetsu9000_lights_front;
}
switch(FEAT_TRAINS, SELF, sw_kintetsu9000_lights, position_in_consist==0||position_in_vehid_chain==0){
  1: sw_kintetsu9000_lights_1;
  gfx_empty;
}
spriteset(kintetsu9000_head_base_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_1.png"){ tmpl_std_v3(0, 0) }
spriteset(kintetsu9000_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_1.png"){ tmpl_std_v3(0, 25) }
spriteset(kintetsu9000_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_1.png"){ tmpl_symm_v3(0, 50) }
spriteset(kintetsu9000_mot_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_1.png"){ tmpl_symm_v3(88, 50) }
spriteset(kintetsu9000_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/kintetsu/kintetsu9000/kintetsu9000_1.png"){ tmpl_std_v3(0, 75) }

//main
  //head gfx
    switch(FEAT_TRAINS, SELF, sw_kintetsu9000_head_2,vehicle_is_flipped){
      mu_car:kintetsu9000_head_base;
      kintetsu9000_head_base_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu9000_head_main,num_vehs_in_vehid_chain==2&&position_in_vehid_chain==0||num_vehs_in_vehid_chain==3&&position_in_vehid_chain==1){
      1:sw_kintetsu9000_head_2;
      kintetsu9000_head_base;
    }
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_kintetsu9000_panto_placer_main,position_in_vehid_chain %4){
        0: kintetsu9000_mot_2;
        2: kintetsu9000_mot;
        kintetsu9000_wag;
      }
  //front-end-fixer
    TRAIN_CONSTRUCTOR_2(sw_kintetsu9000_head_lights, sw_kintetsu9000_head_main, sw_kintetsu9000_lights)
    switch(FEAT_TRAINS, SELF, sw_kintetsu9000_lv,vehicle_type_id){
      mu_car:sw_kintetsu9000_panto_placer_main;
      sw_kintetsu9000_head_lights;
    }
//
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_kintetsu9000_capacity_main,vehicle_type_id){
        mu_car:190;
        170;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_kintetsu9000_car_power_main,position_in_vehid_chain_from_end %3){
      0..1:return 160;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu9000_head_power_main,num_vehs_in_vehid_chain>1&&position_in_vehid_chain==0){
      1:return 160;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu9000_power_main,vehicle_type_id){
      mu_car: sw_kintetsu9000_car_power_main;
      sw_kintetsu9000_head_power_main;
    }
