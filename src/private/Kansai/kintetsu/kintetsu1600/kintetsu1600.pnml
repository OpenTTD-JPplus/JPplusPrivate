  TRAIN_CONSTRUCTOR_2(kintetsu1600_wag, kintetsu1600_car_base, kintetsu1600_rf_t)

//main
  //head gfx
    switch(FEAT_TRAINS, SELF, sw_kintetsu1600_head_main,vehicle_is_flipped){
      1:kintetsu1600_head_mot;
      kintetsu1600_head;
    }
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_kintetsu1600_panto_placer_main,position_in_vehid_chain %4){
        0: kintetsu1600_head_mot_rev;
        2: kintetsu1600_mot;
        kintetsu1600_wag;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_kintetsu1600_lv,vehicle_type_id){
      mu_car:sw_kintetsu1600_panto_placer_main;
      sw_kintetsu1600_head_main;
    }
//
//lv desc
  switch(FEAT_TRAINS, SELF, sw_kintetsu1600_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(LV_KINTETSU_BEIGE),1959);
    2: string(LV_DATED,string(LV_KINTETSU_RED),1965);
    3: string(LV_DATED,string(LV_TWO_TONE),1986);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_kintetsu1600_capacity_main,vehicle_type_id){
        mu_car:150;
        130;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_kintetsu1600_car_power_main,position_in_vehid_chain_from_end %2){
      0:return 125;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu1600_power_main,vehicle_type_id){
      mu_car: sw_kintetsu1600_car_power_main;
      return 125;
    }
