  TRAIN_CONSTRUCTOR_3(kintetsu8000_head_mot, kintetsu8000_head_base, kintetsu8000_rf_mc, sw_kintetsu8000_lights)
  TRAIN_CONSTRUCTOR_3(kintetsu8000_head, kintetsu8000_head_base, kintetsu8000_rf_tc, sw_kintetsu8000_lights)
  TRAIN_CONSTRUCTOR_2(kintetsu8000_mot_2, kintetsu8000_car_base, kintetsu8000_rf_m2)
  TRAIN_CONSTRUCTOR_2(kintetsu8000_mot, kintetsu8000_car_base, kintetsu8000_rf_m)
  TRAIN_CONSTRUCTOR_2(kintetsu8000_wag, kintetsu8000_car_base, kintetsu8000_rf_t)

//main
  //head gfx
    switch(FEAT_TRAINS, SELF, sw_kintetsu8000_head_2,vehicle_is_flipped){
      1:kintetsu8000_head;
      kintetsu8000_head_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu8000_head_main,num_vehs_in_vehid_chain>1){
      1:sw_kintetsu8000_head_2;
      kintetsu8000_head;
    }
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_kintetsu8000_panto_placer_main,position_in_vehid_chain %4){
        0: kintetsu8000_mot_2;
        2: kintetsu8000_mot;
        kintetsu8000_wag;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_kintetsu8000_lv,vehicle_type_id){
      mu_car:sw_kintetsu8000_panto_placer_main;
      sw_kintetsu8000_head_main;
    }
//
//lv desc
  switch(FEAT_TRAINS, SELF, sw_kintetsu8000_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(LV_KINTETSU_BEIGE),1964);
    2: string(LV_DATED,string(LV_KINTETSU_RED),1969);
    3: string(LV_DATED,string(LV_TWO_TONE),1988);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_kintetsu8000_capacity_main,vehicle_type_id){
        mu_car:150;
        130;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_kintetsu8000_car_power_main,position_in_vehid_chain_from_end %3){
      0..1:return 145;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu8000_head_power_main,num_vehs_in_vehid_chain>1&&position_in_vehid_chain==0){
      1:return 145;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu8000_power_main,vehicle_type_id){
      mu_car: sw_kintetsu8000_car_power_main;
      sw_kintetsu8000_head_power_main;
    }
