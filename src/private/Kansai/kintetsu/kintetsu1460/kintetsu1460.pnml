  TRAIN_CONSTRUCTOR_2(kintetsu1460_mot, kintetsu1460_car_base, kintetsu1460_rf_m)
  TRAIN_CONSTRUCTOR_2(kintetsu1460_wag, kintetsu1460_car_base, kintetsu1460_rf_t)

//main
  //head gfx
    switch(FEAT_TRAINS, SELF, sw_kintetsu1460_head_main,vehicle_is_flipped){
      1:kintetsu1460_head;
      kintetsu1460_head_mot;
    }
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_kintetsu1460_panto_placer_main_1,position_in_vehid_chain %2){
        1: kintetsu1460_mot;
        kintetsu1460_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_kintetsu1460_panto_placer_main,num_vehs_in_vehid_chain){
        1: kintetsu1460_head;
        sw_kintetsu1460_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_kintetsu1460_lv,vehicle_type_id){
      mu_car:sw_kintetsu1460_panto_placer_main;
      sw_kintetsu1460_head_main;
    }
//
//lv desc
  switch(FEAT_TRAINS, SELF, sw_kintetsu1460_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(LV_KINTETSU_BEIGE),1957);
    2: string(LV_DATED,string(LV_KINTETSU_RED),1969);
    3: string(LV_DATED,string(LV_TWO_TONE),1988);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_kintetsu1460_capacity_main,vehicle_type_id){
        mu_car:150;
        130;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_kintetsu1460_car_power_main,position_in_vehid_chain_from_end %3){
      0..1:return 75;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu1460_power_main,vehicle_type_id){
      mu_car: sw_kintetsu1460_car_power_main;
      75*2;
    }
