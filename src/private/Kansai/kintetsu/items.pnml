#include "kintetsu9000/kintetsu9000.pnml"

item(FEAT_TRAINS, kintetsu9000) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_kintetsu == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_KINTETSU), "8810/9000/9200/1400/1200/1420/2050/1422/1430", string(STR_NAME_SERIES));
    introduction_date: date(1982, 2, 1);
    model_life: VEHICLE_NEVER_EXPIRES;
    vehicle_life: 30;
    dual_headed: 1;
    
    cost_factor: 20;
    running_cost_factor: 50;
    speed: 110 km/h;
    track_type:TR_1435_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 36 ton;
    badges: ["company/kintetsu"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1435),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_3, 2,4,6)),
    string(STR_USAGE, string(STR_COMMUTER)),
    string(STR_OPERATOR, string(STR_KINTETSU))
    
    );
    
    purchase: kintetsu9000_purchase;
    cargo_capacity:sw_kintetsu9000_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_kintetsu9000_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_kintetsu9000_lv;
    power:sw_kintetsu9000_power_main()*4*1342/1000;
    purchase_power: sw_kintetsu9000_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_empty_desc;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_kintetsu9000_capacity_main()*param_capacity_mod/3;
    power:sw_kintetsu9000_power_main()*4*1342/1000;
    default:sw_kintetsu9000_lv;
    weight: 36;
    
  }
}
