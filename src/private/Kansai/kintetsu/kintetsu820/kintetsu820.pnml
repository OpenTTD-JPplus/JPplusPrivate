//lv desc
  switch(FEAT_TRAINS, SELF, sw_kintetsu820_lv_desc_main, cargo_subtype){
    0: string(LV_DATED,string(LV_KINTETSU_BEIGE),1961);
    1: string(LV_DATED,string(LV_TWO_TONE),1985);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_kintetsu820_capacity_main,vehicle_type_id){
        mu_car:150;
        130;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_kintetsu820_car_power_main,position_in_vehid_chain_from_end %3){
      1:return 125;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu820_power_main,vehicle_type_id){
      mu_car: sw_kintetsu820_car_power_main;
      125;
    }
