//main
  //head gfx
    switch(FEAT_TRAINS, SELF, sw_kintetsu820_head_main,vehicle_is_flipped){
      1:kintetsu820_head;
      kintetsu820_head_mot;
    }
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_kintetsu820_panto_placer_main,position_in_vehid_chain %2){
        1: kintetsu820_mot;
        kintetsu820_wag;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_kintetsu820_lv,vehicle_type_id){
      mu_car:sw_kintetsu820_panto_placer_main;
      sw_kintetsu820_head_main;
    }
