//main
  //head gfx
    switch(FEAT_TRAINS, SELF, sw_kintetsu900_head_main_1,vehicle_is_flipped){
      1:kintetsu900_head;
      kintetsu900_head_mot;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu900_head_main,num_vehs_in_consist){
      3:kintetsu900_head_mot;
      sw_kintetsu900_head_main_1;
    }
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_kintetsu900_panto_placer_main_1,position_in_vehid_chain %2){
        1: kintetsu900_mot;
        kintetsu900_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_kintetsu900_panto_placer_main,num_vehs_in_vehid_chain){
        1: kintetsu900_head;
        sw_kintetsu900_panto_placer_main_1;
      }
  //front-end-fixer
    switch(FEAT_TRAINS, SELF, sw_kintetsu900_lv,vehicle_type_id){
      mu_car:sw_kintetsu900_panto_placer_main;
      sw_kintetsu900_head_main;
    }
//
//lv desc
  switch(FEAT_TRAINS, SELF, sw_kintetsu900_lv_desc_main, cargo_subtype){
    0: string(LV_RANDOM);
    1: string(LV_DATED,string(LV_KINTETSU_BEIGE),1961);
    2: string(LV_DATED,string(LV_KINTETSU_RED),1969);
    3: string(LV_DATED,string(LV_TWO_TONE),1988);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_kintetsu900_capacity_main,vehicle_type_id){
        mu_car:150;
        130;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_kintetsu900_car_power_main,position_in_vehid_chain_from_end %3){
      1:return 145;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_kintetsu900_power_main,vehicle_type_id){
      mu_car: sw_kintetsu900_car_power_main;
      145;
