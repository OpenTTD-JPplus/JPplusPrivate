// purchase
  spriteset(semboku100_purchase_c1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/semboku/semboku100/semboku100_1.png"){ tmpl_purchase_1c_dual(0, 0) }
  spriteset(semboku100_purchase_c2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/semboku/semboku100/semboku100_1.png"){ tmpl_purchase_2c_dual(0, 25) }
  GRAPHIC_STACK_2(semboku100_purchase,  semboku100_purchase_c1, semboku100_purchase_c2)
//base
spriteset(semboku100_lights_front_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/semboku/semboku100/semboku100_lights.png"){ tmpl_std_v3(0, 0) }
spriteset(semboku100_lights_end_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/semboku/semboku100/semboku100_lights.png"){ tmpl_std_v3(0, 25) }
spriteset(semboku100_lights_front_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/semboku/semboku100/semboku100_lights.png"){ tmpl_std_v3(0, 50) }
spriteset(semboku100_lights_end_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/semboku/semboku100/semboku100_lights.png"){ tmpl_std_v3(0, 75) }
switch(FEAT_TRAINS, SELF, sw_semboku100_lights_1, train_is_driving_backwards != vehicle_is_flipped){
  1: semboku100_lights_end_1;
  semboku100_lights_front_1;
}
switch(FEAT_TRAINS, SELF, sw_semboku100_lights_2, train_is_driving_backwards != vehicle_is_flipped){
  1: semboku100_lights_end_2;
  semboku100_lights_front_2;
}
switch(FEAT_TRAINS, SELF, sw_semboku100_lights, current_year<1989){
  1:sw_semboku100_lights_1;  sw_semboku100_lights_2;
}
spriteset(semboku100_1_head_base, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/semboku/semboku100/semboku100_1.png"){ tmpl_std_v3(0, 0) }
spriteset(semboku100_1_head_base_mot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/semboku/semboku100/semboku100_1.png"){ tmpl_std_v3(0, 25) }
spriteset(semboku100_1_head_base_mot_rev, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/semboku/semboku100/semboku100_1.png"){ tmpl_std_rev_v3(0, 25) }
spriteset(semboku100_1_wag, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,      "src/private/Kansai/semboku/semboku100/semboku100_1.png"){ tmpl_std_v3(0, 50) }
