//
  switch(FEAT_TRAINS, SELF, semboku3000_head_base_timed, current_year){
    0..1986:semboku3000_1_head_base;    semboku3000_2_head_base;
  }
  switch(FEAT_TRAINS, SELF, semboku3000_head_base_mot_timed, current_year){
    0..1986:semboku3000_1_head_base_mot;    semboku3000_2_head_base;
  }
  switch(FEAT_TRAINS, SELF, semboku3000_head_base_rev_timed, current_year){
    0..1986:semboku3000_1_head_base_rev;    semboku3000_2_head_1_base_rev;
  }
  switch(FEAT_TRAINS, SELF, semboku3000_head_base_mot_f_timed, current_year){
    0..1986:semboku3000_1_head_base_mot;    semboku3000_2_head_1_base_mot;
  }
  switch(FEAT_TRAINS, SELF, semboku3000_mot_timed, current_year){
    0..1986:semboku3000_1_mot;    semboku3000_2_mot;
  }
  switch(FEAT_TRAINS, SELF, semboku3000_wag_timed, current_year){
    0..1986:semboku3000_1_wag;    semboku3000_2_wag;
  }

  switch(FEAT_TRAINS, SELF, semboku3000_head_base, cargo_subtype){
    1:semboku3000_1_head_base;    2:semboku3000_2_head_base;    3:semboku3000_3_head_base;  semboku3000_head_base_timed;
  }
  switch(FEAT_TRAINS, SELF, semboku3000_head_base_mot, cargo_subtype){
    1:semboku3000_1_head_base_mot;    2:semboku3000_2_head_base;    3:semboku3000_3_head_base_mot;  semboku3000_head_base_mot_timed;
  }

  switch(FEAT_TRAINS, SELF, semboku3000_head_f, cargo_subtype){
    1:semboku3000_1_head_base_rev;    2:semboku3000_2_head_1_base_rev;    3:semboku3000_3_head_f;  semboku3000_head_base_rev_timed;
  }
  switch(FEAT_TRAINS, SELF, semboku3000_head_mot_f_0, cargo_subtype){
    1:semboku3000_1_head_base_mot;    2:semboku3000_2_head_1_base_mot;    3:semboku3000_3_head_mot_f;  semboku3000_head_base_mot_f_timed;
  }
  switch(FEAT_TRAINS, SELF, semboku3000_head_f_rev, cargo_subtype){
    1:semboku3000_1_head_base;    2:semboku3000_2_head_base;    3:semboku3000_3_head_f_rev;  semboku3000_head_base_timed;
  }

  switch(FEAT_TRAINS, SELF, semboku3000_mot, cargo_subtype){
    1:semboku3000_1_mot;    2:semboku3000_2_mot;    3:semboku3000_3_mot;  semboku3000_mot_timed;
  }
  switch(FEAT_TRAINS, SELF, semboku3000_wag, cargo_subtype){
    1:semboku3000_1_wag;    2:semboku3000_2_wag;    3:semboku3000_3_wag;  semboku3000_wag_timed;
  }

//main
  //panto placer
      switch(FEAT_TRAINS, SELF, sw_semboku3000_panto_placer_main_1,position_in_vehid_chain %5){
        0: semboku3000_mot;
        2: semboku3000_mot;
        semboku3000_wag;
      }
      switch(FEAT_TRAINS, SELF, sw_semboku3000_panto_placer_main,position_in_vehid_chain %2){
        0: semboku3000_mot;
        semboku3000_wag;
      }
  switch(FEAT_TRAINS, SELF, semboku3000_head_mot_f, position_in_vehid_chain_from_end){
    0:semboku3000_head_mot_f_0;    semboku3000_head_f_rev;
  }
  //fake head placer
      switch(FEAT_TRAINS, SELF, sw_semboku3000_fake_head_placer_main_6_2,position_in_vehid_chain){
        4: semboku3000_head_f;
        5: semboku3000_head_mot_f;
        sw_semboku3000_panto_placer_main_1;
      }
      switch(FEAT_TRAINS, SELF, sw_semboku3000_fake_head_placer_main_4_4,position_in_vehid_chain){
        2: semboku3000_head_f;
        3: semboku3000_head_f_rev;
        sw_semboku3000_panto_placer_main;
      }
      random_switch(FEAT_TRAINS,PARENT,sw_semboku3000_fake_head_placer_main_0){
        2:sw_semboku3000_fake_head_placer_main_4_4;
        1:sw_semboku3000_fake_head_placer_main_6_2;
      }
      switch(FEAT_TRAINS, SELF, sw_semboku3000_fake_head_placer_main_t, current_year){
        0..1980:sw_semboku3000_panto_placer_main;
        sw_semboku3000_fake_head_placer_main_0;
      }
      switch(FEAT_TRAINS, SELF, sw_semboku3000_fake_head_placer_main,num_vehs_in_vehid_chain){
        0..5:sw_semboku3000_panto_placer_main;
        6..7:sw_semboku3000_fake_head_placer_main_t;
        sw_semboku3000_fake_head_placer_main_6_2;
      }

  //front-end-fixer
    switch(FEAT_TRAINS, SELF, semboku3000_head_base_main,(position_in_vehid_chain==0&&num_vehs_in_vehid_chain==2)||(position_in_vehid_chain==1&&num_vehs_in_vehid_chain==3)){
      1:semboku3000_head_base_mot;
      semboku3000_head_base;
    }
    TRAIN_CONSTRUCTOR_2(semboku3000_head, semboku3000_head_base_main, sw_semboku3000_lights)
    switch(FEAT_TRAINS, SELF, sw_semboku3000_lv,vehicle_type_id){
      mu_car:sw_semboku3000_fake_head_placer_main;
      semboku3000_head;
    }
//
//lv select
  switch(FEAT_TRAINS, SELF, sw_semboku3000_lv_desc_main, cargo_subtype){
    0:string(LV_RANDOM);
    1:string(LV_DATED,string(STR_LIVERY,string(LV_DEFAULT)),1975);
    2:string(LV_DATED,string(STR_LIVERY,string(LV_MODERN)),1987);
    3:string(LV_DATED,string(LV_semboku3000_3),2012);
  }
//post fixers
  //capacity-changer
    switch(FEAT_TRAINS, SELF, sw_semboku3000_capacity_main,vehicle_type_id){
        mu_car:155;
        144;
    }
  //power
    switch(FEAT_TRAINS, SELF, sw_semboku3000_car_power_main,position_in_vehid_chain_from_end %6){
      0..4:return 145;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_semboku3000_head_power_main,num_vehs_in_vehid_chain<4){
      1:return 145*2;
      return 0;
    }
    switch(FEAT_TRAINS, SELF, sw_semboku3000_power_main,vehicle_type_id){
      mu_car: sw_semboku3000_car_power_main;
      sw_semboku3000_head_power_main;
    }
