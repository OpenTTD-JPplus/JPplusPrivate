#include "semboku100/semboku100.pnml"

item(FEAT_TRAINS, semboku100) {
  property {
    OVERRIDEN_TRAIN_DATA
    
    climates_available: param_disable_nankai == 0 ? ALL_CLIMATES : NO_CLIMATE;
    name: string(STR_TRAIN_NAME, string(STR_NAME_SEMBOKU), "100", string(STR_NAME_SERIES));
    introduction_date: date(1971, 4, 1);
    model_life: 34;
    vehicle_life: 29;
    dual_headed: 1;
    
    cost_factor: 18;
    running_cost_factor: 48;
    speed: 100 km/h;
    track_type:TR_1067_DC
     ;
    power: 1 kW;
    tractive_effort_coefficient:  0.2;
    weight: 24 ton;
    badges: ["company/semboku"];
    
  }
	graphics {
    
    
     
    additional_text:string(STR_TRAIN_DESC,
    string(STR_1067),
    string(STR_DENKI, string(STR_DC, 1500)),
    string(STR_LOAD_SPEED, string(STR_DOORS, 4)),
    string(STR_FORMATION, string(STR_NUM_CARS_3, 2,4,6)),
    string(STR_USAGE, string(STR_COMMUTER)),
    string(STR_OPERATOR, string(STR_SEMBOKU))
    
    );
    cargo_subtype_text: sw_semboku100_lv_desc_main;
    purchase: semboku100_purchase;
    cargo_capacity:sw_semboku100_capacity_main()*param_capacity_mod/3;
    purchase_cargo_capacity:sw_semboku100_capacity_main()*param_capacity_mod/3-1;
    loading_speed:param_loading_4D;
    default:sw_semboku100_lv;
    power:sw_semboku100_power_main()*4*1342/1000;
    purchase_power: sw_semboku100_car_power_main()*4*1342/1000;
    
    
    
    
    
  }
  livery_override(mu_car){
		cargo_subtype_text:sw_semboku100_lv_desc_main;
    loading_speed:param_loading_4D;
    cargo_capacity:sw_semboku100_capacity_main()*param_capacity_mod/3;
    power:sw_semboku100_power_main()*4*1342/1000;
    default:sw_semboku100_lv;
    weight: 24;
    
  }
}
